From 6b60fa96409162defa592028f3e47ec8e3f64fe2 Mon Sep 17 00:00:00 2001
From: P4R4D16M4 <patrick@heinzelbecker.com>
Date: Fri, 9 Oct 2026 12:52:45 +0200
Subject: [PATCH 12/15] V600g: register the stock NAND config partition
 read-only

The UntrashOS takeover importer reads /etc/zyxel (UBI volume ubi_config,
UBIFS) from NAND offset 0, 10 MiB.  The parent MTD stays non-writable, so
UBI attaches it in ro_mode like rootfs1 in the loaders.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mtd/nand/raw/comcerto-nand.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/mtd/nand/raw/comcerto-nand.c b/drivers/mtd/nand/raw/comcerto-nand.c
index 4d05f51e8..5ea4f5c72 100644
--- a/drivers/mtd/nand/raw/comcerto-nand.c
+++ b/drivers/mtd/nand/raw/comcerto-nand.c
@@ -110,6 +110,17 @@ static const struct mtd_partition comcerto_nand_v213_parts[] = {
 		.offset = 20 * 1024 * 1024,
 		.size = 110 * 1024 * 1024,
 	},
+	/*
+	 * V600g: stock /etc/zyxel (UBI volume ubi_config, UBIFS) for the
+	 * UntrashOS takeover importer.  Same non-writable parent, so UBI
+	 * attaches it in ro_mode.  Appended after rootfs1 to keep its mtd
+	 * number (the loaders pass ubi.mtd=rootfs1 by name anyway).
+	 */
+	{
+		.name = "config",
+		.offset = 0,
+		.size = 10 * 1024 * 1024,
+	},
 };
 
 static inline struct comcerto_nand *to_comcerto_nand(struct nand_chip *chip)
