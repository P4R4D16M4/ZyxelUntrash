+int comcerto_pfe_ctrl_validate_async_command_queue(void)
+{
+	LIST_HEAD(queue);
+	spinlock_t lock;
+	struct comcerto_pfe_ctrl_async_command_request *request;
+	unsigned long flags;
+	int ret = 0;
+
+	/* This proves only private list ownership under a local lock.  It has no
+	 * worker, global queue, dispatch path or callback, and is empty on return. */
+	request = kzalloc(COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES,
+			  GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&request->node);
+	spin_lock_init(&lock);
+	spin_lock_irqsave(&lock, flags);
+	list_add_tail(&request->node, &queue);
+	if (list_empty(&queue) || list_first_entry(&queue,
+		struct comcerto_pfe_ctrl_async_command_request, node) != request)
+		ret = -EINVAL;
+	list_del_init(&request->node);
+	if (!list_empty(&queue) || !list_empty(&request->node))
+		ret = -EINVAL;
+	spin_unlock_irqrestore(&lock, flags);
+	kfree(request);
+	return ret;
+}
