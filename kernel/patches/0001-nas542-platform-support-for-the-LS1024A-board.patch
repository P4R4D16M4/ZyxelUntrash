diff --git a/drivers/reset/reset-comcerto.c b/drivers/reset/reset-comcerto.c
new file mode 100644
index 000000000..6f4ffed4a
--- /dev/null
+++ b/drivers/reset/reset-comcerto.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mindspeed Comcerto 2000 ClockCore reset controller.
+ *
+ * The register-address encoding is independently corroborated by the
+ * LS1024A reference port and a read-only NAS542 V334 hardware observation.
+ * Only the PFE reset IDs declared in dt-bindings/reset/comcerto-2000.h are
+ * accepted until other reset lines are independently validated.
+ */
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset-controller.h>
+
+#include <dt-bindings/reset/comcerto-2000.h>
+
+#define COMCERTO2000_RESET_DELAY_US	200
+
+struct comcerto_reset {
+	struct regmap *regmap;
+	struct reset_controller_dev rcdev;
+};
+
+#define to_comcerto_reset(_rcdev) \
+	container_of(_rcdev, struct comcerto_reset, rcdev)
+
+static bool comcerto_reset_valid(unsigned long id)
+{
+	return id == COMCERTO2000_RESET_AXI_PFE_SYS ||
+	       id == COMCERTO2000_RESET_PFE_CORE;
+}
+
+static unsigned int comcerto_reset_offset(unsigned long id)
+{
+	return (id & ~0x1f) >> 3;
+}
+
+static int comcerto_reset_assert(struct reset_controller_dev *rcdev,
+				 unsigned long id)
+{
+	struct comcerto_reset *reset = to_comcerto_reset(rcdev);
+
+	if (!comcerto_reset_valid(id))
+		return -EINVAL;
+
+	regmap_update_bits(reset->regmap, comcerto_reset_offset(id),
+			   BIT(id & 0x1f), BIT(id & 0x1f));
+	udelay(COMCERTO2000_RESET_DELAY_US);
+	return 0;
+}
+
+static int comcerto_reset_deassert(struct reset_controller_dev *rcdev,
+				   unsigned long id)
+{
+	struct comcerto_reset *reset = to_comcerto_reset(rcdev);
+
+	if (!comcerto_reset_valid(id))
+		return -EINVAL;
+
+	regmap_update_bits(reset->regmap, comcerto_reset_offset(id),
+			   BIT(id & 0x1f), 0);
+	udelay(COMCERTO2000_RESET_DELAY_US);
+	return 0;
+}
+
+static int comcerto_reset_reset(struct reset_controller_dev *rcdev,
+				unsigned long id)
+{
+	int ret;
+
+	ret = comcerto_reset_assert(rcdev, id);
+	if (ret)
+		return ret;
+
+	return comcerto_reset_deassert(rcdev, id);
+}
+
+static int comcerto_reset_status(struct reset_controller_dev *rcdev,
+				  unsigned long id)
+{
+	struct comcerto_reset *reset = to_comcerto_reset(rcdev);
+	unsigned int value;
+	int ret;
+
+	if (!comcerto_reset_valid(id))
+		return -EINVAL;
+
+	ret = regmap_read(reset->regmap, comcerto_reset_offset(id), &value);
+	if (ret)
+		return ret;
+
+	return !!(value & BIT(id & 0x1f));
+}
+
+static const struct reset_control_ops comcerto_reset_ops = {
+	.reset = comcerto_reset_reset,
+	.assert = comcerto_reset_assert,
+	.deassert = comcerto_reset_deassert,
+	.status = comcerto_reset_status,
+};
+
+static int comcerto_reset_probe(struct platform_device *pdev)
+{
+	struct comcerto_reset *reset;
+	struct device_node *parent;
+
+	reset = devm_kzalloc(&pdev->dev, sizeof(*reset), GFP_KERNEL);
+	if (!reset)
+		return -ENOMEM;
+
+	parent = of_get_parent(pdev->dev.of_node);
+	reset->regmap = syscon_node_to_regmap(parent);
+	of_node_put(parent);
+	if (IS_ERR(reset->regmap))
+		return PTR_ERR(reset->regmap);
+
+	reset->rcdev.owner = THIS_MODULE;
+	reset->rcdev.ops = &comcerto_reset_ops;
+	reset->rcdev.of_node = pdev->dev.of_node;
+	reset->rcdev.nr_resets = COMCERTO2000_RESET_PFE_CORE + 1;
+
+	return devm_reset_controller_register(&pdev->dev, &reset->rcdev);
+}
+
+static const struct of_device_id comcerto_reset_of_match[] = {
+	{ .compatible = "mindspeed,comcerto-2000-reset" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, comcerto_reset_of_match);
+
+static struct platform_driver comcerto_reset_driver = {
+	.probe = comcerto_reset_probe,
+	.driver = {
+		.name = "comcerto-2000-reset",
+		.of_match_table = comcerto_reset_of_match,
+	},
+};
+module_platform_driver(comcerto_reset_driver);
+
+MODULE_DESCRIPTION("Mindspeed Comcerto 2000 reset controller");
+MODULE_LICENSE("GPL");
diff --git a/drivers/reset/reset-ls1024a.c b/drivers/reset/reset-ls1024a.c
new file mode 100644
index 000000000..30d64660d
--- /dev/null
+++ b/drivers/reset/reset-ls1024a.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Mindspeed Comcerto (aka. QorIQ LS1024A) reset driver
+ * Copyright (c) 2018 Hugo Grostabussiat <bonstra@bonstra.fr.eu.org>
+ *
+ * Copied from reset-berlin.c
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset-controller.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+#include <dt-bindings/reset/ls1024a.h>
+
+/* Let the reset be effective (datasheet specifies a minimum of 100us for a
+ * global external reset. Double the duration just to be safe.
+ * Here, we assume a block reset is faster than a global external reset, but
+ * that could be wrong.
+ */
+#define LS1024A_RESET_DELAY_US 200
+
+#define to_ls1024a_reset_priv(p)		\
+	container_of((p), struct ls1024a_reset_priv, rcdev)
+
+struct ls1024a_reset_priv {
+	struct regmap			*regmap;
+	struct reset_controller_dev	rcdev;
+};
+
+static bool is_self_deasserting(unsigned long id)
+{
+	switch(id) {
+	case LS1024A_DEVICE_PWR_ON_SOFT_RST:
+	case LS1024A_DEVICE_GLB_SCLR_RST:
+	case LS1024A_DEVICE_FUNC_SCLR_RST:
+	case LS1024A_DEVICE_CLKRST_SCLR_RST:
+		return true;
+	}
+	return false;
+}
+
+static int ls1024a_reset_reset(struct reset_controller_dev *rcdev,
+                                unsigned long id)
+{
+	struct ls1024a_reset_priv *priv = to_ls1024a_reset_priv(rcdev);
+	int offset = (id & ~0x1f) >> 3;
+	int mask = BIT(id & 0x1f);
+	if (id > LS1024A_MAX_RST)
+		return -EINVAL;
+
+	regmap_write_bits(priv->regmap, offset, mask, mask);
+	udelay(LS1024A_RESET_DELAY_US);
+
+	if (!is_self_deasserting(id))
+		regmap_write_bits(priv->regmap, offset, mask, 0);
+
+	udelay(LS1024A_RESET_DELAY_US);
+
+	return 0;
+}
+
+static int ls1024a_reset_assert(struct reset_controller_dev *rcdev,
+                                 unsigned long id)
+{
+	struct ls1024a_reset_priv *priv = to_ls1024a_reset_priv(rcdev);
+	int offset = (id & ~0x1f) >> 3;
+	int mask = BIT(id & 0x1f);
+	if (id > LS1024A_MAX_RST)
+		return -EINVAL;
+
+	if (is_self_deasserting(id))
+		return -EINVAL;
+
+	regmap_write_bits(priv->regmap, offset, mask, mask);
+	udelay(LS1024A_RESET_DELAY_US);
+	return 0;
+}
+
+static int ls1024a_reset_deassert(struct reset_controller_dev *rcdev,
+                                   unsigned long id)
+{
+	struct ls1024a_reset_priv *priv = to_ls1024a_reset_priv(rcdev);
+	int offset = (id & ~0x1f) >> 3;
+	int mask = BIT(id & 0x1f);
+	if (id > LS1024A_MAX_RST)
+		return -EINVAL;
+
+	if (is_self_deasserting(id))
+		return -EINVAL;
+
+	regmap_write_bits(priv->regmap, offset, mask, 0);
+	udelay(LS1024A_RESET_DELAY_US);
+	return 0;
+}
+
+static int ls1024a_reset_status(struct reset_controller_dev *rcdev,
+                                 unsigned long id)
+{
+	struct ls1024a_reset_priv *priv = to_ls1024a_reset_priv(rcdev);
+	unsigned int offset = (id & ~0x1f) >> 3;
+	unsigned int mask = BIT(id & 0x1f);
+	unsigned int val = 0;
+	if (id > LS1024A_MAX_RST)
+		return -EINVAL;
+
+	regmap_read(priv->regmap, offset, &val);
+	return !!(val & mask);
+}
+
+static const struct reset_control_ops ls1024a_reset_ops = {
+	.reset		= ls1024a_reset_reset,
+	.assert		= ls1024a_reset_assert,
+	.deassert	= ls1024a_reset_deassert,
+	.status		= ls1024a_reset_status
+};
+
+static int ls1024a_reset_probe(struct platform_device *pdev)
+{
+	struct ls1024a_reset_priv *priv;
+	struct device_node *parent_np;
+
+	if (!pdev->dev.of_node)
+		return -EINVAL;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	parent_np = of_get_parent(pdev->dev.of_node);
+	priv->regmap = syscon_node_to_regmap(parent_np);
+	of_node_put(parent_np);
+	if (IS_ERR(priv->regmap))
+		return PTR_ERR(priv->regmap);
+
+	priv->rcdev.of_node = pdev->dev.of_node;
+	priv->rcdev.nr_resets = LS1024A_MAX_RST + 1;
+	priv->rcdev.owner = THIS_MODULE;
+	priv->rcdev.ops = &ls1024a_reset_ops;
+
+	return devm_reset_controller_register(&pdev->dev, &priv->rcdev);
+}
+
+static const struct of_device_id ls1024a_reset_dt_match[] = {
+	{ .compatible = "fsl,ls1024a-reset" },
+	{ },
+};
+
+static struct platform_driver ls1024a_reset_driver = {
+	.probe	= ls1024a_reset_probe,
+	.driver	= {
+		.name = "ls1024a-reset",
+		.of_match_table = ls1024a_reset_dt_match,
+	},
+};
+builtin_platform_driver(ls1024a_reset_driver);
