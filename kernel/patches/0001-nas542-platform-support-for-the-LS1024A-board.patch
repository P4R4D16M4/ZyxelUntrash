diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio-regs.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio-regs.h
new file mode 100644
index 000000000..40a89806d
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio-regs.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Recovered from stock pfe_eth_mdio_{read,write}(). */
+#ifndef COMCERTO_PFE_MDIO_REGS_H
+#define COMCERTO_PFE_MDIO_REGS_H
+
+#include "comcerto-pfe-gemac-regs.h"
+
+#define COMCERTO_PFE_MDIO_STATUS		COMCERTO_PFE_GEMAC_MII_STATUS
+#define COMCERTO_PFE_MDIO_COMMAND		COMCERTO_PFE_GEMAC_MII_COMMAND
+#define COMCERTO_PFE_MDIO_BUSY			COMCERTO_PFE_GEMAC_MII_DONE
+#define COMCERTO_PFE_MDIO_START		BIT(17)
+#define COMCERTO_PFE_MDIO_READ			0x60000000
+#define COMCERTO_PFE_MDIO_WRITE			0x50000000
+#define COMCERTO_PFE_MDIO_PHY_SHIFT		23
+#define COMCERTO_PFE_MDIO_REG_SHIFT		18
+#define COMCERTO_PFE_MDIO_TIMEOUT_LOOPS	1000
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio.c
new file mode 100644
index 000000000..ca6007ef7
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-mdio.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+
+#include "comcerto-pfe-mdio-regs.h"
+#include "comcerto-pfe-mdio.h"
+
+static int comcerto_pfe_mdio_wait(void __iomem *base)
+{
+	u32 status;
+
+	return readl_poll_timeout(base + COMCERTO_PFE_MDIO_STATUS, status,
+				  status & COMCERTO_PFE_MDIO_BUSY,
+				  1, COMCERTO_PFE_MDIO_TIMEOUT_LOOPS);
+}
+
+int comcerto_pfe_mdio_read(void __iomem *base, int phy, int regnum)
+{
+	u32 command;
+	int ret;
+
+	if (!base || phy < 0 || phy > 0x1f || regnum < 0 || regnum > 0x1f)
+		return -EINVAL;
+	command = COMCERTO_PFE_MDIO_READ | COMCERTO_PFE_MDIO_START |
+		  (phy << COMCERTO_PFE_MDIO_PHY_SHIFT) |
+		  (regnum << COMCERTO_PFE_MDIO_REG_SHIFT);
+	writel(command, base + COMCERTO_PFE_MDIO_COMMAND);
+	ret = comcerto_pfe_mdio_wait(base);
+	return ret ? ret : readl(base + COMCERTO_PFE_MDIO_COMMAND) & 0xffff;
+}
+
+int comcerto_pfe_mdio_write(void __iomem *base, int phy, int regnum, u16 val)
+{
+	u32 command;
+
+	if (!base || phy < 0 || phy > 0x1f || regnum < 0 || regnum > 0x1f)
+		return -EINVAL;
+	command = COMCERTO_PFE_MDIO_WRITE | COMCERTO_PFE_MDIO_START | val |
+		  (phy << COMCERTO_PFE_MDIO_PHY_SHIFT) |
+		  (regnum << COMCERTO_PFE_MDIO_REG_SHIFT);
+	writel(command, base + COMCERTO_PFE_MDIO_COMMAND);
+	return comcerto_pfe_mdio_wait(base);
+}
+
+int comcerto_pfe_mdio_set_mdc_div(void __iomem *base, unsigned int divider)
+{
+	u32 value;
+
+	if (!base)
+		return -EINVAL;
+
+	/* Exact stock gemac_set_mdc_div() selector table. */
+	switch (divider) {
+	case 8:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_8;
+		break;
+	case 16:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_16;
+		break;
+	case 32:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_32;
+		break;
+	case 48:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_48;
+		break;
+	case 96:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_96;
+		break;
+	case 128:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_128;
+		break;
+	case 224:
+		value = COMCERTO_PFE_GEMAC_MDC_DIV_224;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	value |= readl(base + COMCERTO_PFE_GEMAC_CONFIG) &
+		~COMCERTO_PFE_GEMAC_MII_DIV_MASK;
+	writel(value, base + COMCERTO_PFE_GEMAC_CONFIG);
+	return 0;
+}
+
+int comcerto_pfe_mdio_enable(void __iomem *base)
+{
+	u32 value;
+
+	if (!base)
+		return -EINVAL;
+	value = readl(base + COMCERTO_PFE_GEMAC_ECNTRL);
+	writel(value | COMCERTO_PFE_GEMAC_ECNTRL_MII,
+	       base + COMCERTO_PFE_GEMAC_ECNTRL);
+	/* Stock gemac_enable_mdio() only updates ECNTRL.  Completion is polled
+	 * by the subsequent Clause-22 command, not by this enable operation. */
+	return 0;
+}
