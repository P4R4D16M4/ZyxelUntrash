+int comcerto_pfe_ctrl_validate_async_command_contract(void)
+{
+	struct comcerto_pfe_ctrl_async_command_request request = { };
+	u32 allocation_bytes = COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES;
+
+	/* The atomic stock path permits at most 0x100 bytes, allocates the fixed
+	 * 0x18-byte header plus payload, then queues it.  Keep the unqueued,
+	 * callback-free zero-length boundary only. */
+	INIT_LIST_HEAD(&request.node);
+	if (request.payload_length > COMCERTO_PFE_CTRL_COMMAND_PAYLOAD_MAX ||
+	    allocation_bytes != COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES ||
+	    request.completion_callback || request.completion_context ||
+	    request.fcode || request.payload_pointer ||
+	    list_empty(&request.node) == false)
