+
+static const struct pfe_expect pfe_expect[] = {
+	{ "ddr", 0x03400000, COMCERTO_PFE_DDR_SIZE, true },
+	{ "axi", 0x9c000000, 0x01000000, true },
+	{ "apb", 0x90500000, 0x00010000, true },
+	{ "iram", 0x83000000, 0x00002000, true },
+	{ "ipsec", 0x9a000000, 0x00100000, false },
+	/* This is the same shared clock/reset window used by the stock restart
+	 * handler.  It is mapped solely for the V334 read-only contract check. */
+	{ "clkcore", 0x904b0000, 0x00000400, true },
+};
