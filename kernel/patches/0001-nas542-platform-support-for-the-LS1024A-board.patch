+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef COMCERTO_PFE_PE_LAYOUT_H
+#define COMCERTO_PFE_PE_LAYOUT_H
+
+#include <linux/build_bug.h>
+#include <linux/types.h>
+
+/*
+ * Exact .{class,tmu,util}_dmem_sh section sizes from NAS542 stock pfe.ko.
+ * These are firmware/control-plane shared-memory contracts, not host buffer
+ * allocations.  Keep them separate from the PFE-DDR firmware reservations.
+ */
+#define COMCERTO_PFE_CLASS_DMEM_SHARED_BYTES	0x1140
+#define COMCERTO_PFE_CLASS_LMEM_SHARED_BYTES	0x1900
+#define COMCERTO_PFE_TMU_DMEM_SHARED_BYTES	0x0338
+#define COMCERTO_PFE_UTIL_DMEM_SHARED_BYTES	0x05e1
+
+enum comcerto_pfe_pe_kind {
+	COMCERTO_PFE_PE_CLASS,
+	COMCERTO_PFE_PE_TMU,
+	COMCERTO_PFE_PE_UTIL,
+};
+
+struct comcerto_pfe_pe_layout {
+	enum comcerto_pfe_pe_kind kind;
+	u8 id;
+	u32 dmem_base;
+	u32 dmem_size;
+	u32 pmem_base;
+	u32 pmem_size;
+	u32 cbus_offset;
+	u32 mem_addr_offset;
+	u32 mem_wdata_offset;
+	u32 mem_rdata_offset;
+};
+
+static_assert(COMCERTO_PFE_CLASS_DMEM_SHARED_BYTES <= 0x2000);
+static_assert(COMCERTO_PFE_CLASS_LMEM_SHARED_BYTES <= 0x2000);
+static_assert(COMCERTO_PFE_TMU_DMEM_SHARED_BYTES <= 0x0800);
+static_assert(COMCERTO_PFE_UTIL_DMEM_SHARED_BYTES <= 0x2000);
+
+/* Pure recovered metadata: no MMIO mapping or register access. */
+int comcerto_pfe_pe_layout(u8 id, struct comcerto_pfe_pe_layout *layout);
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-regs.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-regs.h
new file mode 100644
index 000000000..441d3aaa3
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-regs.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Indirect PE-memory windows recovered from the stock module and GPL U-Boot.
+ * These are constants only: no caller is permitted to access hardware yet.
+ */
+#ifndef COMCERTO_PFE_PE_REGS_H
+#define COMCERTO_PFE_PE_REGS_H
+
+#include "comcerto-pfe-class-bus-regs.h"
+
+#define COMCERTO_PFE_TMU_CBUS_OFFSET		0x00310000
+#define COMCERTO_PFE_UTIL_CBUS_OFFSET		0x00360000
+
+#define COMCERTO_PFE_CLASS_PE_MEM_ADDR		0x00000100
+#define COMCERTO_PFE_CLASS_PE_MEM_WDATA	0x00000104
+#define COMCERTO_PFE_CLASS_PE_MEM_RDATA	0x00000108
+
+#define COMCERTO_PFE_TMU_PE_MEM_ADDR		0x000000e4
+#define COMCERTO_PFE_TMU_PE_MEM_WDATA		0x000000e8
+#define COMCERTO_PFE_TMU_PE_MEM_RDATA		0x000000ec
+
+#define COMCERTO_PFE_UTIL_PE_MEM_ADDR		0x00000100
+#define COMCERTO_PFE_UTIL_PE_MEM_WDATA		0x00000104
+#define COMCERTO_PFE_UTIL_PE_MEM_RDATA		0x00000108
+
+#define COMCERTO_PFE_PE_MEM_WRITE		0x80000000
+#define COMCERTO_PFE_PE_MEM_BYTE_ENABLE_SHIFT	24
+#define COMCERTO_PFE_PE_MEM_DMEM		0x00010000
+#define COMCERTO_PFE_PE_MEM_IMEM		0x00008000
+
+/*
+ * `offset` is 0..3 and `size` is 1..4; both are prevalidated by the loader.
+ * The indirect port presents its byte-enable bits in address-lane order.  The
+ * data word itself is byte-reversed at the MMIO boundary (see pfe_pe_write),
+ * which is intentionally independent of this address-lane mask.  V457
+ * verifies lane 0 by roundtripping the existing CLASS byte zero.
+ */
+#define COMCERTO_PFE_PE_MEM_BYTE_ENABLE(offset, size) \
+	((((1U << (size)) - 1U) << (offset)) << \
+	 COMCERTO_PFE_PE_MEM_BYTE_ENABLE_SHIFT)
+
+#endif
