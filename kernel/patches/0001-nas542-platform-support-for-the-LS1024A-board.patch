diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-class-bus-regs.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-class-bus-regs.h
new file mode 100644
index 000000000..0a326949b
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-class-bus-regs.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Recovered from stock class_bus_{read,write} and PE-LMEM transfer helpers. */
+#ifndef COMCERTO_PFE_CLASS_BUS_REGS_H
+#define COMCERTO_PFE_CLASS_BUS_REGS_H
+
+#define COMCERTO_PFE_CLASS_CBUS_OFFSET		0x00320000
+#define COMCERTO_PFE_CLASS_MEM_ACCESS_CMD	0x00000228
+#define COMCERTO_PFE_CLASS_MEM_ACCESS_WDATA	0x0000022c
+#define COMCERTO_PFE_CLASS_MEM_ACCESS_RDATA	0x00000230
+#define COMCERTO_PFE_CLASS_MEM_ACCESS_ADDR_EXT	0x00000258
+
+#define COMCERTO_PFE_CLASS_ADDR_LOW24_MASK	0x00ffffff
+#define COMCERTO_PFE_CLASS_ADDR_HIGH8_MASK	0xff000000
+#define COMCERTO_PFE_CLASS_PE_LMEM_COMMAND	0x84000000
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.c
new file mode 100644
index 000000000..c158a8fda
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.c
@@ -0,0 +1,1368 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Host-only portion of the NAS542 stock pfe_ctrl_init()/tx_init() contract. */
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#include "comcerto-pfe-ctrl-contract.h"
+#include "comcerto-pfe-fw-load.h"
+#include "comcerto-pfe-pe-layout.h"
+
+void comcerto_pfe_ctrl_prepare_phy_ports(
+	struct comcerto_pfe_ctrl_phy_port *ports, const u8 *interface_codes)
+{
+	unsigned int i;
+
+	if (!ports || !interface_codes)
+		return;
+
+	memset(ports, 0, sizeof(*ports) * COMCERTO_PFE_CTRL_PHY_PORT_COUNT);
+	for (i = 0; i < COMCERTO_PFE_CTRL_PHY_PORT_COUNT; i++) {
+		ports[i].interface_code = interface_codes[i];
+		ports[i].onif_index = i;
+	}
+}
+
+int comcerto_pfe_ctrl_class_phy_port_target(u8 class_pe, u8 port,
+					     u32 *dmem_offset)
+{
+	if (!dmem_offset || class_pe >= COMCERTO_PFE_CTRL_CLASS_PE_COUNT ||
+	    port >= COMCERTO_PFE_CTRL_PHY_PORT_COUNT)
+		return -EINVAL;
+
+	/* Stock tx_init() passes phy_port + 5 through virt_to_class_dmem() and
+	 * publishes the ONIF index byte at that shared-DMEM address. */
+	*dmem_offset = COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+		port * COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+		COMCERTO_PFE_CTRL_PHY_PORT_ONIF_INDEX_OFFSET;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_plan_phy_port_publish(u8 port, u8 value,
+		struct comcerto_pfe_ctrl_dmem_write *writes,
+		unsigned int write_count)
+{
+	unsigned int pe;
+	int ret;
+
+	if (!writes || write_count < COMCERTO_PFE_CTRL_CLASS_PE_COUNT)
+		return -EINVAL;
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		ret = comcerto_pfe_ctrl_class_phy_port_target(pe, port,
+						      &writes[pe].offset);
+		if (ret)
+			return ret;
+		writes[pe].class_pe = pe;
+		writes[pe].value = value;
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_phy_port_plan(void)
+{
+	struct comcerto_pfe_ctrl_phy_port ports[COMCERTO_PFE_CTRL_PHY_PORT_COUNT];
+	struct comcerto_pfe_ctrl_dmem_write writes[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	u8 codes[COMCERTO_PFE_CTRL_PHY_PORT_COUNT] = {
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+	};
+	unsigned int port, pe;
+
+	comcerto_pfe_ctrl_prepare_phy_ports(ports, codes);
+	for (port = 0; port < ARRAY_SIZE(ports); port++) {
+		if (ports[port].callback ||
+		    ports[port].interface_code != COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH ||
+		    ports[port].onif_index != port)
+			return -EINVAL;
+		if (comcerto_pfe_ctrl_plan_phy_port_publish(port,
+				ports[port].onif_index, writes, ARRAY_SIZE(writes)))
+			return -EINVAL;
+		for (pe = 0; pe < ARRAY_SIZE(writes); pe++)
+			if (writes[pe].class_pe != pe || writes[pe].value != port ||
+			    writes[pe].offset != COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+				port * COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+				COMCERTO_PFE_CTRL_PHY_PORT_ONIF_INDEX_OFFSET)
+				return -EINVAL;
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_plan_tx_command(u16 fcode, u16 payload_length,
+	const struct comcerto_pfe_ctrl_tx_configure_payload *payload,
+	struct comcerto_pfe_ctrl_tx_command_plan *plan)
+{
+	u8 port;
+
+	if (!payload || !plan)
+		return -EINVAL;
+	port = payload->physical_port;
+	if (port >= COMCERTO_PFE_CTRL_PHY_PORT_COUNT)
+		return -EINVAL;
+	if (fcode == COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE &&
+	    payload_length < sizeof(*payload))
+		return -EINVAL;
+	if (fcode == COMCERTO_PFE_CTRL_TX_FCODE_DISABLE &&
+	    payload_length < sizeof(payload->physical_port))
+		return -EINVAL;
+	if (fcode != COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE &&
+	    fcode != COMCERTO_PFE_CTRL_TX_FCODE_DISABLE)
+		return -EINVAL;
+	*plan = (struct comcerto_pfe_ctrl_tx_command_plan) {
+		.fcode = fcode,
+		.physical_port = port,
+		.set_enabled = fcode == COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE,
+		.class_value_offset = COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+			port * COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+			COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		.class_enable_offset = COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+			port * COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+			COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET,
+		.util_enable_offset = COMCERTO_PFE_CTRL_UTIL_PHY_PORT_OFFSET + port,
+	};
+	return 0;
+}
+
+int comcerto_pfe_ctrl_build_eth_state_command(u8 port, bool up,
+	const struct comcerto_pfe_ctrl_eth_state_value *value, u16 *fcode,
+	u16 *payload_length, struct comcerto_pfe_ctrl_tx_configure_payload *payload)
+{
+	if (!fcode || !payload_length || !payload ||
+	    port >= COMCERTO_PFE_CTRL_PHY_PORT_COUNT || (up && !value))
+		return -EINVAL;
+
+	*payload = (struct comcerto_pfe_ctrl_tx_configure_payload) {
+		.physical_port = port,
+	};
+	if (up) {
+		*fcode = COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE;
+		*payload_length = sizeof(*payload);
+		memcpy(payload->value, value, sizeof(*value));
+	} else {
+		*fcode = COMCERTO_PFE_CTRL_TX_FCODE_DISABLE;
+		*payload_length = sizeof(payload->physical_port);
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_eth_state_command(void)
+{
+	const struct comcerto_pfe_ctrl_eth_state_value value = {
+		.word = 0x11223344, .halfword = 0x5566,
+	};
+	struct comcerto_pfe_ctrl_tx_configure_payload payload;
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	u16 fcode, payload_length;
+
+	if (comcerto_pfe_ctrl_build_eth_state_command(1, true, &value, &fcode,
+			&payload_length, &payload) ||
+	    fcode != COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE ||
+	    payload_length != sizeof(payload) || payload.physical_port != 1 ||
+	    memcmp(payload.value, &value, sizeof(value)) ||
+	    comcerto_pfe_ctrl_plan_tx_command(fcode, payload_length, &payload,
+			&plan) || !plan.set_enabled)
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_build_eth_state_command(1, false, NULL, &fcode,
+			&payload_length, &payload) ||
+	    fcode != COMCERTO_PFE_CTRL_TX_FCODE_DISABLE ||
+	    payload_length != sizeof(payload.physical_port) ||
+	    payload.physical_port != 1 || memchr_inv(payload.value, 0,
+			sizeof(payload.value)) ||
+	    comcerto_pfe_ctrl_plan_tx_command(fcode, payload_length, &payload,
+			&plan) || plan.set_enabled)
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_tx_command_contract(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload payload = {
+		.physical_port = 1,
+		.value = { 0, 1, 2, 3, 4, 5 },
+	};
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+
+	/* Stack-local ABI validation only: it neither calls a dispatcher nor
+	 * writes CLASS/UTIL DMEM or changes the persistent phy_port records. */
+	if (comcerto_pfe_ctrl_plan_tx_command(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload),
+			&payload, &plan) || !plan.set_enabled ||
+	    plan.class_value_offset != COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+		COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+		COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET ||
+	    plan.class_enable_offset != COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET +
+		COMCERTO_PFE_CTRL_PHY_PORT_BYTES +
+		COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET ||
+	    plan.util_enable_offset != COMCERTO_PFE_CTRL_UTIL_PHY_PORT_OFFSET + 1)
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_plan_tx_command(
+			COMCERTO_PFE_CTRL_TX_FCODE_DISABLE,
+			sizeof(payload.physical_port),
+			&payload, &plan) || plan.set_enabled)
+		return -EINVAL;
+	if (!comcerto_pfe_ctrl_plan_tx_command(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload) - 1,
+			&payload, &plan) ||
+	    !comcerto_pfe_ctrl_plan_tx_command(
+			COMCERTO_PFE_CTRL_TX_FCODE_DISABLE,
+			sizeof(payload.physical_port) - 1, &payload, &plan) ||
+	    !comcerto_pfe_ctrl_plan_tx_command(
+			COMCERTO_PFE_CTRL_TX_FCODE_SET_NAME, sizeof(payload),
+			&payload, &plan))
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_apply_tx_command_local(u16 fcode, u16 payload_length,
+	const struct comcerto_pfe_ctrl_tx_configure_payload *payload,
+	struct comcerto_pfe_ctrl_phy_port *port)
+{
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	u8 *bytes = (u8 *)port;
+
+	if (!port || comcerto_pfe_ctrl_plan_tx_command(fcode, payload_length,
+			payload, &plan))
+		return -EINVAL;
+	if (plan.physical_port != payload->physical_port)
+		return -EINVAL;
+	if (fcode == COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE) {
+		memcpy(bytes + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		       payload->value, COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES);
+		bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] |= BIT(0);
+	} else {
+		bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] &= ~BIT(0);
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_tx_command_local_lifecycle(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload payload = {
+		.physical_port = 2,
+		.value = { 0x10, 0x11, 0x12, 0x13, 0x14, 0x15 },
+	};
+	struct comcerto_pfe_ctrl_phy_port port = {
+		.interface_code = COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		.onif_index = 2,
+	};
+	u8 *bytes = (u8 *)&port;
+
+	/* The object is stack-local.  This validates host record semantics only;
+	 * it does not publish a command, mirror data to a PE, or retain state. */
+	if (comcerto_pfe_ctrl_apply_tx_command_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload),
+			&payload, &port) ||
+	    memcmp(bytes + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		   payload.value, COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES) ||
+	    !(bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] & BIT(0)) ||
+	    port.interface_code != COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH ||
+	    port.onif_index != 2)
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_apply_tx_command_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_DISABLE, sizeof(payload),
+			&payload, &port) ||
+	    bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] & BIT(0) ||
+	    memcmp(bytes + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		   payload.value, COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES))
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_tx_command_dmem_mirror(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload payload = {
+		.physical_port = 0,
+		.value = { 0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5 },
+	};
+	struct comcerto_pfe_ctrl_phy_port port = {
+		.interface_code = COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+	};
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	u8 *class_dmem;
+	u8 *util_dmem;
+	u8 *port_bytes = (u8 *)&port;
+	u32 class_value_offset;
+	u32 class_enable_offset;
+	unsigned int pe;
+	int ret = -EINVAL;
+
+	/* These are isolated byte arrays, not PE mappings.  The loop mirrors the
+	 * exact all-six-CLASS-PE then UTIL ordering but cannot reach hardware. */
+	class_dmem = kcalloc(COMCERTO_PFE_CTRL_CLASS_PE_COUNT,
+		COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES, GFP_KERNEL);
+	util_dmem = kzalloc(COMCERTO_PFE_UTIL_DMEM_SHARED_BYTES, GFP_KERNEL);
+	if (!class_dmem || !util_dmem) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = comcerto_pfe_ctrl_apply_tx_command_local(
+		COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload), &payload,
+		&port);
+	if (ret || comcerto_pfe_ctrl_plan_tx_command(
+		COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload), &payload,
+		&plan))
+		goto out;
+	class_value_offset = plan.class_value_offset -
+		COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET;
+	class_enable_offset = plan.class_enable_offset -
+		COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET;
+	if (class_value_offset + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES >
+		COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES ||
+	    class_enable_offset >= COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES ||
+	    plan.util_enable_offset >= COMCERTO_PFE_UTIL_DMEM_SHARED_BYTES)
+		goto out;
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		u8 *image = class_dmem + pe *
+			COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES;
+
+		memcpy(image + class_value_offset,
+		       port_bytes + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		       COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES);
+		image[class_enable_offset] =
+			port_bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET];
+	}
+	util_dmem[plan.util_enable_offset] =
+		port_bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET];
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		u8 *image = class_dmem + pe *
+			COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES;
+
+		if (memcmp(image + class_value_offset, payload.value,
+			   COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES) ||
+		    !(image[class_enable_offset] & BIT(0)))
+			goto out;
+	}
+	if (!(util_dmem[plan.util_enable_offset] & BIT(0)))
+		goto out;
+	ret = comcerto_pfe_ctrl_apply_tx_command_local(
+		COMCERTO_PFE_CTRL_TX_FCODE_DISABLE, sizeof(payload), &payload,
+		&port);
+	if (ret || comcerto_pfe_ctrl_plan_tx_command(
+		COMCERTO_PFE_CTRL_TX_FCODE_DISABLE, sizeof(payload), &payload,
+		&plan))
+		goto out;
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++)
+		class_dmem[pe * COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES +
+			class_enable_offset] =
+			port_bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET];
+	util_dmem[plan.util_enable_offset] =
+		port_bytes[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET];
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++)
+		if (class_dmem[pe * COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES +
+		    class_enable_offset] & BIT(0))
+			goto out;
+	if (util_dmem[plan.util_enable_offset] & BIT(0))
+		goto out;
+	ret = 0;
+out:
+	kfree(util_dmem);
+	kfree(class_dmem);
+	return ret;
+}
+
+int comcerto_pfe_ctrl_validate_tx_command_port_isolation(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload payload = {
+		.physical_port = 1,
+		.value = { 0xb0, 0xb1, 0xb2, 0xb3, 0xb4, 0xb5 },
+	};
+	struct comcerto_pfe_ctrl_tx_configure_payload invalid = payload;
+	struct comcerto_pfe_ctrl_phy_port ports[COMCERTO_PFE_CTRL_PHY_PORT_COUNT];
+	struct comcerto_pfe_ctrl_phy_port before[COMCERTO_PFE_CTRL_PHY_PORT_COUNT];
+	u8 codes[COMCERTO_PFE_CTRL_PHY_PORT_COUNT] = {
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+	};
+	u8 *selected = (u8 *)&ports[payload.physical_port];
+
+	comcerto_pfe_ctrl_prepare_phy_ports(ports, codes);
+	memcpy(before, ports, sizeof(ports));
+	if (comcerto_pfe_ctrl_apply_tx_command_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload), &payload,
+			&ports[payload.physical_port]) ||
+	    memcmp(&ports[0], &before[0], sizeof(ports[0])) ||
+	    memcmp(&ports[2], &before[2], sizeof(ports[2])) ||
+	    memcmp(selected + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		   payload.value, COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES) ||
+	    !(selected[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] & BIT(0)))
+		return -EINVAL;
+	memcpy(before, ports, sizeof(ports));
+	invalid.physical_port = COMCERTO_PFE_CTRL_PHY_PORT_COUNT;
+	if (!comcerto_pfe_ctrl_apply_tx_command_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(invalid), &invalid,
+			&ports[1]) || memcmp(before, ports, sizeof(ports)))
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_dispatch_tx_local(u16 fcode, u16 payload_length,
+	const struct comcerto_pfe_ctrl_tx_configure_payload *payload,
+	struct comcerto_pfe_ctrl_phy_port *ports,
+	struct comcerto_pfe_ctrl_command_record *record, u16 *completion)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload *local_payload;
+	int handler_result;
+
+	if (!payload || !ports || !record || !completion ||
+	    payload_length > sizeof(record->payload))
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_fcode_to_event(fcode) !=
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_TX)
+		return -EINVAL;
+
+	/* Stock copies the submitted frame into a private 0x110-byte record before
+	 * invoking M_tx_cmdproc.  Preserve that ownership boundary locally. */
+	memset(record, 0, sizeof(*record));
+	memcpy(record, payload, payload_length);
+	*completion = 0;
+	local_payload = (const struct comcerto_pfe_ctrl_tx_configure_payload *)record;
+	if (local_payload->physical_port >= COMCERTO_PFE_CTRL_PHY_PORT_COUNT ||
+	    (fcode != COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE &&
+	     fcode != COMCERTO_PFE_CTRL_TX_FCODE_DISABLE)) {
+		*completion = COMCERTO_PFE_CTRL_COMMAND_STATUS_INVALID;
+		return 0;
+	}
+	handler_result = comcerto_pfe_ctrl_apply_tx_command_local(fcode,
+		payload_length, local_payload,
+		&ports[local_payload->physical_port]);
+	if (handler_result) {
+		*completion = COMCERTO_PFE_CTRL_COMMAND_STATUS_INVALID;
+		return 0;
+	}
+
+	/* The stock common handler overwrites record word zero with success and
+	 * reports synchronous completion state two only after a zero result. */
+	record->status = 0;
+	*completion = COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_tx_local_dispatcher(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload configure = {
+		.physical_port = 1,
+		.value = { 0x71, 0x72, 0x73, 0x74, 0x75, 0x76 },
+	};
+	const struct comcerto_pfe_ctrl_tx_configure_payload disable = {
+		.physical_port = 1,
+	};
+	struct comcerto_pfe_ctrl_tx_configure_payload invalid = configure;
+	struct comcerto_pfe_ctrl_phy_port ports[COMCERTO_PFE_CTRL_PHY_PORT_COUNT];
+	struct comcerto_pfe_ctrl_command_record record;
+	u8 codes[COMCERTO_PFE_CTRL_PHY_PORT_COUNT] = {
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+	};
+	u16 completion;
+
+	comcerto_pfe_ctrl_prepare_phy_ports(ports, codes);
+	if (comcerto_pfe_ctrl_dispatch_tx_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(configure),
+			&configure, ports, &record, &completion) || record.status ||
+	    completion != COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED ||
+	    memcmp((u8 *)&ports[1] + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		   configure.value, sizeof(configure.value)) ||
+	    !(((u8 *)&ports[1])[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] & BIT(0)))
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_dispatch_tx_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_DISABLE,
+			sizeof(disable.physical_port), &disable, ports, &record,
+			&completion) || record.status ||
+	    completion != COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED ||
+	    ((u8 *)&ports[1])[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] & BIT(0))
+		return -EINVAL;
+	invalid.physical_port = COMCERTO_PFE_CTRL_PHY_PORT_COUNT;
+	if (comcerto_pfe_ctrl_dispatch_tx_local(
+			COMCERTO_PFE_CTRL_TX_FCODE_DISABLE,
+			sizeof(invalid.physical_port), &invalid, ports, &record,
+			&completion) ||
+	    completion != COMCERTO_PFE_CTRL_COMMAND_STATUS_INVALID ||
+	    record.status != invalid.physical_port)
+		return -EINVAL;
+	return 0;
+}
