+#ifndef PHY_FREESCALE_LS1024A_SERDES_H
+#define PHY_FREESCALE_LS1024A_SERDES_H
+
+struct ls1024a_serdes_phy_regval {
+	uint32_t offset;
+	uint32_t value;
+};
+
+/*  Snowbush PHY (Serdes1/2) settings for SATA */
+
+/* With 48MHz internal ref clock configuration */
+static const struct ls1024a_serdes_phy_regval ls1024a_serdes_sata_48_cfg[] =
+{
+	/* CMU registers */
+	{ 0x0000, 0x06 }, { 0x0004, 0x00 }, { 0x0008, 0x88 }, { 0x000c, 0x00 },
+	{ 0x0010, 0x84 }, { 0x0014, 0x10 }, { 0x0018, 0x20 }, { 0x001c, 0x00 },
