+	COMCERTO_PFE_STOCK_INIT_HIF,
+	COMCERTO_PFE_STOCK_INIT_FIRMWARE,
+	COMCERTO_PFE_STOCK_INIT_CONTROL,
+	COMCERTO_PFE_STOCK_INIT_ETHERNET,
+};
+
