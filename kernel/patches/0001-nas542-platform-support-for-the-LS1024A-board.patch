+static void comcerto_pfe_ctrl_async_command_dormant_work(
+		struct work_struct *work)
+{
+	struct comcerto_pfe_ctrl_async_command_state *state =
+		container_of(work, struct comcerto_pfe_ctrl_async_command_state,
+			     work);
+	unsigned long flags;
+
+	/* This handler is deliberately inert.  It owns no request processing:
+	 * there is no submitter, queue consumer, dispatcher or callback path. */
+	spin_lock_irqsave(&state->lock, flags);
+	state->worker_scheduled = false;
+	spin_unlock_irqrestore(&state->lock, flags);
+}
+
+void comcerto_pfe_ctrl_prepare_async_command_state(
+		struct comcerto_pfe_ctrl_async_command_state *state)
+{
+	if (!state)
+		return;
+	spin_lock_init(&state->lock);
+	INIT_LIST_HEAD(&state->queue);
+	INIT_WORK(&state->work, comcerto_pfe_ctrl_async_command_dormant_work);
+	state->worker_scheduled = false;
+}
+
+int comcerto_pfe_ctrl_validate_async_command_state(
+		struct comcerto_pfe_ctrl_async_command_state *state)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!state)
+		return -EINVAL;
+	spin_lock_irqsave(&state->lock, flags);
+	if (!list_empty(&state->queue) || state->worker_scheduled)
+		ret = -EINVAL;
+	spin_unlock_irqrestore(&state->lock, flags);
+	return ret;
+}
+
+void comcerto_pfe_ctrl_prepare_dispatch_state(
+		struct comcerto_pfe_ctrl_dispatch_state *state)
+{
+	if (state)
+		*state = (struct comcerto_pfe_ctrl_dispatch_state) { };
+}
+
+int comcerto_pfe_ctrl_validate_dispatch_state(
+		const struct comcerto_pfe_ctrl_dispatch_state *state)
+{
+	unsigned int event;
+
+	if (!state)
+		return -EINVAL;
+	for (event = 0; event < ARRAY_SIZE(state->handlers); event++)
+		if (state->handlers[event])
+			return -EINVAL;
+	return 0;
+}
+
+u8 comcerto_pfe_ctrl_fcode_to_event(u16 fcode)
+{
+	switch (fcode >> 8) {
+	case 0:
+		/* FCODE_TO_EVENT() retains the low byte for group zero, subtracts
+		 * eight, and routes the inclusive selector range 8..16 to bridge. */
+		return fcode >= 8 && fcode <= 16 ?
+			COMCERTO_PFE_CTRL_COMMAND_EVENT_BRIDGE : 4;
+	case 2:
+		return 1;
+	case 3:
+	case 16:
+		return 11;
+	case 4:
+		return 12;
+	case 5:
+		return 2;
+	case 6:
+		return 10;
+	case 7:
+		return 6;
+	case 8:
+		return 22;
+	case 9:
+		return 9;
+	case 10:
+		return 13;
+	case 11:
+		return 17;
+	case 14:
+		return 19;
+	case 15:
+		return 14;
+	case 21:
+		return 23;
+	case 22:
+		return 24;
+	case 32:
+		return 5;
+	default:
+		return 0;
+	}
+}
+
+int comcerto_pfe_ctrl_validate_fcode_map(void)
+{
+	static const struct {
+		u8 group;
+		u8 event;
+	} expected[] = {
+		{ 2, 1 }, { 3, 11 }, { 4, 12 }, { 5, 2 }, { 6, 10 },
+		{ 7, 6 }, { 8, 22 }, { 9, 9 }, { 10, 13 }, { 11, 17 },
+		{ 14, 19 }, { 15, 14 }, { 16, 11 }, { 21, 23 },
+		{ 22, 24 }, { 32, 5 },
+	};
+	unsigned int i;
+
+	if (comcerto_pfe_ctrl_fcode_to_event(8) !=
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_BRIDGE ||
+	    comcerto_pfe_ctrl_fcode_to_event(16) !=
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_BRIDGE ||
+	    comcerto_pfe_ctrl_fcode_to_event(0) != 4 ||
+	    comcerto_pfe_ctrl_fcode_to_event(7) != 4 ||
+	    comcerto_pfe_ctrl_fcode_to_event(17) != 4 ||
+	    comcerto_pfe_ctrl_fcode_to_event(0x0100) != 0 ||
+	    comcerto_pfe_ctrl_fcode_to_event(0x1f00) != 0 ||
+	    comcerto_pfe_ctrl_fcode_to_event(0x2100) != 0)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(expected); i++)
+		if (comcerto_pfe_ctrl_fcode_to_event(expected[i].group << 8) !=
+		    expected[i].event)
+			return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_tx_dispatch_route(void)
+{
+	struct comcerto_pfe_ctrl_dispatch_state state;
+
+	/* Stock tx_init() stores M_tx_cmdproc in gCmdProcTable+0x08.  The common
+	 * FCODE_TO_EVENT() mapper routes every 0x05xx TX command to event two.
+	 * Keep that fact separate from the all-NULL staging table: publishing or
+	 * calling a handler would require the unrecovered command ingress owner. */
+	comcerto_pfe_ctrl_prepare_dispatch_state(&state);
+	if (comcerto_pfe_ctrl_validate_dispatch_state(&state) ||
+	    COMCERTO_PFE_CTRL_CMDPROC_TX_OFFSET != 0x08 ||
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_TX != 2 ||
+	    comcerto_pfe_ctrl_fcode_to_event(
+		    COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE) !=
+		COMCERTO_PFE_CTRL_COMMAND_EVENT_TX ||
+	    comcerto_pfe_ctrl_fcode_to_event(
+		    COMCERTO_PFE_CTRL_TX_FCODE_DISABLE) !=
+		COMCERTO_PFE_CTRL_COMMAND_EVENT_TX ||
+	    comcerto_pfe_ctrl_fcode_to_event(
+		    COMCERTO_PFE_CTRL_TX_FCODE_SET_NAME) !=
+		COMCERTO_PFE_CTRL_COMMAND_EVENT_TX ||
+	    state.handlers[COMCERTO_PFE_CTRL_COMMAND_EVENT_TX])
+		return -EINVAL;
+	return 0;
+}
+
+enum comcerto_pfe_ctrl_bridge_selector
+comcerto_pfe_ctrl_bridge_selector(u16 fcode)
+{
+	/* M_bridge_cmdproc subtracts eight, bounds the result to eight, then uses
+	 * a nine-entry Thumb table branch.  Only its group-zero FCODEs may reach
+	 * that handler, so reject encoded nonzero groups defensively. */
+	if ((fcode >> 8) || fcode < 8 || fcode > 16)
+		return COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID;
+	return COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_8 + (fcode - 8);
+}
+
+int comcerto_pfe_ctrl_validate_bridge_selector_map(void)
+{
+	u16 fcode;
+
+	if (comcerto_pfe_ctrl_bridge_selector(0) !=
+	    COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID ||
+	    comcerto_pfe_ctrl_bridge_selector(7) !=
+	    COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID ||
+	    comcerto_pfe_ctrl_bridge_selector(17) !=
+	    COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID ||
+	    comcerto_pfe_ctrl_bridge_selector(0x0808) !=
+	    COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID)
+		return -EINVAL;
+	for (fcode = 8; fcode <= 16; fcode++)
+		if (comcerto_pfe_ctrl_bridge_selector(fcode) !=
+		    COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_8 + fcode - 8)
+			return -EINVAL;
+	return 0;
+}
+
+bool comcerto_pfe_ctrl_bridge_selector_probe_safe(u16 fcode)
+{
+	/* All valid stock bridge selectors enter stateful vendor paths: interface
+	 * configuration, flow lookup/change, timer/policy update or flow removal.
+	 * The staging driver has no command ingress, payload ABI or teardown owner,
+	 * so none can be a valid probe-time action. */
+	switch (comcerto_pfe_ctrl_bridge_selector(fcode)) {
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_8:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_9:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_10:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_11:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_12:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_13:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_14:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_15:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_16:
+	case COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID:
+	default:
+		return false;
+	}
+}
+
+int comcerto_pfe_ctrl_validate_bridge_operation_gate(void)
+{
+	u16 fcode;
+
+	for (fcode = 0; fcode <= 16; fcode++)
+		if (comcerto_pfe_ctrl_bridge_selector_probe_safe(fcode))
+			return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_no_handler_dispatch(
+		const struct comcerto_pfe_ctrl_dispatch_state *state,
+		struct comcerto_pfe_ctrl_command_record *record)
+{
+	u16 completion = 0;
+	u16 fcode = 8;
+
+	if (!record || comcerto_pfe_ctrl_validate_dispatch_state(state))
+		return -EINVAL;
+	if (comcerto_pfe_ctrl_fcode_to_event(fcode) !=
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_BRIDGE)
+		return -EINVAL;
+	if (state->handlers[COMCERTO_PFE_CTRL_COMMAND_EVENT_BRIDGE])
+		return -EINVAL;
+	memset(record, 0, sizeof(*record));
+	/* __pfe_ctrl_cmd_handler() null-slot branch: record status=1, completion=2. */
+	record->status = COMCERTO_PFE_CTRL_COMMAND_STATUS_NO_HANDLER;
+	completion = COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED;
+	if (record->status != COMCERTO_PFE_CTRL_COMMAND_STATUS_NO_HANDLER ||
+	    memchr_inv(record->payload, 0, sizeof(record->payload)) ||
+	    completion !=
+	    COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED)
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_create_bridge_lists(
+		struct comcerto_pfe_ctrl_bridge_lists *lists)
+{
+	unsigned int head;
+
+	if (!lists)
+		return -EINVAL;
+	*lists = (struct comcerto_pfe_ctrl_bridge_lists) { };
+	lists->l2_active = kcalloc(COMCERTO_PFE_CTRL_BRIDGE_L2_ACTIVE_HEADS,
+					   sizeof(*lists->l2_active), GFP_KERNEL);
+	if (!lists->l2_active)
+		return -ENOMEM;
+	lists->l3_active = kcalloc(COMCERTO_PFE_CTRL_BRIDGE_L3_ACTIVE_HEADS,
+					   sizeof(*lists->l3_active), GFP_KERNEL);
+	if (!lists->l3_active) {
+		kfree(lists->l2_active);
+		lists->l2_active = NULL;
+		return -ENOMEM;
+	}
+	for (head = 0; head < COMCERTO_PFE_CTRL_BRIDGE_L2_ACTIVE_HEADS; head++)
+		INIT_LIST_HEAD(&lists->l2_active[head]);
+	for (head = 0; head < COMCERTO_PFE_CTRL_BRIDGE_L3_ACTIVE_HEADS; head++)
+		INIT_LIST_HEAD(&lists->l3_active[head]);
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_bridge_lists(
+		const struct comcerto_pfe_ctrl_bridge_lists *lists)
+{
+	unsigned int head;
+
+	if (!lists || !lists->l2_active || !lists->l3_active)
+		return -EINVAL;
+	for (head = 0; head < COMCERTO_PFE_CTRL_BRIDGE_L2_ACTIVE_HEADS; head++)
+		if (!list_empty(&lists->l2_active[head]))
+			return -EINVAL;
+	for (head = 0; head < COMCERTO_PFE_CTRL_BRIDGE_L3_ACTIVE_HEADS; head++)
+		if (!list_empty(&lists->l3_active[head]))
+			return -EINVAL;
+	return 0;
+}
+
+void comcerto_pfe_ctrl_destroy_bridge_lists(
+		struct comcerto_pfe_ctrl_bridge_lists *lists)
+{
+	if (!lists)
+		return;
+	kfree(lists->l3_active);
+	kfree(lists->l2_active);
+	*lists = (struct comcerto_pfe_ctrl_bridge_lists) { };
+}
+
+int comcerto_pfe_ctrl_create_bridge_caches(
+		struct comcerto_pfe_ctrl_bridge_caches *caches)
+{
+	if (!caches)
+		return -EINVAL;
+	*caches = (struct comcerto_pfe_ctrl_bridge_caches) { };
+	caches->l2_flow = kzalloc(COMCERTO_PFE_CTRL_BRIDGE_L2_FLOW_CACHE_BYTES,
+				 GFP_KERNEL);
+	if (!caches->l2_flow)
+		return -ENOMEM;
+	caches->l3_flow = kzalloc(COMCERTO_PFE_CTRL_BRIDGE_L3_FLOW_CACHE_BYTES,
+				 GFP_KERNEL);
+	if (!caches->l3_flow) {
+		kfree(caches->l2_flow);
+		caches->l2_flow = NULL;
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_bridge_caches(
+		const struct comcerto_pfe_ctrl_bridge_caches *caches)
+{
+	if (!caches || !caches->l2_flow || !caches->l3_flow)
+		return -EINVAL;
+	if (memchr_inv(caches->l2_flow, 0,
+		       COMCERTO_PFE_CTRL_BRIDGE_L2_FLOW_CACHE_BYTES) ||
+	    memchr_inv(caches->l3_flow, 0,
+		       COMCERTO_PFE_CTRL_BRIDGE_L3_FLOW_CACHE_BYTES))
+		return -EINVAL;
+	return 0;
+}
+
+void comcerto_pfe_ctrl_destroy_bridge_caches(
+		struct comcerto_pfe_ctrl_bridge_caches *caches)
+{
+	if (!caches)
+		return;
+	kfree(caches->l3_flow);
+	kfree(caches->l2_flow);
+	*caches = (struct comcerto_pfe_ctrl_bridge_caches) { };
+}
+
+int comcerto_pfe_ctrl_create_dma_pools(struct device *dev,
+		struct comcerto_pfe_ctrl_dma_pools *pools)
+{
+	if (!dev || !pools)
+		return -EINVAL;
+
+	*pools = (struct comcerto_pfe_ctrl_dma_pools) { };
+	pools->command = dma_pool_create("pfe-ctrl-command", dev,
+		COMCERTO_PFE_CTRL_CMD_BLOCK_BYTES,
+		COMCERTO_PFE_CTRL_DMA_ALIGNMENT,
+		COMCERTO_PFE_CTRL_DMA_BOUNDARY);
+	if (!pools->command)
+		return -ENOMEM;
+	pools->event = dma_pool_create("pfe-ctrl-event", dev,
+		COMCERTO_PFE_CTRL_EVENT_BLOCK_BYTES,
+		COMCERTO_PFE_CTRL_DMA_ALIGNMENT,
+		COMCERTO_PFE_CTRL_DMA_BOUNDARY);
+	if (!pools->event) {
+		dma_pool_destroy(pools->command);
+		pools->command = NULL;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+int comcerto_pfe_ctrl_validate_dma_pools(
+		const struct comcerto_pfe_ctrl_dma_pools *pools)
+{
+	if (!pools || !pools->command || !pools->event)
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_ctrl_probe_dma_pools(
+		struct comcerto_pfe_ctrl_dma_pools *pools)
+{
+	void *command = NULL, *event = NULL;
+	dma_addr_t command_dma = 0, event_dma = 0;
+	int ret = 0;
+
+	if (comcerto_pfe_ctrl_validate_dma_pools(pools))
+		return -EINVAL;
+	command = dma_pool_alloc(pools->command, GFP_KERNEL, &command_dma);
+	if (!command)
+		return -ENOMEM;
+	event = dma_pool_alloc(pools->event, GFP_KERNEL, &event_dma);
+	if (!event) {
+		ret = -ENOMEM;
+		goto out_command;
+	}
+	if (upper_32_bits(command_dma) || upper_32_bits(event_dma) ||
+	    command == event || command_dma == event_dma ||
+	    !IS_ALIGNED(command_dma, COMCERTO_PFE_CTRL_DMA_ALIGNMENT) ||
+	    !IS_ALIGNED(event_dma, COMCERTO_PFE_CTRL_DMA_ALIGNMENT) ||
+	    (command_dma & (COMCERTO_PFE_CTRL_DMA_BOUNDARY - 1)) >
+		COMCERTO_PFE_CTRL_DMA_BOUNDARY - COMCERTO_PFE_CTRL_CMD_BLOCK_BYTES ||
+	    (event_dma & (COMCERTO_PFE_CTRL_DMA_BOUNDARY - 1)) >
+		COMCERTO_PFE_CTRL_DMA_BOUNDARY - COMCERTO_PFE_CTRL_EVENT_BLOCK_BYTES)
+		ret = -ERANGE;
+	/* The blocks are intentionally not initialized as FPP commands or events. */
+	dma_pool_free(pools->event, event, event_dma);
+out_command:
+	dma_pool_free(pools->command, command, command_dma);
+	return ret;
+}
+
+void comcerto_pfe_ctrl_destroy_dma_pools(
+		struct comcerto_pfe_ctrl_dma_pools *pools)
+{
+	if (!pools)
+		return;
+	if (pools->event)
+		dma_pool_destroy(pools->event);
+	if (pools->command)
+		dma_pool_destroy(pools->command);
+	*pools = (struct comcerto_pfe_ctrl_dma_pools) { };
+}
+
+int comcerto_pfe_ctrl_sync_stop(void __iomem *axi, const u32 *mailboxes,
+				u16 pe_mask)
+{
+	unsigned long deadline;
+	unsigned long recovery_deadline;
+	u16 complete = 0;
+	u8 pe;
+	int ret;
+
+	if (!axi || !mailboxes || !pe_mask || pe_mask & ~GENMASK(10, 0))
+		return -EINVAL;
+	for (pe = 0; pe <= 10; pe++) {
+		if (!(pe_mask & BIT(pe)))
+			continue;
+		ret = comcerto_pfe_write_dmem_word(axi, pe, mailboxes[pe],
+						   COMCERTO_PFE_CTRL_PE_STOP_WORD_OFFSET);
+		if (ret)
+			return ret;
+	}
+
+	/* Exact stock contract: all selected PEs acknowledge bit 24 in the
+	 * word immediately following their sync mailbox within five jiffies. */
+	deadline = jiffies + COMCERTO_PFE_CTRL_PE_STOP_TIMEOUT_JIFFIES;
+	recovery_deadline = deadline +
+		COMCERTO_PFE_CTRL_PE_STOP_RECOVERY_JIFFIES;
+	while (complete != pe_mask) {
+		for (pe = 0; pe <= 10; pe++) {
+			u32 status;
+
+			if (!(pe_mask & BIT(pe)) || (complete & BIT(pe)))
+				continue;
+			ret = comcerto_pfe_read_dmem_word(axi, pe,
+				mailboxes[pe] + COMCERTO_PFE_CTRL_PE_STATUS_WORD_OFFSET,
+				&status);
+			if (ret)
+				return ret;
+			if (status & COMCERTO_PFE_CTRL_PE_STOP_WORD_OFFSET)
+				complete |= BIT(pe);
+		}
+		if (complete == pe_mask)
+			return 0;
+		/* The stock loop does not recover at the first five-jiffy
+		 * deadline.  It keeps polling (and yields when appropriate) for
+		 * a further 100 jiffies, then clears every request mailbox. */
+		if (time_after(jiffies, recovery_deadline)) {
+			/* Stock timeout recovery clears every requested sync mailbox. */
+			for (pe = 0; pe <= 10; pe++)
+				if (pe_mask & BIT(pe))
+					comcerto_pfe_write_dmem_word(axi, pe, mailboxes[pe], 0);
+			return -ETIMEDOUT;
+		}
+		cond_resched();
+	}
+	return 0;
+}
+
+int comcerto_pfe_ctrl_sync_start(void __iomem *axi, const u32 *mailboxes,
+				 u16 pe_mask)
+{
+	u8 pe;
+	int ret;
+
+	if (!axi || !mailboxes || !pe_mask || pe_mask & ~GENMASK(10, 0))
+		return -EINVAL;
+	for (pe = 0; pe <= 10; pe++) {
+		if (!(pe_mask & BIT(pe)))
+			continue;
+		ret = comcerto_pfe_write_dmem_word(axi, pe, mailboxes[pe], 0);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.h
new file mode 100644
index 000000000..85a56b779
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-ctrl-contract.h
@@ -0,0 +1,507 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal control-plane allocation contract recovered from pfe_ctrl_init()
+ * in NAS542 stock pfe.ko.  This is metadata only: it neither allocates DMA
+ * nor starts the vendor FPP control thread.
+ */
+#ifndef COMCERTO_PFE_CTRL_CONTRACT_H
+#define COMCERTO_PFE_CTRL_CONTRACT_H
+
+#include <linux/build_bug.h>
+#include <linux/bitops.h>
+#include <linux/dmapool.h>
+#include <linux/io.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#define COMCERTO_PFE_CTRL_CLASS_PE_COUNT	6
+#define COMCERTO_PFE_CTRL_TMU_PE_COUNT	4
+#define COMCERTO_PFE_CTRL_PHY_PORT_COUNT	3
+#define COMCERTO_PFE_CTRL_PHY_PORT_BYTES	0x20
+/* Stock symbol table: .class_dmem_sh:phy_port spans 0xa0 bytes.  Only the
+ * first three 0x20-byte add_onif records are decoded so far. */
+#define COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES	0x00a0
+/* Observed in every NAS542 stock tx_init() -> add_onif() call. */
+#define COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH	0x81
+/* NAS542 stock pfe.ko .class_dmem_sh: phy_port at 0x9b0, three records. */
+#define COMCERTO_PFE_CTRL_CLASS_PHY_PORT_OFFSET	0x09b0
+/* Stock pe_sync_stop()/pe_start() ABI; not a Linux runtime path yet. */
+#define COMCERTO_PFE_CTRL_CLASS_PE_MASK		0x003f
+#define COMCERTO_PFE_CTRL_PE_STOP_WORD_OFFSET		0x01000000
+#define COMCERTO_PFE_CTRL_PE_STATUS_WORD_OFFSET	0x00000004
+#define COMCERTO_PFE_CTRL_PE_STOP_TIMEOUT_JIFFIES	5
+/* pe_sync_stop() waits up to a further 100 jiffies before its timeout
+ * recovery.  The initial five-jiffy point merely begins that grace period. */
+#define COMCERTO_PFE_CTRL_PE_STOP_RECOVERY_JIFFIES	100
+/* Stock host-linked .dmem_sh offsets. pfe_ctrl_init() translates these to
+ * the loaded image's .dmem_sh destination before touching a PE. */
+#define COMCERTO_PFE_CTRL_CLASS_SYNC_MAILBOX_OFFSET	0x0bf8
+#define COMCERTO_PFE_CTRL_TMU_SYNC_MAILBOX_OFFSET		0x02f0
+#define COMCERTO_PFE_CTRL_UTIL_SYNC_MAILBOX_OFFSET	0x05d8
+
+/* Fields written by the stock add_onif() helper inside each phy_port record. */
+#define COMCERTO_PFE_CTRL_PHY_PORT_CALLBACK_OFFSET	0x00
+#define COMCERTO_PFE_CTRL_PHY_PORT_CODE_OFFSET		0x04
+#define COMCERTO_PFE_CTRL_PHY_PORT_ONIF_INDEX_OFFSET	0x05
+/* M_tx_cmdproc's 0x0501 writes six input bytes at +8, then bit zero at
+ * +15.  These are command-ABI fields, not a runtime port configuration. */
+#define COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET		0x08
+#define COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES		6
+#define COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET	0x0f
+/* Stock pfe.ko symbol util_phy_port (5 bytes) in .util_dmem_sh.  M_tx_cmdproc
+ * writes phy_port[port].byte15 to virt_to_util_dmem(util_phy_port + port) on
+ * PE 10 (the "10" is the PE id argument, not an offset).  All plan offsets are
+ * .dmem_sh-section-relative; callers add the loaded .dmem_sh destination
+ * (CLASS 0xb20, UTIL 0x16c0 for the NAS542 images) at the hardware boundary. */
