--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/mindspeed,comcerto-2000-timer.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/mindspeed,comcerto-2000-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Mindspeed Comcerto 2000 timer reconstruction node
+
+maintainers:
+  - ZyxelUntrash reverse-engineering project
+
+description: |
+  Local reconstruction binding derived from the stock Linux 3.2 kernel and
+  runtime evidence. The node is intentionally disabled until the Linux 6.6
+  driver semantics and hardware-test release are complete.
+
+properties:
+  compatible:
+    const: mindspeed,comcerto-2000-timer
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    minItems: 4
+    maxItems: 4
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: timer
+
+  clock-frequency:
+    const: 250000000
+
+  status:
+    const: disabled
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - clock-frequency
+  - status
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    timer@904b0000 {
+        compatible = "mindspeed,comcerto-2000-timer";
+        reg = <0x904b0000 0x1000>;
+        interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&timer_clk>;
+        clock-names = "timer";
+        clock-frequency = <250000000>;
+        status = "disabled";
+    };
+...
