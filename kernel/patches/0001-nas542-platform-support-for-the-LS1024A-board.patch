+static int comcerto_pfe_sync_mailbox_offset(enum comcerto_pfe_fw_image image,
+					    u32 *offset)
+{
+	if (!offset)
+		return -EINVAL;
+	switch (image) {
+	case COMCERTO_PFE_FW_CLASS:
+		*offset = COMCERTO_PFE_CTRL_CLASS_SYNC_MAILBOX_OFFSET;
+		return 0;
+	case COMCERTO_PFE_FW_TMU:
+		*offset = COMCERTO_PFE_CTRL_TMU_SYNC_MAILBOX_OFFSET;
+		return 0;
+	case COMCERTO_PFE_FW_UTIL:
+		*offset = COMCERTO_PFE_CTRL_UTIL_SYNC_MAILBOX_OFFSET;
+		return 0;
+	}
+	return -EINVAL;
+}
