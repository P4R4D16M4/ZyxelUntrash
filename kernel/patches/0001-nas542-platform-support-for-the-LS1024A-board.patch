diff --git a/Documentation/devicetree/bindings/arm/mindspeed,comcerto-2000.yaml b/Documentation/devicetree/bindings/arm/mindspeed,comcerto-2000.yaml
new file mode 100644
index 000000000..83a92aadb
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/mindspeed,comcerto-2000.yaml
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/mindspeed,comcerto-2000.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Mindspeed Comcerto 2000 platforms
+
+maintainers:
+  - ZyxelUntrash reverse-engineering project
+
+description: |
+  Provisional local binding for the reverse-engineered Mindspeed Comcerto 2000
+  platform. This file documents the source skeleton and is not a claim of
+  upstream binding acceptance or complete hardware support.
+
+properties:
+  $nodename:
+    const: '/'
+  compatible:
+    oneOf:
+      - items:
+          - const: zyxel,nas542
+          - const: mindspeed,comcerto-2000-evm
+          - const: mindspeed,comcerto-2000
+      - const: mindspeed,comcerto-2000
+
+additionalProperties: true
diff --git a/Documentation/devicetree/bindings/timer/mindspeed,comcerto-2000-timer.yaml b/Documentation/devicetree/bindings/timer/mindspeed,comcerto-2000-timer.yaml
new file mode 100644
