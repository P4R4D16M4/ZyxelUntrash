--- /dev/null
+++ b/drivers/power/reset/comcerto-nas542-poweroff.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Zyxel NAS542 power-off support for the Mindspeed Comcerto 2000.
+ *
+ * The register sequence is reconstructed from the vendor kernel's
+ * zyxel_power_off() routine.  GPIO 15 is the active-high power cut signal.
+ */
+
+#include <linux/bitops.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/processor.h>
+#include <linux/reboot.h>
+
+#define COMCERTO_GPIO_OUT	0x00
+#define COMCERTO_GPIO_OE	0x04
+#define COMCERTO_GPIO_PINMUX	0x58
+
+#define NAS542_POWER_GPIO	BIT(15)
+#define NAS542_POWER_PINMUX_MASK	GENMASK(31, 30)
+
+struct nas542_poweroff {
+	void __iomem *base;
+};
+
+static int nas542_power_off(struct sys_off_data *data)
+{
+	struct nas542_poweroff *poweroff = data->cb_data;
+	u32 value;
+
+	/* Preserve the ordering of the stock zyxel_power_off() callback. */
+	value = readl_relaxed(poweroff->base + COMCERTO_GPIO_OE);
+	writel_relaxed(value | NAS542_POWER_GPIO,
+		       poweroff->base + COMCERTO_GPIO_OE);
+	dsb(sy);
+
+	value = readl_relaxed(poweroff->base + COMCERTO_GPIO_OUT);
+	writel_relaxed(value | NAS542_POWER_GPIO,
+		       poweroff->base + COMCERTO_GPIO_OUT);
+	dsb(sy);
+
+	value = readl_relaxed(poweroff->base + COMCERTO_GPIO_PINMUX);
+	writel_relaxed(value & ~NAS542_POWER_PINMUX_MASK,
+		       poweroff->base + COMCERTO_GPIO_PINMUX);
+	dsb(sy);
+
+	/*
+	 * The power rail needs a few milliseconds to collapse.  Never return to
+	 * the generic reboot path in that interval: it would panic because a
+	 * successful SYS_OFF_MODE_POWER_OFF handler is not expected to return.
+	 */
+	for (;;)
+		cpu_relax();
+	/* Satisfy the sys_off callback type; control never reaches this point. */
+	return 0;
+}
+
+static int nas542_poweroff_probe(struct platform_device *pdev)
+{
+	struct nas542_poweroff *poweroff;
+	struct resource *res;
+	int ret;
+
+	poweroff = devm_kzalloc(&pdev->dev, sizeof(*poweroff), GFP_KERNEL);
+	if (!poweroff)
+		return -ENOMEM;
+
+	/*
+	 * GPIO 15 lives in the same stock control window as the NAND ready/CE
+	 * word.  The NAND driver exclusively owns only its four-byte child
+	 * resource, so requesting this broad parent range would reject the
+	 * poweroff driver with -EBUSY.  A managed shared mapping is sufficient:
+	 * this driver accesses its GPIO offsets only when the sys-off callback is
+	 * explicitly invoked, and never changes the window during probe.
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	poweroff->base = devm_ioremap(&pdev->dev, res->start,
+				      resource_size(res));
+	if (!poweroff->base)
+		return -ENOMEM;
+
+	ret = devm_register_sys_off_handler(&pdev->dev,
+					    SYS_OFF_MODE_POWER_OFF,
+					    SYS_OFF_PRIO_DEFAULT,
+					    nas542_power_off, poweroff);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register power-off handler\n");
+
+	dev_info(&pdev->dev, "registered GPIO 15 active-high power-off\n");
+	return 0;
+}
+
+static const struct of_device_id nas542_poweroff_of_match[] = {
+	{ .compatible = "zyxel,nas542-poweroff" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nas542_poweroff_of_match);
+
+static struct platform_driver nas542_poweroff_driver = {
+	.probe = nas542_poweroff_probe,
+	.driver = {
+		.name = "nas542-poweroff",
+		.of_match_table = nas542_poweroff_of_match,
+	},
+};
+module_platform_driver(nas542_poweroff_driver);
+
+MODULE_DESCRIPTION("Zyxel NAS542 Comcerto 2000 power-off driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/reset/comcerto-nas542-restart.c b/drivers/power/reset/comcerto-nas542-restart.c
new file mode 100644
index 000000000..1e5253b3c
--- /dev/null
+++ b/drivers/power/reset/comcerto-nas542-restart.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Zyxel NAS542 SoC restart, reconstructed from stock arm_machine_restart(). */
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/processor.h>
+#include <linux/reboot.h>
+
+#include <asm/system_misc.h>
+#include <asm/idmap.h>
+
+#define NAS542_RST_CTRL_PHYS	0x904b0000
+#define NAS542_GLOBAL_RESET	BIT(0)
+
+/*
+ * This stub is entered only after soft_restart() has switched to the ARM
+ * identity map and torn down the L1/L2 caches.  It must not dereference the
+ * driver's ioremap address: that virtual mapping no longer exists there.
+ */
+static void nas542_restart_idmap(void)
+	__attribute__((noreturn, __noinline__, section(".idmap.text")));
+
+static void nas542_restart_idmap(void)
+{
+	volatile u32 * const ctrl = (volatile u32 *)NAS542_RST_CTRL_PHYS;
+
+	*ctrl |= NAS542_GLOBAL_RESET;
+	asm volatile("dsb sy" : : : "memory");
+	for (;;)
+		asm volatile("wfe" : : : "memory");
+}
+
+static int nas542_mcu_restart(struct sys_off_data *data)
+{
+	(void)data;
+	/* Stock arm_machine_restart() reaches comcerto_rst_cntrl_set(1) only
+	 * after entering its identity-mapped cache/MMU teardown path. */
+	soft_restart(virt_to_idmap(nas542_restart_idmap));
+	return 0; /* soft_restart() is expected not to return */
+}
+
+static int nas542_mcu_restart_probe(struct platform_device *pdev)
+{
+	int ret;
+
+	ret = devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
+			SYS_OFF_PRIO_DEFAULT, nas542_mcu_restart, NULL);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "restart handler registration failed\n");
+	dev_info(&pdev->dev, "stock global-reset restart registered\n");
+	return 0;
+}
+
+static const struct of_device_id nas542_mcu_restart_match[] = {
+	{ .compatible = "zyxel,nas542-mcu-watchdog-restart" }, { }
+};
+static struct platform_driver nas542_mcu_restart_driver = {
+	.probe = nas542_mcu_restart_probe,
+	.driver = { .name = "nas542-mcu-watchdog-restart", .of_match_table = nas542_mcu_restart_match },
+};
+module_platform_driver(nas542_mcu_restart_driver);
+MODULE_LICENSE("GPL");
