+static int comcerto_pfe_report_sync_mailboxes(struct comcerto_pfe_port *pfe,
+					      void __iomem *axi)
+{
+	unsigned int id;
+
+	/* This is an observation-only check.  The PE read command accesses the
+	 * firmware DMEM mailbox without changing its contents or enabling TX. */
+	for (id = 0; id <= 10; id++) {
+		u32 command, status;
+		int ret;
+
+		if (!(pfe->pe_sync_valid & BIT(id)))
+			continue;
+		ret = comcerto_pfe_read_dmem_word(axi, id,
+						 pfe->pe_sync_mailbox[id], &command);
+		if (ret)
+			return ret;
+		ret = comcerto_pfe_read_dmem_word(axi, id,
+						 pfe->pe_sync_mailbox[id] +
+						 COMCERTO_PFE_CTRL_PE_STATUS_WORD_OFFSET,
+						 &status);
+		if (ret)
+			return ret;
+		dev_info(pfe->dev, "PE%u sync-mailbox=%#x command=%#x status=%#x\\n",
+			 id, pfe->pe_sync_mailbox[id], command, status);
+	}
+	return 0;
+}
+
+static int comcerto_pfe_load_firmware_images(struct comcerto_pfe_port *pfe,
+					     void __iomem *axi, void __iomem *ddr)
+{
+	struct device *dev = pfe->dev;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pfe_firmware_names); i++) {
+		const struct firmware *fw;
+		u32 mailbox_offset, mailbox_word;
+		int ret;
+
+		ret = request_firmware(&fw, pfe_firmware_names[i], dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "missing firmware %s\n",
+					     pfe_firmware_names[i]);
+		ret = comcerto_pfe_sync_mailbox_offset(pfe_firmware_images[i],
+						       &mailbox_offset);
+		ret = ret ?: comcerto_pfe_firmware_dmem_shared_word(fw->data, fw->size,
+								     mailbox_offset, &mailbox_word);
+		if (!ret) {
+			u16 targets = comcerto_pfe_fw_target_mask(pfe_firmware_images[i]);
+			unsigned int id;
+			for (id = 0; id <= 10; id++)
+				if (targets & BIT(id)) {
+					pfe->pe_sync_mailbox[id] = mailbox_word;
+					pfe->pe_sync_valid |= BIT(id);
+				}
+		}
+		ret = ret ?: comcerto_pfe_load_firmware(dev, axi, ddr,
+					 pfe_firmware_images[i], fw->data, fw->size);
+		release_firmware(fw);
+		if (ret)
+			return dev_err_probe(dev, ret, "could not load firmware %s\n",
+					     pfe_firmware_names[i]);
+		dev_info(dev, "firmware %s transferred to recovered PE windows\n",
+			 pfe_firmware_names[i]);
+	}
+	return 0;
+}
+
+static int comcerto_pfe_discover_sync_mailboxes(struct comcerto_pfe_port *pfe)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pfe_firmware_names); i++) {
+		const struct firmware *fw;
+		u32 offset, mailbox;
+		u16 targets;
+		unsigned int id;
+		int ret;
+
+		ret = request_firmware(&fw, pfe_firmware_names[i], pfe->dev);
+		if (ret)
+			return ret;
+		ret = comcerto_pfe_sync_mailbox_offset(pfe_firmware_images[i], &offset);
+		ret = ret ?: comcerto_pfe_firmware_dmem_shared_word(fw->data, fw->size,
+							      offset, &mailbox);
+		release_firmware(fw);
+		if (ret)
+			return ret;
+		targets = comcerto_pfe_fw_target_mask(pfe_firmware_images[i]);
+		for (id = 0; id <= 10; id++)
+			if (targets & BIT(id)) {
+				pfe->pe_sync_mailbox[id] = mailbox;
+				pfe->pe_sync_valid |= BIT(id);
+			}
+	}
+	return 0;
+}
