diff --git a/drivers/clocksource/timer-comcerto.c b/drivers/clocksource/timer-comcerto.c
new file mode 100644
index 000000000..69a466683
--- /dev/null
+++ b/drivers/clocksource/timer-comcerto.c
@@ -0,0 +1,329 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Mindspeed/Freescale Comcerto 2000 general-purpose timer
+ *
+ * ZyxelUntrash V25 early-registration staging implementation.
+ *
+ * The TIMER_OF_DECLARE path is compiled and linked for ordering validation.
+ * The matching Device Tree node remains disabled and no generated image is
+ * approved for boot.
+ */
+
+#include <linux/bitops.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/compiler.h>
+#include <linux/cpumask.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irqdomain.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/string.h>
+
+#include <linux/printk.h>
+#define COMCERTO_TIMER_RATE_HZ           250000000U
+#define COMCERTO_TIMER_PHYS_BASE         0x90450000U
+#define COMCERTO_TIMER_REGISTER_SIZE     0x00001000U
+
+#define COMCERTO_TIMER1_EVENT            0x008U
+#define COMCERTO_TIMER2_COUNTER          0x01cU
+#define COMCERTO_TIMER_IRQ_MASK          0x048U
+#define COMCERTO_TIMER_IRQ_STATUS_W1C    0x050U
+
+#define COMCERTO_TIMER1_MASK_INDEX       1U
+#define COMCERTO_TIMER1_MASK             BIT(COMCERTO_TIMER1_MASK_INDEX)
+#define COMCERTO_TIMER1_LEGACY_IRQ       88
+
+#define COMCERTO_TIMER_RATING            200
+#define COMCERTO_TIMER_MIN_DELTA         1UL
+#define COMCERTO_TIMER_MAX_DELTA         0xffffffffUL
+
+struct comcerto_timer {
+	void __iomem *base;
+	u32 rate;
+	u32 mask_index;
+	int irq;
+	struct clock_event_device clockevent;
+	struct clocksource clocksource;
+};
+
+static struct comcerto_timer comcerto_timer_compile_only_device;
+static struct comcerto_timer comcerto_timer_early_device;
+
+static int __init comcerto_timer_compile_only_register(void __iomem *base);
+
+static inline u32 comcerto_timer_mask(const struct comcerto_timer *timer)
+{
+	return BIT(timer->mask_index);
+}
+
+static inline u32 comcerto_timer_readl(const struct comcerto_timer *timer,
+				      u32 offset)
+{
+	return readl(timer->base + offset);
+}
+
+static inline void comcerto_timer_writel(const struct comcerto_timer *timer,
+					 u32 value, u32 offset)
+{
+	writel(value, timer->base + offset);
+}
+
+static void comcerto_timer1_disable(struct comcerto_timer *timer)
+{
+	u32 value;
+
+	value = comcerto_timer_readl(timer, COMCERTO_TIMER_IRQ_MASK);
+	value &= ~comcerto_timer_mask(timer);
+	comcerto_timer_writel(timer, value, COMCERTO_TIMER_IRQ_MASK);
+}
+
+static void comcerto_timer1_enable(struct comcerto_timer *timer)
+{
+	u32 value;
+
+	value = comcerto_timer_readl(timer, COMCERTO_TIMER_IRQ_MASK);
+	value |= comcerto_timer_mask(timer);
+	comcerto_timer_writel(timer, value, COMCERTO_TIMER_IRQ_MASK);
+}
+
+static int comcerto_timer1_shutdown(struct clock_event_device *clockevent)
+{
+	struct comcerto_timer *timer;
+
+	timer = container_of(clockevent, struct comcerto_timer, clockevent);
+	comcerto_timer1_disable(timer);
+
+	return 0;
+}
+
+static int comcerto_timer1_set_oneshot(struct clock_event_device *clockevent)
+{
+	return comcerto_timer1_shutdown(clockevent);
+}
+
+static int comcerto_timer1_set_periodic(struct clock_event_device *clockevent)
+{
+	struct comcerto_timer *timer;
+	u32 period;
+
+	timer = container_of(clockevent, struct comcerto_timer, clockevent);
+	period = DIV_ROUND_CLOSEST(timer->rate, HZ);
+
+	comcerto_timer_writel(timer, period, COMCERTO_TIMER1_EVENT);
+	comcerto_timer1_enable(timer);
+
+	return 0;
+}
+
+static int comcerto_timer1_set_next_event(
+	unsigned long delta,
+	struct clock_event_device *clockevent)
+{
+	struct comcerto_timer *timer;
+
+	timer = container_of(clockevent, struct comcerto_timer, clockevent);
+	comcerto_timer_writel(timer, (u32)delta, COMCERTO_TIMER1_EVENT);
+	comcerto_timer1_enable(timer);
+
+	return 0;
+}
+
+static irqreturn_t comcerto_timer1_interrupt(int irq, void *dev_id)
+{
+	struct comcerto_timer *timer = dev_id;
+	struct clock_event_device *clockevent = &timer->clockevent;
+	void (*event_handler)(struct clock_event_device *);
+	u32 enabled;
+	u32 pending;
+	u32 mask;
+
+	(void)irq;
+
+	mask = comcerto_timer_mask(timer);
+	pending = comcerto_timer_readl(timer, COMCERTO_TIMER_IRQ_STATUS_W1C);
+	enabled = comcerto_timer_readl(timer, COMCERTO_TIMER_IRQ_MASK);
+
+	if (!(pending & enabled & mask))
+		return IRQ_NONE;
+
+	if (!clockevent_state_periodic(clockevent))
+		comcerto_timer1_disable(timer);
+
+	comcerto_timer_writel(timer, mask, COMCERTO_TIMER_IRQ_STATUS_W1C);
+
+	event_handler = READ_ONCE(clockevent->event_handler);
+	if (event_handler)
+		event_handler(clockevent);
+
+	return IRQ_HANDLED;
+}
+
+static u64 comcerto_timer2_read(struct clocksource *clocksource)
+{
+	struct comcerto_timer *timer;
+
+	timer = container_of(clocksource, struct comcerto_timer, clocksource);
+
+	return comcerto_timer_readl(timer, COMCERTO_TIMER2_COUNTER);
+}
+
+static int __init comcerto_timer_register(
+	struct comcerto_timer *timer,
+	void __iomem *base,
+	int irq,
+	u32 rate)
+{
+	pr_info("ZT-TIMER: register-begin\n");
+	int error;
+
+	memset(timer, 0, sizeof(*timer));
+
+	timer->base = base;
+	timer->rate = rate;
+	timer->mask_index = COMCERTO_TIMER1_MASK_INDEX;
+	timer->irq = irq;
+
+	timer->clocksource.name = "comcerto-timer2";
+	timer->clocksource.rating = COMCERTO_TIMER_RATING;
+	timer->clocksource.read = comcerto_timer2_read;
+	timer->clocksource.mask = CLOCKSOURCE_MASK(32);
+	timer->clocksource.flags = CLOCK_SOURCE_IS_CONTINUOUS;
+
+	timer->clockevent.name = "comcerto-timer1";
+	timer->clockevent.rating = COMCERTO_TIMER_RATING;
+	timer->clockevent.features =
+		CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT;
+	timer->clockevent.set_state_shutdown = comcerto_timer1_shutdown;
+	timer->clockevent.set_state_periodic = comcerto_timer1_set_periodic;
+	timer->clockevent.set_state_oneshot = comcerto_timer1_set_oneshot;
+	timer->clockevent.tick_resume = comcerto_timer1_shutdown;
+	timer->clockevent.set_next_event = comcerto_timer1_set_next_event;
+	timer->clockevent.cpumask = cpumask_of(0);
+	timer->clockevent.irq = irq;
+
+	comcerto_timer1_disable(timer);
+	comcerto_timer_writel(timer,
+			      comcerto_timer_mask(timer),
+			      COMCERTO_TIMER_IRQ_STATUS_W1C);
+
+	error = clocksource_register_hz(&timer->clocksource, timer->rate);
+	if (error)
+		return error;
+
+	pr_info("ZT-TIMER: clocksource-registered\n");
+
+	error = request_irq(irq,
+			    comcerto_timer1_interrupt,
+			    IRQF_TIMER | IRQF_SHARED,
+			    "comcerto-timer1",
+			    timer);
+	if (error) {
+		clocksource_unregister(&timer->clocksource);
+		return error;
+	}
+
+	pr_info("ZT-TIMER: irq-requested\n");
+
+
+	clockevents_config_and_register(&timer->clockevent,
+					timer->rate,
+					COMCERTO_TIMER_MIN_DELTA,
+					COMCERTO_TIMER_MAX_DELTA);
+
+	pr_info("ZT-TIMER: clockevent-registered\n");
+
+	pr_info("ZT-TIMER: register-success\n");
+	return 0;
+}
+
+/*
+ * Compile-only entry point retained for API validation.
+ * V25 does not call it.
+ */
+static int __init comcerto_timer_compile_only_register(void __iomem *base)
+{
+	return comcerto_timer_register(
+		&comcerto_timer_compile_only_device,
+		base,
+		COMCERTO_TIMER1_LEGACY_IRQ,
+		COMCERTO_TIMER_RATE_HZ);
+}
+
+#if IS_ENABLED(CONFIG_COMCERTO_TIMER_EARLY_STAGING)
+
+static int __init comcerto_timer_of_init(struct device_node *node)
+{
+	pr_info("ZT-TIMER: of-init-begin\n");
+	void __iomem *base;
+	u32 rate = COMCERTO_TIMER_RATE_HZ;
+	int error;
+	int irq;
+
+	base = of_iomap(node, 0);
+	if (!base)
+		return -ENXIO;
+
+	irq = irq_of_parse_and_map(node, 0);
+	if (irq <= 0) {
+		error = -EINVAL;
+		goto error_iounmap;
+	}
+
+	if (of_property_read_u32(node, "clock-frequency", &rate))
+		rate = COMCERTO_TIMER_RATE_HZ;
+
+	pr_info("ZT-TIMER: resources-ready\n");
+	error = comcerto_timer_register(
+		&comcerto_timer_early_device,
+		base,
+		irq,
+		rate);
+	if (error)
+		goto error_irq_mapping;
+
+	pr_info("Comcerto timer: early OF registration staged\n");
+
+	pr_info("ZT-TIMER: of-init-success\n");
+	return 0;
+
+error_irq_mapping:
+	pr_err("ZT-TIMER: cleanup-irq-mapping\n");
+	irq_dispose_mapping(irq);
+
+error_iounmap:
+	pr_err("ZT-TIMER: cleanup-iomap\n");
+	iounmap(base);
+
+	return error;
+}
+
+TIMER_OF_DECLARE(
+	comcerto_2000_timer,
+	"mindspeed,comcerto-2000-timer",
+	comcerto_timer_of_init);
+
+#endif /* CONFIG_COMCERTO_TIMER_EARLY_STAGING */
+
+static void __maybe_unused comcerto_timer_compile_time_assertions(void)
+{
+	BUILD_BUG_ON(COMCERTO_TIMER_PHYS_BASE != 0x90450000U);
+	BUILD_BUG_ON(COMCERTO_TIMER_REGISTER_SIZE != 0x00001000U);
+	BUILD_BUG_ON(COMCERTO_TIMER1_EVENT != 0x008U);
+	BUILD_BUG_ON(COMCERTO_TIMER2_COUNTER != 0x01cU);
+	BUILD_BUG_ON(COMCERTO_TIMER_IRQ_MASK != 0x048U);
+	BUILD_BUG_ON(COMCERTO_TIMER_IRQ_STATUS_W1C != 0x050U);
+	BUILD_BUG_ON(COMCERTO_TIMER1_MASK_INDEX != 1U);
+	BUILD_BUG_ON(COMCERTO_TIMER1_MASK != 0x00000002U);
+	BUILD_BUG_ON(COMCERTO_TIMER1_LEGACY_IRQ != 88);
+	BUILD_BUG_ON(COMCERTO_TIMER_RATE_HZ != 250000000U);
+}
+
+MODULE_DESCRIPTION("Comcerto 2000 timer early-registration staging");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clocksource/timer-comcerto2000-reconstruction.c b/drivers/clocksource/timer-comcerto2000-reconstruction.c
new file mode 100644
index 000000000..48585acdc
--- /dev/null
+++ b/drivers/clocksource/timer-comcerto2000-reconstruction.c
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mindspeed Comcerto 2000 timer reconstruction scaffold
+ *
+ * Generated by ZyxelUntrash RE-5 V11 from Linux 3.2 static/runtime evidence.
+ * V376 registers the now hardware-proven Timer-2 counter as an IRQ-free
+ * clocksource. It does not create a clockevent or enable any timer interrupt.
+ */
+
+#include <linux/errno.h>
+#include <linux/clocksource.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+
+#define COMCERTO_TIMER_EXPECTED_RATE 250000000U
+#define COMCERTO_TIMER_COUNTER_OFF 0x0000001cU
+#define COMCERTO_TIMER_EVENT_OFF 0x00000008U
+#define COMCERTO_TIMER2_REG10_OFF 0x00000010U
+#define COMCERTO_TIMER2_REG14_OFF 0x00000014U
+#define COMCERTO_TIMER2_REG18_OFF 0x00000018U
+#define COMCERTO_TIMER_CONTROL_OFF 0x00000140U
+#define COMCERTO_TIMER_IRQ_CLEAR_OFF 0x00000050U
+#define COMCERTO_TIMER_IRQ_STATUS_OFF 0x00000050U
+#define COMCERTO_TIMER_IRQ_MASK_OFF 0x00000048U
+#define COMCERTO_TIMER_CHANNEL_STRIDE 0x00000020U
+
+/*
+ * V375: the exact stock comcerto_timer_start(channel 2) writes zero at
+ * 0x18, zero at 0x10, then the load at 0x14.  The original function follows
+ * this by unmasking the channel IRQ; V375 deliberately omits that separate
+ * interrupt-delivery step.  Use a large load so the bounded observation
+ * window cannot reach expiry.
+ */
+/* V576: Timer 2 wraps at this upper bound; the clocksource is 32 bit wide,
+ * so it must be 0xffffffff (0x10000000 made time run ~16x fast). */
+#define COMCERTO_TIMER_V375_TIMER2_LOAD 0xffffffffU
+
+#define COMCERTO_TIMER_CTRL_SHUTDOWN 0xffffffffU
+#define COMCERTO_TIMER_CTRL_ENABLE 0xffffffffU
+#define COMCERTO_TIMER_CTRL_ONESHOT 0xffffffffU
+#define COMCERTO_TIMER_CTRL_PERIODIC 0xffffffffU
+#define COMCERTO_TIMER_IRQ_CLEAR_VALUE 0xffffffffU
+
+#define COMCERTO_TIMER_REGISTER_LAYOUT_READY 0
+#define COMCERTO_TIMER_CONTROL_SEMANTICS_READY 0
+#define COMCERTO_TIMER_IMPLEMENTATION_READY 0
+
+struct comcerto_timer_reconstruction {
+	void __iomem *base;
+	u32 rate;
+};
+
+static void __iomem *comcerto_timer_v376_counter;
+
+static u64 comcerto_timer_v376_clocksource_read(struct clocksource *cs)
+{
+	return readl_relaxed(comcerto_timer_v376_counter);
+}
+
+static struct clocksource comcerto_timer_v376_clocksource = {
+	.name = "comcerto-timer2-v376",
+	.rating = 200,
+	.read = comcerto_timer_v376_clocksource_read,
+	.mask = CLOCKSOURCE_MASK(32),
+	.flags = CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static __maybe_unused u32
+comcerto_timer_reconstructed_read_counter(struct comcerto_timer_reconstruction *timer)
+{
+	return readl_relaxed(timer->base + COMCERTO_TIMER_COUNTER_OFF);
+}
+
+static __maybe_unused void
+comcerto_timer_reconstructed_program_event(struct comcerto_timer_reconstruction *timer,
+					   u32 delta)
+{
+	writel_relaxed(delta, timer->base + COMCERTO_TIMER_EVENT_OFF);
+}
+
+static __maybe_unused void
+comcerto_timer_reconstructed_ack(struct comcerto_timer_reconstruction *timer)
+{
+	writel_relaxed(COMCERTO_TIMER_IRQ_CLEAR_VALUE,
+		       timer->base + COMCERTO_TIMER_IRQ_CLEAR_OFF);
+}
+
+static int comcerto_timer_reconstruction_probe(struct platform_device *pdev)
+{
+	struct resource *resource;
+	void __iomem *base;
+	u32 event_a, event_b, counter_a, counter_b, irq_mask, irq_status;
+	u32 timer2_reg10, timer2_reg14, timer2_reg18;
+	u32 rate;
+	int ret;
+
+	/*
+	 * Keep each V372 checkpoint at error level: the normal console threshold
+	 * may hide informational messages during the very early boot window.
+	 * These messages, like the rest of this probe, are observation-only.
+	 */
+	dev_err(&pdev->dev, "ZT-TIMER:AUDIT-BEGIN (read-only)\n");
+
+	ret = device_property_read_u32(&pdev->dev, "clock-frequency", &rate);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "missing reconstructed clock-frequency\n");
+
+	if (rate != COMCERTO_TIMER_EXPECTED_RATE)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "unexpected reconstructed timer rate %u\n",
+				     rate);
+
+	/*
+	 * V371 is deliberately observation-only.  Mapping and readl_relaxed() do
+	 * not alter timer state; in particular no counter/event/control/IRQ value
+	 * is written and no clocksource or clockevent is registered.
+	 */
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "ZT-TIMER:AUDIT no MMIO resource\n");
+
+	base = devm_ioremap_resource(&pdev->dev, resource);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	dev_err(&pdev->dev, "ZT-TIMER:AUDIT-MAPPED start=%pa end=%pa\n",
+		&resource->start, &resource->end);
+
+	event_a = readl_relaxed(base + COMCERTO_TIMER_EVENT_OFF);
+	timer2_reg10 = readl_relaxed(base + COMCERTO_TIMER2_REG10_OFF);
+	timer2_reg14 = readl_relaxed(base + COMCERTO_TIMER2_REG14_OFF);
+	timer2_reg18 = readl_relaxed(base + COMCERTO_TIMER2_REG18_OFF);
+	counter_a = readl_relaxed(base + COMCERTO_TIMER_COUNTER_OFF);
+	irq_mask = readl_relaxed(base + COMCERTO_TIMER_IRQ_MASK_OFF);
+	irq_status = readl_relaxed(base + COMCERTO_TIMER_IRQ_STATUS_OFF);
+	for (ret = 0; ret < 10000; ret++)
+		cpu_relax();
+	event_b = readl_relaxed(base + COMCERTO_TIMER_EVENT_OFF);
+	counter_b = readl_relaxed(base + COMCERTO_TIMER_COUNTER_OFF);
+
+	dev_err(&pdev->dev,
+		 "ZT-TIMER:AUDIT event=%08x/%08x t2=%08x/%08x/%08x counter=%08x/%08x mask=%08x status=%08x (read-only)\n",
+		 event_a, event_b, timer2_reg10, timer2_reg14, timer2_reg18,
+		 counter_a, counter_b, irq_mask, irq_status);
+
+	/*
+	 * V375's only write sequence is byte-for-byte ordered like the exact
+	 * Timer-2 arm of stock comcerto_timer_start(): zero@0x18, zero@0x10,
+	 * load@0x14. It intentionally does not touch IRQ mask@0x48 or status@0x50
+	 * and cannot register an interrupt consumer.  A 0x10000000 load keeps the
+	 * channel away from expiry throughout this short polling interval.
+	 */
+	dev_err(&pdev->dev, "ZT-TIMER:V379-T2-START load=%08x; IRQ unchanged\n",
+		COMCERTO_TIMER_V375_TIMER2_LOAD);
+	writel_relaxed(0, base + COMCERTO_TIMER2_REG18_OFF);
+	writel_relaxed(0, base + COMCERTO_TIMER2_REG10_OFF);
+	writel_relaxed(COMCERTO_TIMER_V375_TIMER2_LOAD,
+		       base + COMCERTO_TIMER2_REG14_OFF);
+	for (ret = 0; ret < 10000; ret++)
+		cpu_relax();
+	counter_a = readl_relaxed(base + COMCERTO_TIMER_COUNTER_OFF);
+	for (ret = 0; ret < 10000; ret++)
+		cpu_relax();
+	counter_b = readl_relaxed(base + COMCERTO_TIMER_COUNTER_OFF);
+	irq_mask = readl_relaxed(base + COMCERTO_TIMER_IRQ_MASK_OFF);
+	irq_status = readl_relaxed(base + COMCERTO_TIMER_IRQ_STATUS_OFF);
+	dev_err(&pdev->dev,
+		"ZT-TIMER:V379-T2-PRE-REGISTER counter=%08x/%08x mask=%08x status=%08x\n",
+		counter_a, counter_b, irq_mask, irq_status);
+
+	if (counter_a == counter_b)
+		return dev_err_probe(&pdev->dev, -EIO,
+			"ZT-TIMER:V379 counter did not advance; refusing clocksource\n");
+
+	/*
+	 * The counter is proven monotonic over the bounded V375 poll interval and
+	 * the 250 MHz rate is a DT property. Register it only as a read-only,
+	 * 32-bit up-counter. Timer 1, IRQ mask and status stay untouched.
+	 */
+	comcerto_timer_v376_counter = base + COMCERTO_TIMER_COUNTER_OFF;
+	ret = clocksource_register_hz(&comcerto_timer_v376_clocksource, rate);
+	dev_err(&pdev->dev, "ZT-TIMER:V379-CLOCKSOURCE ret=%d; IRQ unchanged\n",
+		ret);
+	return ret;
+}
+
+static const struct of_device_id comcerto_timer_reconstruction_of_match[] = {
+	{ .compatible = "mindspeed,comcerto-2000-timer" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, comcerto_timer_reconstruction_of_match);
+
+static struct platform_driver comcerto_timer_reconstruction_driver = {
+	.probe = comcerto_timer_reconstruction_probe,
+	.driver = {
+		.name = "comcerto2000-timer-reconstruction",
+		.of_match_table = comcerto_timer_reconstruction_of_match,
+	},
+};
+module_platform_driver(comcerto_timer_reconstruction_driver);
+
+MODULE_DESCRIPTION("Mindspeed Comcerto 2000 non-operational timer reconstruction scaffold");
+MODULE_LICENSE("GPL");
