+	}
+	dev_emerg(&pdev->dev, "PFE:HIFDESC:100MS:OK\n");
+	/* V328: exercise only pfe_ctrl_init()'s recovered host DMA-pool shape.
+	 * The pools are immediately destroyed; no PE command, GPI, HIF control,
+	 * IRQ, GEMAC or netdev path is reachable from this gate. */
+	ret = comcerto_pfe_ctrl_create_dma_pools(&pdev->dev, &ctrl_pools);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"recovered control DMA-pool allocation failed\n");
+	comcerto_pfe_ctrl_destroy_dma_pools(&ctrl_pools);
+	if (readl(hif + COMCERTO_PFE_HIF_INT_ENABLE) ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_VERSION) != COMCERTO_PFE_HIF_VERSION_INIT ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_BASE) != lower_32_bits(pfe->stock_dma_a_addr) ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_BASE) != lower_32_bits(pfe->stock_dma_b_addr))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"control pool gate disturbed quiescent HIF ownership\n");
+	dev_emerg(&pdev->dev, "PFE:CTRLPOOL:OK\n");
+	return 0;
+#endif
+	#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 4 && COMCERTO_PFE_TMU_SNAPSHOT_ONLY
+	/* Barebox has already brought TMU and its firmware up.  Before resetting
+	 * it from Linux, establish that the live control register is readable. */
+	dev_emerg(&pdev->dev, "TMU adoption snapshot: ctrl=%08x (no write)\n",
+		  readl(axi + COMCERTO_PFE_TMU_OFFSET + 0x0e0));
+	#endif
+	/* Reconstruct the vendor pfe_hw_init() dependency chain before firmware
+	 * execution.  This touches only PFE-local AXI/DDR state; HIF, GEMAC,
+	 * MDIO and packet flow remain disabled at this point. */
+	dev_emerg(&pdev->dev, "stock PFE hardware preparation stage %u begin\n",
+		  COMCERTO_PFE_STOCK_HW_PREP_STAGE);
+	ret = comcerto_pfe_stock_hw_prepare(axi, ddr, ddr_resource->start,
+					   resource_size(ddr_resource));
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"stock PFE hardware preparation failed\n");
+	dev_emerg(&pdev->dev, "stock PFE hardware preparation stage %u complete\n",
+		  COMCERTO_PFE_STOCK_HW_PREP_STAGE);
+	/*
+	 * This proves that Linux can supply a 32-bit DMA-visible HIF RX ring.
+	 * It is deliberately not connected to RX_BASE/RX_CTRL in this stage.
+	 */
+	ret = comcerto_pfe_hif_alloc_rx_ring(&pdev->dev, &pfe->rx_ring,
+			COMCERTO_PFE_HIF_RX_DESC_COUNT,
+			COMCERTO_PFE_HIF_RX_BUFFER_BYTES);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"could not allocate staged HIF RX ring\n");
+	if (devm_add_action_or_reset(&pdev->dev,
+				     comcerto_pfe_release_rx_ring, pfe))
+		return -ENOMEM;
+	/* Separate TX storage and host completion records are prepared for the
+	 * later owned-HIF lifecycle. They remain unregistered with HIF, so this
+	 * does not permit DMA or packet transmission. */
+	ret = comcerto_pfe_hif_alloc_tx_ring(&pdev->dev, &pfe->tx_ring,
+			COMCERTO_PFE_HIF_RX_DESC_COUNT);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"could not allocate staged HIF TX ring\n");
+	if (devm_add_action_or_reset(&pdev->dev,
+				     comcerto_pfe_release_tx_ring, pfe))
+		return -ENOMEM;
+	if (comcerto_pfe_load_firmware_images(pfe, axi, ddr))
+		return -EINVAL;
+	if (pfe->pe_sync_valid != (GENMASK(7, 0) | BIT(9) | BIT(10)))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+			"incomplete recovered PE sync-mailbox set\n");
+	hif = axi + COMCERTO_PFE_HIF_OFFSET;
+	pfe->hif = hif;
+	writel(0, hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	readl(hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	hif_status = readl(hif + COMCERTO_PFE_HIF_INT_STATUS);
+	writel(hif_status & ~(COMCERTO_PFE_HIF_INT_GATE |
+			      COMCERTO_PFE_HIF_INT_RX),
+	       hif + COMCERTO_PFE_HIF_INT_STATUS);
+	readl(hif + COMCERTO_PFE_HIF_INT_STATUS);
+	comcerto_pfe_enable_cores(axi);
+	ret = comcerto_pfe_report_sync_mailboxes(pfe, axi);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"could not observe recovered PE sync mailboxes\\n");
+	/* V291 lifecycle proof: use the stock all-active mask only after the
+	 * mailbox addresses were read back.  Always issue the matching start
+	 * operation, including after a timeout, then verify the cleared state
+	 * before allowing probe to report the stop result. */
+	ret = comcerto_pfe_ctrl_sync_stop(axi, pfe->pe_sync_mailbox,
+					 GENMASK(7, 0) | BIT(9) | BIT(10));
+	start_ret = comcerto_pfe_ctrl_sync_start(axi, pfe->pe_sync_mailbox,
+						GENMASK(7, 0) | BIT(9) | BIT(10));
+	if (!start_ret)
+		start_ret = comcerto_pfe_report_sync_mailboxes(pfe, axi);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"PE sync-stop lifecycle did not acknowledge\\n");
+	if (start_ret)
+		return dev_err_probe(&pdev->dev, start_ret,
+			"PE sync-start lifecycle failed\\n");
+	dev_info(&pdev->dev, "PE sync stop/start lifecycle acknowledged\\n");
+	/*
+	 * Do not issue GEMAC/MDIO traffic here yet.  V130 proved that merely
+	 * loading the PE firmware is not the stock precondition for accessing
+	 * GEMAC: the vendor driver performs its complete hw, HIF and control
+	 * initialisation chain before pfe_eth_init() registers its MDIO bus.
+	 * Keep the recovered transaction helpers compiled for the later Ethernet
+	 * stage, but do not make a DT property bypass that ordering again.
+	 */
+	/*
+	 * Stock hif_init() writes the version contract, and pfe_hif_init()
+	 * then provides the RX descriptor DMA base.  Do exactly those two
+	 * reversible register writes here; RX_CTRL remains zero, so the HIF
+	 * cannot fetch descriptors or transfer packets in this stage.
+	 */
+	writel(COMCERTO_PFE_HIF_VERSION_INIT,
+		hif + COMCERTO_PFE_HIF_VERSION);
+	writel(lower_32_bits(pfe->rx_ring.desc_dma),
+		hif + COMCERTO_PFE_HIF_RX_BASE);
+	if (readl(hif + COMCERTO_PFE_HIF_VERSION) !=
+		    COMCERTO_PFE_HIF_VERSION_INIT ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_BASE) !=
+		    lower_32_bits(pfe->rx_ring.desc_dma))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"HIF RX ring register readback mismatch\n");
+	/* IRQ is registered before RX_CTRL is enabled in a later stage. */
+	ret = devm_request_irq(&pdev->dev, pfe->hif_irq, comcerto_pfe_hif_irq,
+			       0, dev_name(&pdev->dev), pfe);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"could not register staged HIF IRQ\n");
+	/*
+	 * RX capture only: completed frames are recycled by NAPI and deliberately
+	 * discarded.  TX, GEMAC/PHY bring-up and netdev registration remain off.
+	 */
+	napi_enable(&pfe->napi);
+	pfe->hif_rx_enabled = true;
+	writel(COMCERTO_PFE_HIF_RX_CTRL_ENABLE,
+		hif + COMCERTO_PFE_HIF_RX_CTRL);
+	writel(COMCERTO_PFE_HIF_RX_INT_ENABLE,
+		hif + COMCERTO_PFE_HIF_INT_ENABLE);
+
+	dev_info(&pdev->dev,
+		 "firmware cores enabled, %u staged HIF RX descriptors; RX capture/NAPI active, no TX/netdev\n",
+		 pfe->rx_ring.count);
+	return 0;
+}
+static const struct of_device_id comcerto_pfe_of_match[] = {
+	{ .compatible = "mindspeed,comcerto-2000-pfe" }, { }
+};
+MODULE_DEVICE_TABLE(of, comcerto_pfe_of_match);
+static struct platform_driver comcerto_pfe_driver = {
+	.probe = comcerto_pfe_probe,
+	.driver = { .name = "comcerto-pfe", .of_match_table = comcerto_pfe_of_match },
+};
+module_platform_driver(comcerto_pfe_driver);
+MODULE_LICENSE("GPL");
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-probe.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-probe.c
new file mode 100644
index 000000000..f39271db0
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-probe.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Comcerto 2000 PFE inventory-only probe. This driver must not touch MMIO. */
+#include <linux/clk.h>
+#include <linux/ioport.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+static const char * const pfe_resource_names[] = {
+	"ddr", "axi", "apb", "iram", "ipsec",
+};
+
+static int comcerto_pfe_probe(struct platform_device *pdev)
+{
+	struct clk *clk;
+	unsigned long rate = 0;
+	unsigned int i;
+	int irq;
+
+	for (i = 0; i < ARRAY_SIZE(pfe_resource_names); i++) {
+		struct resource *res;
+		resource_size_t size;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+						   pfe_resource_names[i]);
+		if (!res)
+			return dev_err_probe(&pdev->dev, -EINVAL,
+					     "missing resource %s\n",
+					     pfe_resource_names[i]);
+		size = resource_size(res);
+		dev_info(&pdev->dev, "%s: %pa-%pa (%pa bytes)\n",
+			 pfe_resource_names[i], &res->start, &res->end, &size);
+	}
+
+	irq = platform_get_irq_byname(pdev, "hif");
+	if (irq < 0)
+		return dev_err_probe(&pdev->dev, irq, "missing hif IRQ\n");
+
+	clk = devm_clk_get_optional(&pdev->dev, "pfe");
+	if (IS_ERR(clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clk),
+				     "cannot resolve pfe clock\n");
+	if (clk)
+		rate = clk_get_rate(clk);
+
+	dev_info(&pdev->dev,
+		 "inventory complete: hif_irq=%d pfe_clock=%lu; MMIO/DMA/IRQ/firmware untouched\n",
+		 irq, rate);
+	return 0;
+}
+
+static const struct of_device_id comcerto_pfe_of_match[] = {
+	{ .compatible = "mindspeed,comcerto-2000-pfe-probe" },
+	{ }
+};
+
+static struct platform_driver comcerto_pfe_driver = {
+	.probe = comcerto_pfe_probe,
+	.driver = {
+		.name = "comcerto-pfe-probe",
+		.of_match_table = comcerto_pfe_of_match,
+	},
+};
+builtin_platform_driver(comcerto_pfe_driver);
