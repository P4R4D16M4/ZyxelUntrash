+#define COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES	0x18
+#define COMCERTO_PFE_CTRL_COMMAND_STATUS_NO_HANDLER	1
+#define COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED	2
+#define COMCERTO_PFE_CTRL_COMMAND_STATUS_INVALID	0xfffe
