+static void comcerto_pfe_enable_cores(void __iomem *axi)
+{
+	/* Exact stock pfe_firmware_init order: util, TMU mask 0xf, class. */
+	writel(1, axi + COMCERTO_PFE_UTIL_CBUS_OFFSET + 0x4);
+	writel(readl(axi + COMCERTO_PFE_TMU_CBUS_OFFSET + 0x104) | 0xf,
+		axi + COMCERTO_PFE_TMU_CBUS_OFFSET + 0x104);
+	writel(1, axi + COMCERTO_PFE_CLASS_CBUS_OFFSET + 0x4);
+	wmb();
+}
