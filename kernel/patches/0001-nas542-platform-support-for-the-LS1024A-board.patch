+	    interface->onif_index != onif_index)
+		return -EINVAL;
+	/* bridge_interface_deregister() clears bytes 0 and 1 only. */
+	interface->configuration = 0;
+	interface->registered = 0;
+	if (interface->registered || interface->configuration ||
+	    interface->onif_index != onif_index)
+		return -EINVAL;
+	return 0;
