+/* The numeric selector-8 input prefix is two native-endian u16 values:
+ * physical port (0..2) and the byte written to interface.configuration.
+ * The alternative name form begins at byte 4 and remains intentionally
+ * unsupported until the full command ingress ABI is ported. */
+struct comcerto_pfe_ctrl_bridge_selector8_payload {
+	u16 physical_port;
+	u16 configuration;
+};
+
+/* Selector 9 reads payload through offset 0x3c before it allocates and
+ * links a vendor flow object.  The individual key fields are not named yet;
+ * retain the proven minimum envelope only, never an executable lookup. */
+struct comcerto_pfe_ctrl_bridge_selector9_prefix {
+	u8 bytes[COMCERTO_PFE_CTRL_BRIDGE_SELECTOR9_PREFIX_BYTES];
+};
+
+/* Selector 10 reads a compact key through payload+0x12, then removes a
+ * matching L2-bridge entry.  Its alternative interface-name form starts at
+ * byte 0x14 and is intentionally not represented here. */
+struct comcerto_pfe_ctrl_bridge_selector10_key {
+	u8 bytes[COMCERTO_PFE_CTRL_BRIDGE_SELECTOR10_KEY_BYTES];
+};
+
+/* Selector 11 has no request payload.  It walks its six registered interface
+ * slots and writes configuration at +2, an ONIF-derived 12-byte record at
+ * +4, and its empty-result status at +20. */
+struct comcerto_pfe_ctrl_bridge_selector11_reply {
+	u8 reserved0[2];
+	u16 configuration;
+	u8 onif_record[12];
+	u8 reserved1[4];
+	u32 status;
+};
+
+/* Selector 12 delegates to rx_Get_Next_Hash_BridgeEntry(), which copies one
+ * 0x44-byte snapshot record to its caller buffer. */
+struct comcerto_pfe_ctrl_bridge_query_entry {
+	u8 bytes[COMCERTO_PFE_CTRL_BRIDGE_QUERY_ENTRY_BYTES];
+};
+
+/* M_bridge_cmdproc selector 13 rejects every payload length other than 0x60.
+ * Its field semantics and side effects remain intentionally unported. */
+struct comcerto_pfe_ctrl_bridge_selector13_payload {
+	u8 bytes[COMCERTO_PFE_CTRL_BRIDGE_SELECTOR13_BYTES];
+};
+
+/* Selectors 14 and 15 consume the first native-endian u16 only.  Selector 14
+ * requires one to enable/schedule; selector 15 stores this value times ten. */
+struct comcerto_pfe_ctrl_bridge_control_payload {
+	u16 value;
+};
+
+/* Selector 16 consumes no payload.  Stock chooses a full L3/L2 flow flush
+ * when enabled, otherwise its L2-bridge-entry removal path. */
+struct comcerto_pfe_ctrl_bridge_flush_plan {
+	bool enabled;
+	bool flush_l3_l2_flows;
+	bool flush_l2bridge_entries;
+};
+
+/* Linux-owned representation of the stock active-list dimensions.  It is
+ * intentionally separate from interface registration and timer ownership. */
+struct comcerto_pfe_ctrl_bridge_lists {
+	struct list_head *l2_active;
+	struct list_head *l3_active;
+};
+
+/* bridge_init() clears these two host-resident flow-cache regions before it
+ * initializes the active-list heads.  They stay private and all-zero until
+ * the command processor and bridge lifecycle have a reviewed owner. */
+struct comcerto_pfe_ctrl_bridge_caches {
+	void *l2_flow;
+	void *l3_flow;
+};
+
+/* __pfe_ctrl_cmd_handler() treats the first native-endian halfword as the
+ * command result.  It copies the caller payload at record base before calling
+ * a handler, so the rest remains opaque until command ingress is owned. */
+struct comcerto_pfe_ctrl_command_record {
+	u16 status;
+	u8 payload[COMCERTO_PFE_CTRL_COMMAND_RECORD_BYTES - sizeof(u16)];
+};
+
+/* Stock comcerto_fpp_send_command_atomic() allocates payload_length + 0x18.
+ * Its request header uses 32-bit vendor pointers and stores the payload's
+ * self-pointer at +0x14.  This is a layout descriptor only; no list, work or
+ * callback is published by the staging driver. */
+struct comcerto_pfe_ctrl_async_command_request {
+	struct list_head node;
+	u32 completion_callback;
+	u32 completion_context;
+	u16 fcode;
+	u16 payload_length;
+	u32 payload_pointer;
+};
+
+/* Linux-owned dormant state for the recovered atomic command queue.  The
+ * work anchor is initialized, but no path schedules it or exposes requests. */
+struct comcerto_pfe_ctrl_async_command_state {
+	spinlock_t lock;
+	struct list_head queue;
+	struct work_struct work;
+	bool worker_scheduled;
+};
+
+/* FCODE_TO_EVENT() reaches event indices 0..24.  All slots remain NULL: no
+ * stock command processor is published or callable by this staging driver. */
+struct comcerto_pfe_ctrl_dispatch_state {
+	void *handlers[COMCERTO_PFE_CTRL_COMMAND_EVENT_COUNT];
+};
+
+/* M_bridge_cmdproc's direct selector jump table covers precisely 8..16.
