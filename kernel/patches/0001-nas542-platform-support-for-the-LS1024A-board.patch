+enum comcerto_pfe_ctrl_bridge_selector {
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_INVALID,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_8,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_9,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_10,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_11,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_12,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_13,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_14,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_15,
+	COMCERTO_PFE_CTRL_BRIDGE_SELECTOR_16,
+};
