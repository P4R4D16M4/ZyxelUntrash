+	ret = comcerto_pfe_hif_stock_tx_producer_submit(&stock_tx_producer,
+		pfe->tx_test_payload_dma, 60, 0, 3, 3);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"could not publish first Stock TX producer record\n");
+	mb();
+	writel(COMCERTO_PFE_HIF_TX_CTRL_KICK, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	mb();
+	dev_emerg(&pdev->dev, "PFE:V545:KICK0\n");
+	mdelay(100);
+	tx_hif_desc_control = READ_ONCE(tx_test_desc[0].control);
+	dev_emerg(&pdev->dev, "PFE:V545:SLOT0=%08x\n", tx_hif_desc_control);
+	if (!(tx_hif_desc_control & COMCERTO_PFE_HIF_DESC_OWN)) {
+		ret = comcerto_pfe_hif_stock_tx_producer_reclaim(&stock_tx_producer, 0);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+				"could not reclaim completed Stock TX slot zero\n");
+		dev_emerg(&pdev->dev, "PFE:V545:RECLAIM0\n");
+		ret = comcerto_pfe_hif_stock_tx_producer_submit(&stock_tx_producer,
+			pfe->tx_test_payload_next_dma, 60, 0, 3, 3);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+				"could not publish second Stock TX producer record\n");
+		/* Stock hif_xmit_pkt() writes 0x5 here after __hif_xmit_pkt()
+		 * has published a packet; this re-arms a stopped TX scanner. */
+		writel(COMCERTO_PFE_HIF_TX_CTRL_KICK,
+		       hif + COMCERTO_PFE_HIF_TX_CTRL);
+		mb();
+		dev_emerg(&pdev->dev, "PFE:V545:KICK1\n");
+		mdelay(100);
+	}
+	tx_test_control = READ_ONCE(tx_test_desc[1].control);
+	/* This is an HIF descriptor-only experiment; completion is host-side. */
+	tx_hif_completion_control = 0;
+	tx_hif_int_status = readl(hif + COMCERTO_PFE_HIF_INT_STATUS);
+	tx_hif_irq_seen = atomic_read(&pfe->hif_irq_seen);
+	tx_hif_gpi_control = readl(gpi4 + COMCERTO_PFE_GPI_CTRL);
+	tx_hif_rx_control = readl(hif + COMCERTO_PFE_HIF_RX_CTRL);
+	writel(0, gpi4 + COMCERTO_PFE_GPI_CTRL);
+	writel(0, hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	writel(0, hif + COMCERTO_PFE_HIF_RX_CTRL);
+	wmb();
+	mdelay(100);
+	napi_disable(&pfe->napi);
+	writel(lower_32_bits(pfe->stock_dma_a_addr), hif + COMCERTO_PFE_HIF_TX_BASE);
+	writel(lower_32_bits(pfe->stock_dma_b_addr), hif + COMCERTO_PFE_HIF_RX_BASE);
+	wmb();
+	mdelay(100);
+	if (readl(gpi4 + COMCERTO_PFE_GPI_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_BASE) != lower_32_bits(pfe->stock_dma_a_addr) ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_BASE) != lower_32_bits(pfe->stock_dma_b_addr) ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_CTRL) || readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO, "full HIF head observation window did not restore\n");
+	if (!(tx_test_control & COMCERTO_PFE_HIF_DESC_OWN))
+		ret = comcerto_pfe_hif_stock_tx_producer_reclaim(&stock_tx_producer, 1);
+	else
+		ret = -EAGAIN;
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"Stock TX producer context did not reclaim its completed slots\n");
+	ret = comcerto_pfe_hif_stock_tx_producer_validate_idle(&stock_tx_producer);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"Stock TX producer context did not return to idle\n");
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->tx_ring.desc, pfe->tx_ring.desc_dma,
+		pfe->stock_dma_a, pfe->stock_dma_a_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"stock HIF descriptor pair did not restore after ordered TX observation\n");
+	/* Keep every UART record short.  During a HIF IRQ window long printk
+	 * records have previously been damaged by interleaved console traffic. */
+	dev_emerg(&pdev->dev, "PFE:V545:HEAD_WORDS;B0=%08x:B1=%08x\n",
+		  tx_hif_head_before, tx_test_control_next);
+	dev_emerg(&pdev->dev, "PFE:V545:DONE_WORDS;D0=%08x:D1=%08x:S=%08x\n",
+		  tx_hif_desc_control, tx_test_control,
+		  tx_hif_int_status);
+	dev_emerg(&pdev->dev, "PFE:V545:HEAD_STATE;I=%u:G=%08x:R=%08x\n",
+		  tx_hif_irq_seen, tx_hif_gpi_control, tx_hif_rx_control);
+	dev_emerg(&pdev->dev, "PFE:V545:RECLAIM1;LINUX_TX_RESTORED;TX=%08x:IRQ=%08x\n",
+		  readl(hif + COMCERTO_PFE_HIF_TX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_INT_ENABLE));
+	goto v520_done;
+
+v520_restore:
+	/* Error recovery may clear only the two controls whose quiescence is a
+	 * precondition, then restores the known HIF-visible descriptor base. */
+	writel(0, hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	wmb();
+	mdelay(100);
+	writel(lower_32_bits(pfe->stock_dma_a_addr),
+	       hif + COMCERTO_PFE_HIF_TX_BASE);
+	wmb();
+	mdelay(100);
+	if (readl(hif + COMCERTO_PFE_HIF_TX_BASE) !=
+		lower_32_bits(pfe->stock_dma_a_addr) ||
+	    readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"isolated Linux TX enable failed and stock ownership did not restore\n");
+	return dev_err_probe(&pdev->dev, ret,
+		"isolated Linux TX enable contract failed after restore\n");
+
+v520_done:
+	/* V516 is the first hardware observation of the coupled Linux-private TX
+	 * lifecycle.  It ends here: later historical TX-engine, IRQ, descriptor
+	 * publication, GPI, GEMAC and MDIO experiments must not be reachable from
+	 * this RAM-only candidate. */
+	dev_emerg(&pdev->dev,
+		  "PFE:V516:TX_LIFECYCLE:INERT;TX=%08x:IRQ=%08x\n",
+		  readl(hif + COMCERTO_PFE_HIF_TX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_INT_ENABLE));
+	/* V547: Gate 1 - publish and reverse the stock TX port command for the
+	 * PHY-4 port (FPP physical_port 0) while HIF TX/IRQ remain inert. */
+	ret = comcerto_pfe_v547_port0_tx_command(pfe, axi);
+	if (ret)
+		return ret;
+	/* V548: Gate 3 entry - instrumented stock-order MDIO read of PHY 4. */
+	comcerto_pfe_v548_phy4_mdio_probe(&pdev->dev, axi);
+	/* V549: Linux mii_bus + phylib scan of PHY 4/6 (read-only). */
+	/* V550 supersedes the V549 read-only scan: stock GEMAC config + PHY attach. */
+	comcerto_pfe_v550_gemac_phy_attach(pfe, axi);
+	dev_emerg(&pdev->dev, "PFE:V476:POSTPFE=OK\n");
+	dev_emerg(&pdev->dev, "PFE:V417:OK\n");
+	return 0;
+	dev_emerg(&pdev->dev,
+		  "PFE:POSTRESET:V418_TX_BASE_PREFLIGHT base=%08x tx=%08x int=%08x;NO_WRITE\n",
+		  readl(hif + COMCERTO_PFE_HIF_TX_BASE),
+		  readl(hif + COMCERTO_PFE_HIF_TX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_INT_ENABLE));
+	if (readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO, "TX preflight lost quiescence\n");
+	readl(hif + COMCERTO_PFE_HIF_TX_BASE);
+	dev_emerg(&pdev->dev, "PFE:V419:TXP:OK\n");
+	if (upper_32_bits(pfe->tx_ring.desc_dma) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO, "TX base preflight lost quiescence\n");
+	/* The controlled V343 handoff installs stock_dma_a as the HIF-visible TX
+	 * ring.  It is intentionally distinct from tx_ring, whose records remain
+	 * host-only.  Observe the HIF base here; do not substitute either ring. */
+	if (readl(hif + COMCERTO_PFE_HIF_TX_BASE))
+		dev_emerg(&pdev->dev, "PFE:V422:TXB:INHERITED\n");
+	else
+		dev_emerg(&pdev->dev, "PFE:V422:TXB:ZERO\n");
+	dev_emerg(&pdev->dev, "PFE:V421:TXB:OK\n");
+	dev_emerg(&pdev->dev, "PFE:V424:A\n");
+	if (readl(hif + COMCERTO_PFE_HIF_TX_BASE) ==
+	    lower_32_bits(pfe->tx_ring.desc_dma)) {
+		dev_emerg(&pdev->dev, "PFE:V424:X\n");
+		return dev_err_probe(&pdev->dev, -EIO, "inherited TX base aliases private ring\n");
+	}
+	dev_emerg(&pdev->dev, "PFE:V424:F\n");
+	/* V426 extends the ownership boundary proof in time.  The V343-installed
+	 * HIF-visible descriptor chain must remain stable while the recovered
+	 * cores run with TX and all HIF interrupts disabled.  This remains
+	 * read-only: it neither adopts nor rewrites the descriptor base. */
+	hif_tx_base = readl(hif + COMCERTO_PFE_HIF_TX_BASE);
+	if (!hif_tx_base ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"foreign inherited TX base is not quiescent before stability window\n");
+	mdelay(100);
+	if (readl(hif + COMCERTO_PFE_HIF_TX_BASE) != hif_tx_base ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"foreign inherited TX base changed during stability window\n");
+	dev_emerg(&pdev->dev, "PFE:V426:S\n");
+	/* V428 establishes the exact ownership relation.  The HIF TX base must
+	 * be the V343 stock-compatible private DMA chain, not the separate
+	 * host-only tx_ring.  Validation reads the chain only; TX, IRQ and every
+	 * descriptor word remain untouched. */
+	if (hif_tx_base != lower_32_bits(pfe->stock_dma_a_addr)) {
+		dev_emerg(&pdev->dev, "PFE:V428:X\n");
+		return dev_err_probe(&pdev->dev, -EIO,
+			"HIF TX base does not match controlled stock DMA chain\n");
+	}
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->stock_dma_a, pfe->stock_dma_a_addr,
+		pfe->stock_dma_b, pfe->stock_dma_b_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"controlled HIF descriptor chain changed while TX was disabled\n");
+	dev_emerg(&pdev->dev, "PFE:V428:O\n");
+	/* V429 is the final read-only preflight before any future TX-control
+	 * experiment.  HIF owns the V343 ring, but every descriptor is idle and
+	 * both the engine and all interrupt sources remain masked. */
+	if (readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"TX activation preflight found an already active HIF boundary\n");
+	dev_emerg(&pdev->dev, "PFE:V429:P\n");
+	/* V430 separates the first stock TX engine write from the later stock
+	 * interrupt-mask write.  Every prepared descriptor is idle, no producer
+	 * (GPI/GEMAC/MDIO) is enabled, and the mask remains zero.  Bound the
+	 * engine-on interval and always quiesce it before returning an error. */
+	writel(COMCERTO_PFE_HIF_TX_CTRL_ENABLE,
+	       hif + COMCERTO_PFE_HIF_TX_CTRL);
+	wmb();
+	mdelay(100);
+	if (readl(hif + COMCERTO_PFE_HIF_TX_CTRL) !=
+	    COMCERTO_PFE_HIF_TX_CTRL_ENABLE ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE)) {
+		writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+		wmb();
+		return dev_err_probe(&pdev->dev, -EIO,
+			"isolated TX enable did not retain its no-IRQ contract\n");
+	}
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->stock_dma_a, pfe->stock_dma_a_addr,
+		pfe->stock_dma_b, pfe->stock_dma_b_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	wmb();
+	mdelay(100);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"idle descriptors changed during isolated TX enable window\n");
+	if (readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"isolated TX enable did not quiesce cleanly\n");
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->stock_dma_a, pfe->stock_dma_a_addr,
+		pfe->stock_dma_b, pfe->stock_dma_b_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"idle descriptors changed after isolated TX quiesce\n");
+	dev_emerg(&pdev->dev, "PFE:V430:O\n");
+	/* V432 diagnoses the host half of the HIF interrupt contract before any
+	 * interrupt source is ever unmasked.  Engines and masks stay zero; NAPI
+	 * is enabled only for the bounded observation, then disabled again. */
+	dev_emerg(&pdev->dev, "PFE:V432:B\n");
+	ret = devm_request_irq(&pdev->dev, pfe->hif_irq, comcerto_pfe_hif_irq,
+			       0, dev_name(&pdev->dev), pfe);
+	if (ret) {
+		dev_emerg(&pdev->dev, "PFE:V432:R=%d\n", ret);
+		return dev_err_probe(&pdev->dev, ret,
+			"could not bind isolated HIF IRQ before TX mask\n");
+	}
+	dev_emerg(&pdev->dev, "PFE:V432:I\n");
+	napi_enable(&pfe->napi);
+	mdelay(100);
+	napi_disable(&pfe->napi);
+	dev_emerg(&pdev->dev, "PFE:V432:N\n");
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE)) {
+		dev_emerg(&pdev->dev, "PFE:V432:H\n");
+		return dev_err_probe(&pdev->dev, -EIO,
+			"isolated HIF IRQ bind changed a disabled HIF state\n");
+	}
+	if (atomic_read(&pfe->hif_irq_seen) ||
+	    atomic_read(&pfe->hif_rx_irq_seen) ||
+	    atomic_read(&pfe->hif_napi_seen)) {
+		dev_emerg(&pdev->dev, "PFE:V432:E\n");
+		return dev_err_probe(&pdev->dev, -EIO,
+			"isolated HIF IRQ bind observed unexpected activity\n");
+	}
+	dev_emerg(&pdev->dev, "PFE:V432:O\n");
+	/* V433 is the first complete stock TX-control sequence, but with no
+	 * descriptor published and no GPI/GEMAC/MDIO producer.  The handler is
+	 * bound before the 0x11 TX mask becomes visible.  Both mask and engine
+	 * are explicitly cleared after the bounded observation. */
+	napi_enable(&pfe->napi);
+	writel(COMCERTO_PFE_HIF_TX_CTRL_ENABLE,
+	       hif + COMCERTO_PFE_HIF_TX_CTRL);
+	wmb();
+	writel(COMCERTO_PFE_HIF_TX_INT_ENABLE,
+	       hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	wmb();
+	mdelay(100);
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) !=
+	    COMCERTO_PFE_HIF_TX_CTRL_ENABLE ||
+	    (readl(hif + COMCERTO_PFE_HIF_INT_ENABLE) &
+	     COMCERTO_PFE_HIF_TX_INT_ENABLE) != COMCERTO_PFE_HIF_TX_INT_ENABLE) {
+		writel(0, hif + COMCERTO_PFE_HIF_INT_ENABLE);
+		writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+		wmb();
+		napi_disable(&pfe->napi);
+		return dev_err_probe(&pdev->dev, -EIO,
+			"stock TX control sequence did not retain its isolated contract\n");
+	}
+	writel(0, hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	wmb();
+	mdelay(100);
+	napi_disable(&pfe->napi);
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE) ||
+	    atomic_read(&pfe->hif_irq_seen) ||
+	    atomic_read(&pfe->hif_rx_irq_seen) ||
+	    atomic_read(&pfe->hif_napi_seen))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"stock TX control sequence did not quiesce without activity\n");
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->stock_dma_a, pfe->stock_dma_a_addr,
+		pfe->stock_dma_b, pfe->stock_dma_b_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"idle descriptors changed during stock TX control sequence\n");
+	dev_emerg(&pdev->dev, "PFE:V433:O\n");
+	/* V434's longer producer-free TX/IRQ soak has completed in a separate
+	 * hardware run.  V435 stalled before its completion, so V436 starts from
+	 * the independently proven, quiescent V433 handoff instead.  This is still
+	 * pre-publication only: the HIF TX engine and interrupt mask are zero. */
+	/* Put a separately allocated, known 64-byte payload address in descriptor
+	 * 0 while OWN remains clear, read it
+	 * back, then clear it again.  Thus the descriptor shape and DMA address
+	 * contract are proven without handing any work to hardware. */
+	tx_test_desc = pfe->stock_dma_a;
+	if (!pfe->tx_test_payload || upper_32_bits(pfe->tx_test_payload_dma) ||
+	    memchr_inv(pfe->tx_test_payload, 0x5a,
+		       COMCERTO_PFE_HIF_TX_TEST_BYTES) ||
+	    tx_test_desc->control || tx_test_desc->metadata ||
+	    tx_test_desc->data_addr ||
+	    tx_test_desc->next_addr != lower_32_bits(pfe->stock_dma_a_addr +
+						 sizeof(*tx_test_desc)))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"TX pre-publication descriptor or payload contract is invalid\n");
+	tx_test_desc->metadata = 0;
+	tx_test_desc->data_addr = lower_32_bits(pfe->tx_test_payload_dma);
+	dma_wmb();
+	if (tx_test_desc->control || tx_test_desc->metadata ||
+	    tx_test_desc->data_addr != lower_32_bits(pfe->tx_test_payload_dma)) {
+		tx_test_desc->metadata = 0;
+		tx_test_desc->data_addr = 0;
+		dma_wmb();
+		return dev_err_probe(&pdev->dev, -EIO,
+			"TX pre-publication descriptor did not retain an OWN-clear payload\n");
+	}
+	tx_test_desc->metadata = 0;
+	tx_test_desc->data_addr = 0;
+	dma_wmb();
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE))
+		return dev_err_probe(&pdev->dev, -EIO,
+			"TX pre-publication changed HIF control state\n");
+	ret = comcerto_pfe_hif_validate_prepared_descriptors(
+		pfe->stock_dma_a, pfe->stock_dma_a_addr,
+		pfe->stock_dma_b, pfe->stock_dma_b_addr, pfe->rx_ring.buffer_dma,
+		COMCERTO_PFE_HIF_STOCK_DESC_COUNT,
+		COMCERTO_PFE_HIF_RX_BUFFER_BYTES, &hif_fault);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"TX pre-publication did not restore the idle descriptor contract\n");
+	dev_emerg(&pdev->dev, "PFE:V436:P\n");
+	/* Keep the completed V437/V438 experiments in source for audit, but do not
+	 * replay their handoffs while isolating the next stock-order barrier delta. */
+	if (false) {
+	/* V437 publishes exactly descriptor 0 to the already-proven TX engine.
+	 * RX, GPI and the HIF interrupt mask stay off.  The order matches stock
+	 * __hif_xmit_pkt(): payload address first, OWN last.  After a bounded
+	 * observation window, disable TX unconditionally before reclaiming the
+	 * descriptor, whether the HIF cleared OWN or retained it. */
+	tx_test_desc->metadata = 0;
+	tx_test_desc->data_addr = lower_32_bits(pfe->tx_test_payload_dma);
+	dma_wmb();
+	WRITE_ONCE(tx_test_desc->control,
+		   COMCERTO_PFE_HIF_DESC_TX_CONTROL(COMCERTO_PFE_HIF_TX_TEST_BYTES));
+	dma_wmb();
