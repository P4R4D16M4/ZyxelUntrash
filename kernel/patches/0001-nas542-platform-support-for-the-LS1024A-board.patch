diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.c
new file mode 100644
index 000000000..b2c4fc2df
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pure PE-window metadata recovered from the stock module and GPL U-Boot. */
+#include <linux/errno.h>
+#include <linux/string.h>
+#include "comcerto-pfe-pe-layout.h"
+#include "comcerto-pfe-pe-regs.h"
+
+int comcerto_pfe_pe_layout(u8 id, struct comcerto_pfe_pe_layout *layout)
+{
+	if (!layout)
+		return -EINVAL;
+	memset(layout, 0, sizeof(*layout));
+	layout->id = id;
+
+	if (id <= 5) {
+		layout->kind = COMCERTO_PFE_PE_CLASS;
+		layout->dmem_base = id << 20;
+		layout->dmem_size = 0x2000;
+		layout->pmem_base = id << 20;
+		layout->pmem_size = 0x8000;
+		layout->cbus_offset = COMCERTO_PFE_CLASS_CBUS_OFFSET;
+		layout->mem_addr_offset = COMCERTO_PFE_CLASS_PE_MEM_ADDR;
+		layout->mem_wdata_offset = COMCERTO_PFE_CLASS_PE_MEM_WDATA;
+		layout->mem_rdata_offset = COMCERTO_PFE_CLASS_PE_MEM_RDATA;
+		return 0;
+	}
+	if (id == 6 || id == 7 || id == 9) {
+		layout->kind = COMCERTO_PFE_PE_TMU;
+		layout->dmem_base = (id - 6) << 20;
+		layout->dmem_size = 0x800;
+		layout->pmem_base = (id - 6) << 20;
+		layout->pmem_size = 0x2000;
+		layout->cbus_offset = COMCERTO_PFE_TMU_CBUS_OFFSET;
+		layout->mem_addr_offset = COMCERTO_PFE_TMU_PE_MEM_ADDR;
+		layout->mem_wdata_offset = COMCERTO_PFE_TMU_PE_MEM_WDATA;
+		layout->mem_rdata_offset = COMCERTO_PFE_TMU_PE_MEM_RDATA;
+		return 0;
+	}
+	if (id == 10) {
+		layout->kind = COMCERTO_PFE_PE_UTIL;
+		layout->dmem_size = 0x2000;
+		layout->cbus_offset = COMCERTO_PFE_UTIL_CBUS_OFFSET;
+		layout->mem_addr_offset = COMCERTO_PFE_UTIL_PE_MEM_ADDR;
+		layout->mem_wdata_offset = COMCERTO_PFE_UTIL_PE_MEM_WDATA;
+		layout->mem_rdata_offset = COMCERTO_PFE_UTIL_PE_MEM_RDATA;
+		return 0;
+	}
+	return -EINVAL;
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-layout.h
new file mode 100644
