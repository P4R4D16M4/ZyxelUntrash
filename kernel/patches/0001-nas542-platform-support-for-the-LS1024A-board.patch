+struct comcerto_pfe_port {
+	struct device *dev;
+	/* Host-only bridge active-list ownership.  No bridge interface, timer or
+	 * command processor is enabled merely by retaining these empty lists. */
+	struct comcerto_pfe_ctrl_bridge_lists bridge_lists;
+	struct comcerto_pfe_ctrl_bridge_caches bridge_caches;
+	/* Empty DMA pools match stock pfe_ctrl_init() geometry but have no blocks
+	 * checked out and no command/event consumer in this staging driver. */
+	struct comcerto_pfe_ctrl_dma_pools ctrl_pools;
+	struct comcerto_pfe_ctrl_bridge_interface
+		bridge_interfaces[COMCERTO_PFE_CTRL_BRIDGE_INTERFACE_COUNT];
+	/* Opaque host-side command ABI storage. It is kept empty: no function code
+	 * mapping, queueing or dispatch is present in this staging driver. */
+	struct comcerto_pfe_ctrl_command_record bridge_command_record;
+	struct comcerto_pfe_ctrl_async_command_state async_commands;
+	struct comcerto_pfe_ctrl_dispatch_state ctrl_dispatch;
+	/* Mirrors the stock synchronous command-path serialization only.  No
+	 * command may be queued or dispatched while this staging lock exists. */
+	struct mutex bridge_dispatch_lock;
+	/* Both stock bridge timers are represented, but neither is scheduled until
+	 * the FPP bridge command lifecycle has an explicit owner. */
+	struct timer_list bridge_delayed_removal_timer;
+	struct timer_list bridge_timer;
+	struct comcerto_pfe_hif_rx_ring rx_ring;
+	struct comcerto_pfe_hif_tx_ring tx_ring;
+	struct net_device *napi_dev;
+	struct napi_struct napi;
+	unsigned int rx_head;
+	/* The HIF RX base owns this stock-sized coherent descriptor region.  The
+	 * separately allocated rx_ring retains buffer ownership only. */
+	struct comcerto_pfe_hif_desc *hif_rx_desc;
+	void __iomem *hif;
+	int hif_irq;
+	atomic_t hif_irq_seen;
+	atomic_t hif_rx_irq_seen;
+	atomic_t hif_napi_seen;
+	atomic_t hif_rx_recycled;
+	u32 hif_last_irq_status;
+	u32 pe_sync_mailbox[11];
+	u16 pe_sync_valid;
+	bool hif_rx_enabled;
+	void *stock_dma_a, *stock_dma_b;
+	dma_addr_t stock_dma_a_addr, stock_dma_b_addr;
+	void *tx_test_payload;
+	dma_addr_t tx_test_payload_dma;
+	void *tx_test_payload_next;
+	dma_addr_t tx_test_payload_next_dma;
+	/* V574: PFE DDR aperture, needed to reload the PE firmware later. */
+	void __iomem *ddr;
+	phys_addr_t ddr_phys;
+	size_t ddr_size;
+};
