+#define V575_BB_RX_CONTROL(len)	(0x80100000u | ((len) & COMCERTO_PFE_HIF_DESC_LEN_MASK))
+
+struct pfe_expect { const char *name; resource_size_t start, size; bool exact; };
+#define COMCERTO_PFE_HIF_TX_TEST_BYTES	128
