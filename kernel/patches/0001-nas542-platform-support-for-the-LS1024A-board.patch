+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Cadence GEMAC register subset recovered from the NAS542 stock PFE module. */
+#ifndef COMCERTO_PFE_GEMAC_REGS_H
+#define COMCERTO_PFE_GEMAC_REGS_H
+
+#include <linux/bits.h>
+
+/* Stock pfe_eth_init() derives these from the 0x9c000000 AXI resource. */
+#define COMCERTO_PFE_GEMAC1_OFFSET		0x200000
+#define COMCERTO_PFE_GEMAC2_OFFSET		0x220000
+
+#define COMCERTO_PFE_GEMAC_ECNTRL		0x00
+#define COMCERTO_PFE_GEMAC_CONFIG		0x04
+#define COMCERTO_PFE_GEMAC_ECNTRL_MII		BIT(4)
+#define COMCERTO_PFE_GEMAC_MII_STATUS		0x08
+#define COMCERTO_PFE_GEMAC_MII_DONE		BIT(2)
+#define COMCERTO_PFE_GEMAC_MII_COMMAND		0x34
+#define COMCERTO_PFE_GEMAC_MAC_ADDR0		0x88
+#define COMCERTO_PFE_GEMAC_MAC_ADDR_COUNT	8
+#define COMCERTO_PFE_GEMAC_MII_DIV_MASK	GENMASK(20, 18)
+
+/* Exact values selected by stock gemac_set_mdc_div(). */
+#define COMCERTO_PFE_GEMAC_MDC_DIV_8		0x000000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_16		0x040000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_32		0x080000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_48		0x0c0000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_96		0x140000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_128	0x180000
+#define COMCERTO_PFE_GEMAC_MDC_DIV_224	0x1c0000
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-gemac.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-gemac.c
new file mode 100644
index 000000000..3197d2ff3
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-gemac.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Minimal GEMAC primitives recovered from NAS542 stock pfe.ko. */
+#include <linux/io.h>
+
+#include "comcerto-pfe-gemac-regs.h"
+#include "comcerto-pfe-gemac.h"
+
+#define COMCERTO_PFE_GEMAC_ECNTRL_RX_TX_EN	0x0c
+
+void comcerto_pfe_gemac_enable(void __iomem *base)
+{
+	if (base)
+		writel(readl(base + COMCERTO_PFE_GEMAC_ECNTRL) |
+		       COMCERTO_PFE_GEMAC_ECNTRL_RX_TX_EN,
+		       base + COMCERTO_PFE_GEMAC_ECNTRL);
+}
+
+void comcerto_pfe_gemac_disable(void __iomem *base)
+{
+	if (base)
+		writel(readl(base + COMCERTO_PFE_GEMAC_ECNTRL) &
+		       ~COMCERTO_PFE_GEMAC_ECNTRL_RX_TX_EN,
+		       base + COMCERTO_PFE_GEMAC_ECNTRL);
+}
+
+void comcerto_pfe_gemac_set_addresses(void __iomem *base, const u32 *address)
+{
+	unsigned int i;
+
+	if (!base || !address)
+		return;
+
+	/* gemac_set_address(): eight consecutive 32-bit address words. */
+	for (i = 0; i < COMCERTO_PFE_GEMAC_MAC_ADDR_COUNT; i++)
+		writel(address[i], base + COMCERTO_PFE_GEMAC_MAC_ADDR0 +
+		       i * sizeof(*address));
+}
