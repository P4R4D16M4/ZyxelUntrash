diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-command.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-command.c
new file mode 100644
index 000000000..16c670893
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-pe-command.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pure indirect-memory command construction; deliberately no MMIO here. */
+#include <linux/errno.h>
+#include "comcerto-pfe-pe-command.h"
+#include "comcerto-pfe-pe-regs.h"
+
+int comcerto_pfe_pe_command(const struct comcerto_pfe_pe_layout *layout,
+		enum comcerto_pfe_pe_memory memory, u32 destination,
+		u32 byte_offset, u8 byte_count, u32 *command)
+{
+	u32 address, base, size, flag, aperture_start, lane;
+
+	if (!layout || !command || !byte_count || byte_count > 4)
+		return -EINVAL;
+	if (memory == COMCERTO_PFE_PE_DMEM) {
+		base = layout->dmem_base;
+		size = layout->dmem_size;
+		flag = COMCERTO_PFE_PE_MEM_DMEM;
+		aperture_start = 0;
+	} else if (memory == COMCERTO_PFE_PE_PMEM) {
+		base = layout->pmem_base;
+		size = layout->pmem_size;
+		flag = COMCERTO_PFE_PE_MEM_IMEM;
+		aperture_start = 0x10000;
+	} else {
+		return -EINVAL;
+	}
+	if (!size || destination < aperture_start ||
+	    destination - aperture_start >= size ||
+	    byte_offset > size - (destination - aperture_start))
+		return -ERANGE;
+	address = destination - aperture_start + byte_offset;
+	lane = address & 3;
+	if (byte_count > size - address || byte_count > 4 - lane)
+		return -ERANGE;
+	if (memory == COMCERTO_PFE_PE_PMEM)
+		address &= size - 1;
+	*command = base | (address & ~3U) | flag | COMCERTO_PFE_PE_MEM_WRITE |
+		COMCERTO_PFE_PE_MEM_BYTE_ENABLE(lane, byte_count);
+	return 0;
+}
+
+int comcerto_pfe_pe_read_command(const struct comcerto_pfe_pe_layout *layout,
+		enum comcerto_pfe_pe_memory memory, u32 destination,
+		u32 byte_offset, u8 byte_count, u32 *command)
+{
+	int ret;
+
+	ret = comcerto_pfe_pe_command(layout, memory, destination, byte_offset,
+				  byte_count, command);
+	if (!ret)
+		*command &= ~COMCERTO_PFE_PE_MEM_WRITE;
+	return ret;
+}
