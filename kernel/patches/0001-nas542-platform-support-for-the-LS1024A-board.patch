+int comcerto_pfe_ctrl_validate_bridge_interface_lifecycle(void)
+{
+	struct comcerto_pfe_ctrl_bridge_interface
+		interfaces[COMCERTO_PFE_CTRL_BRIDGE_INTERFACE_COUNT];
+	struct comcerto_pfe_ctrl_bridge_interface *interface;
+	const u16 onif_index = 2;
