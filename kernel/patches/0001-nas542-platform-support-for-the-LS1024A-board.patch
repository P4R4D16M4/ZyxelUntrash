+int comcerto_pfe_ctrl_validate_async_command_allocation(void)
+{
+	struct comcerto_pfe_ctrl_async_command_request *request;
+	int ret = 0;
+
+	/* Exercise ownership of the zero-payload allocation boundary only.  This
+	 * request never reaches a queue, work item, dispatcher or callback. */
+	request = kzalloc(COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES,
+			  GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&request->node);
+	request->payload_pointer = (u32)(unsigned long)request +
+		COMCERTO_PFE_CTRL_ASYNC_COMMAND_HEADER_BYTES;
+	if (request->payload_length || request->completion_callback ||
+	    request->completion_context || request->fcode ||
+	    !list_empty(&request->node) ||
+	    request->payload_pointer != (u32)(unsigned long)(request + 1))
+		ret = -EINVAL;
+	kfree(request);
+	return ret;
+}
