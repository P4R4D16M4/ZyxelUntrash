+		struct comcerto_pfe_ctrl_dma_pools *pools);
+int comcerto_pfe_ctrl_validate_dma_pools(
+		const struct comcerto_pfe_ctrl_dma_pools *pools);
+/* Takes one block from each empty pool only to verify the DMA allocation
+ * envelope, then returns both blocks.  It never writes a command record or
+ * exposes either address to PFE hardware. */
+int comcerto_pfe_ctrl_probe_dma_pools(
+		struct comcerto_pfe_ctrl_dma_pools *pools);
+void comcerto_pfe_ctrl_destroy_dma_pools(
+		struct comcerto_pfe_ctrl_dma_pools *pools);
+
+/* Complete stock pe_sync_stop()/pe_start() transaction.  It is intentionally
+ * separate from probe: callers must have already recovered the full consumer
+ * lifecycle and explicitly choose when a PE may be paused. */
+int comcerto_pfe_ctrl_sync_stop(void __iomem *axi, const u32 *mailboxes,
+				u16 pe_mask);
+int comcerto_pfe_ctrl_sync_start(void __iomem *axi, const u32 *mailboxes,
+				 u16 pe_mask);
+
+#endif /* COMCERTO_PFE_CTRL_CONTRACT_H */
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.c
new file mode 100644
index 000000000..b1f12f326
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.c
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Offline-safe firmware parser for the preserved Comcerto PFE ELF contract. */
+#include <linux/elf.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include "comcerto-pfe-fw-elf.h"
+
+#define EM_COMCERTO_PE 111
+
+static bool pfe_range_valid(size_t offset, size_t length, size_t total)
+{
+	return offset <= total && length <= total - offset;
+}
+
+static int pfe_section_domain(const char *name, enum comcerto_pfe_fw_domain *domain)
+{
+	if (!strncmp(name, ".dmem_", 6) || !strcmp(name, ".config"))
+		*domain = COMCERTO_PFE_FW_DMEM;
+	else if (!strcmp(name, ".pmem"))
+		*domain = COMCERTO_PFE_FW_PMEM;
+	else if (!strcmp(name, ".vector"))
+		/* The stock range check routes vector addresses (0 or 0x1f80)
+		 * through the PE DMEM aperture, not the PMEM aperture. */
+		*domain = COMCERTO_PFE_FW_DMEM;
+	else if (!strncmp(name, ".ddr_", 5))
+		*domain = COMCERTO_PFE_FW_DDR;
+	else if (!strncmp(name, ".pe_lmem_", 9))
+		*domain = COMCERTO_PFE_FW_PE_LMEM;
+	else if (!strncmp(name, ".lmem_", 6))
+		*domain = COMCERTO_PFE_FW_PFE_LMEM;
+	else
+		return -ENOEXEC;
+
+	return 0;
+}
+
+static bool pfe_address_range_valid(u32 address, u32 size, u32 base, u32 length)
+{
+	return address >= base && size <= length && address - base <= length - size;
+}
+
+static int pfe_validate_section_contract(enum comcerto_pfe_fw_domain domain,
+					 unsigned long source, u32 destination,
+					 u32 size, bool zero_fill)
+{
+	switch (domain) {
+	case COMCERTO_PFE_FW_DMEM:
+		if (!pfe_address_range_valid(destination, size, 0, 0x2000) ||
+		    (!zero_fill && (source & 3) != (destination & 3)) ||
+		    (destination & 3))
+			return -ENOEXEC;
+		break;
+	case COMCERTO_PFE_FW_PMEM:
+		if (!pfe_address_range_valid(destination, size, 0x10000, 0x8000) ||
+		    (!zero_fill && (source & 3) != (destination & 3)) ||
+		    (destination & 1) ||
+		    (size & 1))
+			return -ENOEXEC;
+		break;
+	case COMCERTO_PFE_FW_DDR:
+		if (!pfe_address_range_valid(destination, size, 0x03400000,
+					     0x00c00000))
+			return -ENOEXEC;
+		break;
+	case COMCERTO_PFE_FW_PE_LMEM:
+		if (!pfe_address_range_valid(destination, size, 0xc3010000,
+					     0x00008000) ||
+		    (!zero_fill && (source & 3) != (destination & 3)) ||
+		    (destination & 3))
+			return -ENOEXEC;
+		break;
+	case COMCERTO_PFE_FW_PFE_LMEM:
+		/* The original loader explicitly leaves this range untouched. */
+		if (!pfe_address_range_valid(destination, size, 0xc0300000,
+					     0x00010000))
+			return -ENOEXEC;
+		break;
+	}
+	return 0;
+}
+
+static int pfe_validate_firmware_elf(const u8 *data, size_t size,
+				     struct comcerto_pfe_fw_layout *layout,
+				     bool relaxed)
+{
+	const Elf32_Ehdr *ehdr;
+	const Elf32_Shdr *shdr;
+	const char *names;
+	u32 shoff, shstrndx;
+	u16 shnum, shentsize;
+	unsigned int i;
+
+	if (!data || !layout || size < sizeof(*ehdr))
+		return -EINVAL;
+	ehdr = (const Elf32_Ehdr *)data;
+	if (memcmp(ehdr->e_ident, ELFMAG, SELFMAG) ||
+	    ehdr->e_ident[EI_CLASS] != ELFCLASS32 ||
+	    ehdr->e_ident[EI_DATA] != ELFDATA2MSB ||
+	    be16_to_cpu(ehdr->e_type) != ET_EXEC ||
+	    be16_to_cpu(ehdr->e_machine) != EM_COMCERTO_PE)
+		return -ENOEXEC;
+
+	shoff = be32_to_cpu(ehdr->e_shoff);
+	shnum = be16_to_cpu(ehdr->e_shnum);
+	shentsize = be16_to_cpu(ehdr->e_shentsize);
+	shstrndx = be16_to_cpu(ehdr->e_shstrndx);
+	if (!shnum || shentsize != sizeof(*shdr) || shstrndx >= shnum ||
+	    !pfe_range_valid(shoff, (size_t)shnum * sizeof(*shdr), size))
+		return -ENOEXEC;
+
+	shdr = (const Elf32_Shdr *)(data + shoff);
+	if (!pfe_range_valid(be32_to_cpu(shdr[shstrndx].sh_offset),
+			     be32_to_cpu(shdr[shstrndx].sh_size), size))
+		return -ENOEXEC;
+	names = (const char *)data + be32_to_cpu(shdr[shstrndx].sh_offset);
+	memset(layout, 0, sizeof(*layout));
+	layout->section_count = shnum;
+
+	for (i = 0; i < shnum; i++) {
+		u32 offset = be32_to_cpu(shdr[i].sh_offset);
+		u32 section_size = be32_to_cpu(shdr[i].sh_size);
+		u32 name = be32_to_cpu(shdr[i].sh_name);
+		u32 flags = be32_to_cpu(shdr[i].sh_flags);
+		u32 type = be32_to_cpu(shdr[i].sh_type);
+		const char *section;
+		struct comcerto_pfe_fw_section *load;
+		enum comcerto_pfe_fw_domain domain;
+
+		if (name >= be32_to_cpu(shdr[shstrndx].sh_size))
+			return -ENOEXEC;
+		if (be32_to_cpu(shdr[i].sh_type) != SHT_NOBITS &&
+		    !pfe_range_valid(offset, section_size, size))
+			return -ENOEXEC;
+		section = names + name;
+		if (!(flags & SHF_ALLOC))
+			continue;
+		if (type != SHT_PROGBITS && type != SHT_NOBITS)
+			return -ENOEXEC;
+		if (pfe_section_domain(section, &domain)) {
+			/* V574: Barebox' embedded util image carries a
+			 * "fast_path" DDR code section without a dot prefix;
+			 * the relaxed (Barebox) contract classifies by address. */
+			u32 addr = be32_to_cpu(shdr[i].sh_addr);
+
+			if (!relaxed || !pfe_address_range_valid(addr, section_size,
+								 0x03400000, 0x00c00000))
+				return -ENOEXEC;
+			domain = COMCERTO_PFE_FW_DDR;
+		}
+		if (layout->load_count == COMCERTO_PFE_MAX_FW_SECTIONS)
+			return -ENOEXEC;
+		/* Stock pe_load_pmem_section() accepts file-backed code only. */
+		if (domain == COMCERTO_PFE_FW_PMEM && type != SHT_PROGBITS)
+			return -ENOEXEC;
+
+		load = &layout->load[layout->load_count++];
+		load->destination = be32_to_cpu(shdr[i].sh_addr);
+		load->source_offset = offset;
+		load->size = section_size;
+		load->domain = domain;
+		load->zero_fill = type == SHT_NOBITS;
+		/* PFE LMEM is firmware-visible state; stock loader deliberately
+		 * leaves it untouched rather than transferring an ELF section. */
+		load->skip = domain == COMCERTO_PFE_FW_PFE_LMEM;
+		/* Stock pfe_ctrl_init() translates control objects from .dmem_sh;
+		 * a PE reset vector contains executable firmware, not a mailbox. */
+		load->dmem_shared = !strcmp(section, ".dmem_sh");
+		if (pfe_validate_section_contract(domain,
+				type == SHT_NOBITS ? 0 : (unsigned long)(data + offset),
+				load->destination, load->size, load->zero_fill))
+			return -ENOEXEC;
+		if (!strcmp(section, ".dmem_sh"))
+			layout->has_dmem = true;
+		else if (domain == COMCERTO_PFE_FW_PE_LMEM)
+			layout->has_pe_lmem = true;
+		else if (domain == COMCERTO_PFE_FW_DDR)
+			layout->has_ddr = true;
+	}
+	/* Barebox' class/tmu images have no .dmem_sh (no host control area). */
+	return (layout->has_dmem || relaxed) ? 0 : -ENOEXEC;
+}
+
+int comcerto_pfe_validate_firmware_elf(const u8 *data, size_t size,
+				      struct comcerto_pfe_fw_layout *layout)
+{
+	return pfe_validate_firmware_elf(data, size, layout, false);
+}
+
+/* V574: same section contract, for the PE images embedded in Barebox. */
+int comcerto_pfe_validate_firmware_elf_relaxed(const u8 *data, size_t size,
+					       struct comcerto_pfe_fw_layout *layout)
+{
+	return pfe_validate_firmware_elf(data, size, layout, true);
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.h
new file mode 100644
index 000000000..73ba04cad
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-elf.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef COMCERTO_PFE_FW_ELF_H
+#define COMCERTO_PFE_FW_ELF_H
+
+#include <linux/types.h>
+
+#define COMCERTO_PFE_MAX_FW_SECTIONS 32
+
+enum comcerto_pfe_fw_domain {
+	COMCERTO_PFE_FW_DMEM,
+	COMCERTO_PFE_FW_PMEM,
+	COMCERTO_PFE_FW_DDR,
+	COMCERTO_PFE_FW_PE_LMEM,
+	COMCERTO_PFE_FW_PFE_LMEM,
+};
+
+struct comcerto_pfe_fw_section {
+	u32 destination;
+	u32 source_offset;
+	u32 size;
+	u8 domain;
+	bool zero_fill;
+	bool skip;
+	/* Host-visible control objects are located relative to this section. */
+	bool dmem_shared;
+};
+
+struct comcerto_pfe_fw_layout {
+	u16 section_count;
+	u16 load_count;
+	bool has_dmem;
+	bool has_pe_lmem;
+	bool has_ddr;
+	struct comcerto_pfe_fw_section load[COMCERTO_PFE_MAX_FW_SECTIONS];
+};
+
+int comcerto_pfe_validate_firmware_elf(const u8 *data, size_t size,
+				      struct comcerto_pfe_fw_layout *layout);
+int comcerto_pfe_validate_firmware_elf_relaxed(const u8 *data, size_t size,
+					       struct comcerto_pfe_fw_layout *layout);
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.c
new file mode 100644
index 000000000..85bc98af5
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Firmware transfer recovered from stock pfe_load_elf()/pe_load_elf_section(). */
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+#include "comcerto-pfe-class-bus-regs.h"
+#include "comcerto-pfe-fw-elf.h"
+#include "comcerto-pfe-fw-load.h"
+#include "comcerto-pfe-pe-command.h"
+#include "comcerto-pfe-pe-layout.h"
+
+static void pfe_pe_write(void __iomem *axi,
+			 const struct comcerto_pfe_pe_layout *pe, u32 command, u32 value)
+{
+	/* Stock pe_mem_memcpy_to32 writes big-endian data before the command. */
+	writel(cpu_to_be32(value), axi + pe->cbus_offset + pe->mem_wdata_offset);
+	writel(command, axi + pe->cbus_offset + pe->mem_addr_offset);
+}
+
+static int pfe_pe_copy(void __iomem *axi, const struct comcerto_pfe_pe_layout *pe,
+		       enum comcerto_pfe_pe_memory memory, u32 destination,
+		       const u8 *source, u32 length, bool zero)
+{
+	u32 offset = 0;
+
+	while (offset < length) {
+		u32 value = 0, command;
+		u32 address = destination + offset;
+		u8 lane = address & 3;
+		u8 count = min_t(u32, 4 - lane, length - offset);
+		int ret;
+
+		if (!zero) {
+			if (count == 4)
+				value = get_unaligned_le32(source + offset);
+			else
+				memcpy(&value, source + offset, count);
+		}
+		/* Match stock pe_dmem_write(): position bytes in their target lane. */
+		value <<= lane * 8;
+		ret = comcerto_pfe_pe_command(pe, memory, destination, offset,
+					      count, &command);
+		if (ret)
+			return ret;
+		pfe_pe_write(axi, pe, command, value);
+		offset += count;
+	}
+	return 0;
+}
+
+static void pfe_class_lmem_write(void __iomem *axi, u32 address, u32 value,
+				 u8 count)
+{
+	void __iomem *cbus = axi + COMCERTO_PFE_CLASS_CBUS_OFFSET;
+
+	/* Exact class_bus_write contract used by stock PE-LMEM loading. */
+	writel(address & COMCERTO_PFE_CLASS_ADDR_HIGH8_MASK,
+		cbus + COMCERTO_PFE_CLASS_MEM_ACCESS_ADDR_EXT);
+	writel(cpu_to_be32(value), cbus + COMCERTO_PFE_CLASS_MEM_ACCESS_WDATA);
+	writel((address & COMCERTO_PFE_CLASS_ADDR_LOW24_MASK) | (count << 24),
+		cbus + COMCERTO_PFE_CLASS_MEM_ACCESS_CMD);
+}
+
+static int pfe_load_section(struct device *dev, void __iomem *axi, void __iomem *ddr,
+			    const struct comcerto_pfe_fw_section *section,
+			    const u8 *data, enum comcerto_pfe_fw_image image)
+{
+	u16 targets = comcerto_pfe_fw_target_mask(image);
+	u32 offset;
+	int id;
+
+	if (section->skip)
+		return 0;
+	if (section->domain == COMCERTO_PFE_FW_DDR) {
+		if (section->zero_fill)
+			memset_io(ddr + section->destination - 0x03400000, 0, section->size);
+		else
+			memcpy_toio(ddr + section->destination - 0x03400000,
+				    data + section->source_offset, section->size);
+		return 0;
+	}
+	if (section->domain == COMCERTO_PFE_FW_PE_LMEM) {
+		if (image != COMCERTO_PFE_FW_CLASS)
+			return -EINVAL;
+		for (offset = 0; offset < section->size; offset += min_t(u32, 4, section->size - offset)) {
+			u8 count = min_t(u32, 4, section->size - offset);
+			u32 value = 0;
+			if (!section->zero_fill)
+				memcpy(&value, data + section->source_offset + offset, count);
+			pfe_class_lmem_write(axi, section->destination + offset, value, count);
+		}
+		return 0;
+	}
+	for (id = 0; id <= 10; id++) {
+		struct comcerto_pfe_pe_layout pe;
+		int ret;
+
+		if (!(targets & BIT(id)))
+			continue;
+		ret = comcerto_pfe_pe_layout(id, &pe);
+		if (ret)
+			return ret;
+		ret = pfe_pe_copy(axi, &pe,
+			section->domain == COMCERTO_PFE_FW_DMEM ? COMCERTO_PFE_PE_DMEM : COMCERTO_PFE_PE_PMEM,
+			section->destination, data + section->source_offset,
+			section->size, section->zero_fill);
+		if (ret)
+			return ret;
+	}
+	dev_dbg(dev, "PFE firmware section %#x/%#x transferred\n",
+		section->destination, section->size);
+	return 0;
+}
+
+static int pfe_load_firmware(struct device *dev, void __iomem *axi, void __iomem *ddr,
+			     enum comcerto_pfe_fw_image image, const u8 *data, size_t size,
+			     bool relaxed)
+{
+	struct comcerto_pfe_fw_layout layout;
+	unsigned int i;
+	int ret;
+
+	if (!dev || !axi || !ddr)
+		return -EINVAL;
+	ret = relaxed ? comcerto_pfe_validate_firmware_elf_relaxed(data, size, &layout) :
+			comcerto_pfe_validate_firmware_elf(data, size, &layout);
+	if (ret)
+		return ret;
+	for (i = 0; i < layout.load_count; i++) {
+		ret = pfe_load_section(dev, axi, ddr, &layout.load[i], data, image);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int comcerto_pfe_load_firmware(struct device *dev, void __iomem *axi, void __iomem *ddr,
+			       enum comcerto_pfe_fw_image image, const u8 *data, size_t size)
+{
+	return pfe_load_firmware(dev, axi, ddr, image, data, size, false);
+}
+
+/* V574: load one of the PE images embedded in Barebox (relaxed contract). */
+int comcerto_pfe_load_firmware_barebox(struct device *dev, void __iomem *axi,
+				       void __iomem *ddr, enum comcerto_pfe_fw_image image,
+				       const u8 *data, size_t size)
+{
+	return pfe_load_firmware(dev, axi, ddr, image, data, size, true);
+}
+
+int comcerto_pfe_firmware_dmem_shared_word(const u8 *data, size_t size,
+					  u32 section_offset, u32 *word)
+{
+	struct comcerto_pfe_fw_layout layout;
+	unsigned int i;
+	int ret;
+
+	if (!data || !word)
+		return -EINVAL;
+	ret = comcerto_pfe_validate_firmware_elf(data, size, &layout);
+	if (ret)
+		return ret;
+	for (i = 0; i < layout.load_count; i++) {
+		const struct comcerto_pfe_fw_section *section = &layout.load[i];
+
+		if (!section->dmem_shared ||
+		    section->domain != COMCERTO_PFE_FW_DMEM ||
+		    section_offset > section->size ||
+		    sizeof(*word) > section->size - section_offset)
+			continue;
+		*word = section->destination + section_offset;
+		return 0;
+	}
+	return -ENOENT;
+}
+
+int comcerto_pfe_write_dmem_byte(void __iomem *axi, u8 pe_id, u32 offset,
+				 u8 value)
+{
+	struct comcerto_pfe_pe_layout pe;
+	u32 command;
+	int ret;
+
+	if (!axi)
+		return -EINVAL;
+	ret = comcerto_pfe_pe_layout(pe_id, &pe);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_pe_command(&pe, COMCERTO_PFE_PE_DMEM, offset,
+				     0, 1, &command);
+	if (ret)
+		return ret;
+	/* The byte-enable names the destination address lane; WDATA is a
+	 * big-endian word at the indirect port.  V459 (lane 0) and V461 (lane 1)
+	 * establish the inverse byte position used here. */
+	pfe_pe_write(axi, &pe, command, (u32)value << ((3 - (offset & 3)) * 8));
+	return 0;
+}
+
+int comcerto_pfe_write_dmem_word(void __iomem *axi, u8 pe_id, u32 offset,
+				 u32 value)
+{
+	struct comcerto_pfe_pe_layout pe;
+	int ret;
+
+	if (!axi)
+		return -EINVAL;
+	ret = comcerto_pfe_pe_layout(pe_id, &pe);
+	if (ret)
+		return ret;
+	return pfe_pe_copy(axi, &pe, COMCERTO_PFE_PE_DMEM, offset,
+			   (const u8 *)&value, sizeof(value), false);
+}
+
+int comcerto_pfe_read_dmem_word(void __iomem *axi, u8 pe_id, u32 offset,
+				 u32 *value)
+{
+	struct comcerto_pfe_pe_layout pe;
+	u32 command;
+	int ret;
+
+	if (!axi || !value)
+		return -EINVAL;
+	ret = comcerto_pfe_pe_layout(pe_id, &pe);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_pe_read_command(&pe, COMCERTO_PFE_PE_DMEM, offset,
+					 0, sizeof(*value), &command);
+	if (ret)
+		return ret;
+	writel(command, axi + pe.cbus_offset + pe.mem_addr_offset);
+	*value = be32_to_cpu(readl(axi + pe.cbus_offset + pe.mem_rdata_offset));
+	return 0;
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.h
new file mode 100644
index 000000000..ab9d54cab
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-load.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef COMCERTO_PFE_FW_LOAD_H
+#define COMCERTO_PFE_FW_LOAD_H
+
+#include <linux/types.h>
+#include <linux/io.h>
+#include "comcerto-pfe-fw-targets.h"
+
+struct device;
+
+int comcerto_pfe_load_firmware(struct device *dev, void __iomem *axi,
+			       void __iomem *ddr,
+			       enum comcerto_pfe_fw_image image,
+			       const u8 *data, size_t size);
+int comcerto_pfe_load_firmware_barebox(struct device *dev, void __iomem *axi,
+				       void __iomem *ddr, enum comcerto_pfe_fw_image image,
+				       const u8 *data, size_t size);
+/* Stock-order single-byte DMEM write; caller owns PE stop/start lifecycle. */
+int comcerto_pfe_write_dmem_byte(void __iomem *axi, u8 pe_id, u32 offset,
+				 u8 value);
+int comcerto_pfe_write_dmem_word(void __iomem *axi, u8 pe_id, u32 offset,
+				 u32 value);
+int comcerto_pfe_read_dmem_word(void __iomem *axi, u8 pe_id, u32 offset,
+				 u32 *value);
+int comcerto_pfe_firmware_dmem_shared_word(const u8 *data, size_t size,
+					  u32 section_offset, u32 *word);
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-targets.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-targets.c
new file mode 100644
index 000000000..475ebb07d
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-fw-targets.c
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Offline-only target selection recovered from stock pfe_load_elf(). */
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include "comcerto-pfe-fw-targets.h"
+
+u16 comcerto_pfe_fw_target_mask(enum comcerto_pfe_fw_image image)
+{
+	switch (image) {
+	case COMCERTO_PFE_FW_CLASS:
+		return GENMASK(5, 0);
+	case COMCERTO_PFE_FW_TMU:
+		return BIT(6) | BIT(7) | BIT(9);
+	case COMCERTO_PFE_FW_UTIL:
+		return BIT(10);
+	default:
+		return 0;
+	}
+}
