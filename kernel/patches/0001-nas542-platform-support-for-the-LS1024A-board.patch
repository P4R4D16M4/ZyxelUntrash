diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-regs.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-regs.h
new file mode 100644
index 000000000..5be485e3a
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-regs.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Recovered from stock hif_init()/hif_{rx,tx}_enable(); no write helpers here. */
+#ifndef COMCERTO_PFE_HIF_REGS_H
+#define COMCERTO_PFE_HIF_REGS_H
+
+#include <linux/bits.h>
+#include <linux/types.h>
+#include <linux/stddef.h>
+
+#define COMCERTO_PFE_HIF_OFFSET		0x00280000
+#define COMCERTO_PFE_HIF_RX_BASE		0x10
+#define COMCERTO_PFE_HIF_RX_CTRL		0x20
+#define COMCERTO_PFE_HIF_TX_BASE		0x24
+#define COMCERTO_PFE_HIF_TX_CTRL		0x04
+#define COMCERTO_PFE_HIF_INT_ENABLE		0x38
+#define COMCERTO_PFE_HIF_INT_STATUS		0x34
+#define COMCERTO_PFE_HIF_VERSION		0x3c
+
+#define COMCERTO_PFE_HIF_VERSION_INIT		0x04000400
+#define COMCERTO_PFE_HIF_RX_CTRL_ENABLE	0x00000005
+#define COMCERTO_PFE_HIF_TX_CTRL_ENABLE	0x00000001
+/* Stock hif_xmit_pkt() writes this to HIF_TX_CTRL after publishing a packet.
+ * Bit 0 remains the active state; bit 2 is the producer re-arm request. */
+#define COMCERTO_PFE_HIF_TX_CTRL_KICK		0x00000005
+#define COMCERTO_PFE_HIF_RX_INT_ENABLE		0x00000005
+#define COMCERTO_PFE_HIF_TX_INT_ENABLE		0x00000011
+
+#define COMCERTO_PFE_HIF_DESC_BYTES		16
+/* Barebox's inherited live rings are 64 entries; the stock Linux driver
+ * allocates 256 entries per newly owned ring.  The 64-entry value below is
+ * therefore an observation-safe staging limit, not an activation contract. */
+#define COMCERTO_PFE_HIF_RX_DESC_COUNT		64
+#define COMCERTO_PFE_HIF_STOCK_DESC_COUNT		256
+#define COMCERTO_PFE_HIF_RX_BUFFER_BYTES	2048
+#define COMCERTO_PFE_HIF_NAPI_WEIGHT		64
+/* Stock Linux pfe_hif_init() allocates distinct coherent TX and RX regions of
+ * this size. Barebox's live PFE-DDR rings are observed only, never adopted. */
+#define COMCERTO_PFE_HIF_STOCK_COHERENT_BYTES	0x9000
+
+/*
+ * Stock pfe_hif_init() gives every RX descriptor to the HIF with:
+ *
+ *   control = BIT(31) | 0x00160000 | (packet_size & 0x3fff)
+ *   metadata = 0
+ *   data_addr = DMA address of the receive buffer
+ *   next_addr = DMA address of the next descriptor
+ *
+ * The last descriptor points back to the first.  These values are only a
+ * recovered wire contract; the staged driver deliberately does not program
+ * an RX_BASE register or enable HIF DMA until buffer recycling, NAPI and the
+ * HIF IRQ path are all present.
+ */
+#define COMCERTO_PFE_HIF_DESC_OWN			BIT(31)
+#define COMCERTO_PFE_HIF_DESC_RX			0x00160000
+#define COMCERTO_PFE_HIF_DESC_LEN_MASK		GENMASK(13, 0)
+#define COMCERTO_PFE_HIF_DESC_RX_CONTROL(len) \
+	(COMCERTO_PFE_HIF_DESC_OWN | COMCERTO_PFE_HIF_DESC_RX | \
+	 ((len) & COMCERTO_PFE_HIF_DESC_LEN_MASK))
+
+/* __hif_xmit_pkt() basic (non-TSO, non-checksum-offload) descriptor form. */
+#define COMCERTO_PFE_HIF_DESC_TX_CONTROL(len) \
+	(COMCERTO_PFE_HIF_DESC_OWN | ((len) & COMCERTO_PFE_HIF_DESC_LEN_MASK))
+/* Stock hif_xmit_pkt() passes flags 3 to __hif_xmit_pkt().  Its producer
+ * publishes the normal host TX descriptor with bit 18 set (the 0x203c OR),
+ * in addition to OWN and the low 14-bit length. */
+#define COMCERTO_PFE_HIF_DESC_TX_CONTROL_HOST(len) \
+	(COMCERTO_PFE_HIF_DESC_TX_CONTROL(len) | 0x00040000)
+
+/* The stock ISR gates on status bit 0 and schedules NAPI for bit 2. */
+#define COMCERTO_PFE_HIF_INT_GATE		0x00000001
+#define COMCERTO_PFE_HIF_INT_RX		0x00000004
+
+/* Exact 16-byte descriptor layout observed in pfe_hif_init()/desc_dump(). */
+struct comcerto_pfe_hif_desc {
+	u32 control;
+	u32 metadata;
+	u32 data_addr;
+	u32 next_addr;
+};
+
+static_assert(sizeof(struct comcerto_pfe_hif_desc) == COMCERTO_PFE_HIF_DESC_BYTES);
+static_assert(COMCERTO_PFE_HIF_STOCK_DESC_COUNT * COMCERTO_PFE_HIF_DESC_BYTES <=
+	      COMCERTO_PFE_HIF_STOCK_COHERENT_BYTES);
+static_assert(offsetof(struct comcerto_pfe_hif_desc, control) == 0);
+static_assert(offsetof(struct comcerto_pfe_hif_desc, metadata) == 4);
+static_assert(offsetof(struct comcerto_pfe_hif_desc, data_addr) == 8);
+static_assert(offsetof(struct comcerto_pfe_hif_desc, next_addr) == 12);
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.c
new file mode 100644
index 000000000..e64983423
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.c
@@ -0,0 +1,773 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/dma-mapping.h>
+#include <linux/bitmap.h>
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+
+#include "comcerto-pfe-hif-ring.h"
+
+static bool comcerto_pfe_hif_stock_tx_producer_valid(
+		const struct comcerto_pfe_hif_stock_tx_producer *producer)
+{
+	return producer && producer->desc && producer->completion &&
+		producer->pending && producer->in_flight && producer->count &&
+		producer->count <= COMCERTO_PFE_HIF_STOCK_DESC_COUNT &&
+		!upper_32_bits(producer->desc_dma);
+}
+
+int comcerto_pfe_hif_stock_tx_producer_init(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		struct comcerto_pfe_hif_desc *desc, dma_addr_t desc_dma,
+		struct comcerto_pfe_hif_tx_completion *completion,
+		struct comcerto_pfe_hif_tx_pending *pending,
+		unsigned long *in_flight, unsigned int count)
+{
+	if (!producer || !desc || !completion || !pending || !in_flight || !count ||
+	    count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    upper_32_bits(desc_dma))
+		return -EINVAL;
+
+	*producer = (struct comcerto_pfe_hif_stock_tx_producer) {
+		.desc = desc, .desc_dma = desc_dma, .completion = completion,
+		.pending = pending, .in_flight = in_flight, .count = count,
+		.header = { .credits = count },
+	};
+	return comcerto_pfe_hif_stock_tx_producer_validate_idle(producer);
+}
+
+int comcerto_pfe_hif_stock_tx_producer_validate_idle(
+		const struct comcerto_pfe_hif_stock_tx_producer *producer)
+{
+	unsigned int i;
+
+	if (!comcerto_pfe_hif_stock_tx_producer_valid(producer) ||
+	    producer->producer != producer->header.reclaim ||
+	    producer->producer != producer->header.publish ||
+	    producer->header.credits != producer->count ||
+	    !bitmap_empty(producer->in_flight, producer->count))
+		return -EINVAL;
+	for (i = 0; i < producer->count; i++)
+		if (READ_ONCE(producer->desc[i].control) ||
+		    READ_ONCE(producer->desc[i].metadata) ||
+		    READ_ONCE(producer->desc[i].data_addr) ||
+		    READ_ONCE(producer->completion[i].dma_addr) ||
+		    READ_ONCE(producer->completion[i].control) ||
+		    memchr_inv(producer->pending[i].opaque, 0,
+			       sizeof(producer->pending[i].opaque)))
+			return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_hif_stock_tx_producer_submit(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		dma_addr_t data_dma, u16 len, u8 client, u8 queue, u16 flags)
+{
+	unsigned int index;
+	u8 *record;
+	u32 control;
+
+	if (!comcerto_pfe_hif_stock_tx_producer_valid(producer) || !len ||
+	    len & ~COMCERTO_PFE_HIF_DESC_LEN_MASK || upper_32_bits(data_dma) ||
+	    client >= COMCERTO_PFE_HIF_CLIENT_MAX || queue > 0xf ||
+	    !producer->header.credits)
+		return -EINVAL;
+	index = producer->producer;
+	if (test_and_set_bit(index, producer->in_flight) ||
+	    READ_ONCE(producer->desc[index].control) ||
+	    READ_ONCE(producer->completion[index].control)) {
+		clear_bit(index, producer->in_flight);
+		return -EBUSY;
+	}
+	record = producer->pending[index].opaque;
+	put_unaligned_le32(lower_32_bits(data_dma), record + 0);
+	put_unaligned_le16(len, record + 4);
+	record[6] = client;
+	record[7] = queue;
+	put_unaligned_le16(flags, record + 8);
+	WRITE_ONCE(producer->desc[index].metadata, producer->barebox_abi ? 0xf0 : 0);
+	WRITE_ONCE(producer->desc[index].data_addr, lower_32_bits(data_dma));
+	WRITE_ONCE(producer->completion[index].dma_addr, lower_32_bits(data_dma));
+	dma_wmb();
+	WRITE_ONCE(producer->completion[index].control,
+		   COMCERTO_PFE_HIF_DESC_OWN | (queue << 16));
+	producer->producer = (index + 1) % producer->count;
+	producer->header.credits--;
+
+	/* This is the recovered 0x2004 publish loop: publish from header.publish
+	 * through producer, with OWN last and the flags-derived host bit.
+	 *
+	 * The vendor __hif_xmit_pkt() executes DSB SY plus outer_cache.sync()
+	 * immediately before it stores the owned descriptor.  dma_wmb() above
+	 * orders the writes for the DMA domain, but intentionally does not invoke
+	 * ARM's heavy barrier hook.  Use mb() at this exact handoff point so a
+	 * newly published descriptor is visible before HIF sees OWN; the caller's
+	 * existing mb() before TX_CTRL=5 remains the stock post-publish sync. */
+	mb();
+	while (producer->header.publish != producer->producer) {
+		index = producer->header.publish;
+		record = producer->pending[index].opaque;
+		control = COMCERTO_PFE_HIF_DESC_TX_CONTROL(
+			get_unaligned_le16(record + 4));
+		/* V563: stock 0x201a..0x203c: a LAST buffer gets LIFM, and every
+		 * client outside 3..6 also gets 0x0e000000 (parse/branch/route
+		 * fetch disable). */
+		if (get_unaligned_le16(record + 8) & BIT(1)) {
+			control |= 0x00040000;
+			if ((u8)(record[6] - 3) > 3 && !producer->barebox_abi)
+				control |= 0x0e000000;
+		}
+		dma_wmb();
+		WRITE_ONCE(producer->desc[index].control, control);
+		producer->header.publish = (index + 1) % producer->count;
+	}
+	return 0;
+}
+
+int comcerto_pfe_hif_stock_tx_producer_reclaim(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		unsigned int index)
+{
+	struct comcerto_pfe_hif_tx_completion *completion;
+	struct comcerto_pfe_hif_desc *desc;
+
+	if (!comcerto_pfe_hif_stock_tx_producer_valid(producer) ||
+	    index >= producer->count || index != producer->header.reclaim ||
+	    !test_bit(index, producer->in_flight) ||
+	    producer->header.credits >= producer->count)
+		return -EINVAL;
+	desc = &producer->desc[index];
+	completion = &producer->completion[index];
+	/* HIF owns the descriptor until it clears OWN.  Nothing may return a
+	 * client credit before this observation. */
+	dma_rmb();
+	if (READ_ONCE(desc->control) & COMCERTO_PFE_HIF_DESC_OWN)
+		return -EAGAIN;
+	if (!READ_ONCE(completion->dma_addr) ||
+	    !(READ_ONCE(completion->control) & COMCERTO_PFE_HIF_DESC_OWN))
+		return -EIO;
+
+	WRITE_ONCE(desc->control, 0);
+	WRITE_ONCE(desc->metadata, 0);
+	WRITE_ONCE(desc->data_addr, 0);
+	*completion = (struct comcerto_pfe_hif_tx_completion) { };
+	memset(producer->pending[index].opaque, 0,
+	       sizeof(producer->pending[index].opaque));
+	dma_wmb();
+	clear_bit(index, producer->in_flight);
+	producer->header.reclaim = (index + 1) % producer->count;
+	producer->header.credits++;
+	return 0;
+}
+
+int comcerto_pfe_hif_stock_tx_producer_abort(
+		struct comcerto_pfe_hif_stock_tx_producer *producer)
+{
+	unsigned int i;
+
+	if (!comcerto_pfe_hif_stock_tx_producer_valid(producer))
+		return -EINVAL;
+	for (i = 0; i < producer->count; i++) {
+		producer->desc[i].control = 0;
+		producer->desc[i].metadata = 0;
+		producer->desc[i].data_addr = 0;
+		producer->completion[i] = (struct comcerto_pfe_hif_tx_completion) { };
+		memset(producer->pending[i].opaque, 0, sizeof(producer->pending[i].opaque));
+	}
+	bitmap_zero(producer->in_flight, producer->count);
+	producer->producer = 0;
+	producer->header = (struct comcerto_pfe_hif_tx_producer_header) {
+		.credits = producer->count,
+	};
+	dma_wmb();
+	return comcerto_pfe_hif_stock_tx_producer_validate_idle(producer);
+}
+
+int comcerto_pfe_hif_prepare_rx_ring(struct comcerto_pfe_hif_desc *desc,
+				     dma_addr_t desc_dma,
+				     const dma_addr_t *buffer_dma,
+				     unsigned int count, u16 buffer_len)
+{
+	unsigned int i;
+
+	if (!desc || !buffer_dma || !count ||
+	    count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    buffer_len & ~COMCERTO_PFE_HIF_DESC_LEN_MASK ||
+	    upper_32_bits(desc_dma) ||
+	    upper_32_bits(desc_dma + (count - 1) * sizeof(*desc)))
+		return -EINVAL;
+
+	for (i = 0; i < count; i++)
+		if (upper_32_bits(buffer_dma[i]))
+			return -ERANGE;
+
+	for (i = 0; i < count; i++) {
+		unsigned int next = (i + 1) % count;
+		dma_addr_t next_dma = desc_dma + next * sizeof(*desc);
+
+		desc[i].metadata = 0;
+		desc[i].data_addr = lower_32_bits(buffer_dma[i]);
+		desc[i].next_addr = lower_32_bits(next_dma);
+		/* Set OWN last, as in the recovered stock initialization path. */
+		dma_wmb();
+		desc[i].control = COMCERTO_PFE_HIF_DESC_RX_CONTROL(buffer_len);
+	}
+
+	dma_wmb();
+	return 0;
+}
+
+int comcerto_pfe_hif_prepare_tx_ring(struct comcerto_pfe_hif_desc *desc,
+				     dma_addr_t desc_dma, unsigned int count)
+{
+	unsigned int i;
+
+	if (!desc || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    upper_32_bits(desc_dma) ||
+	    upper_32_bits(desc_dma + (count - 1) * sizeof(*desc)))
+		return -EINVAL;
+
+	/* Stock pfe_hif_init() zeroes the TX ring, then links its final word. */
+	for (i = 0; i < count; i++) {
+		unsigned int next = (i + 1) % count;
+
+		desc[i].control = 0;
+		desc[i].metadata = 0;
+		desc[i].data_addr = 0;
+		desc[i].next_addr = lower_32_bits(desc_dma +
+						 next * sizeof(*desc));
+	}
+
+	dma_wmb();
+	return 0;
+}
+
+int comcerto_pfe_hif_exercise_tx_descriptor(struct comcerto_pfe_hif_desc *desc,
+		dma_addr_t desc_dma, unsigned int count)
+{
+	struct comcerto_pfe_hif_desc *entry;
+	u32 next;
+
+	if (!desc || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+	entry = &desc[count - 1];
+	next = lower_32_bits(desc_dma);
+	/* Host-only basic __hif_xmit_pkt descriptor form; never published. */
+	entry->metadata = 0;
+	entry->data_addr = 0x01234567;
+	entry->next_addr = next;
+	dma_wmb();
+	entry->control = COMCERTO_PFE_HIF_DESC_TX_CONTROL(0x1a2b);
+	if (entry->control != COMCERTO_PFE_HIF_DESC_TX_CONTROL(0x1a2b) ||
+	    entry->metadata || entry->data_addr != 0x01234567 || entry->next_addr != next)
+		return -EIO;
+	entry->control = 0;
+	entry->metadata = 0;
+	entry->data_addr = 0;
+	entry->next_addr = lower_32_bits(desc_dma);
+	return 0;
+}
+
+int comcerto_pfe_hif_prepare_tx_pending(struct comcerto_pfe_hif_tx_pending *pending,
+					unsigned int count)
+{
+	if (!pending || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+
+	/* Detached records only.  A live Stock producer additionally owns its
+	 * preceding 12-byte reclaim/credit/publish header. */
+	memset(pending, 0, (count + 1) * sizeof(*pending));
+	return 0;
+}
+
+int comcerto_pfe_hif_validate_tx_pending(const struct comcerto_pfe_hif_tx_pending *pending,
+					unsigned int count)
+{
+	unsigned int i;
+
+	if (!pending || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+	for (i = 0; i <= count; i++)
+		if (memchr_inv(pending[i].opaque, 0, sizeof(pending[i].opaque)))
+			return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_hif_exercise_tx_pending_guard(
+		struct comcerto_pfe_hif_tx_pending *pending, unsigned int count)
+{
+	u8 *slot;
+
+	if (!pending || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+
+	/* This is intentionally a detached legacy helper.  Its old record-relative
+	 * offsets modelled pfe+0x1088 rather than the real first record at +0x108c;
+	 * retain its guard-only purpose but use the corrected record layout. */
+	slot = (u8 *)pending + (count - 1) * sizeof(*pending);
+	put_unaligned_le32(0x01234567, slot + 0); /* translated DMA address */
+	put_unaligned_le16(0x1a2b, slot + 4);     /* packet length */
+	slot[6] = COMCERTO_PFE_HIF_CLIENT_MAX - 1;
+	slot[7] = 3;                               /* queue */
+	put_unaligned_le16(0x0010, slot + 8);     /* stock flags word */
+
+	if (get_unaligned_le32(slot + 0) != 0x01234567 ||
+	    get_unaligned_le16(slot + 4) != 0x1a2b ||
+	    slot[6] != COMCERTO_PFE_HIF_CLIENT_MAX - 1 || slot[7] != 3 ||
+	    get_unaligned_le16(slot + 8) != 0x0010)
+		return -EIO;
+
+	/* Leave the candidate's host-only audit exactly as it found it. */
+	return comcerto_pfe_hif_prepare_tx_pending(pending, count);
+}
+
+int comcerto_pfe_hif_exercise_tx_completion(
+		struct comcerto_pfe_hif_tx_completion *completion, unsigned int count)
+{
+	struct comcerto_pfe_hif_tx_completion *entry;
+	const u32 queue = 3;
+
+	if (!completion || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+
+	/* __hif_lib_xmit_pkt() writes an eight-byte per-client completion entry:
+	 * DMA word followed by OWN | ((queue & 0xf) << 16).  This is deliberately
+	 * private storage; no HIF descriptor or register observes it. */
+	entry = &completion[count - 1];
+	entry->dma_addr = 0x01234567;
+	dma_wmb();
+	entry->control = COMCERTO_PFE_HIF_DESC_OWN | (queue << 16);
+	if (comcerto_pfe_hif_tx_completion_ready(entry))
+		return -EIO;
+
+	comcerto_pfe_hif_tx_completion_complete(entry);
+	if (!comcerto_pfe_hif_tx_completion_ready(entry) ||
+	    entry->dma_addr != 0x01234567 || entry->control != (queue << 16))
+		return -EIO;
+
+	*entry = (struct comcerto_pfe_hif_tx_completion) { };
+	return 0;
+}
+
+static int comcerto_pfe_hif_tx_slot_valid(const struct comcerto_pfe_hif_tx_ring *ring,
+					  unsigned int index)
+{
+	if (!ring || !ring->desc || !ring->completion || !ring->pending ||
+	    !ring->in_flight || !ring->count || ring->in_flight_count > ring->count ||
+	    index >= ring->count)
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_hif_tx_submit(struct comcerto_pfe_hif_tx_ring *ring,
+			       unsigned int index, dma_addr_t data_dma, u16 len,
+			       u8 client, u8 queue, u16 flags)
+{
+	struct comcerto_pfe_hif_desc *desc;
+	struct comcerto_pfe_hif_tx_completion *completion;
+	u8 *pending;
+	int ret;
+
+	ret = comcerto_pfe_hif_tx_slot_valid(ring, index);
+	if (ret)
+		return ret;
+	if (!len || len & ~COMCERTO_PFE_HIF_DESC_LEN_MASK ||
+	    upper_32_bits(data_dma) || client >= COMCERTO_PFE_HIF_CLIENT_MAX ||
+	    queue > 0xf)
+		return -EINVAL;
+
+	desc = &ring->desc[index];
+	completion = &ring->completion[index];
+	pending = (u8 *)ring->pending + index * sizeof(*ring->pending);
+	if (test_and_set_bit(index, ring->in_flight))
+		return -EBUSY;
+	if (READ_ONCE(desc->control) || READ_ONCE(desc->metadata) ||
+	    READ_ONCE(desc->data_addr) || READ_ONCE(completion->dma_addr) ||
+	    READ_ONCE(completion->control)) {
+		clear_bit(index, ring->in_flight);
+		return -EBUSY;
+	}
+	if (ring->in_flight_count == ring->count) {
+		clear_bit(index, ring->in_flight);
+		return -ENOSPC;
+	}
+
+	/* `pending` is a detached view whose element zero denotes the first Stock
+	 * record (the live context adds its 12-byte producer header before it).
+	 * The record itself is DMA/len/client/queue/flags at 0/4/6/7/8. */
+	put_unaligned_le32(lower_32_bits(data_dma), pending + 0);
+	put_unaligned_le16(len, pending + 4);
+	pending[6] = client;
+	pending[7] = queue;
+	put_unaligned_le16(flags, pending + 8);
+	WRITE_ONCE(desc->metadata, 0);
+	WRITE_ONCE(desc->data_addr, lower_32_bits(data_dma));
+	WRITE_ONCE(completion->dma_addr, lower_32_bits(data_dma));
+	/* Both ownership words are observable only after their payload fields. */
+	dma_wmb();
+	WRITE_ONCE(completion->control, COMCERTO_PFE_HIF_DESC_OWN | (queue << 16));
+	dma_wmb();
+	WRITE_ONCE(desc->control, COMCERTO_PFE_HIF_DESC_TX_CONTROL(len));
+	ring->in_flight_count++;
+	return 0;
+}
+
+int comcerto_pfe_hif_tx_consume(struct comcerto_pfe_hif_tx_ring *ring,
+				unsigned int index)
+{
+	struct comcerto_pfe_hif_desc *desc;
+	struct comcerto_pfe_hif_tx_completion *completion;
+	u8 *pending;
+	int ret;
+
+	ret = comcerto_pfe_hif_tx_slot_valid(ring, index);
+	if (ret)
+		return ret;
+	if (!test_bit(index, ring->in_flight))
+		return -ENOENT;
+	if (!ring->in_flight_count)
+		return -EIO;
+
+	completion = &ring->completion[index];
+	if (!comcerto_pfe_hif_tx_completion_ready(completion))
+		return -EAGAIN;
+	desc = &ring->desc[index];
+	pending = (u8 *)ring->pending + index * sizeof(*ring->pending);
+	/* Completion is observed before returning all host-side ownership to idle. */
+	dma_rmb();
+	WRITE_ONCE(desc->control, 0);
+	WRITE_ONCE(desc->metadata, 0);
+	WRITE_ONCE(desc->data_addr, 0);
+	*completion = (struct comcerto_pfe_hif_tx_completion) { };
+	memset(pending, 0, sizeof(*ring->pending));
+	dma_wmb();
+	clear_bit(index, ring->in_flight);
+	ring->in_flight_count--;
+	return 0;
+}
+
+int comcerto_pfe_hif_exercise_tx_lifecycle(struct comcerto_pfe_hif_tx_ring *ring)
+{
+	unsigned int first, last;
+	int ret;
+
+	if (!ring || !ring->count)
+		return -EINVAL;
+	first = 0;
+	last = ring->count - 1;
+	ret = comcerto_pfe_hif_tx_submit(ring, last, 0x01234567, 60,
+					0, 3, 0x0010);
+	if (ret)
+		return ret;
+	if (comcerto_pfe_hif_tx_consume(ring, last) != -EAGAIN)
+		return -EIO;
+	comcerto_pfe_hif_tx_completion_complete(&ring->completion[last]);
+	ret = comcerto_pfe_hif_tx_consume(ring, last);
+	if (ret || comcerto_pfe_hif_tx_consume(ring, last) != -ENOENT)
+		return -EIO;
+	/* Exercise index wrap independently after the final-slot guard case. */
+	ret = comcerto_pfe_hif_tx_submit(ring, first, 0x07654321, 64,
+					0, 3, 0);
+	if (ret)
+		return ret;
+	comcerto_pfe_hif_tx_completion_complete(&ring->completion[first]);
+	return comcerto_pfe_hif_tx_consume(ring, first);
+}
+
+int comcerto_pfe_hif_validate_tx_handoff_context(
+		const struct comcerto_pfe_hif_tx_ring *ring)
+{
+	unsigned int i;
+
+	if (!ring || !ring->desc || !ring->completion || !ring->pending ||
+	    !ring->in_flight || !ring->count ||
+	    ring->count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    upper_32_bits(ring->desc_dma) ||
+	    upper_32_bits(ring->desc_dma +
+				 (ring->count - 1) * sizeof(*ring->desc)) ||
+	    ring->in_flight_count || !bitmap_empty(ring->in_flight, ring->count))
+		return -EINVAL;
+
+	/* A base handoff can only expose a fully idle, stock-shaped ring. */
+	dma_rmb();
+	for (i = 0; i < ring->count; i++) {
+		dma_addr_t next = ring->desc_dma +
+			((i + 1) % ring->count) * sizeof(*ring->desc);
+
+		if (READ_ONCE(ring->desc[i].control) ||
+		    READ_ONCE(ring->desc[i].metadata) ||
+		    READ_ONCE(ring->desc[i].data_addr) ||
+		    READ_ONCE(ring->desc[i].next_addr) != lower_32_bits(next) ||
+		    READ_ONCE(ring->completion[i].dma_addr) ||
+		    READ_ONCE(ring->completion[i].control))
+			return -EINVAL;
+	}
+	if (memchr_inv(ring->pending, 0,
+		       (ring->count + 1) * sizeof(*ring->pending)))
+		return -EINVAL;
+	return 0;
+}
+
+int comcerto_pfe_hif_validate_prepared_descriptors(
+		const struct comcerto_pfe_hif_desc *tx, dma_addr_t tx_dma,
+		const struct comcerto_pfe_hif_desc *rx, dma_addr_t rx_dma,
+		const dma_addr_t *rx_buffer_dma, unsigned int count, u16 buffer_len,
+		struct comcerto_pfe_hif_desc_fault *fault)
+{
+	unsigned int i;
+
+	if (!tx || !rx || !rx_buffer_dma || !count ||
+	    count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    buffer_len & ~COMCERTO_PFE_HIF_DESC_LEN_MASK ||
+	    upper_32_bits(tx_dma) || upper_32_bits(rx_dma))
+		return -EINVAL;
+
+	/* Both descriptors are coherent, but this pairs with the HIF's completed
+	 * accesses before observing a chain that has been made its base. */
+	dma_rmb();
+	if (fault)
+		*fault = (struct comcerto_pfe_hif_desc_fault) { };
+	for (i = 0; i < count; i++) {
+		unsigned int next = (i + 1) % count;
+		u32 mismatch = 0;
+		u32 tx_control = READ_ONCE(tx[i].control);
+		u32 tx_metadata = READ_ONCE(tx[i].metadata);
+		u32 tx_data = READ_ONCE(tx[i].data_addr);
+		u32 tx_next = READ_ONCE(tx[i].next_addr);
+		u32 rx_control = READ_ONCE(rx[i].control);
+		u32 rx_metadata = READ_ONCE(rx[i].metadata);
+		u32 rx_data = READ_ONCE(rx[i].data_addr);
+		u32 rx_next = READ_ONCE(rx[i].next_addr);
+
+		if (tx_control)
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_TX_CONTROL;
+		if (tx_metadata)
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_TX_METADATA;
+		if (tx_data)
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_TX_DATA;
+		if (tx_next != lower_32_bits(tx_dma + next * sizeof(*tx)))
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_TX_NEXT;
+		if (rx_control != COMCERTO_PFE_HIF_DESC_RX_CONTROL(buffer_len))
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_RX_CONTROL;
+		if (rx_metadata)
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_RX_METADATA;
+		if (upper_32_bits(rx_buffer_dma[i]) ||
+		    rx_data != lower_32_bits(rx_buffer_dma[i]))
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_RX_DATA;
+		if (rx_next != lower_32_bits(rx_dma + next * sizeof(*rx)))
+			mismatch |= COMCERTO_PFE_HIF_DESC_FAULT_RX_NEXT;
+		if (mismatch) {
+			if (fault)
+				*fault = (struct comcerto_pfe_hif_desc_fault) {
+					.index = i, .mismatch = mismatch,
+					.tx_control = tx_control, .tx_metadata = tx_metadata,
+					.tx_data_addr = tx_data, .tx_next_addr = tx_next,
+					.rx_control = rx_control, .rx_metadata = rx_metadata,
+					.rx_data_addr = rx_data, .rx_next_addr = rx_next,
+				};
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
+
+bool comcerto_pfe_hif_tx_completion_ready(
+		const struct comcerto_pfe_hif_tx_completion *entry)
+{
+	if (!entry)
+		return false;
+
+	/* Stock hif_lib_tx_get_next_complete() tests completion control's OWN bit. */
+	dma_rmb();
+	return !(READ_ONCE(entry->control) & COMCERTO_PFE_HIF_DESC_OWN);
+}
+
+void comcerto_pfe_hif_tx_completion_complete(
+		struct comcerto_pfe_hif_tx_completion *entry)
+{
+	if (!entry)
+		return;
+
+	/* __hif_tx_done_process() clears OWN before client credit handling. */
+	dma_wmb();
+	WRITE_ONCE(entry->control, READ_ONCE(entry->control) &
+		   ~COMCERTO_PFE_HIF_DESC_OWN);
+}
+
+bool comcerto_pfe_hif_rx_desc_ready(const struct comcerto_pfe_hif_desc *desc)
+{
+	/* The HIF clears OWN only after its DMA writes to this descriptor. */
+	dma_rmb();
+	return !(READ_ONCE(desc->control) & COMCERTO_PFE_HIF_DESC_OWN);
+}
+
+void comcerto_pfe_hif_recycle_rx_desc(struct comcerto_pfe_hif_desc *desc,
+				      u16 buffer_len)
+{
+	desc->metadata = 0;
+	/* Preserve data_addr and next_addr: the ring remains circular. */
+	dma_wmb();
+	WRITE_ONCE(desc->control, COMCERTO_PFE_HIF_DESC_RX_CONTROL(buffer_len));
+}
+
+void comcerto_pfe_hif_free_rx_ring(struct device *dev,
+				  struct comcerto_pfe_hif_rx_ring *ring)
+{
+	unsigned int i;
+
+	if (!ring)
+		return;
+
+	if (ring->buffer) {
+		for (i = 0; i < ring->count; i++)
+			if (ring->buffer[i])
+				dma_free_coherent(dev, ring->buffer_len,
+						  ring->buffer[i], ring->buffer_dma[i]);
+	}
+	if (ring->desc)
+		dma_free_coherent(dev, ring->count * sizeof(*ring->desc),
+				  ring->desc, ring->desc_dma);
+
+	kfree(ring->buffer_dma);
+	kfree(ring->buffer);
+	*ring = (struct comcerto_pfe_hif_rx_ring) { };
+}
+
+int comcerto_pfe_hif_alloc_rx_ring(struct device *dev,
+				   struct comcerto_pfe_hif_rx_ring *ring,
+				   unsigned int count, u16 buffer_len)
+{
+	unsigned int i;
+	int ret;
+
+	if (!ring || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT ||
+	    !buffer_len || buffer_len & ~COMCERTO_PFE_HIF_DESC_LEN_MASK)
+		return -EINVAL;
+
+	*ring = (struct comcerto_pfe_hif_rx_ring) {
+		.count = count,
+		.buffer_len = buffer_len,
+	};
+	ring->buffer = kcalloc(count, sizeof(*ring->buffer), GFP_KERNEL);
+	ring->buffer_dma = kcalloc(count, sizeof(*ring->buffer_dma), GFP_KERNEL);
+	if (!ring->buffer || !ring->buffer_dma) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	ring->desc = dma_alloc_coherent(dev, count * sizeof(*ring->desc),
+					&ring->desc_dma, GFP_KERNEL);
+	if (!ring->desc) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	for (i = 0; i < count; i++) {
+		ring->buffer[i] = dma_alloc_coherent(dev, buffer_len,
+						     &ring->buffer_dma[i], GFP_KERNEL);
+		if (!ring->buffer[i]) {
+			ret = -ENOMEM;
+			goto err_free;
+		}
+	}
+
+	ret = comcerto_pfe_hif_prepare_rx_ring(ring->desc, ring->desc_dma,
+						ring->buffer_dma, count, buffer_len);
+	if (!ret)
+		return 0;
+err_free:
+	comcerto_pfe_hif_free_rx_ring(dev, ring);
+	return ret;
+}
+
+void comcerto_pfe_hif_free_tx_ring(struct device *dev,
+				  struct comcerto_pfe_hif_tx_ring *ring)
+{
+	if (!ring)
+		return;
+
+	if (ring->desc)
+		dma_free_coherent(dev, ring->count * sizeof(*ring->desc),
+				  ring->desc, ring->desc_dma);
+	kfree(ring->completion);
+	kfree(ring->pending);
+	bitmap_free(ring->in_flight);
+	*ring = (struct comcerto_pfe_hif_tx_ring) { };
+}
+
+int comcerto_pfe_hif_alloc_tx_ring(struct device *dev,
+				   struct comcerto_pfe_hif_tx_ring *ring,
+				   unsigned int count)
+{
+	int ret;
+
+	if (!ring || !count || count > COMCERTO_PFE_HIF_STOCK_DESC_COUNT)
+		return -EINVAL;
+
+	*ring = (struct comcerto_pfe_hif_tx_ring) { .count = count };
+	ring->completion = kcalloc(count, sizeof(*ring->completion), GFP_KERNEL);
+	if (!ring->completion)
+		return -ENOMEM;
+	ring->pending = kcalloc(count + 1, sizeof(*ring->pending), GFP_KERNEL);
+	if (!ring->pending) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+	ring->in_flight = bitmap_zalloc(count, GFP_KERNEL);
+	if (!ring->in_flight) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+	ret = comcerto_pfe_hif_prepare_tx_pending(ring->pending, count);
+	if (ret)
+		goto err_free;
+
+	ring->desc = dma_alloc_coherent(dev, count * sizeof(*ring->desc),
+					&ring->desc_dma, GFP_KERNEL);
+	if (!ring->desc) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	ret = comcerto_pfe_hif_prepare_tx_ring(ring->desc, ring->desc_dma, count);
+	if (!ret)
+		return 0;
+err_free:
+	comcerto_pfe_hif_free_tx_ring(dev, ring);
+	return ret;
+}
+
+int comcerto_pfe_hif_validate_private_rings(
+		const struct comcerto_pfe_hif_rx_ring *rx,
+		const struct comcerto_pfe_hif_tx_ring *tx)
+{
+	unsigned int i;
+
+	if (!rx || !tx || !rx->desc || !rx->buffer_dma || !tx->desc ||
+	    !tx->completion || !tx->pending || !tx->in_flight || !rx->count ||
+	    rx->count != tx->count || tx->in_flight_count > tx->count)
+		return -EINVAL;
+	if (comcerto_pfe_hif_validate_tx_pending(tx->pending, tx->count))
+		return -EINVAL;
+
+	for (i = 0; i < rx->count; i++) {
+		unsigned int next = (i + 1) % rx->count;
+
+		if (test_bit(i, tx->in_flight) || tx->in_flight_count ||
+		    rx->desc[i].metadata ||
+		    rx->desc[i].data_addr != lower_32_bits(rx->buffer_dma[i]) ||
+		    rx->desc[i].next_addr != lower_32_bits(rx->desc_dma +
+						      next * sizeof(*rx->desc)) ||
+		    rx->desc[i].control != COMCERTO_PFE_HIF_DESC_RX_CONTROL(rx->buffer_len) ||
+		    tx->desc[i].control || tx->desc[i].metadata ||
+		    tx->desc[i].data_addr ||
+		    tx->desc[i].next_addr != lower_32_bits(tx->desc_dma +
+						      next * sizeof(*tx->desc)) ||
+		    tx->completion[i].dma_addr || tx->completion[i].control)
+			return -EINVAL;
+	}
+
+	return 0;
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.h
new file mode 100644
index 000000000..dce9d5124
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-hif-ring.h
@@ -0,0 +1,222 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef COMCERTO_PFE_HIF_RING_H
+#define COMCERTO_PFE_HIF_RING_H
+
+#include <linux/dma-mapping.h>
+#include <linux/device.h>
+#include <linux/types.h>
+#include <linux/stddef.h>
+
+#include "comcerto-pfe-hif-regs.h"
+
+struct comcerto_pfe_hif_tx_ring;
+
+/*
+ * Prepare the stock-compatible circular receive descriptor chain.  Ownership
+ * remains with the HIF only after the caller has programmed RX_BASE and
+ * enabled RX_CTRL; this helper performs neither operation.
+ */
+int comcerto_pfe_hif_prepare_rx_ring(struct comcerto_pfe_hif_desc *desc,
+				     dma_addr_t desc_dma,
+				     const dma_addr_t *buffer_dma,
+				     unsigned int count, u16 buffer_len);
+
+/* Build the stock circular TX descriptor chain; packet ownership stays idle. */
+int comcerto_pfe_hif_prepare_tx_ring(struct comcerto_pfe_hif_desc *desc,
+				     dma_addr_t desc_dma, unsigned int count);
+
+/* Re-check an already prepared, HIF-based descriptor pair without changing
+ * ownership.  Used only while TX is disabled and no ingress traffic is
+ * expected by the caller. */
+struct comcerto_pfe_hif_desc_fault {
+	unsigned int index;
+	u32 mismatch;
+	u32 tx_control;
+	u32 tx_metadata;
+	u32 tx_data_addr;
+	u32 tx_next_addr;
+	u32 rx_control;
+	u32 rx_metadata;
+	u32 rx_data_addr;
+	u32 rx_next_addr;
+};
+
+#define COMCERTO_PFE_HIF_DESC_FAULT_TX_CONTROL	BIT(0)
+#define COMCERTO_PFE_HIF_DESC_FAULT_TX_METADATA	BIT(1)
+#define COMCERTO_PFE_HIF_DESC_FAULT_TX_DATA		BIT(2)
+#define COMCERTO_PFE_HIF_DESC_FAULT_TX_NEXT		BIT(3)
+#define COMCERTO_PFE_HIF_DESC_FAULT_RX_CONTROL	BIT(4)
+#define COMCERTO_PFE_HIF_DESC_FAULT_RX_METADATA	BIT(5)
+#define COMCERTO_PFE_HIF_DESC_FAULT_RX_DATA		BIT(6)
+#define COMCERTO_PFE_HIF_DESC_FAULT_RX_NEXT		BIT(7)
+
+int comcerto_pfe_hif_validate_prepared_descriptors(
+		const struct comcerto_pfe_hif_desc *tx, dma_addr_t tx_dma,
+		const struct comcerto_pfe_hif_desc *rx, dma_addr_t rx_dma,
+		const dma_addr_t *rx_buffer_dma, unsigned int count, u16 buffer_len,
+		struct comcerto_pfe_hif_desc_fault *fault);
+
+/* Stock per-client TX completion ring entry.  Direct pfe.ko disassembly fixes
+ * this eight-byte layout.  `control` carries OWN in bit 31; client and queue
+ * selection belongs to the separate pending record below, not to this word.
+ * It is still not wired to TX. */
+struct comcerto_pfe_hif_tx_completion {
+	u32 dma_addr;
+	u32 control;
+};
+
+static_assert(sizeof(struct comcerto_pfe_hif_tx_completion) == 8);
+static_assert(offsetof(struct comcerto_pfe_hif_tx_completion, dma_addr) == 0);
+static_assert(offsetof(struct comcerto_pfe_hif_tx_completion, control) == 4);
+
+/* Stock __hif_xmit_pkt() places a 12-byte header before this 12-byte stream:
+ * reclaim index at pfe+0x1080, credits at +0x1084 and publish index at +0x1088.
+ * Record n then starts at pfe+0x108c + 12*n and has DMA +0, length +4,
+ * client/queue +6/+7 and flags +8.  The detached host model below still
+ * stores only records; an active Stock producer must bind the header and the
+ * descriptor ring with it as one allocation/lifetime. */
+struct comcerto_pfe_hif_tx_pending {
+	u8 opaque[12];
+};
+
+static_assert(sizeof(struct comcerto_pfe_hif_tx_pending) == 12);
+
+/* The three words immediately preceding the first Stock pending record. */
+struct comcerto_pfe_hif_tx_producer_header {
+	u32 reclaim;
+	u32 credits;
+	u32 publish;
+};
+
+static_assert(sizeof(struct comcerto_pfe_hif_tx_producer_header) == 12);
+
+/* Coupled software view of the Stock producer.  The descriptor region is the
+ * HIF-visible allocation; all remaining members are host-only state from the
+ * same producer transaction.  It is deliberately distinct from the old
+ * detached `tx_ring` helper below. */
+struct comcerto_pfe_hif_stock_tx_producer {
+	struct comcerto_pfe_hif_desc *desc;
+	dma_addr_t desc_dma;
+	struct comcerto_pfe_hif_tx_completion *completion;
+	struct comcerto_pfe_hif_tx_pending *pending;
+	unsigned long *in_flight;
+	unsigned int count;
+	unsigned int producer;
+	struct comcerto_pfe_hif_tx_producer_header header;
+	/* V574: Barebox PE firmware ABI (desc word1 = 0xf0, no fetch-disable
+	 * bits), as Barebox' own HIF send path at 0x01006a8c. */
+	bool barebox_abi;
+};
+
+int comcerto_pfe_hif_stock_tx_producer_init(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		struct comcerto_pfe_hif_desc *desc, dma_addr_t desc_dma,
+		struct comcerto_pfe_hif_tx_completion *completion,
+		struct comcerto_pfe_hif_tx_pending *pending,
+		unsigned long *in_flight, unsigned int count);
+int comcerto_pfe_hif_stock_tx_producer_submit(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		dma_addr_t data_dma, u16 len, u8 client, u8 queue, u16 flags);
+/* Complete one FIFO slot only after the HIF has relinquished descriptor OWN.
+ * This is the Linux-side portion of stock __hif_tx_done_process(): it returns
+ * the client credit and clears the host records after the DMA observation.
+ * It does not touch HIF MMIO or manufacture a completion. */
+int comcerto_pfe_hif_stock_tx_producer_reclaim(
+		struct comcerto_pfe_hif_stock_tx_producer *producer,
+		unsigned int index);
+int comcerto_pfe_hif_stock_tx_producer_abort(
+		struct comcerto_pfe_hif_stock_tx_producer *producer);
+int comcerto_pfe_hif_stock_tx_producer_validate_idle(
+		const struct comcerto_pfe_hif_stock_tx_producer *producer);
+
+/* Stock hif_process_client_req() accepts client IDs 0..7 and zeroes exactly
+ * 0x188 bytes per client.  Its two internal tables have only partially
+ * recovered semantics, so expose this solely as an opaque layout boundary;
+ * it is deliberately not connected to registration or TX submission. */
+#define COMCERTO_PFE_HIF_CLIENT_MAX		8
+#define COMCERTO_PFE_HIF_CLIENT_STATE_BYTES	0x188
+
+struct comcerto_pfe_hif_client_state {
+	u8 opaque[COMCERTO_PFE_HIF_CLIENT_STATE_BYTES];
+};
+
+static_assert(sizeof(struct comcerto_pfe_hif_client_state) ==
+	      COMCERTO_PFE_HIF_CLIENT_STATE_BYTES);
+
+int comcerto_pfe_hif_prepare_tx_pending(struct comcerto_pfe_hif_tx_pending *pending,
+					unsigned int count);
+int comcerto_pfe_hif_validate_tx_pending(const struct comcerto_pfe_hif_tx_pending *pending,
+					unsigned int count);
+/* Exercises one final producer slot and its required guard bytes entirely in
+ * host memory; it neither publishes a descriptor nor writes an HIF register. */
+int comcerto_pfe_hif_exercise_tx_pending_guard(
+		struct comcerto_pfe_hif_tx_pending *pending, unsigned int count);
+/* Host-only basic completion lifecycle: OWN plus queue, then completion. */
+int comcerto_pfe_hif_exercise_tx_completion(
+		struct comcerto_pfe_hif_tx_completion *completion, unsigned int count);
+int comcerto_pfe_hif_exercise_tx_descriptor(struct comcerto_pfe_hif_desc *desc,
+		dma_addr_t desc_dma, unsigned int count);
+
+/* Detached single-client lifecycle model.  These helpers operate only on a
+ * private tx_ring and never access HIF MMIO or publish its descriptor base. */
+int comcerto_pfe_hif_tx_submit(struct comcerto_pfe_hif_tx_ring *ring,
+			       unsigned int index, dma_addr_t data_dma, u16 len,
+			       u8 client, u8 queue, u16 flags);
+int comcerto_pfe_hif_tx_consume(struct comcerto_pfe_hif_tx_ring *ring,
+				unsigned int index);
+int comcerto_pfe_hif_exercise_tx_lifecycle(struct comcerto_pfe_hif_tx_ring *ring);
+/* Read-only eligibility check before a future HIF_TX_BASE handoff. */
+int comcerto_pfe_hif_validate_tx_handoff_context(
+		const struct comcerto_pfe_hif_tx_ring *ring);
+
+bool comcerto_pfe_hif_tx_completion_ready(
+		const struct comcerto_pfe_hif_tx_completion *entry);
+void comcerto_pfe_hif_tx_completion_complete(
+		struct comcerto_pfe_hif_tx_completion *entry);
+
+/* RX ownership transition used by the future NAPI consumer. */
+bool comcerto_pfe_hif_rx_desc_ready(const struct comcerto_pfe_hif_desc *desc);
+void comcerto_pfe_hif_recycle_rx_desc(struct comcerto_pfe_hif_desc *desc,
+				      u16 buffer_len);
+
+/* Allocation and destruction are intentionally separate from HIF activation. */
+struct comcerto_pfe_hif_rx_ring {
+	struct comcerto_pfe_hif_desc *desc;
+	dma_addr_t desc_dma;
+	void **buffer;
+	dma_addr_t *buffer_dma;
+	unsigned int count;
+	u16 buffer_len;
+};
+
+/* TX descriptors live in their own DMA allocation. Completion records are
+ * host-owned bookkeeping and deliberately have no HIF register caller yet. */
+struct comcerto_pfe_hif_tx_ring {
+	struct comcerto_pfe_hif_desc *desc;
+	dma_addr_t desc_dma;
+	struct comcerto_pfe_hif_tx_completion *completion;
+	struct comcerto_pfe_hif_tx_pending *pending;
+	/* Host-side ownership only: set from submit until exactly one consume. */
+	unsigned long *in_flight;
+	unsigned int in_flight_count;
+	unsigned int count;
+};
+
+int comcerto_pfe_hif_alloc_rx_ring(struct device *dev,
+				   struct comcerto_pfe_hif_rx_ring *ring,
+				   unsigned int count, u16 buffer_len);
+void comcerto_pfe_hif_free_rx_ring(struct device *dev,
+				  struct comcerto_pfe_hif_rx_ring *ring);
+
+int comcerto_pfe_hif_alloc_tx_ring(struct device *dev,
+				   struct comcerto_pfe_hif_tx_ring *ring,
+				   unsigned int count);
+void comcerto_pfe_hif_free_tx_ring(struct device *dev,
+				  struct comcerto_pfe_hif_tx_ring *ring);
+
+/* Validate private, prepared storage before any future HIF ownership switch. */
+int comcerto_pfe_hif_validate_private_rings(
+		const struct comcerto_pfe_hif_rx_ring *rx,
+		const struct comcerto_pfe_hif_tx_ring *tx);
+
+#endif
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-init.c b/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-init.c
new file mode 100644
index 000000000..ea46ab0b3
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-init.c
@@ -0,0 +1,483 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exact low-level BMU/GPI setup recovered from NAS542 stock pfe.ko. */
+#include <linux/iopoll.h>
+#include <linux/io.h>
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+
+#include "comcerto-pfe-hw-profile.h"
+#include "comcerto-pfe-hif-regs.h"
+
+#define COMCERTO_PFE_BLOCK_CTRL		0x04
+#define COMCERTO_PFE_BMU_BUFFER_SIZE		0x08
+#define COMCERTO_PFE_BMU_BUFFER_BASE		0x0c
+#define COMCERTO_PFE_BMU_INT_THRESHOLD	0x10
+#define COMCERTO_PFE_BMU_INT_CTRL		0x24
+#define COMCERTO_PFE_BMU_RESET_DONE		BIT(5)
+
+#define COMCERTO_PFE_CLASS_HDR_SIZE		0x014
+#define COMCERTO_PFE_CLASS_LMEM_BUF_SIZE	0x020
+#define COMCERTO_PFE_CLASS_ROUTE_MULTI		0x234
+#define COMCERTO_PFE_CLASS_ROUTE_TABLE_BASE	0x238
+#define COMCERTO_PFE_CLASS_ROUTE_CFG		0x23c
+#define COMCERTO_PFE_CLASS_ROUTE_ENTRY_SIZE	0x244
+#define COMCERTO_PFE_CLASS_ROUTE_MODE		0x25c
+#define COMCERTO_PFE_CLASS_AXI_CTRL		0x200
+#define COMCERTO_PFE_CLASS_REG_060		0x060
+#define COMCERTO_PFE_CLASS_REG_064		0x064
+#define COMCERTO_PFE_CLASS_TM_INQ_ADDR		0x114
+#define COMCERTO_PFE_CLASS_AFULL_THRESHOLD	0x204
+#define COMCERTO_PFE_CLASS_MAX_BUF_COUNT	0x20c
+#define COMCERTO_PFE_CLASS_TSQ_FIFO_THRESHOLD	0x210
+#define COMCERTO_PFE_CLASS_TSQ_MAX_COUNT	0x214
+
+#define COMCERTO_PFE_TMU_INQ_WATERMARK_REG	0x004
+#define COMCERTO_PFE_TMU_AXI_CTRL_REG		0x014
+#define COMCERTO_PFE_TMU_PHY_INQ0		0x0f0
+#define COMCERTO_PFE_TMU_PHY_INQ1		0x0f4
+#define COMCERTO_PFE_TMU_PHY_INQ2		0x0f8
+#define COMCERTO_PFE_TMU_PHY_INQ3		0x0fc
+#define COMCERTO_PFE_TMU_PHY_INQ4		0x134
+#define COMCERTO_PFE_TMU_PHY_INQ5		0x148
+#define COMCERTO_PFE_TMU_PHY_INQ6		0x100
+#define COMCERTO_PFE_TMU_PHY_INQ_LIMIT0	0x0b8
+#define COMCERTO_PFE_TMU_PHY_INQ_LIMIT1	0x138
+#define COMCERTO_PFE_TMU_PHY_INQ_LIMIT2	0x13c
+#define COMCERTO_PFE_TMU_PHY_INQ_LIMIT3	0x140
+#define COMCERTO_PFE_TMU_LLM_BASE		0x0c0
+#define COMCERTO_PFE_TMU_LLM_QUEUE_LEN_REG	0x0c4
+#define COMCERTO_PFE_TMU_CTRL			0x0e0
+#define COMCERTO_PFE_TMU_SYS_GENERIC_CTRL_REG	0x0b4
+#define COMCERTO_PFE_TMU_QUEUES_CFG		0x144
+#define COMCERTO_PFE_TMU_QUEUE_CMD		0x034
+#define COMCERTO_PFE_TMU_QUEUE_ARG		0x038
+#define COMCERTO_PFE_TMU_QUEUE_CFG0		0x054
+#define COMCERTO_PFE_TMU_QUEUE_CFG1		0x058
+#define COMCERTO_PFE_TMU_QUEUE_ENABLE		0x030
+#define COMCERTO_PFE_TMU_QUEUE_GROUPS		4
+#define COMCERTO_PFE_TMU_QUEUES_PER_GROUP	16
+#define COMCERTO_PFE_UTIL_AXI_CTRL		0x200
+
+static bool comcerto_pfe_ddr_range_valid(phys_addr_t ddr_phys,
+					 size_t ddr_size, size_t offset,
+					 size_t length)
+{
+	if (offset > ddr_size || length > ddr_size - offset)
+		return false;
+
+	/* All PFE block registers take 32-bit physical addresses. */
+	return ddr_phys <= U32_MAX - offset &&
+	       ddr_phys + offset <= U32_MAX - (length - 1);
+}
+
+int comcerto_pfe_stock_ddr_layout_valid(phys_addr_t ddr_phys, size_t ddr_size)
+{
+	/*
+	 * These are the fixed, non-overlapping reservations recovered from the
+	 * stock firmware section tables and the stock PFE LLM sizing formula.
+	 */
+	return comcerto_pfe_ddr_range_valid(ddr_phys, ddr_size,
+			COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET,
+			COMCERTO_PFE_CLASS_ROUTE_TABLE_SIZE) &&
+	       comcerto_pfe_ddr_range_valid(ddr_phys, ddr_size,
+			COMCERTO_PFE_UTIL_DDR_OFFSET,
+			COMCERTO_PFE_UTIL_DDR_SIZE) &&
+	       comcerto_pfe_ddr_range_valid(ddr_phys, ddr_size,
+			COMCERTO_PFE_CLASS_DDR_OFFSET,
+			COMCERTO_PFE_CLASS_DDR_SIZE) &&
+	       comcerto_pfe_ddr_range_valid(ddr_phys, ddr_size,
+			COMCERTO_PFE_TMU_LLM_OFFSET,
+			COMCERTO_PFE_TMU_LLM_SIZE) ? 0 : -EINVAL;
+}
+
+int comcerto_pfe_stock_axi_layout_valid(size_t axi_size)
+{
+	/* Every recovered block below is addressed through the AXI resource.
+	 * Keep a 4 KiB register window for each block: the largest literal
+	 * offset used by the recovered setup code is then safely in range. */
+	static const size_t block_offsets[] = {
+		COMCERTO_PFE_BMU1_OFFSET,
+		COMCERTO_PFE_BMU2_OFFSET,
+		COMCERTO_PFE_GPI1_OFFSET,
+		COMCERTO_PFE_GPI2_OFFSET,
+		COMCERTO_PFE_GPI3_OFFSET,
+		COMCERTO_PFE_GPI4_OFFSET,
+		COMCERTO_PFE_HIF_OFFSET,
+		COMCERTO_PFE_TMU_OFFSET,
+		COMCERTO_PFE_CLASS_OFFSET,
+		COMCERTO_PFE_UTIL_OFFSET,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(block_offsets); i++)
+		if (block_offsets[i] > axi_size ||
+		    axi_size - block_offsets[i] < SZ_4K)
+			return -EINVAL;
+
+	return 0;
+}
+
+int comcerto_pfe_stock_bmu_init(void __iomem *base,
+				 const struct comcerto_pfe_bmu_profile *profile)
+{
+	u32 status;
+
+	if (!base || !profile)
+		return -EINVAL;
+
+	/* Stock order: reset, profile, interrupt mask, then enable. */
+	writel(0, base + COMCERTO_PFE_BLOCK_CTRL);
+	writel(profile->buffer_base, base + COMCERTO_PFE_BMU_BUFFER_BASE);
+	writel(profile->buffer_size, base + COMCERTO_PFE_BMU_BUFFER_SIZE);
+	writel(profile->interrupt_threshold,
+	       base + COMCERTO_PFE_BMU_INT_THRESHOLD);
+	writel(0, base + COMCERTO_PFE_BMU_INT_CTRL);
+	writel(2, base + COMCERTO_PFE_BLOCK_CTRL);
+
+	/* The stock driver waits for control-register bit 5 to clear. */
+	return readl_poll_timeout(base + COMCERTO_PFE_BLOCK_CTRL, status,
+				  !(status & COMCERTO_PFE_BMU_RESET_DONE), 1, 1000);
+}
+
+void comcerto_pfe_stock_bmu_enable(void __iomem *base)
+{
+	if (base)
+		/* Exact stock bmu_enable(): control register = 1. */
+		writel(1, base + COMCERTO_PFE_BLOCK_CTRL);
+}
+
+void comcerto_pfe_stock_gpi_init(void __iomem *base,
+				 const struct comcerto_pfe_gpi_profile *profile)
+{
+	if (!base || !profile)
+		return;
+
+	/* Reset/deassert plus gpi_set_config() in exact stock write order. */
+	writel(2, base + COMCERTO_PFE_BLOCK_CTRL);
+	writel(0, base + COMCERTO_PFE_BLOCK_CTRL);
+	writel(COMCERTO_PFE_GPI_LMEM_ALLOC_ADDR_VALUE,
+	       base + COMCERTO_PFE_GPI_LMEM_ALLOC_ADDR);
+	writel(COMCERTO_PFE_GPI_LMEM_FREE_ADDR_VALUE,
+	       base + COMCERTO_PFE_GPI_LMEM_FREE_ADDR);
+	writel(COMCERTO_PFE_GPI_DDR_ALLOC_ADDR_VALUE,
+	       base + COMCERTO_PFE_GPI_DDR_ALLOC_ADDR);
+	writel(COMCERTO_PFE_GPI_DDR_FREE_ADDR_VALUE,
+	       base + COMCERTO_PFE_GPI_DDR_FREE_ADDR);
+	writel(COMCERTO_PFE_GPI_CLASS_ADDR_VALUE,
+	       base + COMCERTO_PFE_GPI_CLASS_ADDR);
+	writel(COMCERTO_PFE_GPI_DDR_DATA_OFFSET_VALUE,
+	       base + COMCERTO_PFE_GPI_DDR_DATA_OFFSET);
+	writel(COMCERTO_PFE_GPI_LMEM_DATA_OFFSET_VALUE,
+	       base + COMCERTO_PFE_GPI_LMEM_DATA_OFFSET);
+	writel(0, base + 0x60);
+	writel(0, base + 0x64);
+	/* V554: stock gpi_set_config() also programs the header and buffer
+	 * sizes (C2K GPI_HDR_SIZE / GPI_BUF_SIZE): DDR 0x100 / LMEM 0x10 header,
+	 * DDR 0x800 / LMEM 0x80 buffers.  V85 omitted both writes. */
+	writel(0x01000010, base + 0x0c);
+	writel(0x08000080, base + 0x10);
+	writel((profile->control_hi << 16) | 3, base + COMCERTO_PFE_GPI_CTRL);
+	writel(profile->rx_cfg, base + COMCERTO_PFE_GPI_RX_CFG);
+	writel(profile->tx_cfg, base + COMCERTO_PFE_GPI_TX_CFG);
+	/* Make GPI AXI transactions non-bufferable; this does not enable the core. */
+	writel(1, base + COMCERTO_PFE_GPI_AXI_CTRL);
+}
+
+void comcerto_pfe_stock_gpi_enable(void __iomem *base)
+{
+	if (base)
+		/* Exact stock gpi_enable(): control register = 1. */
+		writel(1, base + COMCERTO_PFE_BLOCK_CTRL);
+}
+
+void comcerto_pfe_stock_util_init(void __iomem *base)
+{
+	/* Exact stock util_init(): cfg[0] is the constant one. */
+	if (base)
+		writel(1, base + COMCERTO_PFE_UTIL_AXI_CTRL);
+}
+
+int comcerto_pfe_stock_class_init(void __iomem *base, void __iomem *ddr,
+				  phys_addr_t ddr_phys, size_t ddr_size)
+{
+	phys_addr_t route_phys = ddr_phys + COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET;
+
+	if (!base || !ddr || comcerto_pfe_stock_ddr_layout_valid(ddr_phys,
+							       ddr_size) ||
+	    route_phys != (u32)route_phys)
+		return -EINVAL;
+
+	/* class_init(): reset, disable, configure; the caller enables CLASS later. */
+	writel(2, base + COMCERTO_PFE_BLOCK_CTRL);
+	writel(0, base + COMCERTO_PFE_BLOCK_CTRL);
+	writel(1, base + COMCERTO_PFE_CLASS_AXI_CTRL);
+	/* V560: stock class_set_config writes 0x01000010 (movt #0x100); V85 had
+	 * 0x10000010, i.e. a 16x too large DDR header size. */
+	writel(0x01000010, base + COMCERTO_PFE_CLASS_HDR_SIZE);
+	writel(0x80, base + COMCERTO_PFE_CLASS_ROUTE_ENTRY_SIZE);
+	writel((COMCERTO_PFE_CLASS_ROUTE_HASH_BITS << 16) | 0x80,
+	       base + COMCERTO_PFE_CLASS_ROUTE_MULTI);
+	writel(0x0d, base + COMCERTO_PFE_CLASS_ROUTE_MODE);
+	writel(0xb020, base + COMCERTO_PFE_CLASS_ROUTE_CFG);
+	writel((u32)route_phys, base + COMCERTO_PFE_CLASS_ROUTE_TABLE_BASE);
+	memset_io(ddr + COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET, 0,
+		  COMCERTO_PFE_CLASS_ROUTE_TABLE_SIZE);
+	/* V571: stock pfe.ko ipv4_init() (0x108b4) then terminates every
+	 * 128-byte hash bucket: +0x64 = big-endian physical address of the
+	 * bucket itself (empty chain), +0/+4 = 0; +0x68/+0x6c are host-only list
+	 * heads.  With the buckets left zero (V85..V570) the CLASS firmware
+	 * followed a NULL chain for the first unicast UDP/TCP frame and the PE
+	 * hung (V569/V570). */
+	{
+		u32 off;
+
+		for (off = 0; off < COMCERTO_PFE_CLASS_ROUTE_TABLE_SIZE; off += 0x80)
+			iowrite32be((u32)route_phys + off,
+				    ddr + COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET + off + 0x64);
+		wmb();
+	}
+	/* PE data-memory routing registers, retained as recovered literal writes. */
+	writel(0x01000000, base + COMCERTO_PFE_CLASS_REG_060);
+	writel(0x03000200, base + COMCERTO_PFE_CLASS_REG_064);
+	writel(0x01800080, base + COMCERTO_PFE_CLASS_LMEM_BUF_SIZE);
+	writel(0x03800280, base + 0x024);
+	writel(0xc0310008, base + COMCERTO_PFE_CLASS_TM_INQ_ADDR);
+	writel(23, base + COMCERTO_PFE_CLASS_AFULL_THRESHOLD);
+	writel(23, base + COMCERTO_PFE_CLASS_TSQ_FIFO_THRESHOLD);
+	writel(24, base + COMCERTO_PFE_CLASS_MAX_BUF_COUNT);
+	writel(24, base + COMCERTO_PFE_CLASS_TSQ_MAX_COUNT);
+	return 0;
+}
+
+int comcerto_pfe_stock_tmu_prepare(void __iomem *base, phys_addr_t ddr_phys,
+				    size_t ddr_size)
+{
+	phys_addr_t llm_phys = ddr_phys + COMCERTO_PFE_TMU_LLM_OFFSET;
+	u32 status;
+
+	if (!base || comcerto_pfe_stock_ddr_layout_valid(ddr_phys, ddr_size) ||
+	    llm_phys != (u32)llm_phys)
+		return -EINVAL;
+
+	/* Exact pre-traffic portion of stock tmu_init(); no queue traffic enabled. */
+	writel(1, base + COMCERTO_PFE_TMU_CTRL);
+	writel(COMCERTO_PFE_TMU_AXI_CTRL, base + COMCERTO_PFE_TMU_AXI_CTRL_REG);
+	writel(COMCERTO_PFE_TMU_INQ_WATERMARK,
+	       base + COMCERTO_PFE_TMU_INQ_WATERMARK_REG);
+	writel(0xc0210030, base + COMCERTO_PFE_TMU_PHY_INQ0);
+	writel(0xc0230030, base + COMCERTO_PFE_TMU_PHY_INQ1);
+	writel(0xc0340030, base + COMCERTO_PFE_TMU_PHY_INQ2);
+	writel(0xc0290030, base + COMCERTO_PFE_TMU_PHY_INQ3);
+	writel(0xc0350050, base + COMCERTO_PFE_TMU_PHY_INQ4);
+	writel(0xc0360010, base + COMCERTO_PFE_TMU_PHY_INQ5);
+	writel(0xc0250034, base + COMCERTO_PFE_TMU_PHY_INQ6);
+	writel(0x3ff, base + COMCERTO_PFE_TMU_PHY_INQ_LIMIT0);
+	writel(0x3ff, base + COMCERTO_PFE_TMU_PHY_INQ_LIMIT1);
+	writel(0x3ff, base + COMCERTO_PFE_TMU_PHY_INQ_LIMIT2);
+	writel(0x3ff, base + COMCERTO_PFE_TMU_PHY_INQ_LIMIT3);
+	writel(COMCERTO_PFE_TMU_INPUT_ENABLE, base + 0x114);
+	writel((u32)llm_phys, base + COMCERTO_PFE_TMU_LLM_BASE);
+	writel(COMCERTO_PFE_TMU_LLM_QUEUE_LEN,
+	       base + COMCERTO_PFE_TMU_LLM_QUEUE_LEN_REG);
+	writel(COMCERTO_PFE_TMU_SYS_GENERIC_CTRL,
+	       base + COMCERTO_PFE_TMU_SYS_GENERIC_CTRL_REG);
+	writel(0x800, base + COMCERTO_PFE_TMU_QUEUES_CFG);
+	writel(0, base + COMCERTO_PFE_TMU_CTRL);
+	writel(0x40, base + COMCERTO_PFE_TMU_CTRL);
+	/* Atomic (udelay) polls; a sleeping poll never returns with the
+	 * jiffies-only clocksource of these kernels. */
+	if (readl_poll_timeout_atomic(base + COMCERTO_PFE_TMU_CTRL, status,
+				      status & BIT(7), 1, 1000))
+		return -ETIMEDOUT;
+	writel(0x100, base + COMCERTO_PFE_TMU_CTRL);
+	if (readl_poll_timeout_atomic(base + COMCERTO_PFE_TMU_CTRL, status,
+				      status & BIT(9), 1, 1000))
+		return -ETIMEDOUT;
+	/* V554: stock tmu_init() continues with the queue contexts; V85 never
+	 * called this, leaving all 64 TMU queues unconfigured. */
+	comcerto_pfe_stock_tmu_queue_contexts(base, 1);
+	return 0;
+}
+
+int comcerto_pfe_stock_hw_prepare(void __iomem *axi, void __iomem *ddr,
+				  phys_addr_t ddr_phys, size_t ddr_size)
+{
+	const struct comcerto_pfe_bmu_profile bmu1 = {
+		.buffer_base = COMCERTO_PFE_BMU1_BUFFER_BASE,
+		.buffer_size = COMCERTO_PFE_BMU1_BUFFER_SIZE,
+		.interrupt_threshold = COMCERTO_PFE_BMU1_INT_THRESHOLD,
+	};
+	const struct comcerto_pfe_bmu_profile bmu2 = {
+		.buffer_base = ddr_phys + COMCERTO_PFE_BMU2_BUFFER_OFFSET,
+		.buffer_size = COMCERTO_PFE_BMU2_BUFFER_SIZE,
+		.interrupt_threshold = COMCERTO_PFE_BMU2_INT_THRESHOLD,
+	};
+	const struct comcerto_pfe_gpi_profile gpi1 = {
+		.control_hi = COMCERTO_PFE_GPI1_CONTROL_HI,
+		.rx_cfg = COMCERTO_PFE_GPI1_RX_CFG,
+		.tx_cfg = COMCERTO_PFE_GPI1_TX_CFG,
+	};
+	const struct comcerto_pfe_gpi_profile gpi2 = {
+		.control_hi = COMCERTO_PFE_GPI2_CONTROL_HI,
+		.rx_cfg = COMCERTO_PFE_GPI2_RX_CFG,
+		.tx_cfg = COMCERTO_PFE_GPI2_TX_CFG,
+	};
+	const struct comcerto_pfe_gpi_profile gpi3 = {
+		.control_hi = COMCERTO_PFE_GPI3_CONTROL_HI,
+		.rx_cfg = COMCERTO_PFE_GPI3_RX_CFG,
+		.tx_cfg = COMCERTO_PFE_GPI3_TX_CFG,
+	};
+	const struct comcerto_pfe_gpi_profile gpi4 = {
+		.control_hi = COMCERTO_PFE_GPI4_CONTROL_HI,
+		.rx_cfg = COMCERTO_PFE_GPI4_RX_CFG,
+		.tx_cfg = COMCERTO_PFE_GPI4_TX_CFG,
+	};
+	int ret;
+
+	if (!axi || !ddr || comcerto_pfe_stock_ddr_layout_valid(ddr_phys,
+							       ddr_size))
+		return -EINVAL;
+
+	/* Exact pfe_hw_init() order, deliberately exposed one bounded step at a
+	 * time.  A lockup therefore identifies the exact first unsafe access. */
+	ret = comcerto_pfe_stock_bmu_init(axi + COMCERTO_PFE_BMU1_OFFSET,
+					 &bmu1);
+	if (ret)
+		return ret;
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 1
+	return 0;
+#endif
+	ret = comcerto_pfe_stock_bmu_init(axi + COMCERTO_PFE_BMU2_OFFSET,
+					 &bmu2);
+	if (ret)
+		return ret;
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 2
+	return 0;
+#endif
+	ret = comcerto_pfe_stock_class_init(axi + COMCERTO_PFE_CLASS_OFFSET,
+					    ddr, ddr_phys, ddr_size);
+	if (ret)
+		return ret;
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 4
+	pr_emerg("PFE:PREP:CLASS:OK\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 3
+	return 0;
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 4
+	/* V303: observe the live TMU before attempting the stock reset sequence.
+	 * Barebox has already initialised it and started the PEs. */
+	if (COMCERTO_PFE_TMU_SNAPSHOT_ONLY)
+		return 0;
+#endif
+#if !COMCERTO_PFE_TMU_SNAPSHOT_ONLY
+	/* V562: the PFE AXI reset leaves TMU cold (core mask 0, no PHY INQ,
+	 * LLM or queue contexts); the V303 snapshot-only bypass skipped the
+	 * whole stock tmu_init(), including the V554 queue contexts. */
+	ret = comcerto_pfe_stock_tmu_prepare(axi + COMCERTO_PFE_TMU_OFFSET,
+					     ddr_phys, ddr_size);
+	pr_emerg("PFE:V562:TMU_INIT=%d;CTRL=%08x:LLM=%08x/%08x:INQ=%08x/%08x/%08x/%08x:QEN=%08x\n",
+		 ret, readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_CTRL),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_LLM_BASE),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_LLM_QUEUE_LEN_REG),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_PHY_INQ0),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_PHY_INQ1),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_PHY_INQ2),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_PHY_INQ3),
+		 readl(axi + COMCERTO_PFE_TMU_OFFSET + COMCERTO_PFE_TMU_QUEUE_ENABLE));
+	if (ret)
+		return ret;
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 4
+	return 0;
+#endif
+	comcerto_pfe_stock_util_init(axi + COMCERTO_PFE_UTIL_OFFSET);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 5
+	pr_emerg("PFE:PREP:UTIL:OK; TMU_GPI_PE=DISABLED\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 5
+	return 0;
+#endif
+	comcerto_pfe_stock_gpi_init(axi + COMCERTO_PFE_GPI1_OFFSET, &gpi1);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 6
+	pr_emerg("PFE:PREP:GPI1:OK; RX_TX_IRQ=DISABLED\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 6
+	return 0;
+#endif
+	pr_emerg("PFE:PREP:GPI2:BEGIN; RX_TX_IRQ=DISABLED\n");
+	comcerto_pfe_stock_gpi_init(axi + COMCERTO_PFE_GPI2_OFFSET, &gpi2);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 7
+	pr_emerg("PFE:PREP:GPI2:OK; RX_TX_IRQ=DISABLED\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 7
+	return 0;
+#endif
+	comcerto_pfe_stock_gpi_init(axi + COMCERTO_PFE_GPI3_OFFSET, &gpi3);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 8
+	pr_emerg("PFE:PREP:GPI3:OK; RX_TX_IRQ=DISABLED\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 8
+	return 0;
+#endif
+	comcerto_pfe_stock_gpi_init(axi + COMCERTO_PFE_GPI4_OFFSET, &gpi4);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 9
+	pr_emerg("PFE:PREP:GPI4:OK; RX_TX_IRQ=DISABLED\n");
+	return 0;
+#endif
+	comcerto_pfe_stock_bmu_enable(axi + COMCERTO_PFE_BMU1_OFFSET);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE >= 10
+	pr_emerg("PFE:PREP:BMU1:ENABLED; HIF_TMU_GPI_RX_TX_IRQ_PE=DISABLED\n");
+#endif
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 10
+	return 0;
+#endif
+	comcerto_pfe_stock_bmu_enable(axi + COMCERTO_PFE_BMU2_OFFSET);
+	pr_emerg("PFE:PREP:BMU2:ENABLED; HIF_TMU_GPI_RX_TX_IRQ_PE=DISABLED\n");
+	return 0;
+}
+
+/*
+ * Exact queue-context loop from NAS542 stock pfe.ko:tmu_init().
+ *
+ * This is deliberately not called by the RX-only staging driver.  The final
+ * command enables TMU queue processing, so a future caller must first prove
+ * the complete BMU/GPI/CLASS/HIF ownership and pass the board's stock
+ * system_rev value.  Keeping it here makes the otherwise opaque 64-context
+ * sequence reviewable without creating a new runtime side effect.
+ */
+void comcerto_pfe_stock_tmu_queue_contexts(void __iomem *base,
+					    unsigned int stock_system_rev)
+{
+	/* Exact stock tmu_init() tail (pfe.ko 0xe07e..0xe1de): TMU groups 0..2
+	 * use the per-queue variant in CFG0 and 0 in CFG1; group 3 (HIF) uses the
+	 * common value in CFG0 and 0 in CFG1.  NAS542 is C2K RevA1 (rev != 0). */
+	u32 common_cfg = stock_system_rev ? 0x01fc0000 : 0x007c0000;
+	unsigned int group, queue;
+
+	if (!base)
+		return;
+
+	for (group = 0; group < COMCERTO_PFE_TMU_QUEUE_GROUPS; group++) {
+		for (queue = 0; queue < COMCERTO_PFE_TMU_QUEUES_PER_GROUP; queue++) {
+			u32 cfg0;
+
+			if (group == 3)
+				cfg0 = common_cfg;
+			else if (!stock_system_rev)
+				cfg0 = 0x007c0000;
+			else
+				cfg0 = queue ? 0x01400000 : 0x07fc0000;
+			writel((group << 8) | queue, base + COMCERTO_PFE_TMU_QUEUE_CMD);
+			writel(0x00400000, base + COMCERTO_PFE_TMU_QUEUE_ARG);
+			writel(cfg0, base + COMCERTO_PFE_TMU_QUEUE_CFG0);
+			writel(0, base + COMCERTO_PFE_TMU_QUEUE_CFG1);
+		}
+	}
+	writel(0x305, base + COMCERTO_PFE_TMU_QUEUE_CMD);
+	writel(0, base + COMCERTO_PFE_TMU_QUEUE_ARG);
+	writel(5, base + COMCERTO_PFE_TMU_QUEUE_ENABLE);
+	writel(0, base + COMCERTO_PFE_TMU_CTRL);
+}
diff --git a/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-profile.h b/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-profile.h
new file mode 100644
index 000000000..89dfde36a
--- /dev/null
+++ b/drivers/net/ethernet/mindspeed/comcerto-pfe-hw-profile.h
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Stock PFE block profile recovered from NAS542 Linux 3.2.54 pfe.ko.
+ *
+ * This file is intentionally data-only.  Including it does not touch PFE
+ * hardware; activation belongs to the later, ordered hw/HIF/control stage.
+ */
+#ifndef COMCERTO_PFE_HW_PROFILE_H
+#define COMCERTO_PFE_HW_PROFILE_H
+
+#include <linux/types.h>
+
+#define COMCERTO_PFE_DDR_SIZE			0x00c00000
+
+/* Hardware bring-up is promoted one stock step per RAM-only run. */
+#define COMCERTO_PFE_STOCK_HW_PREP_STAGE	11
+#define COMCERTO_PFE_TMU_SNAPSHOT_ONLY		0
+#define COMCERTO_PFE_HIF_ADOPTION_SNAPSHOT_ONLY	1
+
+#define COMCERTO_PFE_BMU1_OFFSET		0x00240000
+#define COMCERTO_PFE_BMU2_OFFSET		0x00250000
+#define COMCERTO_PFE_CLASS_OFFSET		0x00320000
+#define COMCERTO_PFE_TMU_OFFSET		0x00310000
+#define COMCERTO_PFE_UTIL_OFFSET		0x00360000
+#define COMCERTO_PFE_GPI1_OFFSET		0x00210000
+#define COMCERTO_PFE_GPI2_OFFSET		0x00230000
+#define COMCERTO_PFE_GPI3_OFFSET		0x00340000
+#define COMCERTO_PFE_GPI4_OFFSET		0x00290000
+
+struct comcerto_pfe_bmu_profile {
+	u32 buffer_base;
+	u32 buffer_size;
+	u32 interrupt_threshold;
+};
+
+struct comcerto_pfe_gpi_profile {
+	/* Written as (control_hi << 16) | 3 at GPI + 0x08. */
+	u32 control_hi;
+	/* Written verbatim at GPI + 0x4c and GPI + 0x50. */
+	u32 rx_cfg;
+	u32 tx_cfg;
+};
+
+/* Exact invariant writes in stock gpi_set_config(). */
+#define COMCERTO_PFE_GPI_CTRL			0x08
+#define COMCERTO_PFE_GPI_LMEM_ALLOC_ADDR	0x14
+#define COMCERTO_PFE_GPI_LMEM_FREE_ADDR	0x18
+#define COMCERTO_PFE_GPI_DDR_ALLOC_ADDR	0x1c
+#define COMCERTO_PFE_GPI_DDR_FREE_ADDR	0x20
+#define COMCERTO_PFE_GPI_CLASS_ADDR		0x24
+#define COMCERTO_PFE_GPI_DDR_DATA_OFFSET	0x34
+#define COMCERTO_PFE_GPI_LMEM_DATA_OFFSET	0x38
+#define COMCERTO_PFE_GPI_RX_CFG		0x4c
+#define COMCERTO_PFE_GPI_TX_CFG		0x50
+#define COMCERTO_PFE_GPI_AXI_CTRL		0x68
+
+#define COMCERTO_PFE_GPI_LMEM_ALLOC_ADDR_VALUE	0xc0240030
+#define COMCERTO_PFE_GPI_LMEM_FREE_ADDR_VALUE	0xc0240034
+#define COMCERTO_PFE_GPI_DDR_ALLOC_ADDR_VALUE	0xc0250030
+#define COMCERTO_PFE_GPI_DDR_FREE_ADDR_VALUE	0xc0250034
+#define COMCERTO_PFE_GPI_CLASS_ADDR_VALUE	0xc0320010
+#define COMCERTO_PFE_GPI_DDR_DATA_OFFSET_VALUE	0x00000100
+#define COMCERTO_PFE_GPI_LMEM_DATA_OFFSET_VALUE	0x00000010
+
+/* pfe_hw_init() copies these three literal words from .rodata. */
+#define COMCERTO_PFE_BMU1_BUFFER_BASE		0xc0300000
+#define COMCERTO_PFE_BMU1_BUFFER_SIZE		0x00000100
+#define COMCERTO_PFE_BMU1_INT_THRESHOLD	0x00000007
+
+#define COMCERTO_PFE_BMU2_BUFFER_OFFSET	0x00400000
+#define COMCERTO_PFE_BMU2_BUFFER_SIZE		0x00000f00
+#define COMCERTO_PFE_BMU2_INT_THRESHOLD	0x0000000b
+
+#define COMCERTO_PFE_GPI1_CONTROL_HI		0x00000040
+#define COMCERTO_PFE_GPI1_RX_CFG		0x000000bc
+#define COMCERTO_PFE_GPI1_TX_CFG		0x00000050
+
+#define COMCERTO_PFE_GPI2_CONTROL_HI		0x00000040
+#define COMCERTO_PFE_GPI2_RX_CFG		0x000000bc
+#define COMCERTO_PFE_GPI2_TX_CFG		0x00000040
+
+/* pfe_hw_init() copies the GPI2 tuple again for both GPI3 and GPI4. */
+#define COMCERTO_PFE_GPI3_CONTROL_HI		COMCERTO_PFE_GPI2_CONTROL_HI
+#define COMCERTO_PFE_GPI3_RX_CFG		COMCERTO_PFE_GPI2_RX_CFG
+#define COMCERTO_PFE_GPI3_TX_CFG		COMCERTO_PFE_GPI2_TX_CFG
+#define COMCERTO_PFE_GPI4_CONTROL_HI		COMCERTO_PFE_GPI2_CONTROL_HI
+#define COMCERTO_PFE_GPI4_RX_CFG		COMCERTO_PFE_GPI2_RX_CFG
+#define COMCERTO_PFE_GPI4_TX_CFG		COMCERTO_PFE_GPI2_TX_CFG
+
+#define COMCERTO_PFE_CLASS_ROUTE_HASH_BITS	0x0000000f
+/* class_set_config(): route_base = PFE DDR base; 0x80 << hash_bits = 4 MiB. */
+#define COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET	0x00000000
+#define COMCERTO_PFE_CLASS_ROUTE_TABLE_SIZE	0x00400000
+#define COMCERTO_PFE_UTIL_DDR_OFFSET		0x00b80000
+#define COMCERTO_PFE_UTIL_DDR_SIZE		0x0000a270
+#define COMCERTO_PFE_CLASS_DDR_OFFSET		0x00bb0000
+#define COMCERTO_PFE_CLASS_DDR_SIZE		0x00000380
+#define COMCERTO_PFE_TMU_LLM_OFFSET		0x00bc0000
+#define COMCERTO_PFE_TMU_LLM_QUEUE_LEN		0x00001000
+/* Stock PFE: four TMUs, 16 queues each, one byte per queue entry. */
+#define COMCERTO_PFE_TMU_LLM_SIZE \
+	(4 * 16 * COMCERTO_PFE_TMU_LLM_QUEUE_LEN)
+#define COMCERTO_PFE_TMU_INPUT_ENABLE		0x00000001
+#define COMCERTO_PFE_TMU_AXI_CTRL			0x00000003
+#define COMCERTO_PFE_TMU_SYS_GENERIC_CTRL	0x00000005
+#define COMCERTO_PFE_TMU_INQ_WATERMARK		0x000002ee
+
+/* The fixed PFE-DDR map must remain inside the 12 MiB NAS542 aperture. */
+static_assert(COMCERTO_PFE_CLASS_ROUTE_TABLE_OFFSET +
+	      COMCERTO_PFE_CLASS_ROUTE_TABLE_SIZE <= COMCERTO_PFE_DDR_SIZE);
+static_assert(COMCERTO_PFE_UTIL_DDR_OFFSET + COMCERTO_PFE_UTIL_DDR_SIZE <=
+	      COMCERTO_PFE_DDR_SIZE);
+static_assert(COMCERTO_PFE_CLASS_DDR_OFFSET + COMCERTO_PFE_CLASS_DDR_SIZE <=
+	      COMCERTO_PFE_DDR_SIZE);
+static_assert(COMCERTO_PFE_TMU_LLM_OFFSET + COMCERTO_PFE_TMU_LLM_SIZE ==
+	      COMCERTO_PFE_DDR_SIZE);
+
+/* The completed hardware stage must retain this stock dependency order. */
+enum comcerto_pfe_stock_init_step {
