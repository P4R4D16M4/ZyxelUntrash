+static int comcerto_pfe_hif_poll(struct napi_struct *napi, int budget)
+{
+	struct comcerto_pfe_port *pfe =
+		container_of(napi, struct comcerto_pfe_port, napi);
+	int done = 0;
+
+	atomic_inc(&pfe->hif_napi_seen);
+
+	while (done < budget && comcerto_pfe_hif_rx_desc_ready(
+			&pfe->hif_rx_desc[pfe->rx_head])) {
+		/* Packet delivery is added with GEMAC/PHY registration, not here. */
+		comcerto_pfe_hif_recycle_rx_desc(&pfe->hif_rx_desc[pfe->rx_head],
+			pfe->rx_ring.buffer_len);
+		pfe->rx_head = (pfe->rx_head + 1) % pfe->rx_ring.count;
+		done++;
+	}
+
+	if (done < budget)
+		/* Ack the RX gate before accepting the next HIF interrupt. */
+		writel(COMCERTO_PFE_HIF_INT_GATE | COMCERTO_PFE_HIF_INT_RX,
+		       pfe->hif + COMCERTO_PFE_HIF_INT_STATUS);
+	if (done < budget)
+		napi_complete_done(napi, done);
+	if (done < budget)
+		writel(readl(pfe->hif + COMCERTO_PFE_HIF_INT_ENABLE) |
+		       COMCERTO_PFE_HIF_RX_INT_ENABLE,
+		       pfe->hif + COMCERTO_PFE_HIF_INT_ENABLE);
+	atomic_add(done, &pfe->hif_rx_recycled);
+	return done;
+}
+
+static irqreturn_t comcerto_pfe_hif_irq(int irq, void *data)
+{
+	struct comcerto_pfe_port *pfe = data;
+	u32 status = readl(pfe->hif + COMCERTO_PFE_HIF_INT_STATUS);
+
+	if (!(status & COMCERTO_PFE_HIF_INT_GATE))
+		return IRQ_NONE;
+	WRITE_ONCE(pfe->hif_last_irq_status, status);
+	atomic_inc(&pfe->hif_irq_seen);
+	if (status & COMCERTO_PFE_HIF_INT_RX) {
+		atomic_inc(&pfe->hif_rx_irq_seen);
+		writel(0, pfe->hif + COMCERTO_PFE_HIF_INT_ENABLE);
+		napi_schedule_irqoff(&pfe->napi);
+	}
+	/* Stock ISR leaves the RX gate for NAPI and acks unrelated status bits. */
+	writel(status & ~(COMCERTO_PFE_HIF_INT_GATE |
+			 COMCERTO_PFE_HIF_INT_RX),
+	       pfe->hif + COMCERTO_PFE_HIF_INT_STATUS);
+	return IRQ_HANDLED;
+}
+
+static void comcerto_pfe_release_napi(void *data)
+{
+	struct comcerto_pfe_port *pfe = data;
+
+	if (pfe->hif_rx_enabled) {
+		writel(0, pfe->hif + COMCERTO_PFE_HIF_INT_ENABLE);
+		writel(0, pfe->hif + COMCERTO_PFE_HIF_RX_CTRL);
+		napi_disable(&pfe->napi);
+	}
+	netif_napi_del(&pfe->napi);
+	free_netdev(pfe->napi_dev);
+}
