+int comcerto_pfe_ctrl_validate_tx_command_ingress(void)
+{
+	const struct comcerto_pfe_ctrl_tx_configure_payload payload = {
+		.physical_port = 1,
+		.value = { 0xc0, 0xc1, 0xc2, 0xc3, 0xc4, 0xc5 },
+	};
+	struct comcerto_pfe_ctrl_tx_configure_payload invalid = payload;
+	struct comcerto_pfe_ctrl_command_record record = { };
+	struct comcerto_pfe_ctrl_phy_port ports[COMCERTO_PFE_CTRL_PHY_PORT_COUNT];
+	u8 codes[COMCERTO_PFE_CTRL_PHY_PORT_COUNT] = {
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+		COMCERTO_PFE_CTRL_PHY_PORT_CODE_ETH,
+	};
+	u16 completion = 0;
+	int handler_result;
+
+	/* __pfe_ctrl_cmd_handler() copies caller bytes into a private 0x110-byte
+	 * record, invokes the already-selected handler, stores its result at the
+	 * record base, and reports completion=2 only for result zero.  Model that
+	 * envelope locally; record, ports and payload all die at return. */
+	if (comcerto_pfe_ctrl_fcode_to_event(
+		    COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE) !=
+	    COMCERTO_PFE_CTRL_COMMAND_EVENT_TX)
+		return -EINVAL;
+	comcerto_pfe_ctrl_prepare_phy_ports(ports, codes);
+	memcpy(&record, &payload, sizeof(payload));
+	handler_result = comcerto_pfe_ctrl_apply_tx_command_local(
+		COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(payload),
+		(const struct comcerto_pfe_ctrl_tx_configure_payload *)&record,
+		&ports[payload.physical_port]);
+	record.status = handler_result;
+	if (!handler_result)
+		completion = COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED;
+	if (record.status || completion !=
+	    COMCERTO_PFE_CTRL_COMMAND_STATUS_HANDLED ||
+	    memcmp((u8 *)&ports[1] + COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_OFFSET,
+		   payload.value, COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES) ||
+	    !(((u8 *)&ports[1])[COMCERTO_PFE_CTRL_PHY_PORT_TX_ENABLE_OFFSET] &
+	      BIT(0)))
+		return -EINVAL;
+
+	/* Handler failure is preserved in the record and does not signal the
+	 * synchronous success completion.  This uses a fresh local record and
+	 * rejects before any selected port is handed to the local handler. */
+	invalid.physical_port = COMCERTO_PFE_CTRL_PHY_PORT_COUNT;
+	memset(&record, 0, sizeof(record));
+	memcpy(&record, &invalid, sizeof(invalid));
+	completion = 0;
+	handler_result = comcerto_pfe_ctrl_apply_tx_command_local(
+		COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE, sizeof(invalid),
+		(const struct comcerto_pfe_ctrl_tx_configure_payload *)&record,
+		&ports[0]);
+	record.status = handler_result;
+	if (!handler_result || !record.status || completion)
+		return -EINVAL;
+	return 0;
+}
