+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Verified Comcerto 2000 ClockCore reset identifiers. */
+#ifndef _DT_BINDINGS_RESET_COMCERTO_2000_H
+#define _DT_BINDINGS_RESET_COMCERTO_2000_H
+
+/* AXI_RESET_2 at ClockCore offset 0x54, bit 3. */
+#define COMCERTO2000_RESET_AXI_PFE_SYS	0x02a3
+/* PFE_RESET at ClockCore offset 0x108, bit 0. */
+#define COMCERTO2000_RESET_PFE_CORE		0x0840
+
+#endif
