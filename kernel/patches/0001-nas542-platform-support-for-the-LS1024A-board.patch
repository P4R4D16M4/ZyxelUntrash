+/* This is intentionally called before any PFE resource mapping or MMIO.  It
+ * establishes only Linux-owned bridge bookkeeping; no stock bridge service is
+ * made runnable by this helper. */
+static int comcerto_pfe_prepare_bridge_host(struct comcerto_pfe_port *pfe)
+{
+	int ret;
+
+	ret = comcerto_pfe_ctrl_validate_bridge_plan();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_lifecycle();
+	if (ret)
+		return ret;
+	comcerto_pfe_ctrl_prepare_bridge_interfaces(pfe->bridge_interfaces);
+	ret = comcerto_pfe_ctrl_validate_bridge_interfaces(pfe->bridge_interfaces);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector8_payload();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_interface_lifecycle();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector9_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector10_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector11_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_query_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector13_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_control_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_flush_contract();
+	if (ret)
+		return ret;
+	comcerto_pfe_ctrl_prepare_command_record(&pfe->bridge_command_record);
+	ret = comcerto_pfe_ctrl_validate_empty_command_record(
+		&pfe->bridge_command_record);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_async_command_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_async_command_allocation();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_async_command_queue();
+	if (ret)
+		return ret;
+	comcerto_pfe_ctrl_prepare_async_command_state(&pfe->async_commands);
+	ret = comcerto_pfe_ctrl_validate_async_command_state(&pfe->async_commands);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_command_contract();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_eth_state_command();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_command_local_lifecycle();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_command_dmem_mirror();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_command_port_isolation();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_local_dispatcher();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_command_ingress();
+	if (ret)
+		return ret;
+	comcerto_pfe_ctrl_prepare_dispatch_state(&pfe->ctrl_dispatch);
+	ret = comcerto_pfe_ctrl_validate_dispatch_state(&pfe->ctrl_dispatch);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_fcode_map();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_tx_dispatch_route();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_selector_map();
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_operation_gate();
+	if (ret)
+		return ret;
+	mutex_init(&pfe->bridge_dispatch_lock);
+	mutex_lock(&pfe->bridge_dispatch_lock);
+	ret = comcerto_pfe_ctrl_validate_no_handler_dispatch(
+		&pfe->ctrl_dispatch,
+		&pfe->bridge_command_record);
+	mutex_unlock(&pfe->bridge_dispatch_lock);
+	if (ret)
+		return ret;
+	/* The proof record is private and transient; retain no synthetic command
+	 * status in the disabled bridge object. */
+	comcerto_pfe_ctrl_prepare_command_record(&pfe->bridge_command_record);
+	ret = comcerto_pfe_ctrl_validate_empty_command_record(
+		&pfe->bridge_command_record);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_create_bridge_caches(&pfe->bridge_caches);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(pfe->dev,
+		comcerto_pfe_release_bridge_caches, pfe);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_bridge_caches(&pfe->bridge_caches);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_create_dma_pools(pfe->dev, &pfe->ctrl_pools);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(pfe->dev,
+		comcerto_pfe_release_ctrl_dma_pools, pfe);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_validate_dma_pools(&pfe->ctrl_pools);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_probe_dma_pools(&pfe->ctrl_pools);
+	if (ret)
+		return ret;
+	timer_setup(&pfe->bridge_delayed_removal_timer,
+		    comcerto_pfe_bridge_timer_disabled, 0);
+	timer_setup(&pfe->bridge_timer, comcerto_pfe_bridge_timer_disabled, 0);
+	if (timer_pending(&pfe->bridge_delayed_removal_timer) ||
+	    timer_pending(&pfe->bridge_timer))
+		return -EIO;
+	ret = devm_add_action_or_reset(pfe->dev,
+		comcerto_pfe_release_bridge_timers, pfe);
+	if (ret)
+		return ret;
+	ret = comcerto_pfe_ctrl_create_bridge_lists(&pfe->bridge_lists);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(pfe->dev,
+		comcerto_pfe_release_bridge_lists, pfe);
+	if (ret)
+		return ret;
+	return comcerto_pfe_ctrl_validate_bridge_lists(&pfe->bridge_lists);
+}
