diff --git a/drivers/clk/clk-comcerto.c b/drivers/clk/clk-comcerto.c
new file mode 100644
index 000000000..1fdfbddc8
--- /dev/null
+++ b/drivers/clk/clk-comcerto.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mindspeed Comcerto 2000 ClockCore provider, initial read-only stage.
+ *
+ * V334 established these addresses and V337 established the matching native
+ * reset provider.  This driver deliberately implements only is_enabled():
+ * inherited Barebox clocks must not be changed before a full source/divider
+ * reconstruction has been hardware-proven.
+ */
+#include <linux/clk-provider.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <dt-bindings/clock/comcerto-2000.h>
+
+#define COMCERTO2000_CLK_COUNT	(COMCERTO2000_CLK_PFE_SYS + 1)
+
+struct comcerto_clk {
+	struct clk_hw hw;
+	struct regmap *regmap;
+	unsigned int offset;
+	unsigned int mask;
+};
+
+#define to_comcerto_clk(_hw) container_of(_hw, struct comcerto_clk, hw)
+
+static int comcerto_clk_is_enabled(struct clk_hw *hw)
+{
+	struct comcerto_clk *clk = to_comcerto_clk(hw);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(clk->regmap, clk->offset, &value);
+	if (ret)
+		return ret;
+
+	return !!(value & clk->mask);
+}
+
+static const struct clk_ops comcerto_clk_status_ops = {
+	.is_enabled = comcerto_clk_is_enabled,
+};
+
+static int comcerto_clk_register_status(struct device *dev,
+		struct regmap *regmap, struct clk_hw_onecell_data *data,
+		unsigned int id, const char *name, unsigned int offset,
+		unsigned int mask)
+{
+	struct comcerto_clk *clk;
+	struct clk_init_data init = {
+		.name = name,
+		.ops = &comcerto_clk_status_ops,
+	};
+	int ret;
+
+	clk = devm_kzalloc(dev, sizeof(*clk), GFP_KERNEL);
+	if (!clk)
+		return -ENOMEM;
+
+	clk->regmap = regmap;
+	clk->offset = offset;
+	clk->mask = mask;
+	clk->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &clk->hw);
+	if (ret)
+		return ret;
+
+	data->hws[id] = &clk->hw;
+	return 0;
+}
+
+static int comcerto_clk_probe(struct platform_device *pdev)
+{
+	struct clk_hw_onecell_data *data;
+	struct regmap *regmap;
+	int ret;
+
+	regmap = syscon_node_to_regmap(pdev->dev.of_node);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	data = devm_kzalloc(&pdev->dev, struct_size(data, hws,
+			COMCERTO2000_CLK_COUNT), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->num = COMCERTO2000_CLK_COUNT;
+
+	/* PFE core clock generator: control register 0x100, enable bit 0. */
+	ret = comcerto_clk_register_status(&pdev->dev, regmap, data,
+		COMCERTO2000_CLK_PFE_CORE, "comcerto-pfe-core",
+		0x100, BIT(0));
+	if (ret)
+		return ret;
+	/* PFE AXI slave gate: AXI_CLK_CNTRL1 (0x44), bit 3. */
+	ret = comcerto_clk_register_status(&pdev->dev, regmap, data,
+		COMCERTO2000_CLK_PFE_SYS, "comcerto-pfe-sys",
+		0x44, BIT(3));
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(&pdev->dev, of_clk_hw_onecell_get,
+					   data);
+}
+
+static const struct of_device_id comcerto_clk_of_match[] = {
+	{ .compatible = "mindspeed,comcerto-2000-clkcore" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, comcerto_clk_of_match);
+
+static struct platform_driver comcerto_clk_driver = {
+	.probe = comcerto_clk_probe,
+	.driver = {
+		.name = "comcerto-2000-clkcore",
+		.of_match_table = comcerto_clk_of_match,
+	},
+};
+module_platform_driver(comcerto_clk_driver);
+
+MODULE_DESCRIPTION("Mindspeed Comcerto 2000 ClockCore status provider");
+MODULE_LICENSE("GPL");
