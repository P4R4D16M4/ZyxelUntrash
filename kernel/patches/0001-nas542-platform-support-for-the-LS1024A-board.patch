+/*
+ * V547 (V546 corrected): first live publication of the stock TX port command for the PHY-4
+ * port.  Stock platform data maps eth0/egiga0 (GEMAC1, PHY 4) to FPP
+ * physical_port 0 (reports/PFE-PHYSICAL-PORT-MAPPING.md).  The sequence is
+ * the stock M_tx_cmdproc data path without a PE stop/start:
+ *   0x0501 configure: six value bytes, then the enable byte, on all six
+ *          CLASS PEs, then the UTIL enable byte;
+ *   hold 100 ms and re-verify;
+ *   0x0502 disable:   clear the same seven enable bytes (value retained);
+ * and finally the six value bytes are restored to their pre-run snapshot so
+ * that DMEM ends byte-for-byte identical.  GEMAC, MDIO, GPI and HIF TX stay
+ * disabled throughout; on any failure the snapshot is restored best-effort.
+ * The value is a locally administered test address, not a board MAC.
+ */
+#define V546_UTIL_PE	10
+#define V546_BYTE(word, off)	(((word) >> ((3 - ((off) & 3)) * 8)) & 0xff)
+
+struct v546_snapshot {
+	u32 value_lo[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];	/* value bytes 0..3 */
+	u32 value_hi[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];	/* bytes 4,5,pad,enable */
+	u32 util;
+};
+
+static int v546_read(void __iomem *axi, const struct comcerto_pfe_ctrl_tx_command_plan *p,
+		     struct v546_snapshot *s)
+{
+	unsigned int pe;
+	int ret;
+
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		ret = comcerto_pfe_read_dmem_word(axi, pe, p->class_value_offset,
+						  &s->value_lo[pe]);
+		if (!ret)
+			ret = comcerto_pfe_read_dmem_word(axi, pe,
+					p->class_value_offset + 4, &s->value_hi[pe]);
+		if (ret)
+			return ret;
+	}
+	return comcerto_pfe_read_dmem_word(axi, V546_UTIL_PE,
+					   p->util_enable_offset & ~3u, &s->util);
+}
+
+/* Writes value bytes (if @value) and the seven enable bytes. */
+static int v546_write(void __iomem *axi, const struct comcerto_pfe_ctrl_tx_command_plan *p,
+		      const u8 *value_per_pe, bool write_value, u8 enable)
+{
+	unsigned int pe, i;
+	int ret;
+
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		for (i = 0; write_value && i < COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES; i++) {
+			ret = comcerto_pfe_write_dmem_byte(axi, pe,
+				p->class_value_offset + i,
+				value_per_pe[pe * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES + i]);
+			if (ret)
+				return ret;
+		}
+		ret = comcerto_pfe_write_dmem_byte(axi, pe, p->class_enable_offset, enable);
+		if (ret)
+			return ret;
+	}
+	return comcerto_pfe_write_dmem_byte(axi, V546_UTIL_PE, p->util_enable_offset, enable);
+}
+
+static bool v546_matches(const struct comcerto_pfe_ctrl_tx_command_plan *p,
+			 const struct v546_snapshot *s, const u8 *value_per_pe,
+			 const struct v546_snapshot *pre, u8 enable)
+{
+	unsigned int pe;
+
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		const u8 *v = value_per_pe + pe * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES;
+		u32 lo = (u32)v[0] << 24 | (u32)v[1] << 16 | (u32)v[2] << 8 | v[3];
+		/* byte +14 (pad) is never written and must keep its snapshot value */
+		u32 hi = (u32)v[4] << 24 | (u32)v[5] << 16 |
+			 (pre->value_hi[pe] & 0x0000ff00) | enable;
+
+		if (s->value_lo[pe] != lo || s->value_hi[pe] != hi)
+			return false;
+	}
+	return V546_BYTE(s->util, p->util_enable_offset) == enable &&
+	       (s->util & ~(0xffu << ((3 - (p->util_enable_offset & 3)) * 8))) ==
+	       (pre->util & ~(0xffu << ((3 - (p->util_enable_offset & 3)) * 8)));
+}
+
+static int comcerto_pfe_v547_port0_tx_command(struct comcerto_pfe_port *pfe, void __iomem *axi)
+{
+	static const u8 test_value[COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES] = {
+		0x02, 0x5a, 0x54, 0x00, 0x05, 0x46,	/* locally administered */
+	};
+	struct comcerto_pfe_ctrl_tx_configure_payload payload = { .physical_port = 0 };
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	u8 orig[COMCERTO_PFE_CTRL_CLASS_PE_COUNT * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES];
+	u8 test[sizeof(orig)];
+	struct v546_snapshot pre, now;
+	struct device *dev = pfe->dev;
+	u32 class_base, util_base;
+	unsigned int pe;
+	int ret;
+
+	memcpy(payload.value, test_value, sizeof(test_value));
+	ret = comcerto_pfe_ctrl_plan_tx_command(COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE,
+						sizeof(payload), &payload, &plan);
+	if (ret || plan.physical_port != 0)
+		return dev_err_probe(dev, ret ?: -EINVAL, "V547 plan rejected\n");
+	/* V546 used the plan's .dmem_sh-relative offsets as absolute DMEM
+	 * addresses and correctly refused: CLASS 0x9bf lies in .dmem_lit4.
+	 * Translate with the loaded .dmem_sh destination, derived from the
+	 * firmware-discovered sync mailboxes and cross-checked against the
+	 * offline ELF analysis before any access. */
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++)
+		if (!(pfe->pe_sync_valid & BIT(pe)) ||
+		    pfe->pe_sync_mailbox[pe] != pfe->pe_sync_mailbox[0])
+			return dev_err_probe(dev, -EINVAL, "V547 CLASS mailbox map invalid\n");
+	if (!(pfe->pe_sync_valid & BIT(V546_UTIL_PE)))
+		return dev_err_probe(dev, -EINVAL, "V547 UTIL mailbox map invalid\n");
+	class_base = pfe->pe_sync_mailbox[0] - COMCERTO_PFE_CTRL_CLASS_SYNC_MAILBOX_OFFSET;
+	util_base = pfe->pe_sync_mailbox[V546_UTIL_PE] - COMCERTO_PFE_CTRL_UTIL_SYNC_MAILBOX_OFFSET;
+	if (class_base != 0xb20 || util_base != 0x16c0)
+		return dev_err_probe(dev, -EINVAL,
+			"V547 unexpected .dmem_sh bases class=%x util=%x\n", class_base, util_base);
+	plan.class_value_offset += class_base;
+	plan.class_enable_offset += class_base;
+	plan.util_enable_offset += util_base;
+	dev_emerg(dev, "PFE:V547:TXCMD_P0:TARGETS;CV=%04x:CE=%04x:UE=%04x\n",
+		  plan.class_value_offset, plan.class_enable_offset, plan.util_enable_offset);
+
+	ret = v546_read(axi, &plan, &pre);
+	if (ret)
+		return dev_err_probe(dev, ret, "V547 snapshot unreadable\n");
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		u8 *o = orig + pe * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES;
+
+		o[0] = pre.value_lo[pe] >> 24; o[1] = pre.value_lo[pe] >> 16;
+		o[2] = pre.value_lo[pe] >> 8;  o[3] = pre.value_lo[pe];
+		o[4] = pre.value_hi[pe] >> 24; o[5] = pre.value_hi[pe] >> 16;
+		memcpy(test + pe * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES,
+		       test_value, sizeof(test_value));
+		if (pre.value_hi[pe] & 0xff)
+			return dev_err_probe(dev, -EBUSY,
+				"V547 requires port 0 disabled at CLASS PE %u\n", pe);
+	}
+	if (V546_BYTE(pre.util, plan.util_enable_offset))
+		return dev_err_probe(dev, -EBUSY, "V547 requires port 0 UTIL flag clear\n");
+	dev_emerg(dev, "PFE:V547:TXCMD_P0:PRE;V=%08x%04x;UTIL=%08x\n",
+		  pre.value_lo[0], pre.value_hi[0] >> 16, pre.util);
+
+	/* 0x0501 configure */
+	ret = v546_write(axi, &plan, test, true, BIT(0));
+	if (!ret)
+		ret = v546_read(axi, &plan, &now);
+	if (ret || !v546_matches(&plan, &now, test, &pre, BIT(0))) {
+		ret = ret ?: -EIO;
+		goto restore;
+	}
+	dev_emerg(dev, "PFE:V547:TXCMD_P0_CONFIGURED\n");
+	msleep(100);
+	ret = v546_read(axi, &plan, &now);
+	if (ret || !v546_matches(&plan, &now, test, &pre, BIT(0))) {
+		ret = ret ?: -EIO;
+		goto restore;
+	}
+	dev_emerg(dev, "PFE:V547:TXCMD_P0_STABLE_100MS\n");
+
+	/* 0x0502 disable: stock clears only the enable bytes */
+	ret = v546_write(axi, &plan, NULL, false, 0);
+	if (!ret)
+		ret = v546_read(axi, &plan, &now);
+	if (ret || !v546_matches(&plan, &now, test, &pre, 0)) {
+		ret = ret ?: -EIO;
+		goto restore;
+	}
+	dev_emerg(dev, "PFE:V547:TXCMD_P0_DISABLED;VALUE_RETAINED\n");
+
+restore:
+	{
+		int r = v546_write(axi, &plan, orig, true, 0);
+
+		if (!r)
+			r = v546_read(axi, &plan, &now);
+		if (r || memcmp(&now, &pre, sizeof(pre))) {
+			dev_emerg(dev, "PFE:V547:RESTORE_FAILED\n");
+			return dev_err_probe(dev, r ?: -EIO, "V547 restore failed\n");
+		}
+	}
+	if (ret)
+		return dev_err_probe(dev, ret, "V547 failed; snapshot restored\n");
+	dev_emerg(dev, "PFE:V547:TXCMD_P0_RESTORED=OK\n");
+	return 0;
+}
+
+/*
+ * V548: first instrumented MDIO read of PHY 4, reproducing the stock order
+ * mdiobus_register() -> pfe_eth_mdio_reset() -> PHY scan.  Stock platform data
+ * (kernel 0x849cce68) gives MDIO bus 0: enabled, phy_mask 0xffffffaf (PHY 4
+ * and 6), mdc_div 96.  After Barebox and the PFE reset GEMAC1 CONFIG holds
+ * divider 32 (V513R1), i.e. MDC 7.8 MHz; V515r1 never applied the stock 96.
+ * Every step emits a marker first (lossless UART), all waits are bounded
+ * busy-waits, only Clause-22 reads of PHY 4 registers 2/3 are issued, and
+ * GEMAC1 ECNTRL/CONFIG are restored afterwards whatever the outcome.
+ */
+static int v548_wait_idle(void __iomem *g, unsigned int loops, unsigned int us,
+			  u32 *status)
+{
+	unsigned int i;
+
+	for (i = 0; i < loops; i++) {
+		*status = readl(g + COMCERTO_PFE_GEMAC_MII_STATUS);
+		if (*status & COMCERTO_PFE_GEMAC_MII_DONE)
+			return i;
+		udelay(us);
+	}
+	return -ETIMEDOUT;
+}
+
+static int v548_phy_read(struct device *dev, void __iomem *g, int phy, int reg, u32 *val)
+{
+	u32 cmd = COMCERTO_PFE_MDIO_READ | COMCERTO_PFE_MDIO_START |
+		  (phy << COMCERTO_PFE_MDIO_PHY_SHIFT) |
+		  (reg << COMCERTO_PFE_MDIO_REG_SHIFT);
+	u32 status;
+	int n;
+
+	dev_emerg(dev, "PFE:V548:MAN_WRITE;R%d=%08x\n", reg, cmd);
+	writel(cmd, g + COMCERTO_PFE_MDIO_COMMAND);
+	dev_emerg(dev, "PFE:V548:MAN_WRITTEN;R%d\n", reg);
+	udelay(1);
+	n = v548_wait_idle(g, 1001, 10, &status);	/* stock: 1001 x udelay(10) */
+	*val = readl(g + COMCERTO_PFE_MDIO_COMMAND);
+	dev_emerg(dev, "PFE:V548:R%d;LOOPS=%d:STS=%08x:MAN=%08x\n", reg, n, status, *val);
+	return n < 0 ? n : 0;
+}
+
+static void comcerto_pfe_v548_phy4_mdio_probe(struct device *dev, void __iomem *axi)
+{
+	void __iomem *g = axi + COMCERTO_PFE_GEMAC1_OFFSET;
+	u32 ectl, cfg, status, id1 = 0, id2 = 0;
+	int n, r1, r2;
+
+	ectl = readl(g + COMCERTO_PFE_GEMAC_ECNTRL);
+	cfg = readl(g + COMCERTO_PFE_GEMAC_CONFIG);
+	status = readl(g + COMCERTO_PFE_GEMAC_MII_STATUS);
+	dev_emerg(dev, "PFE:V548:PRE;E=%08x:C=%08x:S=%08x\n", ectl, cfg, status);
+
+	dev_emerg(dev, "PFE:V548:MDC_DIV96\n");
+	comcerto_pfe_mdio_set_mdc_div(g, 96);
+	dev_emerg(dev, "PFE:V548:MPE_ON;C=%08x\n", readl(g + COMCERTO_PFE_GEMAC_CONFIG));
+	writel(ectl | COMCERTO_PFE_GEMAC_ECNTRL_MII, g + COMCERTO_PFE_GEMAC_ECNTRL);
+	n = v548_wait_idle(g, 1001, 1, &status);
+	dev_emerg(dev, "PFE:V548:MPE_IDLE;LOOPS=%d:S=%08x\n", n, status);
+
+	r1 = n < 0 ? n : v548_phy_read(dev, g, 4, 2, &id1);
+	r2 = r1 ? r1 : v548_phy_read(dev, g, 4, 3, &id2);
+
+	writel(ectl, g + COMCERTO_PFE_GEMAC_ECNTRL);
+	writel(cfg, g + COMCERTO_PFE_GEMAC_CONFIG);
+	wmb();
+	dev_emerg(dev, "PFE:V548:PHY4_ID=%04x:%04x;RC=%d/%d;RESTORED E=%08x:C=%08x\n",
+		  id1 & 0xffff, id2 & 0xffff, r1, r2,
+		  readl(g + COMCERTO_PFE_GEMAC_ECNTRL),
+		  readl(g + COMCERTO_PFE_GEMAC_CONFIG));
+	dev_emerg(dev, "PFE:V548:MDIO_DONE\n");
+}
+
+/*
+ * V549: register a real Linux mii_bus on GEMAC1's MDIO (stock bus 0) and let
+ * phylib scan it, mirroring stock pfe_eth_init(): mdiobus_alloc(), read/write/
+ * reset callbacks, phy_mask 0xffffffaf (PHY 4 and 6), mdc_div 96.  V548 proved
+ * the raw transaction (PHY 4 = RTL8211E 0x001cc915).  Only Clause-22 reads are
+ * issued (scan + status registers); phylib binding performs no PHY write
+ * because no net_device attaches.  The bus is unregistered and GEMAC1
+ * ECNTRL/CONFIG are restored afterwards.
+ */
+#define V549_PHY_MASK	0xffffffafU
+
+static int v549_mdio_read(struct mii_bus *bus, int phy, int reg)
+{
+	void __iomem *g = bus->priv;
+	u32 status;
+
+	writel(COMCERTO_PFE_MDIO_READ | COMCERTO_PFE_MDIO_START |
+	       (phy << COMCERTO_PFE_MDIO_PHY_SHIFT) |
+	       (reg << COMCERTO_PFE_MDIO_REG_SHIFT), g + COMCERTO_PFE_MDIO_COMMAND);
+	udelay(1);
+	if (v548_wait_idle(g, 1001, 10, &status) < 0)
+		return -ETIMEDOUT;
+	return readl(g + COMCERTO_PFE_MDIO_COMMAND) & 0xffff;
+}
+
+static int v549_mdio_write(struct mii_bus *bus, int phy, int reg, u16 val)
+{
+	/* Not expected in V549 (no attach); refuse rather than touch the PHY. */
+	dev_emerg(&bus->dev, "PFE:V549:UNEXPECTED_MDIO_WRITE;P%d:R%d=%04x;REFUSED\n",
+		  phy, reg, val);
+	return -EPERM;
+}
+
+static int v549_mdio_reset(struct mii_bus *bus)
+{
+	void __iomem *g = bus->priv;
+	u32 status;
+
+	comcerto_pfe_mdio_set_mdc_div(g, 96);
+	writel(readl(g + COMCERTO_PFE_GEMAC_ECNTRL) | COMCERTO_PFE_GEMAC_ECNTRL_MII,
+	       g + COMCERTO_PFE_GEMAC_ECNTRL);
+	return v548_wait_idle(g, 1001, 1, &status) < 0 ? -ETIMEDOUT : 0;
+}
+
+static void __maybe_unused comcerto_pfe_v549_mii_bus_probe(struct device *dev, void __iomem *axi)
+{
+	void __iomem *g = axi + COMCERTO_PFE_GEMAC1_OFFSET;
+	u32 ectl = readl(g + COMCERTO_PFE_GEMAC_ECNTRL);
+	u32 cfg = readl(g + COMCERTO_PFE_GEMAC_CONFIG);
+	struct phy_device *phy;
+	struct mii_bus *bus;
+	int ret, bmsr1, bmsr2, bmcr, lpa, physr;
+
+	bus = mdiobus_alloc();
+	if (!bus) {
+		dev_emerg(dev, "PFE:V549:ALLOC_FAILED\n");
+		goto done;
+	}
+	bus->name = "comcerto-pfe-mdio";
+	snprintf(bus->id, MII_BUS_ID_SIZE, "pfe-mdio-0");
+	bus->priv = g;
+	bus->parent = dev;
+	bus->read = v549_mdio_read;
+	bus->write = v549_mdio_write;
+	bus->reset = v549_mdio_reset;
+	bus->phy_mask = V549_PHY_MASK;
+	dev_emerg(dev, "PFE:V549:REGISTER;MASK=%08x\n", bus->phy_mask);
+	ret = mdiobus_register(bus);
+	if (ret) {
+		dev_emerg(dev, "PFE:V549:REGISTER_FAILED=%d\n", ret);
+		mdiobus_free(bus);
+		goto done;
+	}
+	phy = mdiobus_get_phy(bus, 4);
+	dev_emerg(dev, "PFE:V549:PHY4=%s;ID=%08x;DRV=%s;PHY6=%s\n",
+		  phy ? "found" : "absent", phy ? phy->phy_id : 0,
+		  phy && phy->drv ? phy->drv->name : "unbound",
+		  mdiobus_get_phy(bus, 6) ? "found" : "absent");
+	bmcr = mdiobus_read(bus, 4, MII_BMCR);
+	bmsr1 = mdiobus_read(bus, 4, MII_BMSR);	/* clears latched-low link */
+	bmsr2 = mdiobus_read(bus, 4, MII_BMSR);
+	lpa = mdiobus_read(bus, 4, MII_LPA);
+	physr = mdiobus_read(bus, 4, 0x11);	/* RTL8211E PHY specific status */
+	dev_emerg(dev, "PFE:V549:PHY4_STATUS;BMCR=%04x:BMSR=%04x/%04x:LPA=%04x:PHYSR=%04x;LINK=%s\n",
+		  bmcr & 0xffff, bmsr1 & 0xffff, bmsr2 & 0xffff, lpa & 0xffff,
+		  physr & 0xffff, (bmsr2 >= 0 && (bmsr2 & BMSR_LSTATUS)) ? "UP" : "DOWN");
+	mdiobus_unregister(bus);
+	mdiobus_free(bus);
+done:
+	writel(ectl, g + COMCERTO_PFE_GEMAC_ECNTRL);
+	writel(cfg, g + COMCERTO_PFE_GEMAC_CONFIG);
+	wmb();
+	dev_emerg(dev, "PFE:V549:MII_BUS_DONE;RESTORED E=%08x:C=%08x\n",
+		  readl(g + COMCERTO_PFE_GEMAC_ECNTRL), readl(g + COMCERTO_PFE_GEMAC_CONFIG));
+}
+
+/*
+ * V551: first bounded host-RX window (gate 4).  Runs inside the V550 attach
+ * after link-up.  Stock host roles (V542): HIF +0x24 = PFE->host ring filled
+ * with host buffers + OWN (V85 macro "TX_BASE"), HIF +0x10 = host->PFE chain
+ * (V85 "RX_BASE"); hif_rx_enable() writes 5 to +0x20.  Order: port 0
+ * configure (0x0501, test value) -> EGPI1 enable -> HIF RX ctrl 5 (no IRQ,
+ * polled) -> GEMAC1 NCR RX enable; poll 5 s; then the exact reverse with the
+ * port record and every touched register restored.  No TX of any kind.
+ */
+#define V551_WINDOW_MS	5000
+#define V551_DUMP	4
+
+static int v551_port0_plan(struct comcerto_pfe_port *pfe,
+			   struct comcerto_pfe_ctrl_tx_command_plan *plan)
+{
+	struct comcerto_pfe_ctrl_tx_configure_payload payload = { .physical_port = 0 };
+	u32 cb, ub;
+
+	if (comcerto_pfe_ctrl_plan_tx_command(COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE,
+					      sizeof(payload), &payload, plan))
+		return -EINVAL;
+	cb = pfe->pe_sync_mailbox[0] - COMCERTO_PFE_CTRL_CLASS_SYNC_MAILBOX_OFFSET;
+	ub = pfe->pe_sync_mailbox[V546_UTIL_PE] - COMCERTO_PFE_CTRL_UTIL_SYNC_MAILBOX_OFFSET;
+	if (cb != 0xb20 || ub != 0x16c0)
+		return -EINVAL;
+	plan->class_value_offset += cb;
+	plan->class_enable_offset += cb;
+	plan->util_enable_offset += ub;
+	return 0;
+}
+
+/* V558: firmware-side counters along the RX chain, read through the proven
+ * indirect DMEM path.  Symbols from stock pfe.ko (.class_dmem_sh /
+ * .tmu_dmem_sh): class_drop_counter +0x490 (13 words), class_gFppGlobals
+ * +0x4d0 (13 words), tmu_stats +0x220 (first 16 of 52 words). */
+/* V559: raw EGPI1 (0x00..0x7c) and BMU1/BMU2 (0x00..0x2c, 0x3c..0x58) register
+ * snapshots.  BMU +0x30..+0x38 are skipped: reading the alloc port would
+ * allocate a buffer. */
+static void v559_regs(struct comcerto_pfe_port *pfe, void __iomem *axi, const char *tag)
+{
+	static const u32 bmu_off[] = { 0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18,
+		0x1c, 0x20, 0x24, 0x28, 0x2c, 0x3c, 0x40, 0x44, 0x48, 0x4c, 0x50,
+		0x54, 0x58 };
+	void __iomem *g1 = axi + COMCERTO_PFE_GPI1_OFFSET;
+	u32 v[32];
+	unsigned int i;
+
+	for (i = 0; i < 32; i++)
+		v[i] = readl(g1 + 4 * i);
+	dev_emerg(pfe->dev, "PFE:V559:%s:GPI1A=%*phN\n", tag, 64, v);
+	dev_emerg(pfe->dev, "PFE:V559:%s:GPI1B=%*phN\n", tag, 64, v + 16);
+	for (i = 0; i < ARRAY_SIZE(bmu_off); i++)
+		v[i] = readl(axi + COMCERTO_PFE_BMU1_OFFSET + bmu_off[i]);
+	dev_emerg(pfe->dev, "PFE:V559:%s:BMU1=%*phN\n", tag, 64, v);
+	for (i = 0; i < ARRAY_SIZE(bmu_off); i++)
+		v[i] = readl(axi + COMCERTO_PFE_BMU2_OFFSET + bmu_off[i]);
+	dev_emerg(pfe->dev, "PFE:V559:%s:BMU2=%*phN\n", tag, 64, v);
+}
+
+static void v558_dump(struct comcerto_pfe_port *pfe, void __iomem *axi, const char *tag)
+{
+	u32 cb = pfe->pe_sync_mailbox[0] - COMCERTO_PFE_CTRL_CLASS_SYNC_MAILBOX_OFFSET;
+	u32 tb = pfe->pe_sync_mailbox[6] - COMCERTO_PFE_CTRL_TMU_SYNC_MAILBOX_OFFSET;
+	u32 drop[13] = { 0 }, glob[13], tstat[16], w;
+	unsigned int pe, i;
+
+	for (pe = 0; pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++)
+		for (i = 0; i < 13; i++)
+			if (!comcerto_pfe_read_dmem_word(axi, pe, cb + 0x490 + 4 * i, &w))
+				drop[i] += w;
+	for (i = 0; i < 13; i++)
+		if (comcerto_pfe_read_dmem_word(axi, 0, cb + 0x4d0 + 4 * i, &glob[i]))
+			glob[i] = 0xdeadbeef;
+	for (i = 0; i < 16; i++)
+		if (comcerto_pfe_read_dmem_word(axi, 6, tb + 0x220 + 4 * i, &tstat[i]))
+			tstat[i] = 0xdeadbeef;
+	dev_emerg(pfe->dev, "PFE:V558:%s:CB=%x:TB=%x:CDROP=%*phN\n", tag, cb, tb,
+		  (int)sizeof(drop), drop);
+	dev_emerg(pfe->dev, "PFE:V558:%s:CGLOB=%*phN\n", tag, (int)sizeof(glob), glob);
+	dev_emerg(pfe->dev, "PFE:V558:%s:TSTAT=%*phN\n", tag, (int)sizeof(tstat), tstat);
+}
+
+/*
+ * V563: first bounded packet TX (gate 4).  Runs inside the V551 RX window
+ * after EGPI1 is enabled.  Stock path (pfe_eth_send_packet ->
+ * __hif_lib_xmit_pkt -> __hif_xmit_pkt): a 6-byte HIF header
+ * {client_id 0 (GEM0), queue, client_ctrl 0 (no csum), 0} precedes the
+ * Ethernet frame; flags 0xb; descriptor OWN|0x0e000000|LIFM|len.  The
+ * host->PFE chain is our Linux-owned producer ring at HIF +0x10, kicked with
+ * HIF +0x04 = 5.  Three 60-byte broadcast frames, ethertype 0x88b5 (IEEE
+ * local experimental), locally administered source.  Every slot must be
+ * reclaimed; HIF TX ctrl and +0x10 are restored before returning.
+ */
+#define V563_FRAMES	3
+#define V563_ETH_LEN	60
+#define V563_HDR_LEN	6
+
+static void v563_tx(struct comcerto_pfe_port *pfe, void __iomem *axi,
+		    void __iomem *g, u32 ncr)
+{
+	static const u8 eth_hdr[14] = {
+		0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+		0x02, 0x5a, 0x54, 0x00, 0x05, 0x63,	/* locally administered */
+		0x88, 0xb5,
+	};
+	struct device *dev = pfe->dev;
+	void __iomem *hif = axi + COMCERTO_PFE_HIF_OFFSET;
+	struct comcerto_pfe_hif_stock_tx_producer prod;
+	u8 *buf = pfe->tx_test_payload;
+	u32 tx0, tx1, ctl = 0;
+	unsigned int n, t, sent = 0;
+	int ret;
+
+	ret = comcerto_pfe_hif_validate_tx_handoff_context(&pfe->tx_ring);
+	if (!ret)
+		ret = comcerto_pfe_hif_stock_tx_producer_init(&prod,
+			pfe->tx_ring.desc, pfe->tx_ring.desc_dma,
+			pfe->tx_ring.completion, pfe->tx_ring.pending,
+			pfe->tx_ring.in_flight, COMCERTO_PFE_HIF_STOCK_DESC_COUNT);
+	if (ret || readl(hif + COMCERTO_PFE_HIF_TX_CTRL)) {
+		dev_emerg(dev, "PFE:V563:SKIP;CTX=%d\n", ret);
+		return;
+	}
+	writel(ncr | BIT(3) | BIT(2), g + COMCERTO_PFE_GEMAC_ECNTRL);	/* + GEMAC TX */
+	writel(lower_32_bits(pfe->tx_ring.desc_dma), hif + COMCERTO_PFE_HIF_RX_BASE);
+	mb();
+	writel(COMCERTO_PFE_HIF_TX_CTRL_ENABLE, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	mb();
+	tx0 = readl(g + 0x108);
+	dev_emerg(dev, "PFE:V563:BEGIN;NCR=%08x:TXF=%u:TSR=%08x\n",
+		  readl(g + COMCERTO_PFE_GEMAC_ECNTRL), tx0, readl(g + 0x14));
+	for (n = 0; n < V563_FRAMES; n++) {
+		memset(buf, 0, COMCERTO_PFE_HIF_TX_TEST_BYTES);
+		buf[0] = 0;		/* client_id: GEM0 */
+		buf[1] = 0;		/* queue */
+		memcpy(buf + V563_HDR_LEN, eth_hdr, sizeof(eth_hdr));
+		snprintf((char *)buf + V563_HDR_LEN + sizeof(eth_hdr), 32,
+			 "ZYXELUNTRASH V563 TX %u", n);
+		ret = comcerto_pfe_hif_stock_tx_producer_submit(&prod,
+			pfe->tx_test_payload_dma, V563_HDR_LEN + V563_ETH_LEN,
+			0, 0, 0xb);
+		if (ret)
+			break;
+		ctl = READ_ONCE(pfe->tx_ring.desc[n].control);
+		mb();
+		writel(COMCERTO_PFE_HIF_TX_CTRL_KICK, hif + COMCERTO_PFE_HIF_TX_CTRL);
+		mb();
+		for (t = 0; t < 100; t++) {
+			if (!(READ_ONCE(pfe->tx_ring.desc[n].control) &
+			      COMCERTO_PFE_HIF_DESC_OWN))
+				break;
+			msleep(1);
+		}
+		tx1 = readl(g + 0x108);
+		dev_emerg(dev, "PFE:V563:F%u;D=%08x>%08x:T=%u:TXF=%u:TSR=%08x\n", n,
+			  ctl, READ_ONCE(pfe->tx_ring.desc[n].control), t, tx1,
+			  readl(g + 0x14));
+		ret = comcerto_pfe_hif_stock_tx_producer_reclaim(&prod, n);
+		if (ret)
+			break;
+		sent++;
+		msleep(200);
+	}
+	tx1 = readl(g + 0x108);
+	writel(0, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	mb();
+	msleep(10);
+	writel(lower_32_bits(pfe->stock_dma_a_addr), hif + COMCERTO_PFE_HIF_RX_BASE);
+	writel(ncr | BIT(2), g + COMCERTO_PFE_GEMAC_ECNTRL);		/* RX only again */
+	wmb();
+	if (ret)
+		ret = comcerto_pfe_hif_stock_tx_producer_abort(&prod);
+	else
+		ret = comcerto_pfe_hif_stock_tx_producer_validate_idle(&prod);
+	dev_emerg(dev, "PFE:V563:DONE;SENT=%u:TXF=%u>%u:IDLE=%d:HTX=%08x:B10=%08x\n",
+		  sent, tx0, tx1, ret, readl(hif + COMCERTO_PFE_HIF_TX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_RX_BASE));
+}
+
+static void __maybe_unused comcerto_pfe_v551_rx_window(struct comcerto_pfe_port *pfe,
+					void __iomem *axi, void __iomem *g)
+{
+	static const u8 value[COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES] = {
+		0x02, 0x5a, 0x54, 0x00, 0x05, 0x51,	/* locally administered */
+	};
+	struct device *dev = pfe->dev;
+	void __iomem *hif = axi + COMCERTO_PFE_HIF_OFFSET;
+	void __iomem *gpi = axi + COMCERTO_PFE_GPI1_OFFSET;
+	void __iomem *gpi4 = axi + COMCERTO_PFE_GPI4_OFFSET;
+	u32 g4cfg = 0, g4en = 0;
+	bool hgpi_touched = false;
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	struct comcerto_pfe_hif_desc *rx = pfe->stock_dma_b;
+	u8 orig[COMCERTO_PFE_CTRL_CLASS_PE_COUNT * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES];
+	u8 test[sizeof(orig)];
+	struct v546_snapshot pre, now;
+	u32 b10, b24, gpi_ctrl, ncr;
+	unsigned int i, own = 0, head = 0, frames = 0, bytes = 0;
+	unsigned long end;
+	int ret;
+
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) || readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE)) {
+		dev_emerg(dev, "PFE:V551:SKIP;HIF_NOT_QUIESCENT\n");
+		return;
+	}
+	for (i = 0; i < COMCERTO_PFE_HIF_STOCK_DESC_COUNT; i++)
+		/* every buffer must be one of our own coherent RX buffers */
+		own += (READ_ONCE(rx[i].control) & COMCERTO_PFE_HIF_DESC_OWN) &&
+		       READ_ONCE(rx[i].data_addr) == lower_32_bits(pfe->rx_ring.buffer_dma[i]) &&
+		       READ_ONCE(rx[i].next_addr) == lower_32_bits(pfe->stock_dma_b_addr +
+				((i + 1) % COMCERTO_PFE_HIF_STOCK_DESC_COUNT) * sizeof(*rx));
+	if (own != COMCERTO_PFE_HIF_STOCK_DESC_COUNT || v551_port0_plan(pfe, &plan)) {
+		dev_emerg(dev, "PFE:V551:SKIP;RING_OWN=%u_OR_PLAN\n", own);
+		return;
+	}
+	ret = v546_read(axi, &plan, &pre);
+	if (ret || (pre.value_hi[0] & 0xff) || V546_BYTE(pre.util, plan.util_enable_offset)) {
+		dev_emerg(dev, "PFE:V551:SKIP;PORT0_NOT_DISABLED\n");
+		return;
+	}
+	for (i = 0; i < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; i++) {
+		u8 *o = orig + i * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES;
+
+		o[0] = pre.value_lo[i] >> 24; o[1] = pre.value_lo[i] >> 16;
+		o[2] = pre.value_lo[i] >> 8;  o[3] = pre.value_lo[i];
+		o[4] = pre.value_hi[i] >> 24; o[5] = pre.value_hi[i] >> 16;
+		memcpy(test + i * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES, value, sizeof(value));
+	}
+	b10 = readl(hif + COMCERTO_PFE_HIF_RX_BASE);	/* +0x10 host->PFE */
+	b24 = readl(hif + COMCERTO_PFE_HIF_TX_BASE);	/* +0x24 PFE->host */
+	gpi_ctrl = readl(gpi + 0x04);
+	ncr = readl(g + COMCERTO_PFE_GEMAC_ECNTRL);
+	dev_emerg(dev, "PFE:V551:PRE;B10=%08x:B24=%08x:RING=%08llx:EMPTY=%08llx:GPI1=%08x:NCR=%08x\n",
+		  b10, b24, (u64)pfe->stock_dma_b_addr, (u64)pfe->stock_dma_a_addr, gpi_ctrl, ncr);
+
+	/* V552: mask the HIF line at the GIC for the whole window, then enable
+	 * one producer at a time with a marker and a settle delay after each. */
+	disable_irq(pfe->hif_irq);
+#define V552_STEP(tag) do { \
+		msleep(300); \
+		dev_emerg(dev, "PFE:V552:" tag ";HRX=%08x:INT=%08x:D0=%08x:GPI1=%08x:NCR=%08x:IRQS=%u\n", \
+			  readl(hif + COMCERTO_PFE_HIF_RX_CTRL), \
+			  readl(hif + COMCERTO_PFE_HIF_INT_STATUS), READ_ONCE(rx[0].control), \
+			  readl(gpi + 0x04), readl(g + COMCERTO_PFE_GEMAC_ECNTRL), \
+			  kstat_irqs_usr(pfe->hif_irq)); \
+	} while (0)
+	/* stock roles: buffer ring at +0x24, empty chain at +0x10 */
+	writel(lower_32_bits(pfe->stock_dma_b_addr), hif + COMCERTO_PFE_HIF_TX_BASE);
+	writel(lower_32_bits(pfe->stock_dma_a_addr), hif + COMCERTO_PFE_HIF_RX_BASE);
+	wmb();
+	V552_STEP("S1_BASES");
+	ret = v546_write(axi, &plan, test, true, BIT(0));		/* 0x0501 */
+	if (ret)
+		goto port_restore;
+	V552_STEP("S2_PORT0");
+	writel(COMCERTO_PFE_HIF_RX_CTRL_ENABLE, hif + COMCERTO_PFE_HIF_RX_CTRL);	/* 5 */
+	wmb();
+	V552_STEP("S3_HIF_RX");
+	/* V557: TMU3 delivers host-bound frames through HGPI (GPI4, TMU PHY3 INQ
+	 * 0xc0290030) to the HIF.  Stock pfe_hif_init() enables it with
+	 * gpi_enable() (+0x04 = 1).  V85's V545 path instead wrote 1 and later 0
+	 * to +0x08 (the RX config register, misnamed GPI_CTRL), leaving HGPI
+	 * disabled with a zeroed config.  Restore stock config and enable. */
+	g4cfg = readl(gpi4 + 0x08);
+	g4en = readl(gpi4 + 0x04);
+	writel((COMCERTO_PFE_GPI4_CONTROL_HI << 16) | 3, gpi4 + 0x08);
+	writel(1, gpi4 + 0x04);
+	hgpi_touched = true;
+	dev_emerg(dev, "PFE:V557:HGPI;CFG=%08x>%08x:EN=%08x>%08x\n", g4cfg,
+		  readl(gpi4 + 0x08), g4en, readl(gpi4 + 0x04));
+	/* V555: GEMAC RX first with EGPI1 still disabled, sampled every 50 ms
+	 * for 1 s; then EGPI1, sampled every 20 ms for 1 s.  Separates a
+	 * GEMAC-side stall from a PFE-side (EGPI1/BMU/CLASS) stall. */
+	{
+		unsigned int k;
+
+		v558_dump(pfe, axi, "PRE");
+		v559_regs(pfe, axi, "PRE");
+		writel(ncr | BIT(2), g + COMCERTO_PFE_GEMAC_ECNTRL);	/* GEMAC RX */
+		for (k = 0; k < 20; k++) {
+			dev_emerg(dev, "PFE:V555:A%02u;NSR=%08x:RSR=%08x:RXF=%u:GPI1=%08x:D0=%08x\n",
+				  k, readl(g + 0x08), readl(g + 0x20), readl(g + 0x158),
+				  readl(gpi + 0x04), READ_ONCE(rx[0].control));
+			msleep(50);
+		}
+		dev_emerg(dev, "PFE:V555:GEMAC_ONLY_STABLE_1S\n");
+		writel(1, gpi + 0x04);					/* gpi_enable */
+		for (k = 0; k < 50; k++) {
+			dev_emerg(dev, "PFE:V555:B%02u;NSR=%08x:RSR=%08x:RXF=%u:GPI1=%08x:D0=%08x:H0=%08x\n",
+				  k, readl(g + 0x08), readl(g + 0x20), readl(g + 0x158),
+				  readl(gpi + 0x04), READ_ONCE(rx[0].control),
+				  readl(hif + COMCERTO_PFE_HIF_INT_STATUS));
+			msleep(20);
+		}
+		dev_emerg(dev, "PFE:V555:GPI1_STABLE_1S\n");
+	}
+	v563_tx(pfe, axi, g, ncr);
+
+	end = jiffies + msecs_to_jiffies(3000);
+	{
+		unsigned long beat = jiffies;
+
+		while (time_before(jiffies, end) && frames < 2000) {
+			struct comcerto_pfe_hif_desc *d = &rx[head];
+			u32 ctl, meta;
+			u8 *b;
+
+			if (time_after_eq(jiffies, beat)) {
+				u32 ps0 = 0, ps1 = 0, ps2 = 0;
+
+				/* CLASS PE0 .dmem_pestatus (0x800..0x81f) via the proven
+				 * indirect DMEM read: shows whether CLASS processes frames. */
+				comcerto_pfe_read_dmem_word(axi, 0, 0x800, &ps0);
+				comcerto_pfe_read_dmem_word(axi, 0, 0x804, &ps1);
+				comcerto_pfe_read_dmem_word(axi, 0, 0x808, &ps2);
+				dev_emerg(dev, "PFE:V553:BEAT;F=%u:H=%u:DH=%08x:INT=%08x:IRQS=%u:PES=%08x/%08x/%08x\n",
+					  frames, head, READ_ONCE(d->control),
+					  readl(hif + COMCERTO_PFE_HIF_INT_STATUS),
+					  kstat_irqs_usr(pfe->hif_irq), ps0, ps1, ps2);
+				beat = jiffies + msecs_to_jiffies(250);
+			}
+			if (!comcerto_pfe_hif_rx_desc_ready(d)) {
+				msleep(1);	/* V556: usleep_range never returns on this jiffies-only kernel */
+				continue;
+			}
+			ctl = READ_ONCE(d->control);
+			meta = READ_ONCE(d->metadata);
+			b = pfe->rx_ring.buffer[head];
+			bytes += ctl & COMCERTO_PFE_HIF_DESC_LEN_MASK;
+			if (frames < V551_DUMP)
+				dev_emerg(dev, "PFE:V551:FRAME%u;CTL=%08x:META=%08x:B=%*phN\n",
+					  frames, ctl, meta, 48, b);
+			comcerto_pfe_hif_recycle_rx_desc(d, pfe->rx_ring.buffer_len);
+			head = (head + 1) % COMCERTO_PFE_HIF_STOCK_DESC_COUNT;
+			frames++;
+		}
+	}
+	v558_dump(pfe, axi, "POST");
+	v559_regs(pfe, axi, "POST");
+	dev_emerg(dev, "PFE:V551:RX_WINDOW;FRAMES=%u:LENSUM=%u:HSTS=%08x\n",
+		  frames, bytes, readl(hif + 0x30));
+
+	writel(ncr, g + COMCERTO_PFE_GEMAC_ECNTRL);			/* GEMAC RX off */
+	writel(gpi_ctrl, gpi + 0x04);					/* gpi_disable */
+	if (hgpi_touched) {
+		writel(g4en, gpi4 + 0x04);
+		writel(g4cfg, gpi4 + 0x08);
+	}
+	msleep(100);
+	writel(0, hif + COMCERTO_PFE_HIF_RX_CTRL);
+	wmb();
+port_restore:
+	{
+		int r = v546_write(axi, &plan, NULL, false, 0);	/* 0x0502 */
+
+		if (!r)
+			r = v546_write(axi, &plan, orig, true, 0);
+		if (!r)
+			r = v546_read(axi, &plan, &now);
+		/* recycle anything that arrived during teardown */
+		for (i = 0; i < COMCERTO_PFE_HIF_STOCK_DESC_COUNT; i++)
+			if (!(READ_ONCE(rx[i].control) & COMCERTO_PFE_HIF_DESC_OWN))
+				comcerto_pfe_hif_recycle_rx_desc(&rx[i], pfe->rx_ring.buffer_len);
+		writel(b24, hif + COMCERTO_PFE_HIF_TX_BASE);
+		writel(b10, hif + COMCERTO_PFE_HIF_RX_BASE);
+		wmb();
+		writel(readl(hif + COMCERTO_PFE_HIF_INT_STATUS), hif + COMCERTO_PFE_HIF_INT_STATUS);
+		enable_irq(pfe->hif_irq);
+		dev_emerg(dev, "PFE:V551:CLOSED;PORT0=%s:B10=%08x:B24=%08x:HRX=%08x:GPI1=%08x:NCR=%08x\n",
+			  (!r && !memcmp(&now, &pre, sizeof(pre))) ? "RESTORED" : "RESTORE_FAILED",
+			  readl(hif + COMCERTO_PFE_HIF_RX_BASE), readl(hif + COMCERTO_PFE_HIF_TX_BASE),
+			  readl(hif + COMCERTO_PFE_HIF_RX_CTRL), readl(gpi + 0x04),
+			  readl(g + COMCERTO_PFE_GEMAC_ECNTRL));
+	}
+}
+
+/*
+ * V550: stock GEMAC1 configuration + phylib attach of PHY 4 (data path off).
+ * Stock pfe_eth_open() for eth0: gemac_set_config(mode 4 from mii_config 8,
+ * speed 1000 and full duplex from gemac_mode 0x2b00), allow broadcast, unicast
+ * and multicast hash off, FCS-RX off, 1536 frames, jumbo RX, pause RX, bus
+ * width 64, RX checksum offload per netdev features (off here), phy_connect,
+ * phy_start.  GEMAC RX/TX (NCR bits 2/3), GPI, the port command and HIF stay
+ * disabled.  PHY_INTERFACE_MODE_NA keeps the RTL8211E strap RGMII delays, as
+ * the stock 3.2 driver did (6.6 rtl8211e_config_init only rewrites them for
+ * explicit rgmii* modes).  Everything is torn down and restored afterwards.
+ */
+#define V550_GEMAC_MODE_REG	0x7a0
+#define V550_NCFGR_SPD		BIT(0)
+#define V550_NCFGR_FD		BIT(1)
+#define V550_NCFGR_JUMBO	BIT(3)
+#define V550_NCFGR_NBC		BIT(5)
+#define V550_NCFGR_MTIHEN	BIT(6)
+#define V550_NCFGR_UNIHEN	BIT(7)
+#define V550_NCFGR_BIG		BIT(8)
+#define V550_NCFGR_GBE		BIT(10)
+#define V550_NCFGR_PCSSEL	BIT(11)
+#define V550_NCFGR_PAE		BIT(13)
+#define V550_NCFGR_DBW_MASK	GENMASK(22, 21)
+#define V550_NCFGR_DBW64	BIT(21)
+#define V550_NCFGR_RXCOEN	BIT(24)
+#define V550_NCFGR_IGNFCS	BIT(26)
+#define V550_NCFGR_MODE5	BIT(27)
+
+struct v550_ctx {
+	void __iomem *g;
+	struct device *dev;
+	int last_link, last_speed, last_duplex;
+};
+
+static void v550_adjust_link(struct net_device *ndev)
+{
+	struct v550_ctx *c = netdev_priv(ndev);
+	struct phy_device *phy = ndev->phydev;
+	u32 cfg;
+
+	if (phy->link == c->last_link && phy->speed == c->last_speed &&
+	    phy->duplex == c->last_duplex)
+		return;
+	c->last_link = phy->link;
+	c->last_speed = phy->speed;
+	c->last_duplex = phy->duplex;
+	if (phy->link) {
+		/* stock gemac_set_speed()/gemac_set_duplex() semantics */
+		cfg = readl(c->g + COMCERTO_PFE_GEMAC_CONFIG);
+		cfg &= ~(V550_NCFGR_SPD | V550_NCFGR_GBE | V550_NCFGR_PCSSEL | V550_NCFGR_FD);
+		if (phy->speed == SPEED_1000)
+			cfg |= V550_NCFGR_GBE;
+		else if (phy->speed == SPEED_100)
+			cfg |= V550_NCFGR_SPD;
+		if (phy->duplex == DUPLEX_FULL)
+			cfg |= V550_NCFGR_FD;
+		writel(cfg, c->g + COMCERTO_PFE_GEMAC_CONFIG);
+	}
+	dev_emerg(c->dev, "PFE:V550:ADJUST_LINK;LINK=%s:SPEED=%d:DUPLEX=%s:C=%08x\n",
+		  phy->link ? "UP" : "DOWN", phy->speed,
+		  phy->duplex == DUPLEX_FULL ? "FULL" : "HALF",
+		  readl(c->g + COMCERTO_PFE_GEMAC_CONFIG));
+}
+
+static int v550_mdio_write(struct mii_bus *bus, int phy, int reg, u16 val)
+{
+	void __iomem *g = bus->priv;
+	u32 status;
+
+	writel(COMCERTO_PFE_MDIO_WRITE | COMCERTO_PFE_MDIO_START | val |
+	       (phy << COMCERTO_PFE_MDIO_PHY_SHIFT) |
+	       (reg << COMCERTO_PFE_MDIO_REG_SHIFT), g + COMCERTO_PFE_MDIO_COMMAND);
+	udelay(1);
+	return v548_wait_idle(g, 1001, 10, &status) < 0 ? -ETIMEDOUT : 0;
+}
+
+/*
+ * V564: first real Linux netdev (eth0) on FPP physical port 0 / GEMAC1 / PHY 4.
+ * The data path is brought up exactly as in the hardware-proven V551/V563
+ * windows (RX: GEMAC1 -> EGPI1 -> CLASS -> TMU3 -> HGPI -> HIF ring at +0x24;
+ * TX: Linux producer ring at +0x10 -> CLASS -> TMU0 -> EGPI1 -> GEMAC1) and
+ * then left running.  RX and TX completion are polled by NAPI from a
+ * one-jiffy timer (HIF IRQ stays masked).  TX copies every skb behind the
+ * stock 6-byte HIF header {client 0, queue 0, ctrl 0} into a per-slot
+ * coherent bounce buffer (flags 0xb).  A reboot notifier stops GEMAC, EGPI1,
+ * HGPI and HIF DMA before the kernel restarts into Barebox.
+ */
+#define V564_TXBUF		2048
+#define V564_HDR		6
+#define V564_NCFGR_CAF		BIT(4)
+#define V564_GEM_SA1B		0x88
+#define V564_GEM_SA1T		0x8c
+
+struct v564_priv {
+	struct v550_ctx c;	/* first: v550_adjust_link() uses it */
+	struct comcerto_pfe_port *pfe;
+	struct net_device *ndev;
+	void __iomem *axi, *hif, *g;
+	struct napi_struct napi;
+	struct timer_list poll;
+	spinlock_t tx_lock;
+	struct comcerto_pfe_hif_stock_tx_producer prod;
+	u8 *txbuf;
+	dma_addr_t txbuf_dma;
+	unsigned int rx_head;
+	u32 ncr0, g4en0, g4cfg0;
+	struct notifier_block reboot_nb;
+	struct delayed_work hb;		/* V569 heartbeat */
+	unsigned int hb_seq;
+	unsigned long polls;
+	u32 last_act[6];	/* V572 */
+	u8 dumped;		/* V572: PEs already dumped */
+};
+
+static const u8 v564_mac[ETH_ALEN] = { 0x02, 0x5a, 0x54, 0x00, 0x05, 0x64 };
+/* V570: CLASS port-0 MAC deliberately differs from the netdev MAC.  With the
+ * netdev MAC configured (V564..V569), unicast UDP/TCP to the NAS entered the
+ * stock FPP routing path (unconfigured flow tables) and froze CLASS PE1
+ * (V569); ICMP was punted and worked.  The V551/V563 test value is used. */
+static const u8 v570_class_port_mac[ETH_ALEN] __maybe_unused = { 0x02, 0x5a, 0x54, 0x00, 0x05, 0x51 };
+
+static void v564_reclaim(struct v564_priv *p)
+{
+	spin_lock(&p->tx_lock);
+	while (p->prod.header.credits < p->prod.count &&
+	       !comcerto_pfe_hif_stock_tx_producer_reclaim(&p->prod,
+						p->prod.header.reclaim))
+		;
+	if (netif_queue_stopped(p->ndev) && p->prod.header.credits > 16)
+		netif_wake_queue(p->ndev);
+	spin_unlock(&p->tx_lock);
+}
+
+static int v564_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct v564_priv *p = container_of(napi, struct v564_priv, napi);
+	struct comcerto_pfe_hif_desc *rx = p->pfe->stock_dma_b;
+	struct net_device *ndev = p->ndev;
+	int done = 0;
+
+	p->polls++;
+	v564_reclaim(p);
+	while (done < budget) {
+		struct comcerto_pfe_hif_desc *d = &rx[p->rx_head];
+		u8 *b = p->pfe->rx_ring.buffer[p->rx_head];
+		struct sk_buff *skb;
+		u32 len;
+
+		if (!comcerto_pfe_hif_rx_desc_ready(d))
+			break;
+		len = READ_ONCE(d->control) & COMCERTO_PFE_HIF_DESC_LEN_MASK;
+		if (len > V564_HDR + ETH_HLEN && len <= p->pfe->rx_ring.buffer_len &&
+		    (skb = napi_alloc_skb(napi, len - V564_HDR))) {
+			skb_put_data(skb, b + V564_HDR, len - V564_HDR);
+			skb->protocol = eth_type_trans(skb, ndev);
+			ndev->stats.rx_packets++;
+			ndev->stats.rx_bytes += len - V564_HDR;
+			napi_gro_receive(napi, skb);
+		} else {
+			ndev->stats.rx_dropped++;
+		}
+		if (p->prod.barebox_abi) {	/* V575: Barebox re-arm 0x80100800 */
+			d->metadata = 0;
+			dma_wmb();
+			WRITE_ONCE(d->control, V575_BB_RX_CONTROL(p->pfe->rx_ring.buffer_len));
+		} else {
+			comcerto_pfe_hif_recycle_rx_desc(d, p->pfe->rx_ring.buffer_len);
+		}
+		p->rx_head = (p->rx_head + 1) % COMCERTO_PFE_HIF_STOCK_DESC_COUNT;
+		done++;
+	}
+	if (done) {
+		wmb();
+		/* stock hif_rx_dma_start(): re-arm a stalled RX scanner */
+		writel(COMCERTO_PFE_HIF_RX_CTRL_ENABLE, p->hif + COMCERTO_PFE_HIF_RX_CTRL);
+	}
+	if (done < budget)
+		napi_complete_done(napi, done);
+	return done;
+}
+
+static void v564_timer(struct timer_list *t)
+{
+	struct v564_priv *p = from_timer(p, t, poll);
+
+	napi_schedule(&p->napi);
+	if (netif_running(p->ndev))
+		mod_timer(&p->poll, jiffies + 1);
+}
+
+/*
+ * V569 heartbeat (process context, every 2 s): host-memory and netdev state
+ * first, then the HIF registers, then CLASS PE0..5 activity words through
+ * the indirect DMEM path.  Each group is printed before the next MMIO group
+ * is touched, so a hang shows which access stalled.
+ */
+static void v569_heartbeat(struct work_struct *w)
+{
+	struct v564_priv *p = container_of(to_delayed_work(w), struct v564_priv, hb);
+	struct net_device *ndev = p->ndev;
+	struct comcerto_pfe_hif_desc *rx = p->pfe->stock_dma_b;
+	u32 act[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	unsigned int i;
+
+	pr_emerg("PFE:V569:HB%u;RX=%lu:TX=%lu:RXD=%lu:TXD=%lu:CR=%u:RCL=%u:PROD=%u:RH=%u:D=%08x:POLLS=%lu:Q=%d:CAR=%d\n",
+		 p->hb_seq, ndev->stats.rx_packets, ndev->stats.tx_packets,
+		 ndev->stats.rx_dropped, ndev->stats.tx_dropped, p->prod.header.credits,
+		 p->prod.header.reclaim, p->prod.producer, p->rx_head,
+		 READ_ONCE(rx[p->rx_head].control), p->polls,
+		 netif_queue_stopped(ndev), netif_carrier_ok(ndev));
+	pr_emerg("PFE:V569:HB%u:HIF;HRX=%08x:HTX=%08x:INT=%08x:TXD0=%08x\n", p->hb_seq,
+		 readl(p->hif + COMCERTO_PFE_HIF_RX_CTRL),
+		 readl(p->hif + COMCERTO_PFE_HIF_TX_CTRL),
+		 readl(p->hif + COMCERTO_PFE_HIF_INT_STATUS),
+		 READ_ONCE(p->pfe->tx_ring.desc[p->prod.header.reclaim].control));
+	for (i = 0; i < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; i++)
+		if (comcerto_pfe_read_dmem_word(p->axi, i, 0x804, &act[i]))
+			act[i] = 0xdeadbeef;
+	pr_emerg("PFE:V569:HB%u:PE;%08x/%08x/%08x/%08x/%08x/%08x\n", p->hb_seq,
+		 act[0], act[1], act[2], act[3], act[4], act[5]);
+	/* V572: a CLASS PE whose activity counter did not move since the last
+	 * heartbeat is dumped once, read-only, the way stock pe_status() reads
+	 * it: status block DMEM 0x800.. (state, ctr, rx, tx, drop, +0x18.. the
+	 * 16 DBUG words) and the exception area DMEM 0x1fa8.. (DEAD). */
+	for (i = 0; p->hb_seq && i < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; i++) {
+		u32 w[24];
+		unsigned int k;
+
+		if (act[i] != p->last_act[i] || (p->dumped & BIT(i)))
+			continue;
+		p->dumped |= BIT(i);
+		for (k = 0; k < 24; k++)
+			if (comcerto_pfe_read_dmem_word(p->axi, i, 0x800 + 4 * k, &w[k]))
+				w[k] = 0xdeadbeef;
+		pr_emerg("PFE:V572:PE%u:STAT0=%*phN\n", i, 48, w);
+		pr_emerg("PFE:V572:PE%u:STAT1=%*phN\n", i, 48, w + 12);
+		for (k = 0; k < 16; k++)
+			if (comcerto_pfe_read_dmem_word(p->axi, i, 0x1fa8 + 4 * k, &w[k]))
+				w[k] = 0xdeadbeef;
+		pr_emerg("PFE:V572:PE%u:EXC=%*phN\n", i, 64, w);
+		/* a running PE (PE0) as reference, same window */
+		for (k = 0; k < 24; k++)
+			if (comcerto_pfe_read_dmem_word(p->axi, i ? 0 : 2, 0x800 + 4 * k, &w[k]))
+				w[k] = 0xdeadbeef;
+		pr_emerg("PFE:V572:REF%u:STAT0=%*phN\n", i ? 0 : 2, 48, w);
+		pr_emerg("PFE:V572:REF%u:STAT1=%*phN\n", i ? 0 : 2, 48, w + 12);
+	}
+	memcpy(p->last_act, act, sizeof(p->last_act));
+	p->hb_seq++;
+	schedule_delayed_work(&p->hb, 2 * HZ);
+}
+
+static netdev_tx_t v564_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	struct v564_priv *p = netdev_priv(ndev);
+	unsigned int len = skb->len, idx;
+	u8 *buf;
+
+	if (len > V564_TXBUF - V564_HDR - 64) {
+		ndev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	spin_lock(&p->tx_lock);
+	if (p->prod.header.credits < 2) {
+		netif_stop_queue(ndev);
+		spin_unlock(&p->tx_lock);
+		return NETDEV_TX_BUSY;
+	}
+	idx = p->prod.producer;
+	buf = p->txbuf + idx * V564_TXBUF;
+	memset(buf, 0, V564_HDR);		/* client 0 (GEM0), queue 0, ctrl 0 */
+	skb_copy_bits(skb, 0, buf + V564_HDR, len);
+	if (len < ETH_ZLEN) {
+		memset(buf + V564_HDR + len, 0, ETH_ZLEN - len);
+		len = ETH_ZLEN;
+	}
+	if (!comcerto_pfe_hif_stock_tx_producer_submit(&p->prod,
+			p->txbuf_dma + idx * V564_TXBUF, len + V564_HDR, 0, 0, 0xb)) {
+		mb();
+		writel(COMCERTO_PFE_HIF_TX_CTRL_KICK, p->hif + COMCERTO_PFE_HIF_TX_CTRL);
+		ndev->stats.tx_packets++;
+		ndev->stats.tx_bytes += len;
+	} else {
+		ndev->stats.tx_dropped++;
+	}
+	if (p->prod.header.credits < 2)
+		netif_stop_queue(ndev);
+	spin_unlock(&p->tx_lock);
+	dev_consume_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static int v564_open(struct net_device *ndev)
+{
+	struct v564_priv *p = netdev_priv(ndev);
+
+	napi_enable(&p->napi);
+	netif_start_queue(ndev);
+	mod_timer(&p->poll, jiffies + 1);
+	schedule_delayed_work(&p->hb, 2 * HZ);
+	netdev_emerg(ndev, "PFE:V564:OPEN\n");
+	return 0;
+}
+
+static int v564_stop(struct net_device *ndev)
+{
+	struct v564_priv *p = netdev_priv(ndev);
+
+	netif_stop_queue(ndev);
+	cancel_delayed_work_sync(&p->hb);
+	del_timer_sync(&p->poll);
+	napi_disable(&p->napi);
+	return 0;
+}
+
+static const struct net_device_ops v564_ops = {
+	.ndo_open = v564_open,
+	.ndo_stop = v564_stop,
+	.ndo_start_xmit = v564_xmit,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
+/* Quiesce every DMA producer before the restart into Barebox. */
+static int v564_reboot(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct v564_priv *p = container_of(nb, struct v564_priv, reboot_nb);
+	void __iomem *gpi4 = p->axi + COMCERTO_PFE_GPI4_OFFSET;
+
+	if (action)	/* real reboot; 0 = register_netdev failure path */
+		cancel_delayed_work_sync(&p->hb);
+	writel(p->ncr0, p->g + COMCERTO_PFE_GEMAC_ECNTRL);	/* GEMAC RX/TX off */
+	writel(0, p->axi + COMCERTO_PFE_GPI1_OFFSET + 0x04);	/* EGPI1 off */
+	mdelay(5);
+	writel(0, p->hif + COMCERTO_PFE_HIF_TX_CTRL);
+	writel(0, p->hif + COMCERTO_PFE_HIF_RX_CTRL);
+	writel(p->g4en0, gpi4 + 0x04);
+	writel(p->g4cfg0, gpi4 + 0x08);
+	mdelay(5);
+	pr_emerg("PFE:V564:REBOOT_QUIESCED;HTX=%08x:HRX=%08x:NCR=%08x\n",
+		 readl(p->hif + COMCERTO_PFE_HIF_TX_CTRL),
+		 readl(p->hif + COMCERTO_PFE_HIF_RX_CTRL),
+		 readl(p->g + COMCERTO_PFE_GEMAC_ECNTRL));
+	return NOTIFY_DONE;
+}
+
+/*
+ * V573: the two class-DMEM initialisers of stock __pfe_ctrl_init() that V85
+ * never performed (V572: CLASS PE1 stays RUN but never finishes the first
+ * unicast UDP frame).  Stock writes them to all six CLASS PEs between
+ * pe_sync_stop(0x3f) and pe_start(0x3f); pe_dmem_memcpy_to32() is a
+ * byte-exact host->PE copy, so the PE image equals the host image:
+ *  - icc_control_init (pfe.ko 0x20d48): icctab (.class_dmem_sh +0x660 ->
+ *    DMEM 0x1180, 0x2b8 bytes) zeroed, then u32[0] = 0x40000000,
+ *    u32[1] = 0x80000000 (little-endian host words), bytes 8/40/72 |= 6,
+ *    bytes 15/47/79 |= 4;
+ *  - tx_init (0x1a2f0) via add_onif: phy_port[p] (+0x9b0 -> DMEM 0x14d0,
+ *    32-byte stride) byte +5 = onif index p, for p = 0..2.
+ */
+#define V573_CLASS_SH		0xb20
+#define V573_ICCTAB		(V573_CLASS_SH + 0x660)
+#define V573_ICCTAB_LEN		0x2b8
+#define V573_PHY_PORT		(V573_CLASS_SH + 0x9b0)
+
+static int __maybe_unused v573_stock_ctrl_dmem(struct comcerto_pfe_port *pfe, void __iomem *axi)
+{
+	u8 icc[V573_ICCTAB_LEN] = { 0 };
+	int stop, start, ret = 0;
+	unsigned int pe, i;
+	u32 r0 = 0, r5 = 0;
+
+	put_unaligned_le32(0x40000000, icc + 0);
+	put_unaligned_le32(0x80000000, icc + 4);
+	for (i = 0; i < 3; i++) {
+		icc[8 + 32 * i] |= 6;
+		icc[15 + 32 * i] |= 4;
+	}
+	stop = comcerto_pfe_ctrl_sync_stop(axi, pfe->pe_sync_mailbox, 0x3f);
+	for (pe = 0; !stop && !ret && pe < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; pe++) {
+		for (i = 0; !ret && i < V573_ICCTAB_LEN; i++)
+			ret = comcerto_pfe_write_dmem_byte(axi, pe, V573_ICCTAB + i, icc[i]);
+		for (i = 0; !ret && i < 3; i++)
+			ret = comcerto_pfe_write_dmem_byte(axi, pe, V573_PHY_PORT + 32 * i + 5, i);
+	}
+	start = comcerto_pfe_ctrl_sync_start(axi, pfe->pe_sync_mailbox, 0x3f);
+	comcerto_pfe_read_dmem_word(axi, 0, V573_ICCTAB, &r0);
+	comcerto_pfe_read_dmem_word(axi, 5, V573_ICCTAB + 4, &r5);
+	dev_emerg(pfe->dev, "PFE:V573:STOCK_CTRL_DMEM;STOP=%d:WR=%d:START=%d:ICC0=%08x:ICC1@PE5=%08x\n",
+		  stop, ret, start, r0, r5);
+	return stop ?: ret ?: start;
+}
+
+/*
+ * V574: replace the stock FPP PE firmware by the three PE images embedded in
+ * Barebox (mtd1 0x3a370 class, 0x3b7c4 tmu, 0x353dc util).  With the stock
+ * firmware the first unicast UDP/TCP frame stalls a CLASS PE (V569..V573);
+ * Barebox' firmware is a plain port<->host forwarder that demonstrably
+ * delivers unicast UDP (TFTP) on this exact path, and needs no host control
+ * state (no mailboxes, port commands or DMEM tables).
+ * Sequence (Barebox pfe_hw_init/pfe_firmware_init order): stop the cores,
+ * reset + reconfigure CLASS (stock class_init), TMU (stock tmu_init incl.
+ * queue contexts) and UTIL (reset, util_init), load the images, then enable
+ * UTIL, TMU mask 0xf, CLASS — the exact V386..V388 start order.
+ */
+/*
+ * V575: Barebox' own block configuration for its PE firmware (V574 ran the
+ * Barebox images on the stock block setup: no RX to the host, CLASS PEs
+ * stopped after one frame).  Values from Barebox class_init (0x010066f8) and
+ * tmu_init (0x010067b4), see reports/V562-OFFLINE-RESULT.md.  The route table
+ * stays at the PFE DDR base (Barebox' ddr+0x800000 is inside Linux' BMU2
+ * pool); Barebox' firmware does not use it.
+ */
+
+static void v575_barebox_class_init(void __iomem *c, void __iomem *ddr, u32 route_phys)
+{
+	writel(2, c + 0x04);
+	writel(0, c + 0x04);
+	writel(1, c + 0x200);
+	writel(0x01000010, c + 0x014);
+	writel(0x80, c + 0x244);
+	writel((8 << 16) | 0x80, c + 0x234);
+	writel(0xb000, c + 0x23c);
+	writel(route_phys, c + 0x238);
+	memset_io(ddr, 0, SZ_4M);
+	writel(0x01000000, c + 0x060);
+	writel(0x03000200, c + 0x064);
+	writel(0x01800080, c + 0x020);
+	writel(0x03800280, c + 0x024);
+	writel(0xc0310008, c + 0x114);
+	writel(31, c + 0x204);
+	writel(31, c + 0x210);
+	wmb();
+}
+
+static int v575_barebox_tmu_init(void __iomem *t, u32 llm_phys)
+{
+	unsigned int phy, q;
+	u32 status;
+
+	/* TMU reset + LLM init exactly as the hardware-proven V562 stock
+	 * sequence (Barebox' TMU was reset by power-on instead). */
+	writel(1, t + 0x0e0);
+	writel(3, t + 0x014);
+	writel(0x2ee, t + 0x004);
+	writel(0xc0210030, t + 0x0f0);
+	writel(0xc0230030, t + 0x0f4);
+	writel(0xc0340030, t + 0x0f8);
+	writel(0xc0290030, t + 0x0fc);
+	writel(0xc0350050, t + 0x134);
+	writel(0xc0360010, t + 0x148);
+	writel(0xc0250034, t + 0x100);
+	writel(0x3ff, t + 0x0b8);
+	writel(0x3ff, t + 0x138);
+	writel(0x3ff, t + 0x13c);
+	writel(0x3ff, t + 0x140);
+	writel(1, t + 0x114);
+	writel(llm_phys, t + 0x0c0);
+	writel(0x1000, t + 0x0c4);
+	writel(5, t + 0x0b4);
+	writel(0x800, t + 0x144);
+	writel(0, t + 0x0e0);
+	writel(0x40, t + 0x0e0);
+	if (readl_poll_timeout_atomic(t + 0x0e0, status, status & BIT(7), 1, 1000))
+		return -ETIMEDOUT;
+	writel(0x100, t + 0x0e0);
+	if (readl_poll_timeout_atomic(t + 0x0e0, status, status & BIT(9), 1, 1000))
+		return -ETIMEDOUT;
+	/* Barebox queue contexts: phy 3 all queues and phy 0..2 q0..7 get
+	 * 0x03fc0000, phy 0..2 q8..15 get 0x01fc0000; then +0x30 = 5.  No
+	 * terminal 0x305 command and no +0xe0 = 0 (Barebox leaves 0x100). */
+	for (phy = 0; phy < 4; phy++)
+		for (q = 0; q < 16; q++) {
+			writel((phy << 8) | q, t + 0x034);
+			writel(0x00400000, t + 0x038);
+			writel((phy == 3 || q <= 7) ? 0x03fc0000 : 0x01fc0000, t + 0x054);
+			writel(0, t + 0x058);
+		}
+	writel(5, t + 0x030);
+	wmb();
+	return 0;
+}
+
+static const char * const v574_fw_names[] = {
+	"bb_class.elf", "bb_tmu.elf", "bb_util.elf",
+};
+static const enum comcerto_pfe_fw_image v574_fw_images[] = {
+	COMCERTO_PFE_FW_CLASS, COMCERTO_PFE_FW_TMU, COMCERTO_PFE_FW_UTIL,
+};
+
+static int v574_swap_to_barebox_fw(struct comcerto_pfe_port *pfe, void __iomem *axi)
+{
+	struct device *dev = pfe->dev;
+	void __iomem *cls = axi + COMCERTO_PFE_CLASS_CBUS_OFFSET;
+	void __iomem *tmu = axi + COMCERTO_PFE_TMU_CBUS_OFFSET;
+	void __iomem *utl = axi + COMCERTO_PFE_UTIL_CBUS_OFFSET;
+	u32 st_c = 0, st_t = 0, st_u = 0;
+	unsigned int i;
+	int ret;
+
+	/* stop: Barebox class_disable / tmu_disable(0xf) / util_disable */
+	writel(0, cls + 0x04);
+	writel(readl(tmu + 0x104) & ~0xfu, tmu + 0x104);
+	writel(0, utl + 0x04);
+	wmb();
+	mdelay(10);
+	/* V575: Barebox block configuration instead of the stock one. */
+	v575_barebox_class_init(axi + COMCERTO_PFE_CLASS_OFFSET, pfe->ddr,
+				(u32)pfe->ddr_phys);
+	ret = v575_barebox_tmu_init(axi + COMCERTO_PFE_TMU_OFFSET,
+				    (u32)pfe->ddr_phys + COMCERTO_PFE_TMU_LLM_OFFSET);
+	if (ret) {
+		dev_emerg(dev, "PFE:V574:REINIT_FAILED=%d\n", ret);
+		return ret;
+	}
+	writel(2, utl + 0x04);			/* Barebox util_reset */
+	writel(0, utl + 0x04);
+	comcerto_pfe_stock_util_init(axi + COMCERTO_PFE_UTIL_OFFSET);
+	for (i = 0; i < ARRAY_SIZE(v574_fw_names); i++) {
+		const struct firmware *fw;
+
+		ret = request_firmware(&fw, v574_fw_names[i], dev);
+		if (ret) {
+			dev_emerg(dev, "PFE:V574:MISSING=%s:%d\n", v574_fw_names[i], ret);
+			return ret;
+		}
+		ret = comcerto_pfe_load_firmware_barebox(dev, axi, pfe->ddr,
+							 v574_fw_images[i], fw->data, fw->size);
+		release_firmware(fw);
+		if (ret) {
+			dev_emerg(dev, "PFE:V574:LOAD_FAILED=%s:%d\n", v574_fw_names[i], ret);
+			return ret;
+		}
+	}
+	writel(1, utl + 0x04);
+	writel(readl(tmu + 0x104) | 0x0f, tmu + 0x104);
+	writel(1, cls + 0x04);
+	wmb();
+	mdelay(50);
+	/* pestatus: class DMEM 0x800, tmu 0x80, util 0x0 (from the images) */
+	comcerto_pfe_read_dmem_word(axi, 0, 0x800, &st_c);
+	comcerto_pfe_read_dmem_word(axi, 6, 0x80, &st_t);
+	comcerto_pfe_read_dmem_word(axi, 10, 0x0, &st_u);
+	dev_emerg(dev, "PFE:V574:BAREBOX_FW;CLASS=%08x:TMU=%08x:UTIL=%08x:CC=%08x:TM=%08x:UC=%08x\n",
+		  st_c, st_t, st_u, readl(cls + 0x04), readl(tmu + 0x104), readl(utl + 0x04));
+	return 0;
+}
+
+/* Returns 0 when eth0 is registered and owns ndev/phy/bus; nonzero leaves
+ * the hardware untouched or restored so the V550 teardown can run. */
+static int v564_netdev_up(struct comcerto_pfe_port *pfe, void __iomem *axi,
+			  void __iomem *g, struct net_device *ndev)
+{
+	struct v564_priv *p = netdev_priv(ndev);
+	struct device *dev = pfe->dev;
+	void __iomem *hif = axi + COMCERTO_PFE_HIF_OFFSET;
+	void __iomem *gpi4 = axi + COMCERTO_PFE_GPI4_OFFSET;
+	struct comcerto_pfe_hif_desc *rx = pfe->stock_dma_b;
+	struct comcerto_pfe_ctrl_tx_command_plan plan;
+	u8 val[COMCERTO_PFE_CTRL_CLASS_PE_COUNT * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES];
+	struct v546_snapshot pre;
+	unsigned int i, own = 0;
+	int ret;
+
+	p->pfe = pfe;
+	p->ndev = ndev;
+	p->axi = axi;
+	p->hif = hif;
+	p->g = g;
+	p->rx_head = 0;
+	p->ncr0 = readl(g + COMCERTO_PFE_GEMAC_ECNTRL);
+	spin_lock_init(&p->tx_lock);
+	if (readl(hif + COMCERTO_PFE_HIF_RX_CTRL) || readl(hif + COMCERTO_PFE_HIF_TX_CTRL) ||
+	    readl(hif + COMCERTO_PFE_HIF_INT_ENABLE)) {
+		dev_emerg(dev, "PFE:V564:SKIP;HIF_NOT_QUIESCENT\n");
+		return -EBUSY;
+	}
+	for (i = 0; i < COMCERTO_PFE_HIF_STOCK_DESC_COUNT; i++)
+		own += (READ_ONCE(rx[i].control) & COMCERTO_PFE_HIF_DESC_OWN) &&
+		       READ_ONCE(rx[i].data_addr) == lower_32_bits(pfe->rx_ring.buffer_dma[i]);
+	ret = own != COMCERTO_PFE_HIF_STOCK_DESC_COUNT ? -EIO : v551_port0_plan(pfe, &plan);
+	if (!ret)
+		ret = v546_read(axi, &plan, &pre);
+	if (!ret && ((pre.value_hi[0] & 0xff) || V546_BYTE(pre.util, plan.util_enable_offset)))
+		ret = -EBUSY;
+	if (!ret)
+		ret = comcerto_pfe_hif_validate_tx_handoff_context(&pfe->tx_ring);
+	if (!ret)
+		ret = comcerto_pfe_hif_stock_tx_producer_init(&p->prod,
+			pfe->tx_ring.desc, pfe->tx_ring.desc_dma, pfe->tx_ring.completion,
+			pfe->tx_ring.pending, pfe->tx_ring.in_flight,
+			COMCERTO_PFE_HIF_STOCK_DESC_COUNT);
+	if (ret) {
+		dev_emerg(dev, "PFE:V564:SKIP;PRECHECK=%d:OWN=%u\n", ret, own);
+		return ret;
+	}
+	p->txbuf = dmam_alloc_coherent(dev, COMCERTO_PFE_HIF_STOCK_DESC_COUNT * V564_TXBUF,
+				       &p->txbuf_dma, GFP_KERNEL);
+	if (!p->txbuf || upper_32_bits(p->txbuf_dma + COMCERTO_PFE_HIF_STOCK_DESC_COUNT *
+					V564_TXBUF - 1)) {
+		dev_emerg(dev, "PFE:V564:SKIP;TXBUF\n");
+		return -ENOMEM;
+	}
+	/* V574: V573's stock ICC replay throttled traffic (V573 hardware) and
+	 * is dropped; the stock firmware is replaced by Barebox' PE images. */
+	ret = v574_swap_to_barebox_fw(pfe, axi);
+	if (ret)
+		return ret;
+	p->prod.barebox_abi = true;
+	/* V575: all 256 RX descriptors in Barebox' format before HIF RX starts */
+	for (i = 0; i < COMCERTO_PFE_HIF_STOCK_DESC_COUNT; i++)
+		WRITE_ONCE(rx[i].control, V575_BB_RX_CONTROL(pfe->rx_ring.buffer_len));
+	wmb();
+	for (i = 0; i < COMCERTO_PFE_CTRL_CLASS_PE_COUNT; i++)
+		/* V571: back to the stock port MAC = netdev MAC (V570's dummy
+		 * MAC did not avoid the FPP lookup). */
+		memcpy(val + i * COMCERTO_PFE_CTRL_PHY_PORT_TX_VALUE_BYTES, v564_mac, ETH_ALEN);
+
+	/* Proven V551/V563 order: bases, port 0, HIF RX, HGPI, GEMAC, EGPI1, HIF TX. */
+	writel(lower_32_bits(pfe->stock_dma_b_addr), hif + COMCERTO_PFE_HIF_TX_BASE);
+	writel(lower_32_bits(pfe->tx_ring.desc_dma), hif + COMCERTO_PFE_HIF_RX_BASE);
+	wmb();
+	/* V574: no port-0 configure command — Barebox' class firmware has no
+	 * FPP port table (its DMEM ends at 0xa0c). */
+	writel(COMCERTO_PFE_HIF_RX_CTRL_ENABLE, hif + COMCERTO_PFE_HIF_RX_CTRL);
+	p->g4cfg0 = readl(gpi4 + 0x08);
+	p->g4en0 = readl(gpi4 + 0x04);
+	writel((COMCERTO_PFE_GPI4_CONTROL_HI << 16) | 3, gpi4 + 0x08);
+	writel(1, gpi4 + 0x04);
+	writel(get_unaligned_le32(v564_mac), g + V564_GEM_SA1B);
+	writel(get_unaligned_le16(v564_mac + 4), g + V564_GEM_SA1T);
+	writel(readl(g + COMCERTO_PFE_GEMAC_CONFIG) | V564_NCFGR_CAF, g + COMCERTO_PFE_GEMAC_CONFIG);
+	writel(p->ncr0 | BIT(2) | BIT(3), g + COMCERTO_PFE_GEMAC_ECNTRL);
+	writel(1, axi + COMCERTO_PFE_GPI1_OFFSET + 0x04);
+	mb();
+	writel(COMCERTO_PFE_HIF_TX_CTRL_ENABLE, hif + COMCERTO_PFE_HIF_TX_CTRL);
+	mb();
+	p->reboot_nb.notifier_call = v564_reboot;
+	p->reboot_nb.priority = INT_MAX;
+	register_reboot_notifier(&p->reboot_nb);
+
+	ndev->netdev_ops = &v564_ops;
+	ndev->watchdog_timeo = 5 * HZ;
+	SET_NETDEV_DEV(ndev, dev);
+	eth_hw_addr_set(ndev, v564_mac);
+	netif_napi_add(ndev, &p->napi, v564_napi_poll);
+	timer_setup(&p->poll, v564_timer, 0);
+	INIT_DELAYED_WORK(&p->hb, v569_heartbeat);
+	p->hb_seq = 0;
+	p->polls = 0;
+	p->dumped = 0;
+	if (!ndev->phydev->link)
+		netif_carrier_off(ndev);
+	ret = register_netdev(ndev);
+	dev_emerg(dev, "PFE:V564:NETDEV=%d;NAME=%s:NCR=%08x:CFG=%08x:HRX=%08x:HTX=%08x\n",
+		  ret, ret ? "-" : ndev->name, readl(g + COMCERTO_PFE_GEMAC_ECNTRL),
+		  readl(g + COMCERTO_PFE_GEMAC_CONFIG),
+		  readl(hif + COMCERTO_PFE_HIF_RX_CTRL), readl(hif + COMCERTO_PFE_HIF_TX_CTRL));
+	if (ret) {
+		netif_napi_del(&p->napi);
+		v564_reboot(&p->reboot_nb, 0, NULL);
+		unregister_reboot_notifier(&p->reboot_nb);
+		writel(lower_32_bits(pfe->stock_dma_a_addr), hif + COMCERTO_PFE_HIF_RX_BASE);
+		return ret;
+	}
+	return 0;
+}
+
+static void comcerto_pfe_v550_gemac_phy_attach(struct comcerto_pfe_port *pfe, void __iomem *axi)
+{
+	struct device *dev = pfe->dev;
+	void __iomem *g = axi + COMCERTO_PFE_GEMAC1_OFFSET;
+	u32 ncr = readl(g + COMCERTO_PFE_GEMAC_ECNTRL);
+	u32 cfg = readl(g + COMCERTO_PFE_GEMAC_CONFIG);
+	u32 mode = readl(g + V550_GEMAC_MODE_REG);
+	struct phy_device *phy = NULL;
+	struct net_device *ndev = NULL;
+	struct mii_bus *bus;
+	struct v550_ctx *c;
+	u32 v;
+	int i, ret;
+
+	dev_emerg(dev, "PFE:V550:PRE;NCR=%08x:CFG=%08x:MODE=%08x\n", ncr, cfg, mode);
+	bus = mdiobus_alloc();
+	if (!bus)
+		goto restore;
+	bus->name = "comcerto-pfe-mdio";
+	snprintf(bus->id, MII_BUS_ID_SIZE, "pfe-mdio-0");
+	bus->priv = g;
+	bus->parent = dev;
+	bus->read = v549_mdio_read;
+	bus->write = v550_mdio_write;
+	bus->reset = v549_mdio_reset;
+	bus->phy_mask = V549_PHY_MASK;
+	ret = mdiobus_register(bus);
+	if (ret) {
+		dev_emerg(dev, "PFE:V550:MDIO_REGISTER_FAILED=%d\n", ret);
+		mdiobus_free(bus);
+		goto restore;
+	}
+
+	/* stock gemac_set_config() + flag helpers, applied as one CFG store */
+	writel((readl(g + V550_GEMAC_MODE_REG) & ~0x6u) | 0x4, g + V550_GEMAC_MODE_REG);
+	v = readl(g + COMCERTO_PFE_GEMAC_CONFIG);
+	v &= ~(V550_NCFGR_MODE5 | V550_NCFGR_SPD | V550_NCFGR_PCSSEL | V550_NCFGR_NBC |
+	       V550_NCFGR_UNIHEN | V550_NCFGR_MTIHEN | V550_NCFGR_IGNFCS |
+	       V550_NCFGR_DBW_MASK | V550_NCFGR_RXCOEN);
+	v |= V550_NCFGR_GBE | V550_NCFGR_FD | V550_NCFGR_BIG | V550_NCFGR_JUMBO |
+	     V550_NCFGR_PAE | V550_NCFGR_DBW64;
+	writel(v, g + COMCERTO_PFE_GEMAC_CONFIG);
+	dev_emerg(dev, "PFE:V550:GEMAC_CONFIGURED;NCR=%08x:CFG=%08x:MODE=%08x\n",
+		  readl(g + COMCERTO_PFE_GEMAC_ECNTRL), readl(g + COMCERTO_PFE_GEMAC_CONFIG),
+		  readl(g + V550_GEMAC_MODE_REG));
+
+	ndev = alloc_etherdev(sizeof(struct v564_priv));	/* V564: becomes eth0 */
+	if (!ndev)
+		goto unbus;
+	/* V576: phy_attach_direct() reads the parent's driver owner with
+	 * CONFIG_MODULES, so the parent must be set before phy_connect. */
+	SET_NETDEV_DEV(ndev, dev);
+	c = netdev_priv(ndev);
+	c->g = g;
+	c->dev = dev;
+	c->last_link = -1;
+	phy = mdiobus_get_phy(bus, 4);
+	if (!phy) {
+		dev_emerg(dev, "PFE:V550:PHY4_ABSENT\n");
+		goto unndev;
+	}
+	ret = phy_connect_direct(ndev, phy, v550_adjust_link, PHY_INTERFACE_MODE_NA);
+	if (ret) {
+		dev_emerg(dev, "PFE:V550:PHY_CONNECT_FAILED=%d\n", ret);
+		goto unndev;
+	}
+	dev_emerg(dev, "PFE:V550:PHY_CONNECTED;DRV=%s\n", phy->drv ? phy->drv->name : "?");
+	phy_start(phy);
+	for (i = 0; i < 80 && !(phy->link && c->last_link == 1); i++)
+		msleep(100);
+	dev_emerg(dev, "PFE:V550:LINK_WAIT;MS=%d:LINK=%s:SPEED=%d:DUPLEX=%d\n",
+		  i * 100, phy->link ? "UP" : "DOWN", phy->speed, phy->duplex);
+	/* V564: on success eth0 owns ndev, the PHY and the MDIO bus. */
+	if (phy->link && !v564_netdev_up(pfe, axi, g, ndev))
+		return;
+	phy_stop(phy);
+	phy_disconnect(phy);
+unndev:
+	free_netdev(ndev);
+unbus:
+	mdiobus_unregister(bus);
+	mdiobus_free(bus);
+restore:
+	writel(mode, g + V550_GEMAC_MODE_REG);
+	writel(cfg, g + COMCERTO_PFE_GEMAC_CONFIG);
+	writel(ncr, g + COMCERTO_PFE_GEMAC_ECNTRL);
+	wmb();
+	dev_emerg(dev, "PFE:V550:DONE;RESTORED NCR=%08x:CFG=%08x:MODE=%08x\n",
+		  readl(g + COMCERTO_PFE_GEMAC_ECNTRL), readl(g + COMCERTO_PFE_GEMAC_CONFIG),
+		  readl(g + V550_GEMAC_MODE_REG));
+}
+
+static int comcerto_pfe_probe(struct platform_device *pdev)
+{
+	struct comcerto_pfe_port *pfe;
+	struct comcerto_pfe_pe_layout layout;
+	struct resource *axi_resource;
+	struct resource *ddr_resource;
+	void __iomem *axi, *ddr, *hif, *gpi4, *clkcore;
+	struct clk *pfe_core_clk, *pfe_sys_clk;
+	struct reset_control *axi_pfe_reset, *pfe_core_reset;
+	u32 hif_status;
+	u32 hif_tx_base, hif_rx_base;
+	u32 class_util, class_tmu, class_ctrl, class_int, class_rx, class_tx;
+	u32 command;
+	struct comcerto_pfe_ctrl_dma_pools ctrl_pools;
+	struct comcerto_pfe_hif_desc_fault hif_fault;
+	struct comcerto_pfe_hif_stock_tx_producer stock_tx_producer;
+	struct comcerto_pfe_hif_desc *tx_test_desc, *tx_test_desc_next;
+	struct comcerto_pfe_hif_tx_completion *tx_test_completion;
+	u32 tx_test_control, tx_test_control_next;
+	u32 tx_test_status;
+	u32 tx_test_metadata, tx_test_data, tx_test_data_next;
+	u32 tx_test_completed;
+	u32 tx_hif_desc_control, tx_hif_completion_control, tx_hif_int_status;
+	u32 tx_hif_head_before;
+	u32 tx_hif_irq_seen, tx_hif_gpi_control, tx_hif_rx_control;
+	u32 phy_port_words[COMCERTO_PFE_CTRL_PHY_PORT_COUNT]
+		[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	u32 phy_port_index_words[COMCERTO_PFE_CTRL_PHY_PORT_COUNT]
+		[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	u32 phy_port_symbol[COMCERTO_PFE_CTRL_CLASS_PHY_PORT_SYMBOL_BYTES / sizeof(u32)];
+	u32 tx_cmd_value_words[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	u32 tx_cmd_flag_words[COMCERTO_PFE_CTRL_CLASS_PE_COUNT];
+	u32 tx_cmd_util_word;
+	int tx_test_irq_seen, tx_test_napi_seen;
+	int start_ret;
+	int ret;
+	unsigned int i, port, pe;
+
+	/* V298 binding gate: must be visible before any PFE resource lookup or
+	 * MMIO.  This distinguishes a missing platform bind from a first-access
+	 * hardware lockup. */
+	dev_emerg(&pdev->dev, "PFE stage %u platform probe entered\n",
+		  COMCERTO_PFE_STOCK_HW_PREP_STAGE);
+#if COMCERTO_PFE_STOCK_HW_PREP_STAGE == 0
+	dev_emerg(&pdev->dev, "PFE stage 0 binding confirmed; MMIO disabled\n");
+	return 0;
+#endif
+
+	pfe = devm_kzalloc(&pdev->dev, sizeof(*pfe), GFP_KERNEL);
+	if (!pfe)
+		return -ENOMEM;
+	atomic_set(&pfe->hif_irq_seen, 0);
+	atomic_set(&pfe->hif_rx_irq_seen, 0);
+	atomic_set(&pfe->hif_napi_seen, 0);
+	atomic_set(&pfe->hif_rx_recycled, 0);
+	pfe->dev = &pdev->dev;
+	ret = comcerto_pfe_prepare_bridge_host(pfe);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+			"disabled bridge host contract is inconsistent\n");
+	dev_emerg(&pdev->dev, "PFE:V508:TX_COMMAND_PORT_ISOLATION_EARLY=OK\n");
+	pfe->napi_dev = alloc_netdev(0, "pfehif%d", NET_NAME_UNKNOWN, ether_setup);
+	if (!pfe->napi_dev)
+		return -ENOMEM;
+	netif_napi_add_weight(pfe->napi_dev, &pfe->napi,
+			     comcerto_pfe_hif_poll, COMCERTO_PFE_HIF_NAPI_WEIGHT);
+	if (devm_add_action_or_reset(&pdev->dev,
+				     comcerto_pfe_release_napi, pfe))
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(pfe_expect); i++) {
+		struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+			pfe_expect[i].name);
+		if (!r || r->start != pfe_expect[i].start ||
+		    (pfe_expect[i].exact ? resource_size(r) != pfe_expect[i].size :
+		     resource_size(r) < pfe_expect[i].size))
+			return dev_err_probe(&pdev->dev, -EINVAL, "invalid %s resource\n",
+				pfe_expect[i].name);
+	}
+	/* Validate every recovered PFE block offset before mapping AXI or issuing
+	 * the existing staging writes.  This is a pure bounds check. */
+	axi_resource = platform_get_resource_byname(pdev, IORESOURCE_MEM, "axi");
+	if (comcerto_pfe_stock_axi_layout_valid(resource_size(axi_resource)))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+			"AXI aperture cannot contain the recovered PFE layout\n");
+	pfe->hif_irq = platform_get_irq_byname(pdev, "hif");
+	if (pfe->hif_irq < 0)
+		return dev_err_probe(&pdev->dev, -EINVAL, "missing hif IRQ\n");
+	if (comcerto_pfe_pe_layout(0, &layout) ||
+	    comcerto_pfe_pe_command(&layout, COMCERTO_PFE_PE_DMEM,
+				    0, 0, 4, &command))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+			"invalid recovered PE command contract\n");
+	/*
+	 * Barebox leaves the stock PFE HIF live across bootm.  The recovered
+	 * 3.2.54 ISR first masks HIF interrupts by writing zero at +0x38, then
+	 * acknowledges status with bits 0 and 2 removed at +0x34.  Reproduce
+	 * only that quiesce sequence here: no descriptor, DMA, firmware, netdev
+	 * or Linux IRQ handler is activated in this stage.
+	 */
+	axi = devm_platform_ioremap_resource_byname(pdev, "axi");
+	if (IS_ERR(axi))
+		return PTR_ERR(axi);
+	ddr_resource = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ddr");
+	/* The PFE DDR aperture is already reserved by firmware.  The stock
+	 * driver maps it directly; requesting it again makes modern resource
+	 * arbitration reject an otherwise valid firmware-owned window. */
+	ddr = devm_ioremap(&pdev->dev, ddr_resource->start,
+			   resource_size(ddr_resource));
+	if (!ddr)
+		return -ENOMEM;
+	pfe->ddr = ddr;
+	pfe->ddr_phys = ddr_resource->start;
+	pfe->ddr_size = resource_size(ddr_resource);
+	/* LS1024A/Comcerto-2000 reference code identifies this common window as
+	 * clkcore.  V334 reads the PFE clock and reset words only: AXI clock gate
+	 * control at 0x44, PFE core clock control at 0x100, AXI PFE_SYS reset at
+	 * 0x54 and PFE core reset at 0x108.  No write, reset, or clock transition
+	 * is permitted in the inherited-Barebox state. */
+	clkcore = devm_platform_ioremap_resource_byname(pdev, "clkcore");
+	if (IS_ERR(clkcore))
+		return PTR_ERR(clkcore);
+	pfe_core_clk = devm_clk_get(&pdev->dev, "pfe-core");
+	if (IS_ERR(pfe_core_clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pfe_core_clk),
+			"missing PFE core clock provider\n");
+	pfe_sys_clk = devm_clk_get(&pdev->dev, "pfe-sys");
+	if (IS_ERR(pfe_sys_clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pfe_sys_clk),
+			"missing PFE system clock provider\n");
+	/* The native reset-controller is intentionally status-only in V335.
+	 * No assert/deassert/reset operation is allowed in inherited-Barebox
+	 * state before the hardware handoff contract is proven. */
+	axi_pfe_reset = devm_reset_control_get_exclusive(&pdev->dev, "axi-pfe-sys");
+	if (IS_ERR(axi_pfe_reset))
+		return dev_err_probe(&pdev->dev, PTR_ERR(axi_pfe_reset),
+			"missing AXI PFE reset controller\n");
+	pfe_core_reset = devm_reset_control_get_exclusive(&pdev->dev, "pfe-core");
+	if (IS_ERR(pfe_core_reset))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pfe_core_reset),
+			"missing PFE core reset controller\n");
+	/* V341 establishes the paired PFE reset ordering without an HIF handoff:
+	 * stop the core first, then reset the PFE AXI/system domain; release the
+	 * AXI domain before allowing the core to run.  Each provider operation
+	 * holds its state for 200 us.  No clock, HIF base/control, PE, DMA, IRQ or
+	 * storage write is permitted by this test. */
+	dev_emerg(&pdev->dev, "PFE:RESET-SEQUENCE:BEGIN core->axi / axi->core\n");
+	ret = reset_control_assert(pfe_core_reset);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "PFE core reset assert failed\n");
+	ret = reset_control_assert(axi_pfe_reset);
+	if (ret)
+		goto reset_release;
+	ret = reset_control_deassert(axi_pfe_reset);
+	if (ret)
+		goto reset_release;
+	ret = reset_control_deassert(pfe_core_reset);
+	if (ret)
+		goto reset_release;
+	dev_emerg(&pdev->dev,
+		  "PFE:RESET-SEQUENCE:END axi-pfe-sys=%d pfe-core=%d\n",
+		  reset_control_status(axi_pfe_reset),
+		  reset_control_status(pfe_core_reset));
+	/* V342: give the paired-reset domains a deliberately conservative settle
+	 * window, then capture HIF state once before any other PFE observation.
+	 * This is read-only: descriptor bases and all HIF control words remain
+	 * inherited and untouched. */
+	hif = axi + COMCERTO_PFE_HIF_OFFSET;
+	gpi4 = axi + COMCERTO_PFE_GPI4_OFFSET;
+	mdelay(100);
+	dev_emerg(&pdev->dev,
+		  "PFE:POSTRESET:100MS:HIF rx-base=%08x rx-ctrl=%08x tx-base=%08x tx-ctrl=%08x int-en=%08x int-status=%08x (no write)\n",
+		  readl(hif + COMCERTO_PFE_HIF_RX_BASE),
+		  readl(hif + COMCERTO_PFE_HIF_RX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_TX_BASE),
+		  readl(hif + COMCERTO_PFE_HIF_TX_CTRL),
+		  readl(hif + COMCERTO_PFE_HIF_INT_ENABLE),
