diff --git a/arch/arm/boot/dts/mindspeed/comcerto2000.dtsi b/arch/arm/boot/dts/mindspeed/comcerto2000.dtsi
new file mode 100644
index 000000000..9566a36b8
--- /dev/null
+++ b/arch/arm/boot/dts/mindspeed/comcerto2000.dtsi
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/clock/ls1024a.h>
+#include <dt-bindings/reset/ls1024a.h>
+#include <dt-bindings/phy/phy-ls1024a-serdes.h>
+
+/ {
+	compatible = "mindspeed,comcerto-2000";
+	interrupt-parent = <&intc>;
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <0>;
+			status = "okay";
+		};
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <1>;
+			status = "disabled";
+		};
+	};
+
+	memory@4000000 {
+		device_type = "memory";
+		reg = <0x04000000 0x3c000000>;
+	};
+
+	/* The stock PFE owns this shared firmware/data aperture.  It must not
+	 * enter the Linux page allocator before the PFE firmware loader writes
+	 * its ELF .ddr_* sections there. */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		pfe_ddr: pfe-ddr@3400000 {
+			reg = <0x03400000 0x00c00000>;
+			no-map;
+		};
+	};
+
+	/* Stock comcerto_l2cc_init() initializes this PL310 at 0xfff10000
+	 * with AUX_CTRL 0x00c40000 and reports an 8-way 256 KiB L2 cache. */
+	l2: cache-controller@fff10000 {
+		compatible = "arm,pl310-cache";
+		reg = <0xfff10000 0x1000>;
+		arm,aux-val = <0x00c40000>;
+		arm,aux-mask = <0x01cf0000>;
+		cache-unified;
+		cache-level = <2>;
+	};
+
+	/* ZYXELUNTRASH_RE5_GIC_BEGIN */
+	intc: interrupt-controller@fff01000 {
+		compatible = "arm,cortex-a9-gic";
+		#interrupt-cells = <3>;
+		#address-cells = <1>;
+		interrupt-controller;
+		reg = <0xfff01000 0x00001000>,
+		      <0xfff00100 0x00000100>;
+	};
+	/* ZYXELUNTRASH_RE5_GIC_END */
+
+	/* ZYXELUNTRASH_RE5_V11_TIMER_BEGIN */
+	timer_clk: timer-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <250000000>;
+	};
+
+	timer0: timer@90450000 {
+		compatible = "mindspeed,comcerto-2000-timer";
+		reg = <0x90450000 0x1000>;
+		interrupts = <0 56 1>;
+		clocks = <&timer_clk>;
+		clock-names = "timer";
+		clock-frequency = <250000000>;
+		/*
+		 * V11 reconstruction node. It remains disabled until the
+		 * register roles, control semantics and Linux-6.6 driver are
+		 * independently validated.
+		 */
+		status = "okay";
+	};
+	/* ZYXELUNTRASH_RE5_V11_TIMER_END */
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		poweroff@90470000 {
+			compatible = "zyxel,nas542-poweroff";
+			reg = <0x90470000 0x5c>;
+			status = "okay";
+		};
+
+		/*
+		 * The ClockCore layout is shared with the stock global-reset path.
+		 * V334 verified these PFE clock/reset words read-only on NAS542.
+		 */
+		/* V576: Bonstra LS1024A clock/reset drivers (same id encoding as
+		 * the V85 comcerto bindings, hardware-checked 2026-10-08). */
+		clkcore: clkcore@904b0000 {
+			compatible = "fsl,ls1024a-clkcore", "syscon", "simple-mfd";
+			reg = <0x904b0000 0x400>;
+			#clock-cells = <1>;
+
+			clkreset: pfe_reset: reset-controller {
+				compatible = "fsl,ls1024a-reset";
+				#reset-cells = <1>;
+			};
+
+			/* Uses the physical identity mapping during final restart; the
+			 * ClockCore parent above is the sole owner of the MMIO window. */
+			restart {
+				compatible = "zyxel,nas542-mcu-watchdog-restart";
+				status = "okay";
+			};
+		};
+
+		phystat: phystat@90410000 {
+			compatible = "fsl,ls1024a-phystat", "syscon";
+			reg = <0x90410000 0x100>;
+		};
+
+		gpio: gpio@90470000 {
+			#gpio-cells = <2>;
+			compatible = "fsl,ls1024a-gpio", "syscon", "simple-mfd";
+			reg = <0x90470000 0x200>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 0 64>;
+
+			pinctrl: pinctrl {
+				compatible = "fsl,ls1024a-pinctrl";
+			};
+		};
+
+		pci_usb_ctrl: pci_usb_ctrl@90460000 {
+			compatible = "fsl,ls1024a-pci-usb-ctrl", "syscon", "simple-mfd";
+			reg = <0x90460000 0x10000>;
+			pcie0_intc: pcie0-interrupt-controller {
+				compatible = "fsl,ls1024a-pcie-intc";
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+				interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+			};
+		};
+
+		/*
+		 * SPI0 (stock comcerto_spi.0, Linux-3.2 IRQ 61 = SPI 29, clock
+		 * "spi_i2c" 250 MHz).  No pinctrl: the pins stay in the SPI
+		 * function Barebox/boot ROM left them in (the boot ROM loads
+		 * uloader through this bus).
+		 */
+		spi0: spi@90498000 {
+			compatible = "snps,dw-apb-ssi";
+			reg = <0x90498000 0x1000>;
+			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkcore LS1024A_CLK_I2CSPI>;
+			clock-names = "ssi_clk";
+			reg-io-width = <4>;
+			num-cs = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		i2c: i2c@9049c000 {
+			compatible = "fsl,ls1024a-i2c";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0x9049c000 0x20>;
+			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+			resets = <&clkreset LS1024A_AXI_I2CSPI_RST>;
+			clocks = <&clkcore LS1024A_CLK_I2CSPI>;
+			clock-frequency = <100000>;
+			status = "okay";
+
+			/* NAS542 board MCU (fan/power/watchdog/MAC EEPROM), stock /proc/mcu. */
+
+			/* DS1337-compatible RTC (stock rtcAccess: regs 0-13, alarm 2 = wake). */
+			rtc@68 {
+				compatible = "dallas,ds1337";
+				reg = <0x68>;
+			};
+		};
+
+		usb3_phy: usb3_phy@904a0000 {
+			compatible = "fsl,ls1024a-usb3-phy";
+			reg = <0x904a0000 0x800>;
+			clocks = <&clkcore LS1024A_CLK_REF>;
+			#phy-cells = <0>;
+			resets = <&clkreset LS1024A_USB_USB1_PHY_RESET>,
+			         <&clkreset LS1024A_USB_USB1_UTMI_RESET>;
+			reset-names = "phy", "utmi";
+			status = "okay";
+		};
+
+		serdes@90590000 {
+			compatible = "fsl,ls1024a-serdes-phy";
+			reg = <0x90590000 0xc000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			resets = <&clkreset LS1024A_SERDES_SERDES0_RESET>,
+			         <&clkreset LS1024A_SERDES_SERDES1_RESET>,
+			         <&clkreset LS1024A_SERDES_SERDES2_RESET>;
+			serdes0: serdes0@0 {
+				#phy-cells = <1>;
+				reg = <0>;
+			};
+			serdes1: serdes1@1 {
+				#phy-cells = <1>;
+				reg = <1>;
+			};
+			serdes2: serdes2@2 {
+				#phy-cells = <1>;
+				reg = <2>;
+			};
+		};
+
+		/*
+		 * Stock 3.2.54 reports "PCIe0: Link Up Failed" on every recorded
+		 * boot and enumerates no PCI device; 6.6 sees LTSSM Detect.Quiet.
+		 * Nothing is attached on the NAS542, so the port stays disabled.
+		 */
+		pcie0: pcie@98000000 {
+			compatible = "fsl,ls1024a-pcie";
+			reg = <0x98000000 0x0080000>,
+			      <0xaff10000 0x0020000>;
+			reg-names = "dbi", "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			bus-range = <0x00 0xff>;
+			ranges = <0x81000000 0 0x00000000 0xaff00000 0 0x00010000
+				  0x82000000 0 0x00000000 0xa0000000 0 0x0fe00000>;
+			interrupt-parent = <&pcie0_intc>;
+			interrupts = <12>;
+			interrupt-names = "msi";
+			#interrupt-cells = <1>;
+			clocks = <&clkcore LS1024A_CLK_PCIE0>;
+			clock-names = "axi";
+			resets = <&clkreset LS1024A_AXI_PCIE0_RST>,
+			         <&clkreset LS1024A_PCIe_SATA_PCIE0_PWR_RST>,
+			         <&clkreset LS1024A_PCIe_SATA_PCIE0_REG_RST>;
+			reset-names = "axi", "power", "regs";
+			phys = <&serdes0 LS1024A_SERDES_TYPE_PCIE>;
+			phy-names = "bus";
+			num-lanes = <1>;
+			max-link-speed = <1>;
+			fsl,port-index = <0>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie0_intc 0>,
+					<0 0 0 2 &pcie0_intc 2>,
+					<0 0 0 3 &pcie0_intc 4>,
+					<0 0 0 4 &pcie0_intc 6>;
+			status = "disabled";
+		};
+
+		sata: sata@9d000000 {
+			compatible = "fsl,ls1024a-sata", "generic-ahci";
+			reg = <0x9d000000 0x10000>;
+			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkcore LS1024A_CLK_SATA>,
+				 <&clkcore LS1024A_CLK_SATA_OOB>,
+				 <&clkcore LS1024A_CLK_SATA_PMU>;
+			clock-names = "axi", "oob", "pmu";
+			resets = <&clkreset LS1024A_AXI_SATA_RST>,
+				 <&clkreset LS1024A_SATA_OOB_RST>,
+				 <&clkreset LS1024A_SATA_PMU_RST>,
+				 <&clkreset LS1024A_PCIe_SATA_SATA0_RX_RST>,
+				 <&clkreset LS1024A_PCIe_SATA_SATA0_TX_RST>,
+				 <&clkreset LS1024A_PCIe_SATA_SATA1_RX_RST>,
+				 <&clkreset LS1024A_PCIe_SATA_SATA1_TX_RST>;
+			reset-names = "axi", "oob", "pmu", "sata0_rx", "sata0_tx",
+				      "sata1_rx", "sata1_tx";
+			ports-implemented = <3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			sata0: sata-port@0 {
+				reg = <0>;
+				phys = <&serdes1 LS1024A_SERDES_TYPE_SATA>;
+			};
+			sata1: sata-port@1 {
+				reg = <1>;
+				phys = <&serdes2 LS1024A_SERDES_TYPE_SATA>;
+			};
+		};
+
+		usb3: usb3@9f000000 {
+			compatible = "snps,dwc3";
+			reg = <0x9f000000 0xcfff>;
+			interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb3_phy>;
+			phy-names = "usb3-phy";
+			clocks = <&clkcore LS1024A_CLK_USB1>,
+				 <&clkcore LS1024A_CLK_USB1>,
+				 <&clkcore LS1024A_CLK_INT_REF>;
+			clock-names = "ref", "bus_early", "suspend";
+			dr_mode = "host";
+			snps,usb3_lpm_capable;
+			status = "okay";
+		};
+
+		/* Stock dwc_otg (USB 2.0) at 0x92000000, Linux-3.2 IRQ 53. */
+		usb2: usb@92000000 {
+			compatible = "snps,dwc2";
+			reg = <0x92000000 0x1000000>;
+			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkcore LS1024A_CLK_USB0>;
+			clock-names = "otg";
+			dr_mode = "host";
+			status = "disabled";
+		};
+
+		/*
+		 * Stock Linux 3.2.54 registers this raw NAND controller as
+		 * "comcertonand" at 0xc8300000-0xc8301fff.  The 6.6 controller
+			 * driver remains disabled until the stock virtual control-register
+			 * address has been reconciled to a physical address.  The previously
+			 * tested 0xf0970010 value is a stock-kernel virtual address, not a
+			 * device-tree MMIO address.
+		 */
+		nand: nand@c8300000 {
+			compatible = "mindspeed,comcerto-2000-nand";
+			/* Original driver platform resource, retained for reconciliation. */
+			reg = <0xc8300000 0x2000>,
+			      <0x90470010 0x4>,
+			      <0x905a0000 0x200>,
+			      <0xc4000000 0x01000000>,
+			      <0xcfff0000 0x1000>;
+			reg-names = "stock-probe", "stock-ctrl", "exp-config", "cs4", "ecc";
+			status = "okay";
+		};
+
+		/* V78: inventory only; the driver performs no MMIO or DMA. */
+		pfe_probe: pfe@3400000 {
+			compatible = "mindspeed,comcerto-2000-pfe";
+			/* Stock Linux PFE reports ddr_phys_baseaddr=0x03400000. */
+			reg = <0x03400000 0x00c00000>,
+			      <0x9c000000 0x01000000>,
+			      <0x90500000 0x00010000>,
+			      <0x83000000 0x00002000>,
+			      <0x9a000000 0x01000000>,
+			      <0x904b0000 0x00000400>;
+			reg-names = "ddr", "axi", "apb", "iram", "ipsec", "clkcore";
+			clocks = <&clkcore LS1024A_CLK_PFE>, <&clkcore LS1024A_CLK_PFE_SYS>;
+			clock-names = "pfe-core", "pfe-sys";
+			resets = <&clkreset LS1024A_AXI_PFE_SYS_RST>, <&clkreset LS1024A_PFE_CORE_RST>;
+			reset-names = "axi-pfe-sys", "pfe-core";
+			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "hif";
+			status = "okay";
+		};
+
+
+		/* ZYXELUNTRASH_RE5_UART_BEGIN */
+		uart0: serial@96400000 {
+			compatible = "mindspeed,comcerto-2000-uart", "ns16550a";
+			reg = <0x96400000 0x00001000>;
+			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
+			no-loopback-test;
+			current-speed = <115200>;
+			reg-shift = <2>;
+			/* Vendor fastuart_handle_irq uses the 32-bit serial accessor. */
+			reg-io-width = <4>;
+			clock-frequency = <250000000>;
+			status = "okay";
+		};
+		/* ZYXELUNTRASH_RE5_UART_END */
+	};
+};
diff --git a/arch/arm/boot/dts/mindspeed/zyxel-nas542.dts b/arch/arm/boot/dts/mindspeed/zyxel-nas542.dts
new file mode 100644
index 000000000..b8d283caf
--- /dev/null
+++ b/arch/arm/boot/dts/mindspeed/zyxel-nas542.dts
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+
+#include "comcerto2000.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+
+/ {
+	model = "Zyxel NAS542 (Comcerto 2000 EVM)";
+	compatible = "zyxel,nas542", "mindspeed,comcerto-2000-evm",
+	             "mindspeed,comcerto-2000";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	/* Board GPIOs: Zyxel NAS5xx DT (scpcom ls1024a-6.1.y), stock gpio_init. */
+	leds {
+		compatible = "gpio-leds";
+		hdd1-green {
+			label = "hdd1-green";
+			gpios = <&gpio 48 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd1-red {
+			label = "hdd1-red";
+			gpios = <&gpio 49 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd2-green {
+			label = "hdd2-green";
+			gpios = <&gpio 50 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd2-red {
+			label = "hdd2-red";
+			gpios = <&gpio 51 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd3-green {
+			label = "hdd3-green";
+			gpios = <&gpio 52 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd3-red {
+			label = "hdd3-red";
+			gpios = <&gpio 53 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd4-green {
+			label = "hdd4-green";
+			gpios = <&gpio 54 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		hdd4-red {
+			label = "hdd4-red";
+			gpios = <&gpio 55 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		sys-green {
+			label = "sys-green";
+			gpios = <&gpio 56 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		sys-red {
+			label = "sys-red";
+			gpios = <&gpio 57 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		copy-green {
+			label = "copy-green";
+			gpios = <&gpio 58 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+		copy-red {
+			label = "copy-red";
+			gpios = <&gpio 59 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+		power {
+			label = "power";
+			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_POWER>;
+			debounce-interval = <100>;
+		};
+		reset {
+			label = "reset";
+			gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <100>;
+		};
+		copy {
+			label = "copy";
+			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_PROG1>;
+			debounce-interval = <100>;
+		};
+	};
+
+	chosen {
+		stdout-path = "/soc/serial@96400000:115200n8";
+		bootargs = "console=ttyS0,115200n8 earlycon ignore_loglevel loglevel=8 panic=-1";
+	};
+};
+
+&gpio {
+	/* Stock platform_init drives GPIO14 high at boot ("Enable USB ..."). */
+	usb-power-hog {
+		gpio-hog;
+		gpios = <14 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-power";
+	};
+};
+
+/* Boot SPI-NOR (uloader/Barebox/env): strictly read-only. */
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <4000000>;
+		spi-cpha;
+		spi-cpol;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "uloader";
+				reg = <0x00000 0x40000>;
+				read-only;
+			};
+			partition@40000 {
+				label = "barebox";
+				reg = <0x40000 0x80000>;
+				read-only;
+			};
+			partition@c0000 {
+				label = "env";
+				reg = <0xc0000 0x40000>;
+				read-only;
+			};
+		};
+	};
+};
diff --git a/arch/arm/mach-comcerto/Kconfig b/arch/arm/mach-comcerto/Kconfig
new file mode 100644
index 000000000..9d5306034
--- /dev/null
+++ b/arch/arm/mach-comcerto/Kconfig
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config ARCH_COMCERTO
+	bool "Mindspeed Comcerto 2000 SoC support"
+	depends on ARCH_MULTI_V7
+	select ARM_AMBA
+	select ARM_GIC
+	select COMMON_CLK
+	select MFD_SYSCON
+	select RESET_CONTROLLER
+	select GENERIC_IRQ_MULTI_HANDLER
+	select SPARSE_IRQ
+	select USE_OF
+	help
+	  Compile the initial Device Tree based Linux support skeleton for
+	  Mindspeed Comcerto 2000 Cortex-A9 systems. Hardware drivers remain
+	  disabled until their register maps and clocks are independently proven.
+
+# Bonstra LS1024A drivers (third_party/linux-ls1024a) depend on this symbol.
+config ARCH_LS1024A
+	def_bool ARCH_COMCERTO
+	select HAVE_ARM_SCU
+	select HAVE_SMP
+	select HAVE_ARM_TWD if SMP
+	select ARM_ERRATA_754322
+	select ARM_ERRATA_764369 if SMP
+	select ARCH_HAS_RESET_CONTROLLER
+	select GPIOLIB
+	select MIGHT_HAVE_PCI
+	select PINCTRL
+	select PINCTRL_LS1024A
