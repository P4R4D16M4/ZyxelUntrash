+#define COMCERTO_PFE_CTRL_TX_FCODE_CONFIGURE			0x0501
+#define COMCERTO_PFE_CTRL_TX_FCODE_DISABLE			0x0502
+#define COMCERTO_PFE_CTRL_TX_FCODE_SET_NAME			0x0505
+#define COMCERTO_PFE_CTRL_TX_CONFIGURE_PAYLOAD_BYTES	20
