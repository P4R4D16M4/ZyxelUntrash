diff --git a/drivers/mtd/nand/raw/comcerto-nand-regs.h b/drivers/mtd/nand/raw/comcerto-nand-regs.h
new file mode 100644
index 000000000..63bd9fe94
--- /dev/null
+++ b/drivers/mtd/nand/raw/comcerto-nand-regs.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Mindspeed Comcerto 2000 Expansion Bus / NAND ECC register contract. */
+
+#ifndef __COMCERTO_NAND_REGS_H__
+#define __COMCERTO_NAND_REGS_H__
+
+#include <linux/bitops.h>
+#include <linux/build_bug.h>
+
+/* Sizes of the named read-only DT resources. */
+#define COMCERTO_NAND_PROBE_BYTES	0x2000
+#define COMCERTO_EXP_CONFIG_BYTES	0x200
+#define COMCERTO_ECC_BYTES		0x1000
+
+/* Expansion Bus configuration block (DT resource: exp-config). */
+#define COMCERTO_EXP_SW_RST		0x000
+#define COMCERTO_EXP_CS_EN		0x004
+#define COMCERTO_EXP_CS4_BASE		0x018
+#define COMCERTO_EXP_CS4_SEG		0x02c
+#define COMCERTO_EXP_CS4_CFG		0x040
+#define COMCERTO_EXP_CS4_TMG1		0x054
+#define COMCERTO_EXP_CS4_TMG2		0x068
+#define COMCERTO_EXP_CLK_DIV		0x080
+
+#define COMCERTO_EXP_CS_EN_CLK		BIT(0)
+#define COMCERTO_EXP_CS_EN_CS4		BIT(5)
+#define COMCERTO_EXP_CS4_CFG_NAND	BIT(9)
+
+/* Expansion ECC block (DT resource: ecc). */
+#define COMCERTO_ECC_SHIFT_EN_CFG	0x000
+#define COMCERTO_ECC_GEN_CFG		0x004
+#define COMCERTO_ECC_INIT_CFG		0x00c
+#define COMCERTO_ECC_PRTY_OUT_SEL	0x010
+#define COMCERTO_ECC_POLY_START	0x014
+#define COMCERTO_ECC_CS_SEL_CFG	0x018
+#define COMCERTO_ECC_IDLE_STAT		0x01c
+#define COMCERTO_ECC_POLY_STAT		0x020
+#define COMCERTO_ECC_CORR_STAT		0x024
+#define COMCERTO_ECC_CORR_DONE_STAT	0x028
+#define COMCERTO_ECC_CORR_DATA_STAT	0x02c
+
+#define COMCERTO_ECC_SHIFT_EN		BIT(0)
+#define COMCERTO_ECC_INIT		BIT(0)
+#define COMCERTO_ECC_CS4_SEL		BIT(4)
+#define COMCERTO_ECC_IDLE		BIT(0)
+#define COMCERTO_ECC_CORR_DONE		BIT(0)
+
+/*
+ * Stock 3.2.54 comcerto_enable_hw_ecc() sets bit 24 only when its mode
+ * argument is 1.  The custom write-page callback passes 1, while the custom
+ * read-page callback passes 0.  Consequently bit 24 selects generation
+ * (write), not correction (read).
+ */
+#define COMCERTO_ECC_GEN_READ_1BIT_1024	0x00080400
+#define COMCERTO_ECC_GEN_WRITE_1BIT_1024	0x01080400
+#define COMCERTO_ECC_CS4_SELECTED	COMCERTO_ECC_CS4_SEL
+#define COMCERTO_ECC_POLY_IDLE_STATE	0x00000002
+
+/*
+ * Directly observed stock control/status register semantics.  The stock
+ * driver accesses virtual address 0xf0970010. The recovered stock mapping
+ * proves its physical counterpart is 0x90470010; it is declared in the DT
+ * stock-control resource rather than encoded in this register header.
+ */
+#define COMCERTO_NAND_STOCK_CTRL_BYTES	0x4
+#define COMCERTO_NAND_STOCK_CHIP_ENABLE	BIT(28)
+#define COMCERTO_NAND_STOCK_READY		BIT(29)
+
+/*
+ * The stock cmd_ctrl callback loads these from 0x849ef500. They are byte
+ * offsets from the ioremapped 0xc8300000 resource, not from CS4.
+ */
+#define COMCERTO_NAND_STOCK_ADDR_OFFSET	0x200
+#define COMCERTO_NAND_STOCK_CMD_OFFSET	0x400
+
+/* Stock C2000 CS4 timings, retained for future read-only bring-up. */
+#define COMCERTO_EXP_CS4_TMG1_STOCK	0x0a0a001a
+#define COMCERTO_EXP_CS4_TMG2_STOCK	0x05050202
+
+static_assert(COMCERTO_EXP_CLK_DIV < COMCERTO_EXP_CONFIG_BYTES);
+static_assert(COMCERTO_ECC_CORR_DATA_STAT < COMCERTO_ECC_BYTES);
+static_assert(COMCERTO_NAND_STOCK_ADDR_OFFSET < COMCERTO_NAND_PROBE_BYTES);
+static_assert(COMCERTO_NAND_STOCK_CMD_OFFSET < COMCERTO_NAND_PROBE_BYTES);
+static_assert(COMCERTO_NAND_STOCK_CHIP_ENABLE != COMCERTO_NAND_STOCK_READY);
+
+#endif /* __COMCERTO_NAND_REGS_H__ */
diff --git a/drivers/mtd/nand/raw/comcerto-nand.c b/drivers/mtd/nand/raw/comcerto-nand.c
new file mode 100644
index 000000000..4d05f51e8
--- /dev/null
+++ b/drivers/mtd/nand/raw/comcerto-nand.c
@@ -0,0 +1,1953 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mindspeed Comcerto 2000 raw NAND controller, identification stage.
+ *
+ * The NAS542 stock driver uses proprietary hardware ECC and flash BBTs. The
+ * first enabled stage is therefore intentionally narrower than a usable MTD
+ * driver: it may identify the chip, but cannot send program/erase commands,
+ * cannot write data cycles, and skips all BBT handling. It exists solely to
+ * validate the recovered command/address apertures in a RAM boot.
+ */
+
+#include <linux/errno.h>
+#include <linux/crc32.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/partitions.h>
+#include <linux/mtd/rawnand.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <asm/unaligned.h>
+#include <asm/barrier.h>
+
+#include "comcerto-nand-regs.h"
+
+struct comcerto_nand {
+	struct nand_chip chip;
+	void __iomem *data;
+	void __iomem *ctrl;
+	void __iomem *exp;
+	void __iomem *ecc;
+	/* V241 RAM-only UBIFS superblock representation diagnostic. */
+	u8 ubifs_v241[4096];
+	u8 ubifs_v241_pages;
+};
+
+static u8 comcerto_nand_bitrev8(u8 value)
+{
+	value = ((value & 0x55) << 1) | ((value >> 1) & 0x55);
+	value = ((value & 0x33) << 2) | ((value >> 2) & 0x33);
+	return (value << 4) | (value >> 4);
+}
+
+/*
+ * V241 does not alter the MTD buffer.  It only asks whether the stored UBIFS
+ * CRC can be explained by a controller-style byte/word presentation issue.
+ * The checksum spans the UBIFS node payload (bytes 8..4095), exactly as
+ * fs/ubifs/io.c does.  A match identifies a deterministic representation to
+ * implement in a later, separately reviewed RAM-only candidate.
+ */
+static u32 comcerto_nand_v241_ubifs_crc(const u8 *node, unsigned int mode)
+{
+	u32 crc = ~0;
+	unsigned int i, source;
+	u8 value;
+
+	for (i = 0; i < 4096 - 8; i++) {
+		source = 8 + i;
+		switch (mode) {
+		case 1:
+			source = 8 + (i ^ 1);
+			break;
+		case 2:
+			source = 8 + ((i & ~3) | (3 - (i & 3)));
+			break;
+		case 4:
+			source = 8 + (i ^ 1);
+			break;
+		case 5:
+			source = 8 + ((i & ~3) | (3 - (i & 3)));
+			break;
+		}
+		value = node[source];
+		if (mode >= 3)
+			value = comcerto_nand_bitrev8(value);
+		crc = crc32(crc, &value, 1);
+	}
+	return crc;
+}
+
+static void comcerto_nand_v241_ubifs_diagnose(struct comcerto_nand *cn,
+						       struct device *dev)
+{
+	static const char * const names[] = {
+		"identity", "swap16", "reverse32", "bitrev8",
+		"bitrev8+swap16", "bitrev8+reverse32",
+	};
+	u32 stored = get_unaligned_le32(cn->ubifs_v241 + 4);
+	unsigned int mode;
+	u32 calculated;
+
+	for (mode = 0; mode < ARRAY_SIZE(names); mode++) {
+		calculated = comcerto_nand_v241_ubifs_crc(cn->ubifs_v241, mode);
+		dev_notice(dev,
+			   "V241 UBIFS CRC %s: calculated=%08x stored=%08x match=%u\n",
+			   names[mode], calculated, stored, calculated == stored);
+	}
+}
+
+/*
+ * V213 exposes only the discovered stock rootfs1 range to UBI.  Its offset
+ * and length were independently inventoried in V211; the parent MTD remains
+ * non-writable, so the child inherits a read-only write path.
+ */
+static const struct mtd_partition comcerto_nand_v213_parts[] = {
+	{
+		.name = "rootfs1",
+		.offset = 20 * 1024 * 1024,
+		.size = 110 * 1024 * 1024,
+	},
+};
+
+static inline struct comcerto_nand *to_comcerto_nand(struct nand_chip *chip)
+{
+	return container_of(chip, struct comcerto_nand, chip);
+}
+
+static bool comcerto_nand_is_write_command(int cmd)
+{
+	return cmd == NAND_CMD_SEQIN || cmd == NAND_CMD_PAGEPROG ||
+	       cmd == NAND_CMD_ERASE1 || cmd == NAND_CMD_ERASE2 ||
+	       cmd == NAND_CMD_RNDIN;
+}
+
+static void comcerto_nand_cmd_ctrl(struct nand_chip *chip, int cmd,
+				   unsigned int ctrl)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	u32 value;
+
+	if (ctrl & NAND_CTRL_CHANGE) {
+		value = readl(cn->ctrl);
+		if (ctrl & NAND_NCE)
+			value &= ~COMCERTO_NAND_STOCK_CHIP_ENABLE;
+		else
+			value |= COMCERTO_NAND_STOCK_CHIP_ENABLE;
+		writel(value, cn->ctrl);
+	}
+
+	if (cmd == NAND_CMD_NONE)
+		return;
+
+	/*
+	 * The same byte values occur in row addresses.  In particular page 16
+	 * supplies address byte 0x10 through ALE, which must never be mistaken for
+	 * PAGEPROG.  Reject write opcodes only when they are actually sent through
+	 * the command latch; MTD remains read-only independently.
+	 */
+	if ((ctrl & NAND_CLE) && comcerto_nand_is_write_command(cmd)) {
+		dev_warn_ratelimited(nand_to_mtd(chip)->dev.parent,
+				     "blocked NAND write/erase command 0x%02x\n", cmd);
+		/*
+		 * This is an evidence-only tripwire.  The command is rejected above;
+		 * a stack trace lets a RAM-only test identify any unexpected caller
+		 * before broader reads are considered again.
+		 */
+		dump_stack();
+		return;
+	}
+
+	/*
+	 * Stock comcerto_nand_cmd_ctrl() executes a full-system DSB immediately
+	 * before every command- or address-latch byte.  Do not rely on the weaker
+	 * architecture-dependent ordering hidden in iowrite8(): this bridge feeds
+	 * the ECC stream selector as well as the NAND bus.
+	 */
+	dsb(sy);
+
+	if (ctrl & NAND_CLE)
+		iowrite8(cmd, cn->data + COMCERTO_NAND_STOCK_CMD_OFFSET);
+	else if (ctrl & NAND_ALE)
+		iowrite8(cmd, cn->data + COMCERTO_NAND_STOCK_ADDR_OFFSET);
+}
+
+static int comcerto_nand_dev_ready(struct nand_chip *chip)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+
+	return !!(readl(cn->ctrl) & COMCERTO_NAND_STOCK_READY);
+}
+
+static void comcerto_nand_read_buf(struct nand_chip *chip, u8 *buf, int len)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	int i;
+
+	/*
+	 * Stock nand_read_buf() at 0x8435d0bc does not use an optimized string
+	 * accessor.  It performs one fixed-aperture byte load followed by `dsb sy`
+	 * before storing that byte to RAM.  The barrier is significant for the
+	 * controller/ECC stream boundary; ARM __raw_readsb has no per-byte barrier.
+	 */
+	for (i = 0; i < len; i++) {
+		u8 value = __raw_readb(cn->data);
+
+		/* Preserve stock's load -> DSB -> RAM-store instruction order. */
+		barrier();
+		dsb(sy);
+		barrier();
+		buf[i] = value;
+	}
+}
+
+/* No NAND data-input cycle is ever emitted by this identification driver. */
+static void comcerto_nand_discard_write_buf(struct nand_chip *chip,
+					    const u8 *buf, int len)
+{
+}
+
+/*
+ * V144 is deliberately observational: the recovered 3.2 driver polls the
+ * ECC status block, but this port must not enable generation or correction
+ * before its full read algorithm and OOB layout are reconstructed.  Taking a
+ * single register snapshot establishes the reset/idle state without writing
+ * any controller, NAND or ECC register.
+ */
+static void comcerto_nand_log_ecc_snapshot(struct platform_device *pdev,
+					    struct comcerto_nand *cn)
+{
+	dev_notice(&pdev->dev,
+		   "ECC snapshot (read-only): cfg=%08x gen=%08x init=%08x prty=%08x "
+		   "poly-start=%08x cs=%08x idle=%08x poly=%08x corr=%08x "
+		   "corr-done=%08x corr-data=%08x\\n",
+		   readl(cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_GEN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_INIT_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_PRTY_OUT_SEL),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_START),
+		   readl(cn->ecc + COMCERTO_ECC_CS_SEL_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_IDLE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+}
+
+/*
+ * V259 is observational. The recovered stock probe maps only its NAND,
+ * control and ECC resources, so the expansion-bus state is inherited from
+ * firmware. Record it before nand_scan() without modifying any register.
+ */
+static void comcerto_nand_v259_log_expansion_state(struct platform_device *pdev,
+						     struct comcerto_nand *cn)
+{
+	dev_notice(&pdev->dev,
+		   "V259 expansion state: rst=%08x en=%08x cs4-base=%08x seg=%08x cfg=%08x tmg1=%08x tmg2=%08x div=%08x expected-tmg1=%08x expected-tmg2=%08x\n",
+		   readl(cn->exp + COMCERTO_EXP_SW_RST),
+		   readl(cn->exp + COMCERTO_EXP_CS_EN),
+		   readl(cn->exp + COMCERTO_EXP_CS4_BASE),
+		   readl(cn->exp + COMCERTO_EXP_CS4_SEG),
+		   readl(cn->exp + COMCERTO_EXP_CS4_CFG),
+		   readl(cn->exp + COMCERTO_EXP_CS4_TMG1),
+		   readl(cn->exp + COMCERTO_EXP_CS4_TMG2),
+		   readl(cn->exp + COMCERTO_EXP_CLK_DIV),
+		   COMCERTO_EXP_CS4_TMG1_STOCK,
+		   COMCERTO_EXP_CS4_TMG2_STOCK);
+}
+
+/*
+ * V148 observes whether the already-programmed stock ECC engine changes
+ * state during the bounded raw reads.  This remains observational: no ECC
+ * register is written and no correction result is consumed.
+ */
+static void comcerto_nand_log_ecc_postread(struct platform_device *pdev,
+					    struct comcerto_nand *cn)
+{
+	dev_notice(&pdev->dev,
+		   "ECC post-read snapshot (read-only): cfg=%08x gen=%08x init=%08x "
+		   "prty=%08x poly-start=%08x cs=%08x idle=%08x poly=%08x corr=%08x "
+		   "corr-done=%08x corr-data=%08x\n",
+		   readl(cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_GEN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_INIT_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_PRTY_OUT_SEL),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_START),
+		   readl(cn->ecc + COMCERTO_ECC_CS_SEL_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_IDLE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+}
+
+/*
+ * These are the four writes in stock comcerto_enable_hw_ecc(mode == 0),
+ * recovered directly from 3.2.54: select CS4, program 1-bit/1024-byte read
+ * correction, then initialise and enable the engine.  The stock custom read
+ * callback passes mode 0; mode 1 and GEN_CFG bit 24 belong to the write path.
+ */
+static void comcerto_nand_enable_stock_ecc_read(struct comcerto_nand *cn)
+{
+	writel(COMCERTO_ECC_CS4_SELECTED,
+	       cn->ecc + COMCERTO_ECC_CS_SEL_CFG);
+	writel(COMCERTO_ECC_GEN_READ_1BIT_1024,
+	       cn->ecc + COMCERTO_ECC_GEN_CFG);
+	writel(COMCERTO_ECC_INIT, cn->ecc + COMCERTO_ECC_INIT_CFG);
+	writel(COMCERTO_ECC_SHIFT_EN, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+}
+
+/*
+ * V243 comparison control. V185 used the controller's inherited bit-24 mode
+ * and the calculate handshake below. That sequence produced valid normal
+ * reads on this board, although the complete stock disassembly later
+ * identified it as the write/generate path. Keep it isolated from the MTD
+ * callback and use it only for one bounded, read-only A/B capture.
+ */
+static void comcerto_nand_enable_v185_ecc(struct comcerto_nand *cn)
+{
+	writel(COMCERTO_ECC_CS4_SELECTED,
+	       cn->ecc + COMCERTO_ECC_CS_SEL_CFG);
+	writel(COMCERTO_ECC_GEN_WRITE_1BIT_1024,
+	       cn->ecc + COMCERTO_ECC_GEN_CFG);
+	writel(COMCERTO_ECC_INIT, cn->ecc + COMCERTO_ECC_INIT_CFG);
+	writel(COMCERTO_ECC_SHIFT_EN, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+}
+
+/*
+ * Exact stock calculate_ecc() controller handshake, reconstructed from
+ * 0x843630c4..0x8436312a.  It belongs exclusively to the stock custom write
+ * callback.  It remains here as recovered documentation but is deliberately
+ * unused while all NAND writes are blocked.
+ */
+static int __maybe_unused comcerto_nand_calculate_stock_ecc(struct nand_chip *chip)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	unsigned int attempt, i;
+
+	writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+	for (attempt = 0; attempt < 1000; attempt++) {
+		if (readl(cn->ecc + COMCERTO_ECC_IDLE_STAT) & COMCERTO_ECC_IDLE)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000)
+		return -ETIMEDOUT;
+
+	writel(COMCERTO_ECC_SHIFT_EN, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+	writel(COMCERTO_ECC_INIT, cn->ecc + COMCERTO_ECC_PRTY_OUT_SEL);
+	for (i = 0; i < 14; i++)
+		iowrite8(0xff, cn->data);
+	writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+	writel(0, cn->ecc + COMCERTO_ECC_PRTY_OUT_SEL);
+	return 0;
+}
+
+static int comcerto_nand_correct_step(struct nand_chip *chip, u8 *data,
+				      size_t data_len, int page, unsigned int step);
+
+static int __maybe_unused comcerto_nand_v244_compare_sequences(struct platform_device *pdev,
+						 struct comcerto_nand *cn)
+{
+	struct nand_chip *chip = &cn->chip;
+	u8 *data, ecc[14];
+	unsigned int step;
+	int correction, ret;
+
+	data = kmalloc(2048, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	/* Exact stock-read sequence, including the RAM-only correction strobe. */
+	ret = nand_read_page_op(chip, 10240, 0, NULL, 0);
+	if (ret)
+		goto out;
+	for (step = 0; step < 2; step++) {
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(chip, data + step * 1024, 1024,
+					false, false);
+		if (ret)
+			goto out;
+		ret = nand_read_data_op(chip, ecc, sizeof(ecc), false, false);
+		if (ret)
+			goto out;
+		dev_notice(&pdev->dev,
+			   "V244 stock step %u pre: data=%08x ecc=%08x poly=%08x corr=%08x done=%08x corr-data=%08x\n",
+			   step, crc32(~0, data + step * 1024, 1024),
+			   crc32(~0, ecc, sizeof(ecc)),
+			   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+		correction = comcerto_nand_correct_step(chip,
+				data + step * 1024, 1024, 10240, step);
+		dev_notice(&pdev->dev,
+			   "V244 stock step %u post: result=%d data=%08x poly=%08x corr=%08x done=%08x corr-data=%08x\n",
+			   step, correction,
+			   crc32(~0, data + step * 1024, 1024),
+			   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+		if (correction < 0)
+			break;
+	}
+
+	/* Repeat independently with the empirically successful V185 sequence. */
+	ret = nand_read_page_op(chip, 10240, 0, NULL, 0);
+	if (ret)
+		goto out;
+	for (step = 0; step < 2; step++) {
+		comcerto_nand_enable_v185_ecc(cn);
+		ret = nand_read_data_op(chip, data + step * 1024, 1024,
+					false, false);
+		if (ret)
+			goto out;
+		ret = comcerto_nand_calculate_stock_ecc(chip);
+		if (ret)
+			goto out;
+		dev_notice(&pdev->dev,
+			   "V244 V185 step %u pre: data=%08x poly=%08x corr=%08x done=%08x corr-data=%08x\n",
+			   step, crc32(~0, data + step * 1024, 1024),
+			   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+		correction = comcerto_nand_correct_step(chip,
+				data + step * 1024, 1024, 10240, step);
+		dev_notice(&pdev->dev,
+			   "V244 V185 step %u post: result=%d data=%08x poly=%08x corr=%08x done=%08x corr-data=%08x\n",
+			   step, correction,
+			   crc32(~0, data + step * 1024, 1024),
+			   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+		if (correction < 0)
+			break;
+	}
+	ret = 0;
+
+out:
+	kfree(data);
+	return ret;
+}
+
+/*
+ * V247 isolates the failing second half of the first volume-table page.
+ * Rather than continuing after step-0's 14 ECC transfers, start a fresh
+ * read at logical column 1024 and compare it with the preserved stock dump.
+ * The operation is read-only and all buffers are temporary RAM.
+ */
+static int comcerto_nand_v247_readdress_step1(struct platform_device *pdev,
+					       struct comcerto_nand *cn)
+{
+	struct nand_chip *chip = &cn->chip;
+	u8 *data;
+	u8 ecc[14];
+	int correction, ret;
+
+	data = kmalloc(1024, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	ret = nand_read_page_op(chip, 10434, 1024, NULL, 0);
+	if (ret)
+		goto out;
+	comcerto_nand_enable_stock_ecc_read(cn);
+	ret = nand_read_data_op(chip, data, 1024, false, false);
+	if (ret)
+		goto out;
+	ret = nand_read_data_op(chip, ecc, sizeof(ecc), false, false);
+	if (ret)
+		goto out;
+
+	dev_notice(&pdev->dev,
+		   "V247 page 10434 readdressed step1 pre: data=%08x expected=6f4f2e40 ecc=%08x expected-ecc=ec6edb2a poly=%08x corr=%08x done=%08x\n",
+		   crc32(~0, data, 1024), crc32(~0, ecc, sizeof(ecc)),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT));
+	correction = comcerto_nand_correct_step(chip, data, 1024, 10434, 1);
+	dev_notice(&pdev->dev,
+		   "V247 page 10434 readdressed step1 post: result=%d data=%08x poly=%08x corr=%08x done=%08x corr-data=%08x\n",
+		   correction, crc32(~0, data, 1024),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+
+	/* V248: address the physical boundary after data0 + its 14 ECC bytes. */
+	ret = nand_read_page_op(chip, 10434, 1038, NULL, 0);
+	if (ret)
+		goto out;
+	comcerto_nand_enable_stock_ecc_read(cn);
+	ret = nand_read_data_op(chip, data, 1024, false, false);
+	if (ret)
+		goto out;
+	ret = nand_read_data_op(chip, ecc, sizeof(ecc), false, false);
+	if (ret)
+		goto out;
+	dev_notice(&pdev->dev,
+		   "V248 page 10434 physical-column-1038 step1: data=%08x expected=6f4f2e40 ecc=%08x expected-ecc=ec6edb2a prefix=%*phN\n",
+		   crc32(~0, data, 1024), crc32(~0, ecc, sizeof(ecc)),
+		   16, data);
+
+	/*
+	 * V249: capture the controller's raw 2048+64-byte page stream without
+	 * enabling the ECC engine.  This distinguishes an address-layout issue
+	 * from bytes consumed or transformed by the stock ECC data path.
+	 */
+	kfree(data);
+	data = kmalloc(2112, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	ret = nand_read_page_op(chip, 10434, 0, NULL, 0);
+	if (ret)
+		goto out;
+	writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+	ret = nand_read_data_op(chip, data, 2112, false, false);
+	if (ret)
+		goto out;
+	dev_notice(&pdev->dev,
+		   "V249 page 10434 raw stream: data0=%08x expected=57e89e2b data1=%08x expected=6f4f2e40 oob=%08x prefix0=%*phN prefix1=%*phN oob0=%*phN\n",
+		   crc32(~0, data, 1024), crc32(~0, data + 1024, 1024),
+		   crc32(~0, data + 2048, 64), 16, data, 16, data + 1024,
+		   16, data + 2048);
+	ret = 0;
+out:
+	kfree(data);
+	return ret;
+}
+
+/*
+ * V251 tests the two possible OOB ECC slices against the second 1-KiB data
+ * sector.  Random-column output selects stored parity without clocking the
+ * intervening data through the ECC engine.  Each candidate starts from a
+ * fresh page operation and uses a private RAM buffer.
+ */
+static int comcerto_nand_v251_step1_oob_ecc(struct platform_device *pdev,
+					     struct comcerto_nand *cn)
+{
+	struct nand_chip *chip = &cn->chip;
+	u8 *data;
+	u8 ecc[14];
+	unsigned int candidate;
+	int correction, ret = 0;
+
+	data = kmalloc(1024, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	for (candidate = 0; candidate < 2; candidate++) {
+		ret = nand_read_page_op(chip, 10434, 1024, NULL, 0);
+		if (ret)
+			break;
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(chip, data, 1024, false, false);
+		if (ret)
+			break;
+		ret = nand_change_read_column_op(chip, 2048 + candidate * 14,
+						 NULL, 0, false);
+		if (ret)
+			break;
+		ret = nand_read_data_op(chip, ecc, sizeof(ecc), false, false);
+		if (ret)
+			break;
+		dev_notice(&pdev->dev,
+			   "V251 page 10434 step1 OOB-slice%u pre: data=%08x ecc=%08x prefix=%*phN\n",
+			   candidate, crc32(~0, data, 1024),
+			   crc32(~0, ecc, sizeof(ecc)), 14, ecc);
+		correction = comcerto_nand_correct_step(chip, data, 1024,
+							10434, 1);
+		dev_notice(&pdev->dev,
+			   "V251 page 10434 step1 OOB-slice%u post: result=%d data=%08x expected=6f4f2e40 corr=%08x done=%08x corr-data=%08x\n",
+			   candidate, correction, crc32(~0, data, 1024),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+			   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+	}
+
+	kfree(data);
+	return ret;
+}
+
+/* V253: bounded read-only search for page-10434's known second-sector CRC. */
+static int comcerto_nand_v253_neighbor_rows(struct platform_device *pdev,
+					    struct comcerto_nand *cn)
+{
+	struct nand_chip *chip = &cn->chip;
+	u8 *stream;
+	unsigned int page;
+	int ret = 0;
+
+	stream = kmalloc(2076, GFP_KERNEL);
+	if (!stream)
+		return -ENOMEM;
+
+	for (page = 10430; page <= 10439; page++) {
+		ret = nand_read_page_op(chip, page, 0, NULL, 0);
+		if (ret)
+			break;
+		writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+		ret = nand_read_data_op(chip, stream, 2076, false, false);
+		if (ret)
+			break;
+		dev_notice(&pdev->dev,
+			   "V253 row %u raw: first=%08x after-ecc0=%08x target=6f4f2e40 prefix0=%*phN prefix1=%*phN\n",
+			   page, crc32(~0, stream, 1024),
+			   crc32(~0, stream + 1038, 1024),
+			   8, stream, 8, stream + 1038);
+	}
+
+	kfree(stream);
+	return ret;
+}
+
+/* V254: compare MMIO FIFO access widths on one bounded, known page. */
+static int comcerto_nand_v254_fifo_width(struct platform_device *pdev,
+					 struct comcerto_nand *cn)
+{
+	u8 *stream;
+	unsigned int width;
+	int ret = 0;
+
+	stream = kmalloc(2076, GFP_KERNEL);
+	if (!stream)
+		return -ENOMEM;
+
+	for (width = 1; width <= 4; width <<= 1) {
+		ret = nand_read_page_op(&cn->chip, 10434, 0, NULL, 0);
+		if (ret)
+			break;
+		writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+		if (width == 1)
+			ioread8_rep(cn->data, stream, 2076);
+		else if (width == 2)
+			ioread16_rep(cn->data, stream, 2076 / 2);
+		else
+			ioread32_rep(cn->data, stream, 2076 / 4);
+		dev_notice(&pdev->dev,
+			   "V254 width%u page10434: first=%08x after-ecc0=%08x target=6f4f2e40 prefix0=%*phN prefix1=%*phN\n",
+			   width * 8, crc32(~0, stream, 1024),
+			   crc32(~0, stream + 1038, 1024),
+			   8, stream, 8, stream + 1038);
+	}
+
+	kfree(stream);
+	return ret;
+}
+
+/*
+ * V260 executes the restored stock sequence from a pristine post-scan state.
+ * It uses stock's byte-load-plus-DSB loop from nand_read_buf() at 0x8435d0bc
+ * and its proven data/ecc/spare interleave.
+ * V255 proved the unconditional SHIFT_EN clear performed by the stock
+ * read_page_hwecc callback at 0x84363248, immediately after correct_ecc().
+ * This edge is required even when correct_ecc() reports a clean sector: the
+ * following enable must initialise a new 1-KiB ECC transfer.  The diagnostic
+ * is bounded to one known page and never emits a NAND write command.
+ */
+static int comcerto_nand_v260_stock_interleaved_read(struct platform_device *pdev,
+					     struct comcerto_nand *cn)
+{
+	u8 *data;
+	u8 ecc[28];
+	u8 spare[36];
+	unsigned int step;
+	int correction, ret;
+
+	data = kmalloc(2048, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	ret = nand_read_page_op(&cn->chip, 10434, 0, NULL, 0);
+	if (ret)
+		goto out;
+
+	for (step = 0; step < 2; step++) {
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(&cn->chip, data + step * 1024, 1024,
+					false, false);
+		if (ret)
+			break;
+		ret = nand_read_data_op(&cn->chip, ecc + step * 14, 14,
+					false, false);
+		if (ret)
+			break;
+		correction = comcerto_nand_correct_step(&cn->chip,
+				data + step * 1024, 1024, 10434, step);
+		/* Exact stock callback transition after every correction call. */
+		writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+		/* Stock consumes 18 OOB bytes between its two 1024-byte steps. */
+		ret = nand_read_data_op(&cn->chip, spare + step * 18, 18,
+					false, false);
+		if (ret)
+			break;
+		dev_notice(&pdev->dev,
+			   "V260 interleaved page10434 step%u: correction=%d data=%08x expected=%08x ecc=%08x spare=%08x cfg=%08x prefix=%*phN\n",
+			   step, correction,
+			   crc32(~0, data + step * 1024, 1024),
+			   step ? 0x6f4f2e40 : 0x57e89e2b,
+			   crc32(~0, ecc + step * 14, 14),
+			   crc32(~0, spare + step * 18, 18),
+			   readl(cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG),
+			   8, data + step * 1024);
+		if (correction < 0) {
+			ret = correction;
+			break;
+		}
+	}
+
+out:
+	/* Keep the ECC shifter quiescent on every diagnostic exit path. */
+	writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+	kfree(data);
+	return ret;
+}
+
+static void __maybe_unused comcerto_nand_log_ecc_enabled(struct platform_device *pdev,
+					   struct comcerto_nand *cn)
+{
+	dev_notice(&pdev->dev,
+		   "ECC stock-read enable snapshot: cfg=%08x gen=%08x init=%08x "
+		   "prty=%08x cs=%08x idle=%08x poly=%08x corr=%08x corr-done=%08x "
+		   "corr-data=%08x\n",
+		   readl(cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_GEN_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_INIT_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_PRTY_OUT_SEL),
+		   readl(cn->ecc + COMCERTO_ECC_CS_SEL_CFG),
+		   readl(cn->ecc + COMCERTO_ECC_IDLE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT),
+		   readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT));
+}
+
+static int __maybe_unused comcerto_nand_audit_stock_correction_gate(struct platform_device *pdev,
+						      struct comcerto_nand *cn, bool allow_strobe,
+						      bool verbose);
+
+/*
+ * Stock 3.2.54 comcerto_correct_ecc(), recovered from the complete
+ * decompressed kernel rather than from the earlier truncated extraction.
+ *
+ * A pending polynomial result is consumed through CORR_DATA_STAT.  Each
+ * non-terminal value encodes a 16-bit word offset in bits 16..26 and an XOR
+ * mask in bits 0..15.  The controller never sees this RAM correction buffer:
+ * the only write below is the ECC-local POLY_START strobe.  A NAND input,
+ * program or erase command remains impossible through cmd_ctrl.
+ */
+static int comcerto_nand_correct_step(struct nand_chip *chip, u8 *data,
+				      size_t data_len, int page, unsigned int step)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	u32 corr, previous;
+	unsigned int attempt, corrected = 0;
+
+	for (attempt = 0; attempt < 1000; attempt++) {
+		if (readl(cn->ecc + COMCERTO_ECC_IDLE_STAT) & COMCERTO_ECC_IDLE)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000) {
+		dev_err(nand_to_mtd(chip)->dev.parent,
+			"V184 ECC page %d step %u: idle timeout\n", page, step);
+		return -ETIMEDOUT;
+	}
+
+	/* Stock correct_ecc() enters the correction stream only for bit 0. */
+	if (!(readl(cn->ecc + COMCERTO_ECC_POLY_STAT) & BIT(0)))
+		return 0;
+
+	writel(COMCERTO_ECC_INIT, cn->ecc + COMCERTO_ECC_POLY_START);
+	for (attempt = 0; attempt < 1000; attempt++) {
+		corr = readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT);
+		if ((corr >> 16) == 0x87fd)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000) {
+		dev_err(nand_to_mtd(chip)->dev.parent,
+			"V184 ECC page %d step %u: first correction marker timeout\n",
+			page, step);
+		return -ETIMEDOUT;
+	}
+
+	previous = corr;
+	for (attempt = 0; attempt < 1000; attempt++) {
+		u32 word, mask;
+
+		udelay(1);
+		corr = readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT);
+		if ((corr >> 16) == 0x87fe) {
+			if (!(readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT) &
+			      COMCERTO_ECC_CORR_DONE))
+				continue;
+			if (readl(cn->ecc + COMCERTO_ECC_CORR_STAT) & BIT(24)) {
+				dev_notice(nand_to_mtd(chip)->dev.parent,
+					   "V184 ECC page %d step %u: uncorrectable corr=%08x data=%08x\n",
+					   page, step,
+					   readl(cn->ecc + COMCERTO_ECC_CORR_STAT), corr);
+				return -EBADMSG;
+			}
+			return corrected;
+		}
+		if (corr == previous)
+			continue;
+
+		word = (corr >> 16) & GENMASK(10, 0);
+		if (word >= data_len / sizeof(__be16)) {
+			dev_err(nand_to_mtd(chip)->dev.parent,
+				"V184 ECC page %d step %u: invalid correction word %u\n",
+				page, step, word);
+			return -EBADMSG;
+		}
+		/* Stock uses ldrh/eor/strh on ARM's native little-endian word. */
+		mask = corr & GENMASK(15, 0);
+		data[word * sizeof(__be16)] ^= mask & 0xff;
+		data[word * sizeof(__be16) + 1] ^= mask >> 8;
+		previous = corr;
+		corrected++;
+	}
+
+	dev_err(nand_to_mtd(chip)->dev.parent,
+		"V184 ECC page %d step %u: completion timeout\n", page, step);
+	return -ETIMEDOUT;
+}
+
+/*
+ * V150's first active-ECC data-path check.  It is intentionally only a
+ * 64-byte reread of already validated physical page 0.  The raw NAND engine
+ * remains selected, so this does not invoke a correction callback or make
+ * the page generally accessible; it only establishes whether the enabled
+ * stock shifter changes the observable ECC completion state.
+ */
+static int __maybe_unused comcerto_nand_read_page0_ecc_audit(struct mtd_info *mtd)
+{
+	u8 buf[64];
+	size_t retlen;
+	int ret;
+
+	ret = mtd_read(mtd, 0, sizeof(buf), &retlen, buf);
+	if (ret)
+		return ret;
+	if (retlen != sizeof(buf))
+		return -EIO;
+	if (get_unaligned_be32(buf) != 0x55424923)
+		return -EBADMSG;
+
+	dev_notice(mtd->dev.parent,
+		   "page-0 stock-ECC transfer audit verified UBI magic: %08x\n",
+		   get_unaligned_be32(buf));
+	return 0;
+}
+
+/*
+ * V188+ deliberately use bounded normal reads, not a scan: this brackets
+ * V186's former pages-4--63 experiment while retaining all three write
+ * barriers. V196 invokes this helper twice for adjacent pages, rather than
+ * using a multi-page buffer or scan helper. Any attempted program command is
+ * rejected by cmd_ctrl and accompanied by the tripwire stack.
+ */
+static int __maybe_unused comcerto_nand_read_single_tripwire_audit(struct mtd_info *mtd,
+						    unsigned int page)
+{
+	u8 *buf;
+	size_t retlen;
+	int ret;
+
+	if (mtd->flags & MTD_WRITEABLE)
+		return -EPERM;
+	buf = kmalloc(mtd->writesize, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	ret = mtd_read(mtd, page * mtd->writesize, mtd->writesize, &retlen, buf);
+	if (!ret && retlen == mtd->writesize)
+		dev_notice(mtd->dev.parent,
+			   "V206 remaining block-sample page-%u: data-crc=%08x\\n",
+			   page, crc32(~0, buf, mtd->writesize));
+	else if (!ret)
+		ret = -EIO;
+	if (ret)
+		dev_err(mtd->dev.parent,
+			"V206 remaining block-sample page-%u failed: %d retlen=%zu\\n",
+			page, ret, retlen);
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * V171 predates the complete stock callback disassembly and is retained only
+ * as disabled historical evidence. V260 proved the actual stream is two
+ * 1024-byte data/ECC-14/spare-18 groups, not a trailing 36-byte spare area.
+ */
+static int __maybe_unused comcerto_nand_read_interleaved_page_audit(struct platform_device *pdev,
+						      struct comcerto_nand *cn,
+						      unsigned int page, u32 expected_magic)
+{
+	u8 *buf;
+	u8 *oob;
+	u8 ecc[28];
+	u8 tail[36];
+	unsigned int step;
+	u32 stored_crc, calculated_crc;
+	int ret = 0;
+
+	buf = kmalloc(nand_to_mtd(&cn->chip)->writesize, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	oob = kmalloc(nand_to_mtd(&cn->chip)->oobsize, GFP_KERNEL);
+	if (!oob) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = nand_read_page_op(&cn->chip, page, 0, NULL, 0);
+	if (ret)
+		goto out;
+
+	for (step = 0; step < 2; step++) {
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(&cn->chip, buf + step * 1024, 1024,
+					false, false);
+		if (ret)
+			break;
+		ret = nand_read_data_op(&cn->chip, ecc + step * 14, 14,
+					false, false);
+		if (ret)
+			break;
+		if (!page && !step && get_unaligned_be32(buf) != 0x55424923) {
+			ret = -EBADMSG;
+			break;
+		}
+		dev_notice(&pdev->dev,
+			   "V172 page-%u stream step %u: data-crc=%08x ecc-crc=%08x\n",
+			   page, step, crc32(~0, buf + step * 1024, 1024),
+			   crc32(~0, ecc + step * 14, 14));
+		comcerto_nand_log_ecc_postread(pdev, cn);
+	}
+	if (ret)
+		goto out_oob;
+	ret = nand_read_data_op(&cn->chip, tail, sizeof(tail), false, false);
+	if (ret)
+		goto out_oob;
+	ret = nand_read_oob_op(&cn->chip, page, 0, oob,
+			       nand_to_mtd(&cn->chip)->oobsize);
+	if (ret)
+		goto out_oob;
+	dev_notice(&pdev->dev,
+		   "V173 page-%u logical data-crc=%08x ecc-crc=%08x tail-crc=%08x oob-match=%u magic=%08x expected=%08x\n",
+		   page, crc32(~0, buf, nand_to_mtd(&cn->chip)->writesize),
+		   crc32(~0, ecc, sizeof(ecc)), crc32(~0, tail, sizeof(tail)),
+		   !memcmp(tail, oob + 28, sizeof(tail)), get_unaligned_be32(buf),
+		   expected_magic);
+	stored_crc = get_unaligned_be32(buf + 60);
+	calculated_crc = crc32(~0, buf, 60);
+	if (expected_magic)
+		dev_notice(&pdev->dev,
+		   "V175 page-%u logical UBI-header crc=%08x stored=%08x match=%u\n",
+		   page, calculated_crc, stored_crc, calculated_crc == stored_crc);
+	if ((expected_magic && (get_unaligned_be32(buf) != expected_magic ||
+				calculated_crc != stored_crc)) ||
+	    memcmp(tail, oob + 28, sizeof(tail)))
+		ret = -EBADMSG;
+
+out_oob:
+	kfree(oob);
+
+out:
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * V178 MTD callback: reconstruct the stock interleaved physical stream into
+	 * a normal 2048-byte page buffer and runs the recovered stock correction
+	 * protocol per 1024-byte step. This same transformation is also the
+	 * raw-page contract: both interfaces expose contiguous data followed by
+	 * the logical 28 ECC and 36 spare bytes.
+ */
+static int comcerto_nand_read_page_interleaved(struct nand_chip *chip, u8 *buf,
+						int oob_required, int page)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	u8 ecc[28];
+	u8 tail[36];
+	unsigned int step, corrected = 0;
+	int ret;
+
+	ret = nand_read_page_op(chip, page, 0, NULL, 0);
+	if (ret)
+		return ret;
+	for (step = 0; step < 2; step++) {
+		if (page == 11010)
+			dev_notice(nand_to_mtd(chip)->dev.parent,
+				   "V232 ECC page 11010 step %u pre: poly=%08x corr=%08x done=%08x\n",
+				   step, readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+				   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+				   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT));
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(chip, buf + step * 1024, 1024, false, false);
+		if (ret)
+			return ret;
+		ret = nand_read_data_op(chip, ecc + step * 14, 14, false, false);
+		if (ret)
+			return ret;
+		if (page == 10434 && step == 1)
+			dev_notice(nand_to_mtd(chip)->dev.parent,
+				   "V252 page 10434 normal step1 pre-correction: data=%08x expected=6f4f2e40 ecc=%08x data-prefix=%*phN ecc-prefix=%*phN poly=%08x\n",
+				   crc32(~0, buf + 1024, 1024),
+				   crc32(~0, ecc + 14, 14), 16, buf + 1024,
+				   14, ecc + 14,
+				   readl(cn->ecc + COMCERTO_ECC_POLY_STAT));
+		ret = comcerto_nand_correct_step(chip, buf + step * 1024, 1024,
+							 page, step);
+		/* Stock read_page_hwecc clears SHIFT_EN after every ECC step. */
+		writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+		/* The next physical bytes are this step's 18-byte spare area. */
+		{
+			int spare_ret;
+
+			spare_ret = nand_read_data_op(chip, tail + step * 18, 18,
+						      false, false);
+			if (spare_ret)
+				return spare_ret;
+		}
+		if (ret < 0)
+			return ret;
+		if (page == 11010)
+			dev_notice(nand_to_mtd(chip)->dev.parent,
+				   "V232 ECC page 11010 step %u post: result=%d poly=%08x corr=%08x done=%08x\n",
+				   step, ret, readl(cn->ecc + COMCERTO_ECC_POLY_STAT),
+				   readl(cn->ecc + COMCERTO_ECC_CORR_STAT),
+				   readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT));
+		if (ret)
+			dev_notice(nand_to_mtd(chip)->dev.parent,
+				   "V230 ECC corrected page %d step %u: %d word(s)\n",
+				   page, step, ret);
+		corrected += ret;
+	}
+	if (oob_required) {
+		memcpy(chip->oob_poi, ecc, sizeof(ecc));
+		memcpy(chip->oob_poi + sizeof(ecc), tail, sizeof(tail));
+	}
+	/*
+	 * Capture only the two pages comprising the known UBIFS superblock.  The
+	 * capture is private RAM diagnostic state; the MTD caller's buffer and all
+	 * NAND-facing operations above are unchanged.
+	 */
+	if (page == 11010 || page == 11011) {
+		unsigned int half = page - 11010;
+
+		memcpy(cn->ubifs_v241 + half * nand_to_mtd(chip)->writesize, buf,
+		       nand_to_mtd(chip)->writesize);
+		cn->ubifs_v241_pages |= BIT(half);
+		if (cn->ubifs_v241_pages == 3) {
+			comcerto_nand_v241_ubifs_diagnose(cn,
+						   nand_to_mtd(chip)->dev.parent);
+			cn->ubifs_v241_pages = 7;
+		}
+	}
+	return corrected;
+}
+
+/*
+ * The generic NAND subpage helper reads directly through read_buf().  That
+ * would expose this controller's physical data/ECC/data/ECC stream to users
+ * of small normal MTD reads (notably UBI's 64-byte EC and VID headers).
+ * Reconstruct the full logical page first and return only the requested RAM
+ * range.  This has no NAND write or erase operation.
+ */
+static int comcerto_nand_read_subpage_interleaved(struct nand_chip *chip,
+						   u32 data_offs, u32 readlen,
+						   u8 *buf, int page)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	u8 *step_data;
+	u8 *step_ecc;
+	u8 *full_page;
+	int ret;
+
+	if (data_offs > mtd->writesize || readlen > mtd->writesize - data_offs)
+		return -EINVAL;
+
+	/*
+	 * V245: UBI asks for 64-byte EC/VID headers at offset zero.  Reading a
+	 * complete physical page for that request also enters the second ECC
+	 * step, although none of its data is wanted.  The recovered stock dump
+	 * proves the first data/ECC pair byte-for-byte (CRCs 3082bc0a and
+	 * 730b5d41 on rootfs1 page zero), while V244 showed that the speculative
+	 * second step is where the controller reports -EBADMSG.  Execute only the
+	 * covered ECC step when the requested range fits in the first 1024 bytes.
+	 */
+	if (data_offs + readlen <= 1024) {
+		if (page == 10240)
+			dev_notice(mtd->dev.parent,
+				   "V246 bounded subpage page=%d offs=%u len=%u step=0\n",
+				   page, data_offs, readlen);
+		step_data = kmalloc(1024 + 14, GFP_KERNEL);
+		if (!step_data)
+			return -ENOMEM;
+		step_ecc = step_data + 1024;
+		ret = nand_read_page_op(chip, page, 0, NULL, 0);
+		if (ret)
+			goto out_step;
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(chip, step_data, 1024, false,
+					false);
+		if (ret)
+			goto out_step;
+		ret = nand_read_data_op(chip, step_ecc, 14, false,
+					false);
+		if (ret)
+			goto out_step;
+		ret = comcerto_nand_correct_step(chip, step_data,
+						 1024, page, 0);
+		if (ret < 0)
+			goto out_step;
+		memcpy(buf + data_offs, step_data + data_offs, readlen);
+	out_step:
+		writel(0, cn->ecc + COMCERTO_ECC_SHIFT_EN_CFG);
+		kfree(step_data);
+		return ret;
+	}
+
+	full_page = kmalloc(mtd->writesize, GFP_KERNEL);
+	if (!full_page)
+		return -ENOMEM;
+
+	ret = comcerto_nand_read_page_interleaved(chip, full_page, 0, page);
+	if (ret >= 0)
+		memcpy(buf + data_offs, full_page + data_offs, readlen);
+	kfree(full_page);
+	return ret;
+}
+
+/*
+ * The recovered controller path can reconstruct main-area data and ECC, but
+ * its raw OOB view is not yet suitable for interpreting the factory bad-block
+ * marker (it currently exposes zero-filled marker bytes).  Treating those
+ * bytes as a marker makes UBI discard every PEB before it can read an EC
+ * header.  In this RAM-only, write-disabled test stage we therefore make no
+ * bad-block assertion.  This only permits read-only UBI inspection; the MTD
+ * write lock and command gate remain independently enforced.
+ */
+static int comcerto_nand_block_bad_unknown(struct nand_chip *chip, loff_t ofs)
+{
+	return 0;
+}
+
+/*
+ * RAW MTD operations must expose the recovered physical stream conversion,
+ * but must never enter the ECC result machine.  In particular, an OOB
+ * fingerprint read is not permission to consume a pending correction result
+ * left by a preceding normal read.
+ */
+static int comcerto_nand_read_page_interleaved_raw(struct nand_chip *chip,
+						    u8 *buf, int oob_required,
+						    int page)
+{
+	struct comcerto_nand *cn = to_comcerto_nand(chip);
+	u8 ecc[28];
+	u8 tail[36];
+	unsigned int step;
+	int ret;
+
+	ret = nand_read_page_op(chip, page, 0, NULL, 0);
+	if (ret)
+		return ret;
+	for (step = 0; step < 2; step++) {
+		comcerto_nand_enable_stock_ecc_read(cn);
+		ret = nand_read_data_op(chip, buf + step * 1024, 1024, false, false);
+		if (ret)
+			return ret;
+		ret = nand_read_data_op(chip, ecc + step * 14, 14, false, false);
+		if (ret)
+			return ret;
+		ret = nand_read_data_op(chip, tail + step * 18, 18, false, false);
+		if (ret)
+			return ret;
+	}
+	if (oob_required) {
+		memcpy(chip->oob_poi, ecc, sizeof(ecc));
+		memcpy(chip->oob_poi + sizeof(ecc), tail, sizeof(tail));
+	}
+	return 0;
+}
+
+/*
+ * OOB-only MTD requests must use the same physical-stream reconstruction as
+ * page reads.  The generic syndrome OOB helper assumes it can seek from a
+ * contiguous 2048-byte data area, which is false for the interleaved stream.
+ */
+static int comcerto_nand_read_oob_interleaved(struct nand_chip *chip, int page)
+{
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	u8 *data;
+	int ret;
+
+	data = kmalloc(mtd->writesize, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	ret = comcerto_nand_read_page_interleaved(chip, data, 1, page);
+	kfree(data);
+	return ret;
+}
+
+static int comcerto_nand_read_oob_interleaved_raw(struct nand_chip *chip, int page)
+{
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	u8 *data;
+	int ret;
+
+	data = kmalloc(mtd->writesize, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	ret = comcerto_nand_read_page_interleaved_raw(chip, data, 1, page);
+	kfree(data);
+	return ret;
+}
+
+/*
+ * The MTD flags and command barrier are the primary write protection.  These
+ * callbacks are a third, controller-local barrier required by the on-host
+ * ECC contract: even an accidental write path can never reach a data-input
+ * or program operation.
+ */
+static int comcerto_nand_write_page_reject(struct nand_chip *chip,
+					   const u8 *buf, int oob_required, int page)
+{
+	return -EROFS;
+}
+
+static int comcerto_nand_write_oob_reject(struct nand_chip *chip, int page)
+{
+	return -EROFS;
+}
+
+static int comcerto_nand_ooblayout_ecc(struct mtd_info *mtd, int section,
+				       struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+	region->offset = 0;
+	region->length = 28;
+	return 0;
+}
+
+static int comcerto_nand_ooblayout_free(struct mtd_info *mtd, int section,
+					struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+	region->offset = 28;
+	region->length = 36;
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops comcerto_nand_ooblayout_ops = {
+	.ecc = comcerto_nand_ooblayout_ecc,
+	.free = comcerto_nand_ooblayout_free,
+};
+
+/*
+ * V168 implements stock correct_ecc()'s non-mutating status path.  The strobe
+ * is available only for the already observed pending state, once, on page 4.
+ * It waits for both status markers and returns the stock uncorrectable result
+ * without consuming correction data or altering RAM.
+ */
+static int __maybe_unused comcerto_nand_audit_stock_correction_gate(struct platform_device *pdev,
+						      struct comcerto_nand *cn, bool allow_strobe,
+						      bool verbose)
+{
+	unsigned int attempt;
+	u32 poly, corr_data;
+
+	for (attempt = 0; attempt < 1000; attempt++) {
+		if (readl(cn->ecc + COMCERTO_ECC_IDLE_STAT) & COMCERTO_ECC_IDLE)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000)
+		return -ETIMEDOUT;
+
+	poly = readl(cn->ecc + COMCERTO_ECC_POLY_STAT);
+	if (!(poly & BIT(0))) {
+		if (verbose)
+			dev_notice(&pdev->dev,
+				   "V157 stock correction gate: clean transfer (poly=%08x); no strobe\n",
+				   poly);
+		return 0;
+	}
+	if (!allow_strobe) {
+		dev_err(&pdev->dev,
+			"V166 stock correction gate: pending state poly=%08x; strobe withheld\n",
+			poly);
+		comcerto_nand_log_ecc_postread(pdev, cn);
+		return -EUCLEAN;
+	}
+
+	writel(COMCERTO_ECC_INIT, cn->ecc + COMCERTO_ECC_POLY_START);
+	for (attempt = 0; attempt < 1000; attempt++) {
+		corr_data = readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT);
+		if ((corr_data >> 16) == 0x87fd)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000) {
+		dev_err(&pdev->dev,
+			"V168 correction strobe timed out before first marker; no data consumed\n");
+		comcerto_nand_log_ecc_postread(pdev, cn);
+		return -ETIMEDOUT;
+	}
+	for (attempt = 0; attempt < 1000; attempt++) {
+		corr_data = readl(cn->ecc + COMCERTO_ECC_CORR_DATA_STAT);
+		if ((corr_data >> 16) == 0x87fe)
+			break;
+		udelay(1);
+	}
+	if (attempt == 1000) {
+		dev_err(&pdev->dev,
+			"V168 correction strobe timed out before completion; no data consumed\n");
+		comcerto_nand_log_ecc_postread(pdev, cn);
+		return -ETIMEDOUT;
+	}
+	if (readl(cn->ecc + COMCERTO_ECC_CORR_DONE_STAT) & COMCERTO_ECC_CORR_DONE) {
+		u32 corr = readl(cn->ecc + COMCERTO_ECC_CORR_STAT);
+
+		if (corr & BIT(24)) {
+			dev_notice(&pdev->dev,
+				   "V168 correction complete: uncorrectable corr=%08x; data untouched\n",
+				   corr);
+			comcerto_nand_log_ecc_postread(pdev, cn);
+			return -EBADMSG;
+		}
+	}
+	dev_err(&pdev->dev,
+		"V168 correction completion is not a proven data-result form; data withheld\n");
+	comcerto_nand_log_ecc_postread(pdev, cn);
+	return -EUCLEAN;
+}
+
+/*
+ * V144 showed that the boot environment leaves the controller in the known
+ * write/generate configuration, routed to CS4 and idle.  Verify that inherited
+ * state before registration.  Each normal read step subsequently replaces it
+ * with COMCERTO_ECC_GEN_READ_1BIT_1024 before transferring any page data.
+ */
+static int comcerto_nand_validate_stock_ecc_state(struct platform_device *pdev,
+						   struct comcerto_nand *cn)
+{
+	u32 gen = readl(cn->ecc + COMCERTO_ECC_GEN_CFG);
+	u32 cs = readl(cn->ecc + COMCERTO_ECC_CS_SEL_CFG);
+	u32 idle = readl(cn->ecc + COMCERTO_ECC_IDLE_STAT);
+	u32 poly = readl(cn->ecc + COMCERTO_ECC_POLY_STAT);
+
+	if (gen != COMCERTO_ECC_GEN_WRITE_1BIT_1024 ||
+	    cs != COMCERTO_ECC_CS4_SELECTED ||
+	    !(idle & COMCERTO_ECC_IDLE) ||
+	    poly != COMCERTO_ECC_POLY_IDLE_STATE) {
+		dev_err(&pdev->dev,
+			"unsafe ECC precondition: gen=%08x cs=%08x idle=%08x poly=%08x\\n",
+			gen, cs, idle, poly);
+		return -EUCLEAN;
+	}
+
+	dev_notice(&pdev->dev,
+		   "inherited ECC state verified (write/generate mode, CS4, idle); read mode is set per step\\n");
+	return 0;
+}
+
+/*
+ * V141's sole data-path test: a single raw read of page 0.  This proves the
+ * controller data aperture without interpreting NAND contents, enabling ECC,
+ * scanning BBTs, attaching UBI, or exposing a write path.
+ */
+static int __maybe_unused comcerto_nand_read_ubi_headers(struct mtd_info *mtd, loff_t offset,
+					   const char *label)
+{
+	u8 *buf;
+	size_t retlen;
+	u32 stored_crc, calculated_crc, vid_offset, vol_id, lnum;
+	int ret;
+
+	buf = kmalloc(mtd->writesize, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	ret = mtd_read(mtd, offset, 64, &retlen, buf);
+	if (!ret && retlen == 64) {
+		/* UBI EC header: 60-byte payload followed by big-endian CRC32. */
+		if (get_unaligned_be32(buf) != 0x55424923) {
+			ret = -EBADMSG;
+			goto out;
+		}
+		stored_crc = get_unaligned_be32(buf + 60);
+		calculated_crc = crc32(~0, buf, 60);
+		if (stored_crc != calculated_crc) {
+			ret = -EBADMSG;
+			goto out;
+		}
+		vid_offset = get_unaligned_be32(buf + 16);
+		if (vid_offset >= mtd->erasesize || vid_offset % mtd->writesize) {
+			ret = -EBADMSG;
+			goto out;
+		}
+		dev_notice(mtd->dev.parent,
+			   "V210 %s partial EC-header read CRC verified: %08x\n",
+			   label, calculated_crc);
+
+		ret = mtd_read(mtd, offset + vid_offset, 64, &retlen, buf);
+		if (ret || retlen != 64) {
+			if (!ret)
+				ret = -EIO;
+			goto out;
+		}
+		if (get_unaligned_be32(buf) != 0x55424921) {
+			ret = -EBADMSG;
+			goto out;
+		}
+		stored_crc = get_unaligned_be32(buf + 60);
+		calculated_crc = crc32(~0, buf, 60);
+		if (stored_crc != calculated_crc) {
+			ret = -EBADMSG;
+			goto out;
+		}
+		vol_id = get_unaligned_be32(buf + 8);
+		lnum = get_unaligned_be32(buf + 12);
+		dev_notice(mtd->dev.parent,
+			   "V210 %s partial VID-header read CRC verified: vol=%u lnum=%u\n",
+			   label, vol_id, lnum);
+	} else if (!ret) {
+		ret = -EIO;
+	}
+
+out:
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * V215 rechecks, but never attaches itself, the stock rootfs2 eraseblock
+ * range. A
+ * valid EC header without a VID header is an ordinary free UBI PEB, so it is
+ * counted rather than treated as a driver failure.  This is deliberately not
+ * an UBI scan: it makes normal MTD reads only and never calls UBI or writes
+ * NAND metadata.
+ */
+static int __maybe_unused comcerto_nand_inventory_ubi_region(struct mtd_info *mtd,
+					       loff_t start, u32 pebs,
+					       const char *label)
+{
+	u8 *buf;
+	size_t retlen;
+	u32 peb, stored_crc, calculated_crc, vid_offset, vol_id, lnum;
+	u32 ec_valid = 0, vid_valid = 0, free_or_invalid = 0;
+	int ret = 0;
+
+	buf = kmalloc(64, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	for (peb = 0; peb < pebs; peb++) {
+		loff_t offset = start + (loff_t)peb * mtd->erasesize;
+
+		ret = mtd_read(mtd, offset, 64, &retlen, buf);
+		if (ret || retlen != 64) {
+			if (!ret)
+				ret = -EIO;
+			goto out;
+		}
+		if (get_unaligned_be32(buf) != 0x55424923 ||
+		    get_unaligned_be32(buf + 60) != crc32(~0, buf, 60)) {
+			free_or_invalid++;
+			continue;
+		}
+		vid_offset = get_unaligned_be32(buf + 16);
+		if (!ec_valid)
+			dev_notice(mtd->dev.parent,
+				   "V219 %s EC geometry: version=%u vid=%u data=%u write=%u subpage-sft=%u writebuf=%u\\n",
+				   label, buf[4], vid_offset,
+				   get_unaligned_be32(buf + 20), mtd->writesize,
+				   mtd->subpage_sft, mtd->writebufsize);
+		if (vid_offset >= mtd->erasesize || vid_offset % mtd->writesize) {
+			free_or_invalid++;
+			continue;
+		}
+		ec_valid++;
+		ret = mtd_read(mtd, offset + vid_offset, 64, &retlen, buf);
+		if (ret || retlen != 64) {
+			if (!ret)
+				ret = -EIO;
+			goto out;
+		}
+		stored_crc = get_unaligned_be32(buf + 60);
+		calculated_crc = crc32(~0, buf, 60);
+		if (get_unaligned_be32(buf) != 0x55424921 ||
+		    stored_crc != calculated_crc) {
+			free_or_invalid++;
+			continue;
+		}
+		vid_valid++;
+		if (vid_valid <= 3) {
+			vol_id = get_unaligned_be32(buf + 8);
+			lnum = get_unaligned_be32(buf + 12);
+			dev_notice(mtd->dev.parent,
+			   "V215 %s VID PEB %u: vol=%u lnum=%u\\n",
+				   label, peb, vol_id, lnum);
+		}
+	}
+
+	dev_notice(mtd->dev.parent,
+		   "V215 %s inventory: pebs=%u ec-valid=%u vid-valid=%u other=%u\\n",
+		   label, pebs, ec_valid, vid_valid, free_or_invalid);
+out:
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * V147 extends the bounded page-0 observation by one OOB-only read.  It does
+ * not enable the ECC engine, interpret a free/OOB layout, or expose OOB to
+ * callers.  The checksum and prefix are a reproducible fingerprint for the
+ * stock 1-bit/1024-byte ECC-layout reconstruction that follows.
+ */
+static int __maybe_unused comcerto_nand_log_page0_oob(struct comcerto_nand *cn)
+{
+	struct mtd_info *mtd = nand_to_mtd(&cn->chip);
+	u8 *oob;
+	int ret;
+
+	oob = kmalloc(mtd->oobsize, GFP_KERNEL);
+	if (!oob)
+		return -ENOMEM;
+
+	ret = nand_read_oob_op(&cn->chip, 0, 0, oob, mtd->oobsize);
+	if (!ret)
+		dev_notice(mtd->dev.parent,
+			   "page-0 raw OOB fingerprint: bytes=%u crc=%08x prefix=%*ph\n",
+			   mtd->oobsize, crc32(~0, oob, mtd->oobsize),
+			   min_t(unsigned int, mtd->oobsize, 32), oob);
+
+	kfree(oob);
+	return ret;
+}
+
+/* Page 2 is the first payload page after page-0 EC and page-1 VID headers. */
+static int __maybe_unused comcerto_nand_log_page2_oob(struct comcerto_nand *cn)
+{
+	struct mtd_info *mtd = nand_to_mtd(&cn->chip);
+	u8 *oob;
+	int ret;
+
+	oob = kmalloc(mtd->oobsize, GFP_KERNEL);
+	if (!oob)
+		return -ENOMEM;
+
+	ret = nand_read_oob_op(&cn->chip, 2, 0, oob, mtd->oobsize);
+	if (!ret)
+		dev_notice(mtd->dev.parent,
+			   "page-2 raw OOB fingerprint: bytes=%u crc=%08x prefix=%*ph\n",
+			   mtd->oobsize, crc32(~0, oob, mtd->oobsize),
+			   min_t(unsigned int, mtd->oobsize, 32), oob);
+
+	kfree(oob);
+	return ret;
+}
+
+static int comcerto_nand_probe(struct platform_device *pdev)
+{
+	static const char * const required_resources[] = {
+		"stock-probe", "stock-ctrl", "exp-config", "cs4", "ecc",
+	};
+	struct comcerto_nand *cn;
+	struct mtd_info *mtd;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
