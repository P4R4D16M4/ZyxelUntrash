+#define CP15_GET(Opcode_1, CRn, CRm, Opcode_2)				\
+	register unsigned long value;					\
+	__asm {mrc p15,##Opcode_1,value,##CRn, ##CRm, ##Opcode_2}	\
+	return value;			
