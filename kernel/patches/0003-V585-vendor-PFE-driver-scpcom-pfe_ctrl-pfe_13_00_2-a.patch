+} hw_L3Flow_entry, *Phw_L3Flow_entry;
+
+
+void Bridge_output_interface_reset(U32 if_index);
+
+#else	// !defined (COMCERTO_2000_CONTROL)
+
+/* data path HW L2 flow entry */
+typedef struct _tL2Flow_entry {
+	U32 	flags;
+	U32 	dma_addr;
+	U32		next;
