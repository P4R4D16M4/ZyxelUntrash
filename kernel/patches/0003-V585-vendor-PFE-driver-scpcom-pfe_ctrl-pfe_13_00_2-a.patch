+static __inline U8 HASH_MACVLAN(void *pmacaddr)
+{
+	U8  hash;
+	U16 sum;
+	U16  *macAddr  = (U16 *)pmacaddr;
+
+	sum = ( macAddr[0] ^ macAddr[1] ^ macAddr[2]);
+	hash = (sum >> 8) ^ (sum & 0xFF);
+
+	return ((hash ^ (hash >> 4)) & (NUM_MACVLAN_HASH_ENTRIES - 1));
+}
