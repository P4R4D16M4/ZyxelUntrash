+PRTPflow RTP_find_flow(U16 id)
+{
+	PRTPflow flow_entry;
+	struct slist_entry *entry;
+	U32 hash_key;
+
+	hash_key = HASH_RTP(id);
+	slist_for_each(flow_entry, entry, &rtpflow_cache[hash_key], list)
+	{
+		if (id && (flow_entry->ingress_socketID == id))
+			return flow_entry;
+	}
+
+	return NULL;
+}
