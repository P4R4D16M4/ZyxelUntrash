+static void RTP_reset_stats(PRTCPStats pStats, U8 type)
+{
+	struct pfe_ctrl *ctrl = &pfe->ctrl;
+
+	pe_sync_stop(ctrl, (1 << UTIL_ID));
+
+	RTP_clear_stats(pStats, type);
+
+	pStats->state = cpu_to_be16(type);
+
+	pe_start(ctrl, (1 << UTIL_ID));
+}
