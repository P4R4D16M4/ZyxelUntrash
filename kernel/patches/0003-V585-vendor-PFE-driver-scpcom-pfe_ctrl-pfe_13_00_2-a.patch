diff --git a/drivers/pfe_ctrl/pfe_emulation.c b/drivers/pfe_ctrl/pfe_emulation.c
new file mode 100644
index 000000000..0544edd44
--- /dev/null
+++ b/drivers/pfe_ctrl/pfe_emulation.c
@@ -0,0 +1,179 @@
+/*
