+
+#define MC6_NUM_HASH_ENTRIES 16
+
+typedef struct tMC6_context {
+
+	unsigned char hoplimit_check_rule;
+}MC6_context;
+
+#if defined (COMCERTO_2000)
+
+#if defined (COMCERTO_2000_CONTROL)
+
+/** Control path MC6 HW entry */
+typedef struct _thw_MC6Entry {
+	U32 	flags;
+	U32 	dma_addr;
+	U32 next;
+	U32 src_addr[4];
+	U32 dst_addr[4];
+	/* common portion */
+	MCxEntry mcdest;
