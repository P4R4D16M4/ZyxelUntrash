+	while ( TRNG_CNTL & 0x80000000UL)
+		;
+	// Make first request
+	TRNG_CNTL = 1;
+	int i;
+	for(i=0;i<48;) {
+		while ( TRNG_CNTL & 0x80000000UL)
+			;
+		sc->ELP_REGS->ESPAH_IV_RND = TNG_DATA0;
+		sc->ELP_REGS->ESPAH_IV_RND = TNG_DATA1;
+		sc->ELP_REGS->ESPAH_IV_RND = TNG_DATA2;
+		sc->ELP_REGS->ESPAH_IV_RND = TNG_DATA3;
+		TRNG_CNTL = 1;
+		i+=4;
+
+	}
+#elif	defined(ESPAH_USE_PRNG)
