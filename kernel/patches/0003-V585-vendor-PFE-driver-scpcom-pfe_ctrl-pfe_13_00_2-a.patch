+	U32 	flags;
+	U16		stream_id;
+	U16		stream_type;
+	U32		saddr[4];
+	U32		daddr[4];
+	U16		sport;
+	U16		dport;
+	U16		proto;
+	U16		slot;
+	struct _tRTPinfo	rtp_info;
+	struct _tRTCPStats	stats;
+} RTPQOS_ENTRY, *PRTPQOS_ENTRY;
+
+#endif
+
+typedef struct _tRTP_enable_stats_command {
+	U16 stream_id;
+	U16 stream_type;
+	U32 saddr[4];
+	U32 daddr[4];
+	U16 sport;
