+	if (!pfe_vwd_classify_packet(priv, skb, 0, 1, &vapid, &own_mac))
+	{
+#ifdef VWD_DEBUG
+		printk("%s: Accepted\n", __func__);
+//		pfe_vwd_dump_skb( skb );
+#endif
+		skb_push(skb, ETH_HLEN);
+		pfe_vwd_send_packet( skb, priv, 0, &priv->vaps[vapid], own_mac, 0);
+		return NF_STOLEN;
+	}
+
+done:
+	return NF_ACCEPT;
