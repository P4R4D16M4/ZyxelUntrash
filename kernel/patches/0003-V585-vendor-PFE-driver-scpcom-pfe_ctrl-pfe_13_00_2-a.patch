diff --git a/arch/arm/mach-comcerto/board-dt.c b/arch/arm/mach-comcerto/board-dt.c
index 22d153cc0..ae2df3092 100644
--- a/arch/arm/mach-comcerto/board-dt.c
+++ b/arch/arm/mach-comcerto/board-dt.c
@@ -1,8 +1,31 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Minimal compile-only Device Tree machine descriptor for Comcerto 2000. */
 #include <linux/init.h>
+#include <linux/io.h>
 #include <linux/of.h>
 #include <asm/mach/arch.h>
+#include <asm/system_info.h>
+
+/* GPIO block (0x90470000, AGENTS.md trap 2) DEVICE_ID register: bits 27:24
+ * hold the C2K silicon revision.  The vendor PFE driver selects its UTIL
+ * firmware by system_rev (0 = rev A0), as the stock ATAG path set it. */
+#define COMCERTO_GPIO_DEVICE_ID	0x90470050
+
+static int __init comcerto_set_system_rev(void)
+{
+	void __iomem *reg;
+
+	if (!of_machine_is_compatible("mindspeed,comcerto-2000"))
+		return 0;
+	reg = ioremap(COMCERTO_GPIO_DEVICE_ID, 4);
+	if (!reg)
+		return -ENOMEM;
+	system_rev = (readl(reg) >> 24) & 0xf;
+	iounmap(reg);
+	pr_info("comcerto: silicon revision %u\n", system_rev);
+	return 0;
+}
+arch_initcall(comcerto_set_system_rev);
 
