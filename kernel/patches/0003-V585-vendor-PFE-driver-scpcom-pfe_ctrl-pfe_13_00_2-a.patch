+static void MC6_entry_add_to_pe(U32 dma_addr, U32 hash)
+{
+	int id;
+	U32 *pe_addr;
+
+	pe_addr = (U32*)&mc6_table_memory[hash];
+
+	for (id=CLASS0_ID; id <= CLASS_MAX_ID; id++)
+		pe_dmem_write(id, dma_addr, virt_to_class_dmem(pe_addr), 4);
