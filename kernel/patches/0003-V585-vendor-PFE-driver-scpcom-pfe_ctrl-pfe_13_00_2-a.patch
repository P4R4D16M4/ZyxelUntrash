+PRouteEntry IP_Check_Route(PCtEntry pCtEntry)
+{
+	PRouteEntry pRtEntry;
+
+	pRtEntry = L2_route_get(pCtEntry->route_id);
+	if (!pRtEntry)
+		return NULL;
+
+	pCtEntry->pRtEntry = pRtEntry;
+
+	return pRtEntry;
+}
