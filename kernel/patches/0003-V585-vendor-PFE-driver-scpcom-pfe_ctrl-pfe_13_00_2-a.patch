+
+	hw_MC6Entry *hw_entry;
+}MC6Entry, *PMC6Entry;
+
+
+#else
+/** Data path MC6 entry */
+typedef struct _tMC6Entry {
+	U32 	flags;
+	U32 	dma_addr;
+	U32 	next;
+	U32 src_addr[4];
+	U32 dst_addr[4];
+	/* common portion */
+	MCxEntry mcdest;
+	U16 status;
+	U8 rtpqos_slot;
+}MC6Entry, *PMC6Entry;
+#endif
+
+#else /* COMCERTO 1000 */
+typedef struct _tMC6Entry {
