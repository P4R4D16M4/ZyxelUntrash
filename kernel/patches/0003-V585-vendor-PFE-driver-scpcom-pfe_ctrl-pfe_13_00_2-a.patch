+#endif
+#if defined (COMCERTO_2000_UTIL)
+#define FRAG_DMEM_BUFFER	MEMCPY_TMP_BUF
+#define FRAG_DMEM_BUFFER_SIZE	MEMCPY_TMP_BUF_SIZE
