+#define RTPQOS_USED			(1 << 1)
+#define RTPQOS_UPDATING		(1 << 2)
+#endif
+
+
+#if defined (COMCERTO_2000)
+
+#if defined (COMCERTO_2000_CONTROL)
+
+/* control path HW rtp qos stats entry */
