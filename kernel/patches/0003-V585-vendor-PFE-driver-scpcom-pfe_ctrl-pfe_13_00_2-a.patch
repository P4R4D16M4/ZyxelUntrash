+/** Control path MC4 SW entry */
+typedef struct _tMC4Entry {
+	struct slist_entry list;
+	U32 src_addr;
+	U32 dst_addr;
+	/* common portion */
+	MCxEntry mcdest;
+	U16 status;
+	U16 rtpqos_ref_count;
