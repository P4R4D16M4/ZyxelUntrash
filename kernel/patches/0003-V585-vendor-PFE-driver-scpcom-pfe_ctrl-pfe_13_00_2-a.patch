+/**
+ * IP_expire()
+ *
+ *
+ */
+void IP_expire(PCtEntry pCtEntry)
+{
+	/* Can't send indication, try later from timeout routine */
+	pCtEntry->status |= (CONNTRACK_FF_DISABLED | CONNTRACK_TIMED_OUT);
+
+	IP_delete_CT_route(pCtEntry);
+}
