+#define PPP_LCP		0xc021	/* Link Control Protocol */
+#define PPP_IPCP	0x8021	/* IP Control Protocol */
+#define PPP_IPV6CP	0x8057	/* IPv6 Control Protocol */
+#define PPP_PAP		0xc023
+#define PPP_CHAP	0xc223
+
+
+#include "types.h"
