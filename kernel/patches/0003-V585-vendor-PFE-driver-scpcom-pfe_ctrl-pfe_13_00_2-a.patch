+typedef struct _tMC6Entry {
+	struct slist_entry list;
+	U32 src_addr[4];
+	U32 dst_addr[4];
+	/* common portion */
+	MCxEntry mcdest;
+	U16 status;
+	U16 rtpqos_ref_count;
