+	vap_cmd.action = RESET;
+
+	if (!pfe_vwd_handle_vap(priv, &vap_cmd)){
+		printk(KERN_INFO"VAP reset is  successfull\n");
+		//vap->ifname[0] = '\0';
+	}
+
+	spin_unlock_bh(&priv->vaplock);
+	rtnl_unlock();
+
+	return count;
+}
