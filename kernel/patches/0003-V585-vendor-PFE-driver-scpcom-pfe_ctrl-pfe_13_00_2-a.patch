+
+static int ipsec_eape_reset(void)
+{
+#ifdef CONFIG_OF
+	int rc;
+	struct reset_control *rst_ipsec = devm_reset_control_get_exclusive(pfe->dev, "ipsec");
+
+	if (IS_ERR(rst_ipsec)) {
+		rc = PTR_ERR(rst_ipsec);
+		dev_err(pfe->dev, "Failed to get pfe reset control: %d\n", rc);
