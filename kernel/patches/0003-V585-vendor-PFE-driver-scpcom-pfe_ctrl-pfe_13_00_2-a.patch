+		len += sprintf(buf + len, "	Id  	       : %d \n", vap->vapid);
+		len += sprintf(buf + len, "	Index          : %d \n", vap->ifindex);
+		len += sprintf(buf + len, "	State          : %s \n", (vap->state  == VAP_ST_OPEN) ? "OPEN":"CLOSED");
