+#define FLOW_DIR_FWD    2  // Forwarded flow for all traffic getting forwarded
+
+#define FLOW_DIR_IN_BITVAL (1 << FLOW_DIR_IN)
+#define FLOW_DIR_OUT_BITVAL (1 << FLOW_DIR_OUT)
+#define FLOW_DIR_FWD_BITVAL (1 << FLOW_DIR_FWD)
