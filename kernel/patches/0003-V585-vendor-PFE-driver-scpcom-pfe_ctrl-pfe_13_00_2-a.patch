+/**
+ * IP_delete_CT_route()
+ *
+ *
+ */
+void IP_delete_CT_route(PCtEntry pEntry)
+{
+	PRouteEntry pRtEntry = pEntry->pRtEntry;
+	U32 id;
+
+	if (IS_NULL_ROUTE(pRtEntry))
+		return;
+
+	id = pRtEntry->id;
+
+	L2_route_put(pRtEntry);
+
+#if defined(COMCERTO_2000)
+	pEntry->pRtEntry = NULL;
+#else
+	pEntry->route_id = id;
+#endif
+}
