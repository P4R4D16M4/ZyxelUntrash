+			u_int8_t ipproto[256 / 8];
+		} protocol;
+		struct {
+			u_int8_t dscp_value[64 / 8];
+		} dscp;
+		struct {
+			u_int32_t v4_addr;
+			u_int8_t v4_masklen;
+		} ipaddr;
+		struct {
