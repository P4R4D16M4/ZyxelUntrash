+MAC_ADDR gem_get_laddrN(void *base, unsigned int entry_index)
+{
+	MAC_ADDR addr = {0xffffffff, 0xffffffff};
+
+	if( (entry_index < 1) || (entry_index > EMAC_SPEC_ADDR_MAX) )
