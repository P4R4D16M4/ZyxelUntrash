+{
+	U32 sum;
+	sum = Saddr + ((Daddr << 7) | (Daddr >> 25));
+	sum ^= Sport + ((Dport << 11) | (Dport >> 21));
+	sum ^= (sum >> 16);
+	sum ^= (sum >> 8);
+	return (sum ^ Proto) & CT_TABLE_HASH_MASK;
+}
