+{
+	if (Is_FastCT_block(pblock))
+	{
+		*(U8 **)pblock = pFast_CTData_freelist;
+		pFast_CTData_freelist = (U8 *)pblock;
+	}
+	else
+		Heap_Free(pblock);
+}
