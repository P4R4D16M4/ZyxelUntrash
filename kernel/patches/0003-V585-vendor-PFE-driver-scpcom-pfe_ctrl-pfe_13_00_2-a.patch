+PCtEntry ct_alloc(void)
+{
+	PCtEntry pEntry_orig;
+	PCtEntry pEntry_rep;
+
+	/* Allocate local entry */
+	pEntry_orig = pfe_kzalloc(2 * sizeof(CtEntry), GFP_KERNEL);
