+	void *ddr_start;		/* points to start of current BMU2 buffer */
+	u16 ddr_offset;			/* offset in current BMU2 buffer */
+	u16 ddr_left;			/* remaining space in current BMU2 buffer */
+	u16 flags;			/* flags from the first session mtd */
+//	u8 saw_ts;
