+typedef struct tMC4_context {
+
+  	unsigned char ttl_check_rule;
+}MC4_context;
+
+
+#if defined (COMCERTO_2000)
+
+#if defined (COMCERTO_2000_CONTROL)
+
+/** Control path MC4 HW entry */
+typedef struct _thw_MC4Entry {
+	U32 	flags;
+	U32 	dma_addr;
+	U32 next;
