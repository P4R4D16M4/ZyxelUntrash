+		} ethertype;
+		struct {
+			U8 ipproto[256 / 8];
+		} protocol;
+		struct {
+			U8 dscp_value[64 / 8];
+		} dscp;
+		struct {
+			U32 v4_addr;
+			U8 v4_masklen;
+		} ipaddr;
+		struct {
+			U32 v6_addr[4];
+			U8 v6_masklen;
+		} ipv6addr;
+		struct {
+			U16 sport_from;
+			U16 sport_to;
+			U16 dport_from;
+			U16 dport_to;
+		} port;
+		struct {
+			U16 vlan_from;
+			U16 vlan_to;
+			U16 prio_from;
+			U16 prio_to;
+		} vlan;
+	};
+} __attribute__((__packed__)) icc_add_delete_cmd_t;
