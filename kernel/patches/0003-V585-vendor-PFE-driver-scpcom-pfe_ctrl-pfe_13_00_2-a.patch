+U32 IP_get_fwmark(PCtEntry pOrigEntry, PCtEntry pReplEntry)
+{
+	U32 fwmark;
+
+	fwmark = pOrigEntry->fwmark;
+	if (fwmark != pReplEntry->fwmark)
+	{
+		fwmark |= ((U32)pReplEntry->fwmark << 16) | 0x80000000;
+	}
+	return fwmark;
+}
