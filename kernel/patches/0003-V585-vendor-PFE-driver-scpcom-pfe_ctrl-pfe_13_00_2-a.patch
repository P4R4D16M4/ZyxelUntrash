+/** pfe_eth_set_device_wakeup
+ *
+ *  Called when a netdevice changes its wol status.
+ *  Scans state of all interfaces and updae PFE device
+ *  wakeable state
+ */
+static void pfe_eth_set_device_wakeup(struct pfe *pfe)
+{
