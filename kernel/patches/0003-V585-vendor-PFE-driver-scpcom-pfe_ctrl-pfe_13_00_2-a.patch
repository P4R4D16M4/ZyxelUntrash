+			U8 current_qnum;	// current active queue number
+			U8 next_flag;		// set to TRUE when current queue number must be updated
+		};
+	};
+	U8 init_flag;
+#endif
+} QM_SchedDesc, *PQM_SchedDesc;
+
+
+// commands
+
+typedef struct _tQosEnableCommand {
