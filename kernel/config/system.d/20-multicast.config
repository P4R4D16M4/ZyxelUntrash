# IPv4 multicast group management (IGMP), as on stock.  Without it the NAS
# never answers the router's IGMP queries, so a snooping switch or a WLAN
# bridge may stop forwarding 239.255.255.250 to it: SSDP searches (VLC, TVs)
# then miss the media server until its next NOTIFY.
# Merged over system.config by kernel/build-kernel.sh.
CONFIG_IP_MULTICAST=y
