# v1.2 "felt RAM": memory tiers RAM -> zswap (lz4) -> swap (SSD or HDD).
# Merged over system.config by kernel/build-kernel.sh; every =y here must
# survive olddefconfig or the build fails.
#
# Multi-gen LRU (on 32 bit it needs FLATMEM, which system.config has).
# Thrashing guard at runtime: /sys/kernel/mm/lru_gen/min_ttl_ms.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Compressed swap cache. 6.6 has no zswap shrinker (6.8+): cold pages reach
# the swap device only when the pool is full or via memory.reclaim.
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
# Pressure stall information: input for untrash-memd.
CONFIG_PSI=y
# cgroup v2 controllers: memory.low/high/reclaim per service, CPU and I/O
# priority for Desk/SMB/SSH over background jobs.
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_CGROUP_FREEZER=y
