# nftables, so untrash-mesh can limit what a cloud tunnel peer (a Nextcloud
# server, docs/architecture/cloud-api.md §4) reaches on this NAS: only the
# WebDAV port.  Without it the tunnel would open every NAS service to that
# server (security check 2026-11-03).  Built in: the filter must exist before
# untrash-mesh adds the peer, with no module to load.
# Merged over system.config by kernel/build-kernel.sh.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
