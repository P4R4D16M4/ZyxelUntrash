#!/bin/sh
# untrash-pfe-firmware [CACHE [SLOT [KERNELFILE]]]  (untrash-init, before systemd and udev)
#
# The network engine (PFE) of the NAS542 needs its PE firmware.  UntrashOS
# does not ship it: every NAS542 carries the matching set (pfe_12_00_2) in its
# own stock firmware, in the initramfs of the stock kernel on NAND partition
# kernel<SLOT>: the stock slot of the install run (ACTIVE_SLOT in device.env,
# default 1); the loader went into the other one (rootfs1 does not contain
# the firmware).  Preferred source is KERNELFILE: the copy of that stock kernel
# the stock firmware itself saved to the stick in the install run
# (install-*/mtd<4|6>-before-a.bin), so the NAND is not read at all.  The
# installer seeds the cache of the installed system, so NAND is only the
# fallback for systems installed before.  It is
# extracted once (untrash-pfe-extract) into CACHE (default
# /state/firmware/pfe) and the kernel firmware search path is pointed there;
# pfe.ko loads it later.
#
# Only a set the driver can use is accepted: version string pfe_12_00_2 and
# the shared-memory sizes of the stock driver (CONFIG_PFE_CTRL_FW12,
# tools/pfe/check-fw12-layout.py).  Read-only: the NAND MTD is registered
# non-writable.  The log also goes to CACHE.log on the state.
# Tests: ZT_PFE_KERNEL = a file standing in for kernel<SLOT>,
# ZT_PFE_FWPATH = file standing in for the firmware_class path parameter.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
D=${1:-/state/firmware/pfe}
SLOT=${2:-1}
case $SLOT in 1|2) ;; *) SLOT=1 ;; esac
KFILE=${3:-}
FWPATH=${ZT_PFE_FWPATH:-/sys/module/firmware_class/parameters/path}
LIB=$(dirname "$0")
log() {
	{ echo "UNTRASH-PFE: $*" >/dev/kmsg; } 2>/dev/null || echo "UNTRASH-PFE: $*"
	{ echo "$(date -u +%FT%TZ) $*" >>"$D.log"; } 2>/dev/null
}
mkdir -p "$(dirname "$D")" 2>/dev/null

# .dmem_sh sizes of the pfe_12_00_2 class and util images (bytes)
want_class=4416 want_util=1505
dmem_sh() {	# $1 = ELF32 big-endian -> size of section .dmem_sh, empty if none
	python3 - "$1" <<'P' 2>/dev/null
import struct, sys
b = open(sys.argv[1], "rb").read()
if b[:4] != b"\x7fELF" or b[5] != 2:
    sys.exit(1)
shoff, = struct.unpack(">I", b[32:36]); shentsize, shnum, shstrndx = struct.unpack(">HHH", b[46:52])
sh = [struct.unpack(">IIIIIIIIII", b[shoff + i * shentsize:shoff + i * shentsize + 40]) for i in range(shnum)]
strtab = b[sh[shstrndx][4]:sh[shstrndx][4] + sh[shstrndx][5]]
for s in sh:
    if strtab[s[0]:strtab.index(b"\0", s[0])] == b".dmem_sh":
        print(s[5])
P
}
usable() {	# $1 = directory with *_c2000.elf
	for f in class tmu util; do [ -s "$1/${f}_c2000.elf" ] || return 1; done
	grep -q pfe_12_00_2 "$1/class_c2000.elf" || return 1
	[ "$(dmem_sh "$1/class_c2000.elf")" = $want_class ] && [ "$(dmem_sh "$1/util_c2000.elf")" = $want_util ]
}

if ! usable "$D"; then
	src=${ZT_PFE_KERNEL:-}
	[ -z "$src" ] && [ -n "$KFILE" ] && [ -s "$KFILE" ] && src=$KFILE
	if [ -z "$src" ]; then
		mtd=$(sed -n "s/^mtd\([0-9]*\): .* \"kernel$SLOT\"\$/\1/p" /proc/mtd)
		[ -n "$mtd" ] && src=/dev/mtd$mtd || log "no NAND kernel$SLOT: no PFE firmware"
	fi
	if [ -n "$src" ]; then
		rm -rf "$D.new"
		if out=$(python3 "$LIB/untrash-pfe-extract" "$src" "$D.new" 2>&1) && usable "$D.new"; then
			rm -rf "$D"; mv "$D.new" "$D"; sync
			log "PE firmware pfe_12_00_2 copied from the stock kernel ($src): $out"
		else
			rm -rf "$D.new"; log "stock kernel $src has no usable pfe_12_00_2 PE firmware: $out"
		fi
	fi
fi
usable "$D" || exit 1
printf '%s' "$D" >"$FWPATH"
log "firmware path $D"
