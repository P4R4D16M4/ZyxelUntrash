[Unit]
Description=UntrashOS: enable PCIe ASM1061 storage after PFE startup
# PCIe before the PFE firmware handoff breaks RX.  Order: PFE first, then
# the PCIe root port, then generic PCI AHCI.
After=systemd-modules-load.service network.target
Before=untrash-data.service untrash-zyxel.service
Wants=network.target

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 20
ExecStart=/sbin/modprobe pcie_ls1024a
ExecStart=/sbin/modprobe ahci
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
