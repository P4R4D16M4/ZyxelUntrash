#!/bin/sh
# Self-signed TLS certificate of this NAS (FTP over TLS, HTTPS), made on the
# NAS itself: no key in the image.  Kept in /etc (state overlay).
D=/etc/untrash/tls
[ -s $D/untrash.key ] && [ -s $D/untrash.crt ] && exit 0
mkdir -p $D && chmod 700 $D
openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$(hostname)" \
	-keyout $D/untrash.key -out $D/untrash.crt 2>/dev/null
chmod 600 $D/untrash.key
