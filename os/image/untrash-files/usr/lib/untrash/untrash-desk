    dl = [d for d in disks() if not d.get("usb")]
    st = settings_load()
    on = sorted(k for k, v in st.get("services", {}).items() if (v.get("active") if isinstance(v, dict) else v))
    errs = read(["journalctl", "-p", "err", "-b", "-n", "25", "--no-pager", "-o", "cat"], timeout=15)
    info = {"version": first("/etc/untrash-version", "?").strip(), "kernel": os.uname().release,
            "boot": boot_env().get("ZT_BOOT", "?") + "/" + boot_env().get("ZT_SLOT", "?"),
            "disks": ", ".join("%.1f TB" % (d["size"] / 1e12) for d in dl if d.get("size")),
            "raid": ", ".join("%s %s" % (a["level"], a["health"]) for a in overview()["arrays"]) or "–",
            "language": st.get("language", "de"), "services": ", ".join(on),
            "errors": redact(errs.strip())[-2500:]}
    return {"issues": proj.get("issues", ""), "info": info}


