# codecs a browser plays without help (Firefox/Chrome); everything else is remuxed
WEB_VIDEO = {"h264", "vp8", "vp9", "av1"}
WEB_AUDIO = {"aac", "mp3", "opus", "vorbis", "flac"}


def files_probe(user, q):
    """Duration, container and streams of a media file (ffprobe) and how the
    player gets it: "direct" (the browser plays the file) or "remux" (ffmpeg
    copies the video and converts only the sound, live, files_stream)."""
    _b, full = resolve(user, q.get("share", ""), q.get("path", ""))
    if not os.path.isfile(full):
        raise Fail("Keine Datei.", 404)
    try:
        j = json.loads(read([FFPROBE, "-v", "error", "-print_format", "json", "-show_format", "-show_streams", full],
                            timeout=30) or "{}")
    except ValueError:
        j = {}
    fmt = j.get("format", {})
    vids, auds, subs = [], [], []
    for st in j.get("streams", []):
        t, tags = st.get("codec_type"), st.get("tags") or {}
        info = {"index": st.get("index"), "codec": st.get("codec_name", "?"), "lang": tags.get("language", ""),
                "title": tags.get("title", "")}
        if t == "video" and not (st.get("disposition") or {}).get("attached_pic"):
            info.update(width=st.get("width"), height=st.get("height"))
            vids.append(info)
        elif t == "audio":
            info.update(channels=st.get("channels"))
            auds.append(info)
        elif t == "subtitle":
            subs.append(info)
    names = fmt.get("format_name", "")
    # ffprobe names mkv and webm alike ("matroska,webm"): the extension decides
    ext = os.path.splitext(full)[1].lower()
    direct = ext in (".mp4", ".m4v", ".m4a", ".mov", ".webm", ".mp3", ".ogg", ".oga", ".opus", ".flac", ".wav", ".aac") \
        and all(v["codec"] in WEB_VIDEO for v in vids) and all(a["codec"] in WEB_AUDIO | {"pcm_s16le"} for a in auds[:1])
    playable = not vids or vids[0]["codec"] in WEB_VIDEO
    return {"duration": float(fmt.get("duration") or 0), "container": names, "video": vids, "audio": auds,
            "subtitles": subs, "mode": "direct" if direct else "remux" if playable else "none",
            "note": "" if playable else "Videoformat %s spielt kein Browser; Umkodieren kommt mit dem Export." % (
                vids[0]["codec"] if vids else "?")}


def files_upload(user, q, handler, length):
    name = q.get("name", "")
    if not name or "/" in name or name in (".", "..") or length > 64 * 1024 ** 3:
        raise Fail("Ungültiger Dateiname.")
    _b, full = resolve(user, q.get("share", ""), q.get("path", ""), write=True)
    dst = os.path.join(full, name)
    tmp = os.path.join(full, ".%s.untrash-upload" % name)
    with open(tmp, "wb") as f:
        left = length
        while left:
            b = handler.rfile.read(min(left, 1 << 20))
            if not b:
                os.unlink(tmp)
                raise Fail("Übertragung abgebrochen.")
            f.write(b)
            left -= len(b)
    os.chmod(tmp, 0o777)
    if not TEST:
        os.chown(tmp, owner_of(user), 500)
    os.replace(tmp, dst)
    return {}


