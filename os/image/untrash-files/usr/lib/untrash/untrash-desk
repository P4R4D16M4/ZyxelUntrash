TLS_DIR = R + "/etc/untrash/tls"


def cert_info():
    crt = TLS_DIR + "/untrash.crt"
    if not os.path.isfile(crt):
        return {"present": False}
    out = read(["openssl", "x509", "-in", crt, "-noout", "-subject", "-issuer", "-startdate", "-enddate",
                "-fingerprint", "-sha256"])
    info = {"present": True}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        info[{"subject": "subject", "issuer": "issuer", "notBefore": "from", "notAfter": "until"}.get(k.strip(), "fingerprint"
             if "Fingerprint" in k else k.strip())] = v.strip()
    info["self_signed"] = info.get("subject") == info.get("issuer")
    return info


