def first(path, default=""):
    try:
        return open(R + path).read().strip()
    except OSError:
        return default


def overview():
    s = settings_load()
    up = float((first("/proc/uptime", "0 0").split() or ["0"])[0])
    mem = {}
    for line in first("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        mem[k] = int(v.split()[0]) * 1024 if v.split() else 0
    addrs = []
    for line in read(["ip", "-4", "-o", "addr", "show"]).splitlines():
        p = line.split()
        if len(p) > 3 and p[1] != "lo":
            addrs.append({"if": p[1], "addr": p[3]})
    units = {}
    for u in ("smbd", "ssh", "vsftpd", "nfs-server", "minidlna", "chrony", "hd-idle", "avahi-daemon"):
        units[u] = read(["systemctl", "is-active", u + ".service"]).strip() or "unknown"
    md = []
    stat = first("/proc/mdstat")
    for m in re.finditer(r"^(md\d+) : (\w+) (\w+) (.*?)\n.*?\[([U_]+)\]", stat, re.M | re.S):
        if m.group(1) in ("md0", "md1"):     # stock firmware/swap mirrors over 4 bays (untrash-storage)
            continue
        md.append({"name": m.group(1), "state": m.group(2), "level": m.group(3), "health": m.group(5),
                   "degraded": "_" in m.group(5)})
    return {"hostname": s["hostname"], "version": first("/etc/untrash-version", "?"),
            "uptime": int(up), "load": first("/proc/loadavg").split()[:3],
            "mem_total": mem.get("MemTotal", 0), "mem_avail": mem.get("MemAvailable", 0),
            "addresses": addrs, "services": units, "volumes": volumes(), "arrays": md,
            "unsupported": s.get("unsupported", []), "time": datetime.datetime.now().isoformat(timespec="seconds"),
            "takeover": os.path.exists(TAKEOVER)}


def disks():
    out = []
    try:
        lb = json.loads(read(["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,TRAN,MODEL,SERIAL,FSTYPE,PARTLABEL,MOUNTPOINT"]) or "{}")
    except ValueError:
        lb = {}
    for d in lb.get("blockdevices", []):
        if d.get("type") != "disk" or (d.get("name") or "").startswith(("mtd", "ram", "zram", "loop", "md")):
            continue
        h = read(["smartctl", "-H", "-A", d["path"]], timeout=15)
        health = "ok" if "PASSED" in h else ("fehler" if "FAILED" in h else "?")
        temp = next((ln.split()[9] for ln in h.splitlines() if "Temperature_Celsius" in ln and len(ln.split()) > 9), "")
        out.append({"name": d["name"], "size": d.get("size"), "model": (d.get("model") or "").strip(),
                    "usb": d.get("tran") == "usb", "smart": health, "temp": temp,
                    "parts": [{"name": p["name"], "fs": p.get("fstype"), "label": p.get("partlabel"),
                               "mount": p.get("mountpoint")} for p in d.get("children") or []]})
    return out


