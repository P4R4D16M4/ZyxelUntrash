def share_access(user):
    if is_admin(user):
        return {x["name"]: {"path": x["path"], "access": "rw"} for x in shares() if x["enabled"]}
    stock = IMP.Stock(CONFIG)
    gl = [g for _gid, g, _t, _d in stock.groups() if user in stock.members(g)] + [EVERYONE]
    return IMP.user_access(stock, user, gl)


def resolve(user, share, rel, write=False):
    acc = share_access(user).get(share)
    if not acc or acc["access"] == "deny":
        raise Fail("Kein Zugriff auf diese Freigabe.", 403)
    if write and acc["access"] != "rw":
        raise Fail("Nur Lesezugriff.", 403)
    base = os.path.realpath(R + acc["path"])
    full = os.path.realpath(os.path.join(base, (rel or "").lstrip("/")))
    if full != base and not full.startswith(base + "/"):
        raise Fail("Pfad außerhalb der Freigabe.", 403)
    if os.path.basename(full) in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN):
        raise Fail("Geschützte Datei.", 403)
    return base, full


def owner_of(user):
    c = db()
    try:
        r = c.execute("SELECT uid FROM smb_user WHERE uname=?", (user,)).fetchone()
        return r[0] if r else 0
    finally:
        c.close()


def files_list(user, q):
    base, full = resolve(user, q.get("share", ""), q.get("path", ""))
    if not os.path.isdir(full):
        raise Fail("Kein Ordner.", 404)
    out = []
    for e in sorted(os.scandir(full), key=lambda e: (not e.is_dir(), e.name.lower())):
        if e.name.startswith(".") and e.name in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN, ".system", ".media"):
            continue
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        out.append({"name": e.name, "dir": e.is_dir(follow_symlinks=False), "size": st.st_size, "mtime": int(st.st_mtime)})
    return {"entries": out, "path": os.path.relpath(full, base) if full != base else ""}


def files_op(user, req):
    op, share = req.get("op"), req.get("share", "")
    _b, full = resolve(user, share, req.get("path", ""), write=True)
    name = req.get("name", "")
    if op in ("mkdir", "rename") and (not name or "/" in name or name in (".", "..")):
        raise Fail("Ungültiger Name.")
    if op == "mkdir":
        p = os.path.join(full, name)
        os.mkdir(p)
        os.chmod(p, 0o777)
        if not TEST:
            os.chown(p, owner_of(user), 500)
    elif op == "delete":
        if full == _b:
            raise Fail("Die Freigabe selbst bleibt.")
        if os.path.isdir(full) and not os.path.islink(full):
            shutil.rmtree(full)
        else:
            os.unlink(full)
    elif op == "rename":
        if full == _b:
            raise Fail("Die Freigabe selbst bleibt.")
        dst = os.path.join(os.path.dirname(full), name)
        if os.path.exists(dst):
            raise Fail("Name existiert schon.")
        os.rename(full, dst)
    else:
        raise Fail("Unbekannte Aktion.")
    return {}


