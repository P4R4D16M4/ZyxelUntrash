BACKUP = os.environ.get("ZT_BACKUP_TOOL", "/usr/lib/untrash/untrash-backup")
BACKUP_SECRETS = R + "/etc/untrash/backup-secrets"


def backup_tool(*args):
    r = subprocess.run([BACKUP] + list(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=600)
    if r.returncode:
        raise Fail((r.stderr.strip().splitlines() or r.stdout.strip().splitlines() or ["Fehler"])[-1].replace("untrash-backup: ", ""))
    return r.stdout


def backup_state():
    jobs = settings_load().get("backup", {}).get("jobs", [])
    try:
        status = json.loads(backup_tool("status") or "{}")
    except (Fail, ValueError):
        status = {}
    return {"jobs": jobs, "status": status, "shares": [x["name"] for x in shares() if x["enabled"]],
            "usb": [{"path": v["path"], "label": v["label"]} for v in volumes() if v["kind"] == "usb"]}


def backup_jobs(req):
    paths = {x["name"]: x["path"] for x in shares()}
    usb = {v["path"] for v in volumes() if v["kind"] == "usb"}
    clean = lambda p: "/".join(x for x in str(p or "").split("/") if x not in ("", ".", ".."))[:200]  # noqa: E731
    out, secrets_ = [], {}
    for j in req.get("jobs") or []:
        if j.get("type") not in ("archive", "sync", "rsync"):
            raise Fail("Art: Archiv, Synchronisation oder Rsync.")
        src = []
        for x in j.get("sources") or []:
            if x.get("share") not in paths:
                raise Fail("Quelle: Freigabe wählen.")
            src.append((paths[x["share"]].rstrip("/") + "/" + clean(x.get("folder"))).rstrip("/"))
        if not src:
            raise Fail("Mindestens eine Quelle.")
        t = j.get("target") or {}
        if j["type"] == "rsync":
            if not re.fullmatch(r"[A-Za-z0-9.:-]{1,253}", t.get("host", "")) or not re.fullmatch(r"[\w.-]{1,64}", t.get("module", "")):
                raise Fail("Rsync-Server und Modul prüfen.")
            tgt = {"kind": "rsync", "host": t["host"], "module": t["module"], "user": re.sub(r"[^\w.@-]", "", t.get("user", ""))[:64]}
        elif t.get("kind") == "usb":
            if t.get("path") not in usb:
                raise Fail("USB-Ziel wählen.")
            tgt = {"kind": "usb", "path": t["path"]}
        else:
            if t.get("share") not in paths:
                raise Fail("Ziel: Freigabe wählen.")
            tgt = {"kind": "local", "path": (paths[t["share"]].rstrip("/") + "/" + clean(t.get("folder"))).rstrip("/"),
                   "share": t["share"], "folder": clean(t.get("folder"))}
            if any(tgt["path"] == p0 or tgt["path"].startswith(p0 + "/") for p0 in src):
                raise Fail("Das Ziel darf nicht in der Quelle liegen.")
        sc = j.get("schedule") or {}
        if sc.get("kind", "manual") not in ("manual", "hourly", "daily", "weekly", "monthly"):
            raise Fail("Zeitplan prüfen.")
        jid = j.get("id") if re.fullmatch(r"[a-z0-9]{8}", j.get("id") or "") else secrets.token_hex(4)
        out.append({"id": jid, "name": re.sub(r"[^\w .-]", "_", (j.get("name") or "Sicherung"))[:40], "type": j["type"],
                    "sources": src, "source_names": [{"share": x["share"], "folder": clean(x.get("folder"))} for x in j["sources"]],
                    "target": tgt, "keep": max(1, min(1000, int(j.get("keep") or 7))),
                    "bwlimit": max(0, int(j.get("bwlimit") or 0)), "active": bool(j.get("active")),
                    "schedule": {"kind": sc.get("kind", "manual"), "hour": int(sc.get("hour", 2)) % 24,
                                 "minute": int(sc.get("minute", 0)) % 60, "day": int(sc.get("day", 0)) % 7,
                                 "mday": max(1, min(28, int(sc.get("mday", 1))))}})
        if j["type"] == "rsync" and j.get("password"):      # empty = keep the stored one
            secrets_[jid] = j["password"]
    s = settings_load()
    s.setdefault("backup", {})["jobs"] = out
    settings_save(s, apply=False)
    os.makedirs(BACKUP_SECRETS, mode=0o700, exist_ok=True)
    for jid, pw in secrets_.items():
        with open(os.open(os.path.join(BACKUP_SECRETS, jid), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write(pw)
    for f in os.listdir(BACKUP_SECRETS):
        if f not in {j["id"] for j in out}:
            os.unlink(os.path.join(BACKUP_SECRETS, f))
    return {"jobs": out}


