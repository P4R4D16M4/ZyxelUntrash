def check_password(pw):
    if not isinstance(pw, str) or len(pw) < 8 or len(pw) > 64 or "\n" in pw or "\0" in pw:
        raise Fail("Das Passwort braucht 8 bis 64 Zeichen.")


def smb_set_password(name, uid, pw):
    nt = untrash_auth.nt_hash(pw)
    c = db()
    try:
        c.execute("UPDATE smb_user SET passwd=? WHERE uname=?", ("X" * 32 + ":" + nt, name))
        if name == "admin":
            sh = untrash_auth.unix_crypt(pw, "$6$" + secrets.token_hex(8) + "$")
            c.execute("INSERT OR REPLACE INTO ugs_misc VALUES ('admin_shadow_passwd', ?)", (sh,))
            sysrun(["usermod", "-p", sh, "admin"])
        c.commit()
    finally:
        c.close()
    line = "%s:%d:%s:%s:[U          ]:LCT-00000000:\n" % (name, uid, "X" * 32, nt)
    if TEST:
        SYSLOG.append(["pdbedit-import", name])
        return
    tmp = os.path.join("/run/untrash", "pw-%s" % secrets.token_hex(6))
    os.makedirs("/run/untrash", exist_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, line.encode())
        os.close(fd)
        sysrun(["pdbedit", "-x", "-u", name], check=False)
        sysrun(["pdbedit", "-i", "smbpasswd:" + tmp, "-e", "tdbsam"])
    finally:
        os.unlink(tmp)


def user_create(req):
    name, pw = req.get("name", ""), req.get("password", "")
    if not NAME_RE.match(name) or name.lower() in ("root", "admin", GUEST, "nobody", EVERYONE):
        raise Fail("Ungültiger Benutzername.")
    check_password(pw)
    c = db()
    try:
        if c.execute("SELECT 1 FROM smb_user WHERE uname=? COLLATE NOCASE", (name,)).fetchone():
            raise Fail("Den Benutzer gibt es schon.")
        uid = max(503, c.execute("SELECT max(uid) FROM smb_user").fetchone()[0] or 0) + 1
        c.execute("INSERT INTO smb_user VALUES (?,?,?,?,?,?)",
                  (uid, name, "user-create", "user", "", (req.get("description") or "")[:60]))
        c.execute("INSERT INTO group_member VALUES (500, ?, ?, ?)", (EVERYONE, uid, name))
        c.commit()
    finally:
        c.close()
    sysrun(["useradd", "-u", str(uid), "-g", "500", "-M", "-d", "/nonexistent", "-s", "/usr/sbin/nologin",
            "-c", (req.get("description") or "")[:60], name])
    smb_set_password(name, uid, pw)
    for g in req.get("groups") or []:
        group_member(g, name, True)
    resmb()
    return {"uid": uid}


def user_delete(req):
    name = req.get("name", "")
    if name in ("admin", GUEST):
        raise Fail("Eingebaute Benutzer bleiben.")
    c = db()
    try:
        if not c.execute("SELECT 1 FROM smb_user WHERE uname=?", (name,)).fetchone():
            raise Fail("Unbekannter Benutzer.", 404)
        for t in ("smb_user", "group_member", "share_user_privilege"):
            c.execute("DELETE FROM %s WHERE uname=?" % t, (name,))
        c.commit()
    finally:
        c.close()
    sysrun(["pdbedit", "-x", "-u", name], check=False)
    sysrun(["userdel", name], check=False)
    resmb()
    return {}


def user_quota(name):
    """Stock per-user, per-volume hard block limit (user_grp_func.set_vol_quota)."""
    c = db()
    try:
        r = c.execute("SELECT uid FROM smb_user WHERE uname=?", (name,)).fetchone()
    finally:
        c.close()
    if not r:
        raise Fail("Unbekannter Benutzer.", 404)
    uid = r[0]
    out = []
    for v in volumes():
        if v["kind"] != "intern":
            continue
        used = limit = 0
        for line in read(["repquota", "-n", "-u", "-O", "csv", v["path"]]).splitlines()[1:]:
            f = line.split(",")
            if len(f) > 5 and f[0].lstrip("#") == str(uid):
                used, limit = int(f[3] or 0), int(f[5] or 0)
        out.append({"volume": v["id"], "label": v["label"], "used_kb": used, "limit_gb": round(limit / 1048576.0, 2)})
    return {"uid": uid, "quotas": out}


def user_quota_set(req):
    q = user_quota(req.get("name", ""))
    vols = {v["id"]: v for v in volumes() if v["kind"] == "intern"}
    for vid, gb in (req.get("quotas") or {}).items():
        if vid not in vols:
            raise Fail("Unbekanntes Volume.")
        gb = int(gb or 0)
        if not 0 <= gb <= 16383:
            raise Fail("Kontingent 0 (ohne Grenze) bis 16383 GB.")
        sysrun(["setquota", "-u", str(q["uid"]), "0", str(gb * 1048576), "0", "0", vols[vid]["path"]])
    return {}


def user_password(req, me):
    name = req.get("name") or me
    if name != me and not is_admin(me):
        raise Fail("Nur Administratoren ändern fremde Passwörter.", 403)
    if name == me and not is_admin(me) and not auth_ok(me, req.get("old", "")):
        raise Fail("Das bisherige Passwort stimmt nicht.", 403)
    check_password(req.get("password", ""))
    c = db()
    try:
        r = c.execute("SELECT uid FROM smb_user WHERE uname=?", (name,)).fetchone()
    finally:
        c.close()
    if not r or name == GUEST:
        raise Fail("Unbekannter Benutzer.", 404)
    smb_set_password(name, r[0], req["password"])
    return {}


def auth_ok(user, pw):
    if TEST:
        return pw == os.environ.get("ZT_DESK_TESTPW")
    return untrash_auth.check(user, pw)


def group_member(gname, uname, add):
    c = db()
    try:
        g = c.execute("SELECT gid FROM smb_group WHERE gname=?", (gname,)).fetchone()
        u = c.execute("SELECT uid FROM smb_user WHERE uname=?", (uname,)).fetchone()
        if not g or not u:
            raise Fail("Unbekannte Gruppe oder unbekannter Benutzer.", 404)
        if gname == EVERYONE:
            raise Fail("Alle Benutzer gehören zu everyone.")
        c.execute("DELETE FROM group_member WHERE gname=? AND uname=?", (gname, uname))
        if add:
            c.execute("INSERT INTO group_member VALUES (?,?,?,?)", (g[0], gname, u[0], uname))
        c.commit()
    finally:
        c.close()
    sysrun(["gpasswd", "-a" if add else "-d", uname, gname], check=False)


def group_create(req):
    name = req.get("name", "")
    if not NAME_RE.match(name) or name.lower() in (EVERYONE, "root", "users", "admin"):
        raise Fail("Ungültiger Gruppenname.")
    c = db()
    try:
        if c.execute("SELECT 1 FROM smb_group WHERE gname=? COLLATE NOCASE", (name,)).fetchone():
            raise Fail("Die Gruppe gibt es schon.")
        gid = max(500, c.execute("SELECT max(gid) FROM smb_group").fetchone()[0] or 0) + 1
        c.execute("INSERT INTO smb_group VALUES (?,?,?,?)", (gid, name, "local", (req.get("description") or "")[:60]))
        c.commit()
    finally:
        c.close()
    sysrun(["groupadd", "-g", str(gid), name])
    for u in req.get("members") or []:
        group_member(name, u, True)
    resmb()
    return {"gid": gid}


def group_delete(req):
    name = req.get("name", "")
    if name == EVERYONE:
        raise Fail("everyone bleibt.")
    c = db()
    try:
        for t in ("smb_group", "group_member", "share_group_privilege"):
            c.execute("DELETE FROM %s WHERE gname=?" % t, (name,))
        c.commit()
    finally:
        c.close()
    sysrun(["groupdel", name], check=False)
    resmb()
    return {}


def group_set_members(req):
    name, want = req.get("name", ""), set(req.get("members") or [])
    have = set(next((g["members"] for g in groups() if g["name"] == name), []))
    for u in sorted(want - have):
        group_member(name, u, True)
    for u in sorted(have - want):
        group_member(name, u, False)
    resmb()
    return {}


# ---------------------------------------------------------------- shares

def volumes():
    """Mounted data volumes under /i-data (stock and ut-data) and /e-data."""
    out = []
    for root, kind in ((IDATA, "intern"), (EDATA, "usb")):
        for d in sorted(glob.glob(root + "/*")):
            n = os.path.basename(d)
            if n in ("sysvol", ".system", ".media") or os.path.islink(d) or not os.path.isdir(d):
                continue
            label = ""
            try:
                label = open(os.path.join(d, ".system", "name_label")).read().strip()
            except OSError:
                pass
            try:
                st = os.statvfs(d)
                size, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
            except OSError:
                size = free = 0
            out.append({"id": n, "path": d.replace(R, "", 1), "kind": kind, "label": label or n,
                        "size": size, "free": free, "sysvol": os.path.realpath(IDATA + "/sysvol") == os.path.realpath(d)})
    return out


def shares():
    c = db()
    try:
        out = []
        for s_name, s_path, ctype, desc, en, br, rc, media, web in c.execute(
                "SELECT s_name, s_path, create_type, s_desc, s_enable, browseable, recycle, mdaserv_public_type, "
                "web_public FROM smb_share ORDER BY s_name COLLATE NOCASE"):
            out.append({"name": s_name, "path": s_path, "type": ctype, "description": desc or "",
                        "enabled": en == "y", "browseable": br == "y", "recycle": rc == "y", "media": media or 0,
                        "web_public": web == "y",
                        "present": os.path.isdir(R + s_path),
                        "users": dict(c.execute("SELECT uname, privilege FROM share_user_privilege WHERE s_name=?", (s_name,))),
                        "groups": dict(c.execute("SELECT gname, privilege FROM share_group_privilege WHERE s_name=?", (s_name,)))})
        return out
    finally:
        c.close()


def volume_dirs(q):
    """Folders below a volume (one level, for the folder picker); admins only."""
    vol = next((v for v in volumes() if v["id"] == q.get("volume")), None)
    if not vol:
        raise Fail("Volume wählen.")
    rel = "/".join(x for x in str(q.get("path") or "").split("/") if x not in ("", ".", ".."))
    base = os.path.realpath(R + vol["path"])
    full = os.path.realpath(os.path.join(base, rel))
    if full != base and not full.startswith(base + "/") or not os.path.isdir(full):
        raise Fail("Ordner prüfen.")
    shared = {x["path"] for x in shares()}
    out = []
    for e in sorted(os.scandir(full), key=lambda e: e.name.lower()):
        if e.is_dir(follow_symlinks=False) and not e.name.startswith((".", "@")):
            p = vol["path"] + "/" + os.path.relpath(e.path, base)
            out.append({"name": e.name, "shared": next((x["name"] for x in shares() if x["path"] == p), None) if p in shared else None})
    return {"volume": vol["id"], "path": rel, "dirs": out}


def share_save(req):
    """Create (new=true) or update a share: description, flags, rights."""
    name = req.get("name", "")
    if not SHARE_RE.match(name) or name.lower() in ("global", "homes", "printers", "ipc$"):
        raise Fail("Ungültiger Freigabename.")
    c = db()
    try:
        exists = c.execute("SELECT s_path FROM smb_share WHERE s_name=? COLLATE NOCASE", (name,)).fetchone()
        if req.get("new"):
            if exists:
                raise Fail("Die Freigabe gibt es schon.")
            vol = next((v for v in volumes() if v["id"] == req.get("volume")), None)
            if not vol:
                raise Fail("Volume wählen.")
            folder = "/".join(x for x in str(req.get("folder") or "").split("/") if x not in ("", ".", ".."))
            if folder:
                # an existing folder on the volume (any depth) becomes the share
                path = "%s/%s" % (vol["path"], folder)
                if not os.path.isdir(R + path) or os.path.islink(R + path):
                    raise Fail("Ordner prüfen.")
                if any(x[0] == path for x in c.execute("SELECT s_path FROM smb_share")):
                    raise Fail("Dieser Ordner ist schon freigegeben.")
            else:
                path = "%s/%s" % (vol["path"], name)
            c.execute("INSERT INTO smb_share VALUES (?,?,?,?,?,?,?,?,?)",
                      (name, path, "user-create", "", "y", "y", "n", 0, "n"))
            if not folder:
                if not TEST:
                    os.makedirs(path, exist_ok=True)
                    os.chmod(path, 0o777)
                else:
                    os.makedirs(R + path, exist_ok=True)
        elif not exists:
            raise Fail("Unbekannte Freigabe.", 404)
        sets = {"s_desc": (req.get("description") or "")[:120],
                "s_enable": "y" if req.get("enabled", True) else "n",
                "browseable": "y" if req.get("browseable", True) else "n",
                "recycle": "y" if req.get("recycle", False) else "n",
                "mdaserv_public_type": int(req.get("media") or 0) & 7}
        if "web_public" in req:
            sets["web_public"] = "y" if req.get("web_public") else "n"
        c.execute("UPDATE smb_share SET %s WHERE s_name=?" % ", ".join("%s=?" % k for k in sets),
                  list(sets.values()) + [name])
        if "users" in req or "groups" in req or req.get("new"):
            ulist = req.get("users") or ({"admin": "rw"} if req.get("new") else {})
            glist = req.get("groups") or {}
            uids = dict(c.execute("SELECT uname, uid FROM smb_user"))
            gids = dict(c.execute("SELECT gname, gid FROM smb_group"))
            for u, p in list(ulist.items()) + list(glist.items()):
                if p not in ("rw", "ro", "deny"):
                    raise Fail("Recht muss rw, ro oder deny sein.")
            if any(u not in uids for u in ulist) or any(g not in gids for g in glist):
                raise Fail("Unbekannter Benutzer oder unbekannte Gruppe in den Rechten.")
            c.execute("DELETE FROM share_user_privilege WHERE s_name=?", (name,))
            c.execute("DELETE FROM share_group_privilege WHERE s_name=?", (name,))
            c.executemany("INSERT INTO share_user_privilege VALUES (?,?,?,?)",
                          [(name, uids[u], u, p) for u, p in sorted(ulist.items())])
            c.executemany("INSERT INTO share_group_privilege VALUES (?,?,?,?)",
                          [(name, gids[g], g, p) for g, p in sorted(glist.items())])
        c.commit()
    finally:
        c.close()
    resmb()
    media_sync()
    return {}


def share_delete(req):
    """Stock semantics: the share disappears, the folder and its data stay."""
    name = req.get("name", "")
    c = db()
    try:
        r = c.execute("SELECT create_type FROM smb_share WHERE s_name=?", (name,)).fetchone()
        if not r:
            raise Fail("Unbekannte Freigabe.", 404)
        if r[0] == "built-in":
            raise Fail("Eingebaute Freigaben bleiben.")
        for t in ("smb_share", "share_user_privilege", "share_group_privilege"):
            c.execute("DELETE FROM %s WHERE s_name=?" % t, (name,))
        c.commit()
    finally:
        c.close()
    resmb()
    media_sync()
    return {}


def media_sync():
    """Media server shares follow the per-share media flags."""
    s = settings_load()
    s["services"]["mediaserver"]["shares"] = {x["name"]: x["media"] for x in shares() if x["enabled"] and x["media"]}
    settings_save(s, apply=False)


