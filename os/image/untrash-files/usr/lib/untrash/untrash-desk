def cert_regenerate(req):
    cn = req.get("cn") or settings_load()["hostname"]
    if not re.fullmatch(r"[A-Za-z0-9.-]{1,64}", cn):
        raise Fail("Name: Buchstaben, Ziffern, Punkt, Bindestrich.")
    os.makedirs(TLS_DIR, mode=0o700, exist_ok=True)
    r = subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650", "-subj", "/CN=" + cn,
                        "-addext", "subjectAltName=DNS:%s,DNS:%s.local" % (cn, cn.split(".")[0]),
                        "-keyout", TLS_DIR + "/untrash.key.new", "-out", TLS_DIR + "/untrash.crt.new"],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if r.returncode:
        raise Fail("openssl: %s" % r.stdout.decode(errors="replace")[-200:])
    os.chmod(TLS_DIR + "/untrash.key.new", 0o600)
    os.replace(TLS_DIR + "/untrash.key.new", TLS_DIR + "/untrash.key")
    os.replace(TLS_DIR + "/untrash.crt.new", TLS_DIR + "/untrash.crt")
    tls_reload()
    return cert_info()


def cert_upload(req):
    """Own certificate (PEM, chain allowed) + unencrypted private key; the key
    must belong to the certificate."""
    crt, key = req.get("cert") or "", req.get("key") or ""
    if "BEGIN CERTIFICATE" not in crt or "PRIVATE KEY" not in key or len(crt) + len(key) > 200000:
        raise Fail("Zertifikat und Schlüssel im PEM-Format einfügen.")
    if "ENCRYPTED" in key:
        raise Fail("Der Schlüssel darf nicht verschlüsselt sein.")
    os.makedirs(TLS_DIR, mode=0o700, exist_ok=True)
    tmpc, tmpk = TLS_DIR + "/up.crt", TLS_DIR + "/up.key"
    open(tmpc, "w").write(crt)
    with open(os.open(tmpk, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(key)
    a = read(["openssl", "x509", "-in", tmpc, "-noout", "-pubkey"])
    b = read(["openssl", "pkey", "-in", tmpk, "-pubout"])
    if not a or a != b:
        os.unlink(tmpc)
        os.unlink(tmpk)
        raise Fail("Der Schlüssel passt nicht zum Zertifikat.")
    os.replace(tmpk, TLS_DIR + "/untrash.key")
    os.replace(tmpc, TLS_DIR + "/untrash.crt")
    tls_reload()
    return cert_info()


