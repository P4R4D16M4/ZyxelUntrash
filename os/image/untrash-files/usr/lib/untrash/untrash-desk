    import urllib.request
    try:
        h = urllib.request.urlopen(DLNA_URL, timeout=3).read().decode("utf-8", "replace")
    except (OSError, ValueError):
        return None
    cells = lambda row: [re.sub(r"<[^>]+>", "", x).strip() for x in re.findall(r"<td[^>]*>(.*?)</td>", row, re.S)]  # noqa: E731
    rows = [cells(r) for r in re.findall(r"<tr[^>]*>(.*?)</tr>", h, re.S)]
    lib = {}
    for r in rows:
        if len(r) == 2 and r[1].isdigit():
            k = r[0].lower()
            lib["audio" if "audio" in k else "video" if "video" in k else "image" if "image" in k else k] = int(r[1])
    clients = [{"type": r[1], "ip": r[2], "connections": int(r[4]) if r[4].isdigit() else 0}
               for r in rows if len(r) >= 5 and r[0].isdigit() and re.fullmatch(r"[\d.:a-fA-F]+", r[2])]
    return {"library": lib, "clients": clients}


