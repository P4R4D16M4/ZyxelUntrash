# ------------------------------------------------------- download service

ARIA_RPC = os.environ.get("ZT_ARIA2_RPC", "http://127.0.0.1:6800/jsonrpc")
DL_KEYS = ["gid", "status", "totalLength", "completedLength", "downloadSpeed", "uploadSpeed", "errorMessage",
           "files", "bittorrent", "dir"]


def aria(method, *params):
    try:
        tok = "token:" + open(R + "/etc/untrash/aria2.secret").read().strip()
        body = json.dumps({"jsonrpc": "2.0", "id": "d", "method": method, "params": [tok] + list(params)}).encode()
        with urllib.request.urlopen(urllib.request.Request(ARIA_RPC, body, {"Content-Type": "application/json"}),
                                    timeout=10) as r:
            return json.load(r).get("result")
    except urllib.error.HTTPError as e:
        try:
            raise Fail("Download-Dienst: %s" % json.load(e)["error"]["message"])
        except (ValueError, KeyError):
            raise Fail("Download-Dienst: Fehler %d" % e.code)
    except OSError:
        raise Fail("Der Download-Dienst läuft nicht.", 503)


def downloads():
    d = settings_load()["services"]["download"]
    out = {"settings": d, "shares": [x["name"] for x in shares() if x["enabled"]], "items": [], "running": False}
    if not d["active"]:
        return out
    try:
        items = aria("aria2.tellActive", DL_KEYS) + aria("aria2.tellWaiting", 0, 200, DL_KEYS) + \
            aria("aria2.tellStopped", 0, 200, DL_KEYS)
    except Fail:
        return out
    out["running"] = True
    for it in items:
        bt = (it.get("bittorrent") or {}).get("info") or {}
        f0 = (it.get("files") or [{}])[0]
        name = bt.get("name") or os.path.basename(f0.get("path") or "") or \
            ((f0.get("uris") or [{}])[0].get("uri", "") if f0.get("uris") else "?")
        out["items"].append({"gid": it["gid"], "status": it["status"], "name": name,
                             "size": int(it.get("totalLength") or 0), "done": int(it.get("completedLength") or 0),
                             "down": int(it.get("downloadSpeed") or 0), "up": int(it.get("uploadSpeed") or 0),
                             "error": it.get("errorMessage", ""), "torrent": bool(it.get("bittorrent"))})
    return out


def downloads_add(req):
    url = (req.get("url") or "").strip()
    if not re.fullmatch(r"(https?|ftp|sftp)://\S+|magnet:\?\S+", url):
        raise Fail("Adresse: http(s)://, ftp:// oder magnet:?…")
    return {"gid": aria("aria2.addUri", [url])}


def downloads_torrent(handler, length):
    if not 0 < length <= 4 << 20:
        raise Fail("Keine Torrent-Datei.")
    data = handler.rfile.read(length)
    if not data.startswith(b"d"):
        raise Fail("Keine Torrent-Datei.")
    return {"gid": aria("aria2.addTorrent", base64.b64encode(data).decode())}


def downloads_ctl(req):
    gid, act = req.get("gid", ""), req.get("action")
    if act == "purge":
        aria("aria2.purgeDownloadResult")
        return {}
    if not re.fullmatch(r"[0-9a-f]{16}", gid):
        raise Fail("Unbekannter Download.")
    if act == "pause":
        aria("aria2.forcePause", gid)
    elif act == "resume":
        aria("aria2.unpause", gid)
    elif act == "remove":
        try:
            aria("aria2.forceRemove", gid)
        except Fail:
            pass
        aria("aria2.removeDownloadResult", gid)
    else:
        raise Fail("pause, resume, remove oder purge.")
    return {}


