def static(base, rel):
    rel = urllib.parse.unquote(rel.split("?", 1)[0])
    b = os.path.realpath(base)
    full = os.path.realpath(os.path.join(b, rel))
    if not full.startswith(b + "/") or not os.path.isfile(full):
        return None
    t = STATIC_TYPES.get(os.path.splitext(full)[1])
    return (open(full, "rb").read(), t) if t else None


