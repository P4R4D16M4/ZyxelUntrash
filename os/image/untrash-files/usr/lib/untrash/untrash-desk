def iscsi_targets(req):
    s = settings_load()
    lunnames = {l["name"] for l in s["iscsi"]["luns"]}
    sec, old = iscsi_secrets(), {t["iqn"]: t for t in s["iscsi"]["targets"]}
    out, newsec, seen = [], {}, set()
    iqn_re = r"(iqn\.\d{4}-\d{2}\.[a-z0-9.-]+(:[\w.:-]+)?|eui\.[0-9a-fA-F]{16})"
    for t in req.get("targets") or []:
        name = t.get("name", "")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,31}", name):
            raise Fail("Zielname: Buchstaben, Ziffern, _ -.")
        iqn = (t.get("iqn") or "iqn.2026-10.local.untrash:%s.%s" % (s["hostname"].lower(), name.lower())).strip()
        if not re.fullmatch(iqn_re, iqn) or len(iqn) > 223 or iqn in seen:
            raise Fail("IQN prüfen (iqn.JJJJ-MM.domain:name), nicht doppelt.")
        seen.add(iqn)
        luns = [x for x in t.get("luns") or [] if x in lunnames][:10]
        inis = [x.strip() for x in t.get("initiators") or [] if x.strip()]
        if any(not re.fullmatch(iqn_re, x) for x in inis):
            raise Fail("Initiator-IQN prüfen.")
        a = dict(sec.get(iqn) or (sec.get(old[iqn]["iqn"]) if iqn in old else {}) or {})
        if t.get("chap"):
            if t.get("chap_password"):
                if not 12 <= len(t["chap_password"]) <= 16:
                    raise Fail("CHAP-Passwort: 12 bis 16 Zeichen.")
                a["password"] = t["chap_password"]
            a["user"] = (t.get("chap_user") or "").strip()[:64]
            if not a.get("user") or not a.get("password"):
                raise Fail("CHAP: Benutzer und Passwort.")
            if t.get("mutual"):
                if t.get("mutual_password"):
                    a["mutual_password"] = t["mutual_password"]
                a["mutual_user"] = (t.get("mutual_user") or "").strip()[:64]
                if not a.get("mutual_user") or not a.get("mutual_password") or a["mutual_password"] == a["password"]:
                    raise Fail("Gegenseitiges CHAP: eigener Benutzer und ein anderes Passwort.")
            else:
                a.pop("mutual_user", None)
                a.pop("mutual_password", None)
            newsec[iqn] = a
        out.append({"name": name, "iqn": iqn, "luns": luns, "initiators": inis, "active": bool(t.get("active", True))})
    s["iscsi"]["targets"] = out
    settings_save(s, apply=False)
    with open(os.open(ISCSI_SECRETS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(newsec, f)
    iscsi_apply()
    return {"targets": out}


