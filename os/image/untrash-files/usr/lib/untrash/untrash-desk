                    raise Fail("Ungültige Domain: %s" % str(d)[:80])
                if c not in vals:
                    vals.append(c)
            restart = restart or vals != s[k]
            rebuild = rebuild or (k == "allow" and vals != s[k])
            s[k] = vals
    AB.save(s)
    if rebuild:
        s["count"] = AB.build(s)
        AB.save(s)
        AB.reload_hosts()
    if "active" in req:
        os.makedirs(AB.DATA, exist_ok=True)
