def raid_job(req):
    """Starts one untrash-storage job in the background (stock: storage_main
    thread + lock file); the log is polled through /api/raid."""
    op = req.get("op", "")
    if op not in RAID_OPS:
        raise Fail("Unbekannter Auftrag.")
    if RAIDJOB["state"] == "running":
        raise Fail("Ein Speicherauftrag läuft noch.")
    need = RAID_CONFIRM.get(op)
    if need and req.get("confirm") != need:
        raise Fail("Zum Bestätigen %s eintippen." % need)
    args = {k: v for k, v in req.items() if k not in ("op", "confirm")}
    RAIDJOB.update(state="running", op=op, log=[time.strftime("%H:%M:%S ") + "Auftrag " + op])

    def worker():
        rc = 1
        try:
            p = subprocess.Popen([STORAGE, "run", op, json.dumps(args)], stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True)
            for line in p.stdout:
                RAIDJOB["log"].append(line.rstrip("\n"))
                del RAIDJOB["log"][:-2000]
            rc = p.wait()
        except OSError as e:
            RAIDJOB["log"].append("FEHLER %s" % e)
        try:
            with LOCK:
                resmb()            # shares on a deleted volume left the database
        except (Fail, OSError) as e:
            RAIDJOB["log"].append("Samba: %s" % e)
        RAIDJOB["state"] = "done" if rc == 0 else "failed"

    threading.Thread(target=worker, daemon=True).start()
    return {"op": op}


# ------------------------------------------------------------- slot update

UPDATE = {"state": "idle", "log": []}


def boot_env():
    try:
        return dict(l.rstrip("\n").split("=", 1) for l in open(R + "/run/untrash/boot.env") if "=" in l)
    except OSError:
        return {}


def update_upload(handler, length):
    """Body = a slot file (*.utslot, os/install/mk-stick-system.sh); stored,
    signature + payload hashes checked by zt-loader's rules, written to the
    inactive slot, boot state prefers it once.  The loader falls back to the
    old slot if the new one never confirms itself (3 tries)."""
    if length <= 8192 or length > 1536 * 1024 * 1024:
        raise Fail("Keine Systemabbild-Datei.")
    os.makedirs(UPLOAD_DIR, exist_ok=True)
    tmp = os.path.join(UPLOAD_DIR, "upload.utslot")
    with open(tmp, "wb") as f:
        left = length
        while left:
            b = handler.rfile.read(min(left, 1 << 20))
            if not b:
                raise Fail("Übertragung abgebrochen.")
            f.write(b)
            left -= len(b)
    with open(tmp, "rb") as f:
        f.seek(length - 8192)
        man = f.read(4096).rstrip(b"\0").decode("utf-8", "replace")
        sig = f.read(64)
    m = dict(l.split("=", 1) for l in man.splitlines() if "=" in l)
    if m.get("format") != "untrash-slot-2":
        raise Fail("Kein UntrashOS-Systemabbild (Format).")
    open(tmp + ".manifest", "w").write(man)
    open(tmp + ".sig", "wb").write(sig)
    ok = TEST or any(subprocess.run(["/usr/lib/untrash/zt-sig", "verify", k, tmp + ".manifest", tmp + ".sig"],
                                    stdout=subprocess.DEVNULL).returncode == 0
                     for k in glob.glob("/usr/lib/untrash/keys/*.pub"))
    if not ok:
        raise Fail("Signatur ungültig: Abbild nicht von UntrashOS.")
    with open(tmp, "rb") as f:
        for p in ("kernel", "dtb", "initrd"):
            if m.get(p + "_off"):
                f.seek(int(m[p + "_off"]))
                if hashlib.sha256(f.read(int(m[p + "_len"]))).hexdigest() != m.get(p + "_sha256"):
                    raise Fail("Abbild beschädigt (%s)." % p)
    UPDATE.update(state="ready", version=m.get("version", "?"), file=tmp, size=length,
                  log=["Abbild %s geprüft (Signatur, Kernel, DTB, initrd)" % m.get("version", "?")])
    return {"version": UPDATE["version"]}


def update_install(req):
    if UPDATE.get("state") != "ready":
        raise Fail("Erst ein Abbild hochladen.")
    env = boot_env()
    slot = env.get("ZT_SLOT") or ""
    other = "b" if slot == "a" else "a"
    f = UPDATE["file"]
    if env.get("ZT_BOOT") == "file":
        dst = "%s/.untrash/slot-%s.utslot" % (env.get("ZT_HOST", "/run/untrash/host"), other)
        sysrun(["cp", f, dst + ".new"])
        sysrun(["sync"])
        sysrun(["mv", dst + ".new", dst])
    else:
        part = read(["findfs", "PARTLABEL=ut-sys-" + other]).strip() or "PARTLABEL=ut-sys-" + other
        # head at the start of the partition, trailer in its last 8 KiB
        sysrun(["/usr/lib/untrash/untrash-slot-write", f, part])
    sysrun(["/usr/lib/untrash/untrash-bootstate", "prefer", other])
    UPDATE["log"].append("in Slot %s geschrieben; Neustart startet %s" % (other.upper(), UPDATE["version"]))
    UPDATE["state"] = "installed"
    return {"slot": other}


