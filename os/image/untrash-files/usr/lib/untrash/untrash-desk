def link_create(user, req):
    """A download link for a file or folder the user may read: expires after
    1..90 days, optionally with a password (stored as salted SHA-256)."""
    share, path = req.get("share", ""), req.get("path", "")
    _b, full = resolve(user, share, path)
    if not os.path.exists(full):
        raise Fail("Keine Datei.", 404)
    days = int(req.get("days") or 7)
    if not 1 <= days <= 90:
        raise Fail("Gültigkeit 1 bis 90 Tage.")
    pw = req.get("password") or ""
    if pw and len(pw) < 4:
        raise Fail("Passwort für den Link: mindestens 4 Zeichen.")
    tok = secrets.token_urlsafe(18)
    salt = secrets.token_hex(8)
    d = links_load()
    d[tok] = {"share": share, "path": path, "owner": user, "dir": os.path.isdir(full), "created": int(time.time()),
              "expires": int(time.time() + days * 86400), "salt": salt,
              "pw": hashlib.sha256((salt + pw).encode()).hexdigest() if pw else ""}
    links_write(d)
    return {"token": tok, "url": "/s/" + tok, "expires": d[tok]["expires"]}


def links_list(user):
    adm = is_admin(user)
    return {"links": [{"token": k, "share": v["share"], "path": v["path"], "owner": v["owner"], "dir": v.get("dir"),
                       "expires": v["expires"], "password": bool(v.get("pw"))}
                      for k, v in sorted(links_load().items(), key=lambda x: -x[1]["created"]) if adm or v["owner"] == user]}


def link_delete(user, req):
    d = links_load()
    v = d.get(req.get("token", ""))
    if not v or not (is_admin(user) or v["owner"] == user):
        raise Fail("Unbekannter Link.", 404)
    del d[req["token"]]
    links_write(d)
    return {}


