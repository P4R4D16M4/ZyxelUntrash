def adblock_save(req):
    s = AB.load()
    restart = rebuild = False
    if "lists" in req:
        ls = []
        for x in req["lists"][:20]:
            url = str(x.get("url", "")).strip()
            if not re.fullmatch(r"https?://[^\s]{4,500}", url):
                raise Fail("Ungültige Listen-Adresse: %s" % url[:80])
            ls.append({"name": str(x.get("name") or url)[:60], "url": url, "on": bool(x.get("on"))})
        rebuild = ls != s["lists"]
        s["lists"] = ls
    for k in ("allow", "block"):
