[Unit]
Description=UntrashOS: confirm the running slot to the loader
ConditionPathExists=/proc/device-tree/chosen/untrash,stage
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/untrash/untrash-bootstate mark-good
ExecStartPost=/usr/lib/untrash/untrash-sound --optional play success
