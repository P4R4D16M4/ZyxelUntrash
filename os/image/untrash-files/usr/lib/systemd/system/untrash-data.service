[Unit]
Description=UntrashOS: data partition ut-data (way A) at /i-data/utdata
ConditionKernelCommandLine=!untrash.installer=1
ConditionPathExists=/dev/disk/by-partlabel/ut-data
After=local-fs.target untrash-zyxel.service systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mountpoint -q /i-data || mount -t tmpfs -o mode=0755,size=1m tmpfs /i-data; mkdir -p /i-data/utdata; mountpoint -q /i-data/utdata || mount -t btrfs -o noatime /dev/disk/by-partlabel/ut-data /i-data/utdata; chmod 777 /i-data/utdata; [ -e /i-data/sysvol ] || ln -s utdata /i-data/sysvol'
ExecStop=/bin/umount /i-data/utdata

[Install]
WantedBy=multi-user.target
