STATE_LIB = os.environ.get("ZT_STATE_LIB", "/var/lib/untrash")
ZONEINFO = os.environ.get("ZT_ZONEINFO", "/usr/share/zoneinfo")
MEDIA_VIDEO, MEDIA_PHOTO, MEDIA_MUSIC = 1, 2, 4     # stock ugs_comm_def MEDIA_SERV_PUBLIC_*
IMPORT_TOOL = os.environ.get("ZT_IMPORT_TOOL", "/usr/sbin/untrash-import-zyxel")
# stock dydns_main_model providers (inadyn there too) + current free services;
# stock "dhs" and "myzyxelth" no longer exist
DYNDNS = {"dyndns": "default@dyndns.org", "noip": "default@no-ip.com", "3322": "dyndns@3322.org",
          "zoneedit": "default@zoneedit.com", "duckdns": "default@duckdns.org",
          "freedns": "default@freedns.afraid.org", "dynv6": "default@dynv6.com"}
WEBDAV_PORT, WEBDAV_TLS_PORT = 5002, 5003            # stock httpd_dav.conf
BOND_MODES = ("balance-rr", "active-backup", "balance-xor", "broadcast", "802.3ad", "balance-tlb", "balance-alb")
WEEKDAYS = ("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

LANGUAGES = ("de", "en", "fr")
DEFAULTS = {
    "hostname": "zyxel-untrash",
    "language": "de",          # Desk default; a browser may choose its own (i18n.js)
    "netbios": {"name": "ZYXEL-UNTRASH", "description": "UntrashOS", "workgroup": "WORKGROUP", "nomaster": False},
    "time": {"timezone": "Europe/Berlin", "ntp": True, "ntp_server": "pool.ntp.org"},
    "network": {"eth0": {"mode": "dhcp", "address": "", "gateway": "", "mtu": 1500},
                "eth1": {"mode": "dhcp", "address": "", "gateway": "", "mtu": 1500},
